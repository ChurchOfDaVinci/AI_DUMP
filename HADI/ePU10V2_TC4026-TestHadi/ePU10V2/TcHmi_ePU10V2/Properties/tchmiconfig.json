  "actionTemplates": [
    {
      "name": "PopupOpen",
      "category": "Action Templates",
      "actions": [
        {
          "objectType": "Condition",
          "active": true,
          "parts": [
            {
              "if": [
                {
                  "compare1": {
                    "objectType": "Symbol",
                    "valueType": "tchmi:framework#/definitions/TcHmi.Controls.System.TcHmiPopup.TargetFile",
                    "symbolExpression": "%tp%Target::path%/tp%"
                  },
                  "compare2": {
                    "objectType": "FunctionExpression",
                    "functionExpression": "\"\""
                  },
                  "compareOperator": "!=",
                  "logic": null
                }
              ],
              "then": [
                {
                  "objectType": "WriteToSymbol",
                  "active": true,
                  "symbolExpression": "%ctrl%TcHmiPopupRegion::TargetFile%/ctrl%",
                  "value": {
                    "objectType": "Symbol",
                    "valueType": "tchmi:framework#/definitions/TcHmi.Controls.System.TcHmiPopup.TargetFile",
                    "symbolExpression": "%tp%Target%/tp%"
                  },
                  "asyncWait": true
                },
                {
                  "objectType": "WriteToSymbol",
                  "active": true,
                  "symbolExpression": "%ctrl%TcHmiPopupRegion::HeaderText%/ctrl%",
                  "value": {
                    "objectType": "Symbol",
                    "valueType": "tchmi:general#/definitions/String",
                    "symbolExpression": "%f%ToUpperCase(%tp%Title%/tp%)%/f%"
                  },
                  "asyncWait": true
                },
                {
                  "objectType": "ControlApiFunction",
                  "active": true,
                  "control": "TcHmiPopupRegion",
                  "fn": "open",
                  "asyncWait": true
                }
              ]
            },
            {
              "else": []
            }
          ],
          "asyncWait": true
        }
      ],
      "parameters": [
        {
          "name": "Target",
          "type": "tchmi:framework#/definitions/TcHmi.Controls.System.TcHmiPopup.TargetFile",
          "description": ""
        },
        {
          "name": "Title",
          "type": "tchmi:general#/definitions/String",
          "description": ""
        }
      ]
    }
  ],
