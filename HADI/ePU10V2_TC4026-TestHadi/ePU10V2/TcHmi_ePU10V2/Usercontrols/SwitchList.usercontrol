<div id="SwitchInputField_1" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-height="100" data-tchmi-height-unit="px" data-tchmi-left="0" data-tchmi-left-unit="px" data-tchmi-target-user-control="Contents/SwitchInputField.usercontrol" data-tchmi-top="5" data-tchmi-top-unit="px" data-tchmi-width-unit="px" data-tchmi-height-mode="Content" data-tchmi-right="0" data-tchmi-title="%pp%Label1%/pp%" data-tchmi-var="%pp%Data1%/pp%" data-tchmi-info="%pp%Info1%/pp%" data-tchmi-visibility="%f%if(%pp%Enable1%/pp%){&quot;Visbile&quot;}else{&quot;Collapsed&quot;}%/f%">


</div>
<div id="SwitchInputField_2" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-height="100" data-tchmi-height-unit="px" data-tchmi-left="0" data-tchmi-left-unit="px" data-tchmi-target-user-control="Contents/SwitchInputField.usercontrol" data-tchmi-top="5" data-tchmi-top-unit="px" data-tchmi-width-unit="px" data-tchmi-height-mode="Content" data-tchmi-right="0" data-tchmi-title="%pp%Label2%/pp%" data-tchmi-var="%pp%Data2%/pp%" data-tchmi-info="%pp%Info2%/pp%" data-tchmi-visibility="%f%if(%pp%Enable2%/pp%){&quot;Visbile&quot;}else{&quot;Collapsed&quot;}%/f%" data-tchmi-grid-row-index="1">
</div>
<div id="SwitchInputField_3" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-height="100" data-tchmi-height-unit="px" data-tchmi-left="0" data-tchmi-left-unit="px" data-tchmi-target-user-control="Contents/SwitchInputField.usercontrol" data-tchmi-top="5" data-tchmi-top-unit="px" data-tchmi-width-unit="px" data-tchmi-height-mode="Content" data-tchmi-right="0" data-tchmi-title="%pp%Label3%/pp%" data-tchmi-var="%pp%Data3%/pp%" data-tchmi-info="%pp%Info3%/pp%" data-tchmi-visibility="%f%if(%pp%Enable3%/pp%){&quot;Visbile&quot;}else{&quot;Collapsed&quot;}%/f%" data-tchmi-grid-row-index="2">
</div>
<div id="SwitchInputField_4" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-height="100" data-tchmi-height-unit="px" data-tchmi-left="0" data-tchmi-left-unit="px" data-tchmi-target-user-control="Contents/SwitchInputField.usercontrol" data-tchmi-top="5" data-tchmi-top-unit="px" data-tchmi-width-unit="px" data-tchmi-height-mode="Content" data-tchmi-right="0" data-tchmi-title="%pp%Label4%/pp%" data-tchmi-var="%pp%Data4%/pp%" data-tchmi-info="%pp%Info4%/pp%" data-tchmi-visibility="%f%if(%pp%Enable4%/pp%){&quot;Visbile&quot;}else{&quot;Collapsed&quot;}%/f%" data-tchmi-grid-row-index="3">
</div>
</div>


</div>

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[
  {
    "event": "%pp%Show%/pp%",
    "actions": [
      {
        "objectType": "SwitchCase",
        "active": true,
        "compare": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/BOOL",
          "symbolExpression": "%pp%Show%/pp%"
        },
        "cases": [
          {
            "caseValue": {
              "objectType": "StaticValue",
              "valueType": "tchmi:general#/definitions/BOOL",
              "value": true
            },
            "actions": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctx%owner::Visibility%/ctx%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:framework#/definitions/Visibility",
                  "value": "Visible"
                },
                "asyncWait": true
              }
            ]
          },
          {
            "caseValue": {
              "objectType": "StaticValue",
              "valueType": "tchmi:general#/definitions/BOOL",
              "value": false
            },
            "actions": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctx%owner::Visibility%/ctx%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:framework#/definitions/Visibility",
                  "value": "Collapsed"
                },
                "asyncWait": true
              }
            ]
          }
        ],
        "asyncWait": true
      }
    ]
  }
]</script>
</div>