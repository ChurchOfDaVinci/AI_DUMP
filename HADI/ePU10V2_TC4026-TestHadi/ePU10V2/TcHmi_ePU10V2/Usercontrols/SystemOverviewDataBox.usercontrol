  "bottomRight": 3.0,
  "topLeftUnit": "px",
  "topRightUnit": "px",
  "bottomLeftUnit": "px",
  "bottomRightUnit": "px"
}
</script>






</div>

<script data-tchmi-target-attribute="data-tchmi-border-width" type="application/json">
