<div
  id="SystemOverviewDataBox"
  data-tchmi-type="TcHmi.Controls.System.TcHmiUserControl"
  data-tchmi-top="0"
  data-tchmi-left="0"
  data-tchmi-width="100"
  data-tchmi-height="100"
  data-tchmi-width-unit="%"
  data-tchmi-height-unit="%"
  data-tchmi-creator-viewport-width="500"
  data-tchmi-creator-viewport-height="320"
 data-tchmi-height-mode="Content" data-tchmi-width-mode="Value" data-tchmi-visibility="%f%if(%pp%Show%/pp%){'Visible'}else{'Collapsed'}%/f%"><div id="TcHmiTextblock_OverviewDataBox" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="0" data-tchmi-left-unit="px" data-tchmi-text="%f%ToUpperCase(FormatString('{0} {1}',%pp%Title%/pp%, %pp%ModeMessage%/pp%))%/f%" data-tchmi-top="0" data-tchmi-top-unit="px" data-tchmi-width="100" data-tchmi-width-unit="%" data-tchmi-word-wrap="True" data-tchmi-text-horizontal-alignment="Center" data-tchmi-text-vertical-alignment="Center" data-tchmi-text-font-size="%i%TitleSize%/i%" data-tchmi-height-mode="Value" data-tchmi-text-font-weight="Bold" data-tchmi-height="%f%%i%TitleSize%/i%+20%/f%">




</div>
<div id="TcHmiGrid_OverviewDataBox" data-tchmi-type="TcHmi.Controls.System.TcHmiGrid" data-tchmi-left="0" data-tchmi-left-unit="px" data-tchmi-top="%ctrl%TcHmiTextblock_OverviewDataBox::RenderedHeight%/ctrl%" data-tchmi-top-unit="px" data-tchmi-width="100" data-tchmi-width-unit="%" data-tchmi-height-mode="Content" data-tchmi-cell-wrap="False" data-tchmi-min-width="150">
<script data-tchmi-target-attribute="data-tchmi-column-options" type="application/json">
[
  {
    "overflow": false,
    "width": 3.0,
    "widthMode": "Value",
    "widthUnit": "factor"
  },
  {
    "minWidth": 70.0,
    "width": 1,
    "widthMode": "Value",
    "widthUnit": "factor"
  }
]
</script>

<script data-tchmi-target-attribute="data-tchmi-row-options" type="application/json">
[
  {
    "height": 1.0,
    "heightMode": "Value",
    "heightUnit": "factor",
    "overflow": false
  },
  {
    "height": 1,
    "heightMode": "Value",
    "heightUnit": "factor"
  },
  {
    "height": 1,
    "heightMode": "Value",
    "heightUnit": "factor"
  }
]
</script>
<div id="TcHmiTextblock_OverviewDataBox_Power" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="0" data-tchmi-left-unit="px" data-tchmi-text="%l%L_Power%/l%" data-tchmi-top="0" data-tchmi-top-unit="px" data-tchmi-word-wrap="True" data-tchmi-right="0" data-tchmi-bottom="0" data-tchmi-height-mode="Content" data-tchmi-text-horizontal-alignment="Left" data-tchmi-text-vertical-alignment="Center" data-tchmi-text-font-size="%i%TextSize%/i%" data-tchmi-visibility="%f%if(%pp%ShowPower%/pp%){'Visible'}else{'Collapsed'}%/f%" data-tchmi-grid-row-index="1">

<script data-tchmi-target-attribute="data-tchmi-content-padding" type="application/json">
{
  "left": 10,
  "right": 10,
  "top": 5,
  "bottom": 5,
  "leftUnit": "px",
  "rightUnit": "px",
  "topUnit": "px",
  "bottomUnit": "px"
}
</script>
</div>
<div id="TcHmiTextblock_OverviewDataBox_Powerdata" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="0" data-tchmi-left-unit="px" data-tchmi-top="0" data-tchmi-top-unit="px" data-tchmi-word-wrap="True" data-tchmi-right="0" data-tchmi-bottom="0" data-tchmi-height-mode="Value" data-tchmi-text-horizontal-alignment="Left" data-tchmi-text-vertical-alignment="Center" data-tchmi-text-font-size="%i%TextSize%/i%" data-tchmi-grid-column-index="1" data-tchmi-text="%f%FormatString('{0|.0f} kW', %pp%Power%/pp%)%/f%" data-tchmi-grid-row-index="1">
<script data-tchmi-target-attribute="data-tchmi-content-padding" type="application/json">
{
  "left": 10,
  "right": 10,
  "top": 5,
  "bottom": 5,
  "leftUnit": "px",
  "rightUnit": "px",
  "topUnit": "px",
  "bottomUnit": "px"
}
</script>
</div>
