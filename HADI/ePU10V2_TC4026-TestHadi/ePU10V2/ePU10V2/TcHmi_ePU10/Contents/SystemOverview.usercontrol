<div id="TcHmiHtmlHost_8" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-height-unit="%" data-tchmi-left-unit="px" data-tchmi-top-unit="px" data-tchmi-width-unit="%" data-tchmi-scale-mode="ScaleToFill" data-tchmi-height-mode="Value" data-tchmi-width-mode="Value" data-tchmi-left="0" data-tchmi-top="0" data-tchmi-right="0" data-tchmi-bottom="0">
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <!-- Replace the <style> block inside the <head> with this: -->
        <style>
            html, body {
                margin: 0;
                padding: 0;
                width: 100%;
                height: 100%;
                overflow: hidden;
            }

            #batteryContainer {
                position: relative;
                width: 100%;
                height: 100%;
            }

            #batteryLevel {
                transition: y 0.5s, height 0.5s, fill 0.5s;
                fill: url(#batteryGradient);
            }

            #batteryCap {
                fill: #666;
                rx: 5;
                ry: 5;
            }

            #batteryFrame {
                fill: none;
                stroke: #999;
                stroke-width: 5;
            }

            #lightningSvg {
                display: none;
                position: absolute;
                bottom: 0;
                left: 0;
                transition: transform 0.5s ease-in-out;
            }

            @keyframes bounceAnimation {
                0%, 20%, 50%, 80%, 100% {
                    transform: translateY(0);
                }

                40% {
                    transform: translateY(-10px);
                }

                60% {
                    transform: translateY(-5px);
                }
            }

            #lightningSvg.bouncing {
                animation: bounceAnimation #batteryInputContainer

            {
                text-align: center;
                margin-top: 10px;
            }

            #batteryInput {
                background: transparent;
                border: none;
                color: #333;
                font-size: 16px;
                padding: 5px;
                width: 60px;
                text-align: center;
            }

            #batteryText {
                fill: #000; /* Text color */
                font-family: Arial, sans-serif;
                font-size: 20px;
                text-anchor: middle;
                dominant-baseline: middle;
            }
        </style>
    </head>
    <body>

        <div id="batteryContainer">
            <svg id="batterySVG" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 495 320">
                <defs>
                    <lineargradient id="batteryGradient" x1="0%" y1="100%" x2="0%" y2="0%">
                        <!-- Use JavaScript to generate gradient stops based on battery level -->
                    </lineargradient>
                    <style type="text/css" id="flow-animation-in">
                        .flow-animation-in {
                            animation: flow-animation-in 0.5s linear;
                            animation-iteration-count: infinite;
                        }

                        @keyframes flow-animation-in {
                            to {
                                stroke-dashoffset: -16;
                            }
                        }

                        <style type="text/css" id="flow-animation-out" > .flow-animation-out {
                            animation: flow-animation-out 0.5s linear;
                            animation-iteration-count: infinite;
                        }

                        @keyframes flow-animation-out {
                            to {
                                stroke-dashoffset: 16;
                            }
                        }
                    </style>
                </defs>
                <rect id="batteryCap" x="230" y="40" width="30" height="5" rx="5" ry="5"></rect>
                <rect id="batteryLevel" x="205" y="240" width="80" height="0" rx="10" ry="10"></rect>
                <rect id="batteryFrame" x="200" y="45" width="90" height="200" rx="15" ry="15"></rect>
                <text id="batteryText" x="245" y="115">0%</text>
