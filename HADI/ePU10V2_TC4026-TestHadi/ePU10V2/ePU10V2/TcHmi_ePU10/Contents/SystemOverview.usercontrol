    <script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[
  {
    "event": "%s%b_refreshHMIdata%/s%",
    "actions": [
      {
        "objectType": "Comment",
        "comment": "Contactor states"
      },
      {
        "objectType": "Function",
        "active": true,
        "fn": "TcHmi.Functions.TcHmi_ePU10.ToggleSVG",
        "fnParams": [
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%s%PLC.HMI.Monitoringvars::Switchgear::b_ACOutputState%/s%"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": "cell-OutputClosed"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": "cell-OutputOpen"
          }
        ],
        "asyncWait": true
      },
      {
        "objectType": "Function",
        "active": true,
        "fn": "TcHmi.Functions.TcHmi_ePU10.ToggleSVG",
        "fnParams": [
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/BOOL",
            "symbolExpression": "%s%PLC.HMI.Monitoringvars::Switchgear::b_NetContactorState%/s%"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": "cell-NetContClosed"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": "cell-NetContOpen"
          }
        ],
        "asyncWait": true
      },
      {
        "objectType": "Function",
        "active": true,
        "fn": "TcHmi.Functions.TcHmi_ePU10.ToggleSVG",
        "fnParams": [
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%s%PLC.HMI.Monitoringvars::Switchgear::b_ACInputState%/s%"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": "cell-InputClosed"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": "cell-InputOpen"
          }
        ],
        "asyncWait": true
      },
      {
        "objectType": "Function",
        "active": true,
        "fn": "TcHmi.Functions.TcHmi_ePU10.ToggleSVG",
        "fnParams": [
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%s%PLC.HMI.Monitoringvars::Switchgear::b_DCCouplingState%/s%"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": "cell-DCExtClosed"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": "cell-DCExtOpen"
          }
        ],
        "asyncWait": true
      },
      {
        "objectType": "Function",
        "active": true,
        "fn": "TcHmi.Functions.TcHmi_ePU10.ToggleSVG",
        "fnParams": [
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%s%PLC.HMI.Monitoringvars::Switchgear::b_ACDetectedInput%/s%"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": "cell-ACInputDetected"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": ""
          }
        ],
        "asyncWait": true
      },
      {
        "objectType": "Function",
        "active": true,
        "fn": "TcHmi.Functions.TcHmi_ePU10.ToggleSVG",
        "fnParams": [
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%s%PLC.HMI.Monitoringvars::Switchgear::b_ACDetectedBusbar%/s%"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": "cell-ACOutputDetected"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": ""
          }
        ],
        "asyncWait": true
      },
      {
        "objectType": "Comment",
        "comment": "Battery Indicator update script"
      },
      {
        "objectType": "Function",
        "active": true,
        "fn": "TcHmi.Functions.TcHmi_ePU10.ToggleSVG",
        "fnParams": [
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%s%PLC.HMI.Monitoringvars::Switchgear::b_DCDetected%/s%"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": "lightningSvg"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": ""
          }
        ],
        "asyncWait": true
      },
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "var symbol = new TcHmi.Symbol('%s%PLC.HMI.Monitoringvars::Battery::r_SocScaled%/s%');",
          "symbol.readEx(function (data) {",
          "    if (data.error === TcHmi.Errors.NONE) {",
          "        // Handle result value... ",
          "        var batteryLevel = parseFloat(data.value).toFixed(1); ",
          "        ",
          "        batteryLevel = Math.max(0, Math.min(100, batteryLevel));",
          "        // Update the battery level display",
          "  \t\tvar batteryLevelElement = document.getElementById('batteryLevel');",
          "  \t\tbatteryLevelElement.setAttribute('height', (batteryLevel * 1.9));",
          "  \t\tbatteryLevelElement.setAttribute('y', 240 - (batteryLevel * 1.9)); // Adjust the y position",
          "        ",
          "          // Update the battery color gradient",
          "  \t\tupdateGradient(batteryLevel);",
          "  \t\t",
          "  \t\tvar batteryTextElement = document.getElementById('batteryText');",
          "\t\tbatteryTextElement.textContent = batteryLevel + '%'",
          "    } else {",
          "        // Handle error... ",
          "    }",
          "});",
          "",
          "    ",
          "    function updateGradient(level) {",
          "      var gradient = document.getElementById('batteryGradient');",
          "      gradient.innerHTML = \"\"; // Clear existing gradient stops",
          "",
          "      var stops = [",
          "        { offset: '0%', color: '#ddd' },",
          "        { offset: '100%', color: '#333' }",
          "      ];",
          "",
          "      if (level < 20) {",
          "        stops[1].color = 'red';",
          "      } else if (level < 50) {",
          "        stops[1].color = 'orange';",
          "      } else {",
          "        stops[1].color = 'green';",
          "      }",
          "",
          "      stops.forEach(function (stop) {",
          "        var stopElement = document.createElementNS('http://www.w3.org/2000/svg', 'stop');",
          "        stopElement.setAttribute('offset', stop.offset);",
          "        stopElement.setAttribute('style', 'stop-color:' + stop.color + ';stop-opacity:1');",
          "        gradient.appendChild(stopElement);",
          "      });",
          "    }"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      },
      {
        "objectType": "Comment",
        "comment": "Flow animation"
      },
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "// Javascript for DC flow animation",
          "var symbol1 = new TcHmi.Symbol('%s%PLC.HMI.Monitoringvars::Switchgear::r_DCCouplingCurrent%/s%');",
          "var symbol2 = new TcHmi.Symbol('%s%PLC.HMI.Monitoringvars::AcDcCharger::r_DcPower%/s%');",
          "",
          "var value1 = null;",
          "var value2 = null;",
          "",
          "function tryUpdateFlow() {",
          "    if (value1 !== null && value2 !== null)",
          "        updateFlow(value1 + value2, true, document.getElementById('cell-DCbusFlow'));",
          "}",
          "",
          "symbol1.readEx(function (data) {",
          "    if (data.error === TcHmi.Errors.NONE) {",
          "        value1 = data.value / 0.66; // DC power to current est.",
          "        tryUpdateFlow();",
          "    } else {",
          "        // Handle error...",
          "    }",
          "});",
          "",
          "symbol2.readEx(function (data) {",
          "    if (data.error === TcHmi.Errors.NONE) {",
          "        value2 = data.value; ",
          "        tryUpdateFlow();",
          "    } else {",
          "        // Handle error...",
          "    }",
          "});",
          "",
          "//DC ext flow animation",
          "var symbol = new TcHmi.Symbol('%s%PLC.HMI.Monitoringvars::Switchgear::r_DCCouplingCurrent%/s%');",
          "symbol.readEx(function (data) {",
          "    if (data.error === TcHmi.Errors.NONE) {",
          "        // Handle result value... ",
          "        var value = data.value;",
          "        var element = document.getElementById('cell-DCextFlow');",
          "        updateFlow(value, true, element);",
          "    } else {",
          "        // Handle error... ",
          "    }",
          "});",
          "",
          "",
          "//DC charger flow animation",
          "var symbol = new TcHmi.Symbol('%s%PLC.HMI.Monitoringvars::AcDcCharger::r_DcPower%/s%');",
          "symbol.readEx(function (data) {",
          "    if (data.error === TcHmi.Errors.NONE) {",
          "        // Handle result value... ",
          "        var value = data.value;",
          "        var element = document.getElementById('cell-DcChargerFlow');",
          "        updateFlow(-value, true, element);\t",
          "    } else {",
          "        // Handle error... ",
          "    }",
          "});",
          "",
          "// Javascript for AC flow animation",
          "var symbol = new TcHmi.Symbol('%s%PLC.HMI.Monitoringvars::Powerstack::r_ActivePower%/s%');",
          "symbol.readEx(function (data) {",
          "    if (data.error === TcHmi.Errors.NONE) {",
          "        // Handle result value... ",
          "        var value = data.value;",
          "        var element = document.getElementById('cell-BatteryFlowAC');",
          "        updateFlow(value, true, element);",
          "    } else {",
          "        // Handle error... ",
          "    }",
          "});",
          "",
          "var symbol = new TcHmi.Symbol('%s%PLC.HMI.Monitoringvars::Switchgear::r_ACOutputPower%/s%');",
          "symbol.readEx(function (data) {",
          "    if (data.error === TcHmi.Errors.NONE) {",
          "        // Handle result value... ",
          "        var value = data.value;",
          "        var element = document.getElementById('cell-OutputFlow');",
          "        updateFlow(value, true, element);",
          "    } else {",
          "        // Handle error... ",
          "    }",
          "});",
          "",
          "",
          "var powerSymbol = new TcHmi.Symbol('%s%PLC.HMI.Monitoringvars::Switchgear::r_ACInputPower%/s%');",
          "powerSymbol.readEx(function (data) {",
          "    if (data.error === TcHmi.Errors.NONE) {",
          "        // Handle result value... ",
          "        var value = data.value;",
          "        var element = document.getElementById('cell-InputFlow');",
          "        updateFlow(value, true, element);\t",
          "    } else {",
          "        // Handle error... ",
          "    }",
          "});",
          "",
          "const enableSymbol = new TcHmi.Symbol(",
          "    '%s%PLC.HMI.Monitoringvars::Switchgear::b_ACInputState%/s%'",
          ");",
          "",
          "",
          "// Read both values",
          "Promise.all([",
          "    new Promise(resolve => powerSymbol.readEx(resolve)),",
          "    new Promise(resolve => enableSymbol.readEx(resolve))",
          "])",
          ".then(([powerData, enableData]) => {",
          "",
          "    if (",
          "        powerData.error === TcHmi.Errors.NONE &&",
          "        enableData.error === TcHmi.Errors.NONE",
          "    ) {",
          "",
          "        const level = powerData.value;",
          "        const enabled = enableData.value;",
          "",
          "        const element = document.getElementById('cell-InputFlow-contactor');",
          "",
          "        updateFlow(level, enabled, element);",
          "",
          "    } else {",
          "",
          "        console.log('Symbol read error');",
          "",
          "    }",
          "});",
          "",
          "function updateFlow(level, enabled, element) {",
          "",
          "    // Extra boolean condition",
          "    if (!enabled) {",
          "        element.classList.remove('flow-animation-out');",
          "        element.classList.remove('flow-animation-in');",
          "        element.style.display = 'none';",
          "        return;",
          "    }",
          "",
          "    // Normal flow handling",
          "    if (level < -10) {",
          "",
          "        element.classList.add('flow-animation-out');",
          "        element.classList.remove('flow-animation-in');",
          "        element.style.display = 'block';",
          "",
          "    } else if (level > 10) {",
          "",
          "        element.classList.remove('flow-animation-out');",
          "        element.classList.add('flow-animation-in');",
          "        element.style.display = 'block';",
          "",
          "    } else {",
          "",
          "        element.classList.remove('flow-animation-out');",
          "        element.classList.remove('flow-animation-in');",
          "        element.style.display = 'none';",
          "    }",
          "}"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      },
      {
        "objectType": "WriteToSymbol",
        "active": false,
        "symbolExpression": "%s%PLC.HMI.Monitoringvars::Switchgear::b_NetContactorState%/s%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/BOOL",
          "value": false
        },
        "asyncWait": true
      }
    ],
    "displayName": "Update SVG elements"
  }
]</script>

