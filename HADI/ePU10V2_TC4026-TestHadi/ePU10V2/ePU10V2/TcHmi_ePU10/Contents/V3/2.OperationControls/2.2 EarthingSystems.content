                  "symbolExpression": "%s%PLC.HMI.Controlvars::HardSettings::system::e_EarthingSystem%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:server#/definitions/PLC.eEarthingSystems-ShowRecursively",
                  "value": 0
                },
                "compareOperator": "!=",
                "logic": null
              }
            ],
            "then": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctrl%TcHmiGrid_Earthing_1252::BorderColor%/ctrl%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:framework#/definitions/Color",
                  "value": {
                    "color": "None"
                  }
                },
                "asyncWait": true
              },
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctrl%TcHmiTextblock_EarthingSystemWarning::Visibility%/ctrl%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:framework#/definitions/Visibility",
                  "value": "Hidden"
                },
                "asyncWait": true
              }
            ]
          },
          {
            "else": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctrl%TcHmiGrid_Earthing_1252::BorderColor%/ctrl%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:framework#/definitions/Color",
                  "value": {
                    "color": "rgba(255, 15, 15, 1)"
                  }
                },
                "asyncWait": true
              },
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctrl%TcHmiTextblock_EarthingSystemWarning::Visibility%/ctrl%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:framework#/definitions/Visibility",
                  "value": "Visible"
                },
                "asyncWait": true
              }
            ]
          }
        ],
        "asyncWait": true
      }
    ]
  }
]</script>
</div>
<div id="TcHmiHtmlHost_10" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-grid-column-index="0" data-tchmi-grid-row-index="0" data-tchmi-height-unit="px" data-tchmi-left="0" data-tchmi-left-unit="%" data-tchmi-top="0" data-tchmi-top-unit="%" data-tchmi-width-unit="px" data-tchmi-right-unit="%" data-tchmi-bottom-unit="%" data-tchmi-visibility="Visible" data-tchmi-creator-locked="True" data-tchmi-creator-visibility="Visible" data-tchmi-width="0" data-tchmi-height="0">
<!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Three Column Pop-up</title>
        <style>

            #popup-container {
                display: none;
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                width: 80%;
                max-width: 800px;
                background-color: rgba(0,0,0,0.85);
                padding: 0px;
                border: 2px solid #ccc;
                box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
                z-index: 1000;
                border-radius: 10px; /* Added border-radius for rounded corners */
            }

            .column {
                width: 33.33%;
                float: left;
                background-color:none;
                box-sizing:border-box;
                padding: 20px;
            }

            .close-btn {
                position: absolute;
                transform: scale(300%, 300%);
                top: 10px;
                right: 10px;
                cursor: pointer;
            }
        </style>
    </head>
    <body>

        <div id="popup-container">
            <span class="close-btn" onclick="closePopup()">&times;</span>
            <div class="column">
                <!-- Content for the first column -->
                <h1>TN-S</h1>
                <p>
                    In the TN-S system the protective earthing (PE) is provided by the low voltage distribution panel of the client.<br>
                    Therefore, the PE and Neutral must be connected at the client side.<br>
                    The PE-Neutral link in the e-PU10 must be opened and the insulation monitor is disabled.<br>
                </p>
                <h3>Earthing Rod</h3>
                <p>
                    A primary earthing rod with an impedance of less than 166 Ohm is required when 30mA RCD's are used in the LV distributor panel of the client. <br>
                    In any other case, this earthing rod must be less than 0.5 Ohm. The primary earthing rod must be connected at client side. <br>
                    A secondary earthing rod is required when PE conductor exceeds 65m length with identical requirements.
                </p>
                <h3>IMPORTANT</h3>
                <p>PE and Neutral can only be connected at one location in the system.</p>
            </div>
            <div class="column">
                <!-- Content for the second column -->
                <h1>TN-C-S</h1>
                <p>
                    In the TN-C-S system the protective earthing (PE) is provided by the e-PU10.<br>
                    Therefore, the PE-Neutral link in the e-PU10 must be closed and the insulation monitor is disabled.<br>
                    At the client side, no additional connection between PE-Neutral must be made.<br>
                </p>
                <h3>Earthing Rod</h3>
                <p>
                    A primary earhting rod with an impedance of less than 166 Ohm is required when 30mA RCD's are used in the LV distributor panel of the client. <br>
                    In any other case, this earthing rod must be less than 0.5 Ohm. The primary earthing rod must be connected at e-PU side. <br>
                    A secondary earthing rod is required when PE conductor exceeds 65m length with identical requirements.
                </p>
                <h3>IMPORTANT</h3>
                <p>PE and Neutral can only be connected at one location in the system.</p>
            </div>
            <div class="column">
                <!-- Content for the third column -->
                <h1>IT</h1>
                <p>
                    In the IT system the protective earthing (PE) is isolated from the phase conductors(L1, L2, L3, N) <br>
                    Therefore, the PE-Neutral link in the e-PU10 must be opened and the insulation monitor is enabled.<br>
                    Also at the client side, no connection between PE-Neutral must be made.<br>
                </p>
                <h3>Earthing Rod</h3>
                <p>
                    The earthrod + PE is required to bind all enclosures together either at e-PU10 or client side. <br>
                    The impedance of the earthrod must ensure less then 50V during a phase-earth fault.
                </p>
                <h3>IMPORTANT</h3>
                <p>
                    30/300mA Residual current devices at the client side installations might not work properly.<br>
                    The protection is provided by the e-PU10 insulation monitor which will shutdown when phase conductors connect to earth. <br>
                    Although this is a fairly safe scenario, make sure you have appropriate knowledge and understand the consequences!
                </p>
            </div>
        </div>

        <script>
    function openPopup() {
        var popup = document.getElementById('popup-container');
        popup.style.display = 'block';
    }

    function closePopup() {
        var popup = document.getElementById('popup-container');
        popup.style.display = 'none';
    }
        </script>

    </body>
</html>


</div>
</div>