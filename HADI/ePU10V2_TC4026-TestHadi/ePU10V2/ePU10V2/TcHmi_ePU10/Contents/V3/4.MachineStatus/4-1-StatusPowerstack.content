<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[
  {
    "event": "%s%PLC.Settings.Configuration::b_DoublePowerModule%/s%",
    "actions": [
      {
        "objectType": "SwitchCase",
        "active": true,
        "compare": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/BOOL",
          "symbolExpression": "%s%PLC.Settings.Configuration::b_DoublePowerModule%/s%"
        },
        "cases": [
          {
            "caseValue": {
              "objectType": "StaticValue",
              "valueType": "tchmi:general#/definitions/BOOL",
              "value": true
            },
            "actions": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctx%owner::TargetContent%/ctx%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:framework#/definitions/ContentPath",
                  "value": "Contents/V3/4.MachineStatus/4-1-PowerStackHTMLHostDoubleInverter.content"
                },
                "asyncWait": true
              }
            ]
          },
          {
            "caseValue": {
              "objectType": "StaticValue",
              "valueType": "tchmi:general#/definitions/BOOL",
              "value": false
            },
            "actions": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctx%owner::TargetContent%/ctx%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:framework#/definitions/ContentPath",
                  "value": "Contents/V3/4.MachineStatus/4-1-PowerStackHTMLHostSingleInverter.content"
                },
                "asyncWait": true
              }
            ]
          }
        ],
        "asyncWait": true
      }
    ]
  },
  {
    "event": "%s%b_refreshHMIdata%/s%",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "var symbol = new TcHmi.Symbol('%s%PLC.HMI.Monitoringvars::Powerstack::e_StatusPowerStack%/s%');",
          "symbol.readEx(function (data) {",
          "        if (data.error === TcHmi.Errors.NONE) {",
          "                // ctx.success = return value in HMI async function",
          "                //      get string from enum scheme by value resolved integer value of enum",
          "                document.getElementById('cell-PM1_statesign').style.stroke = '#666';",
          "                if (data.value === 5) { //fault",
          "                \tdocument.getElementById('cell-PM1_statesign').style.fill = 'red';",
          "        \t\t}",
          "                 else if (data.value === 11) {// EMstop",
          "                \tdocument.getElementById('cell-PM1_statesign').style.fill = 'red';",
          "                \tdocument.getElementById('cell-PM1_statesign').style.stroke = 'yellow';",
          "        \t\t}",
          "                else if (data.value === 3 || data.value === 4) {// Running",
          "                \tdocument.getElementById('cell-PM1_statesign').style.fill = '#0f0';",
          "        \t\t}",
          "                else if (data.value === 2) {// Idle",
          "                \tdocument.getElementById('cell-PM1_statesign').style.fill = '#0df';",
          "        \t\t}",
          "                else { // undefined / init",
          "\t\t\t\t\tdocument.getElementById('cell-PM1_statesign').style.fill = '#f5f5f5';                \t",
          "        \t\t}        ",
          "            } else {",
          "            }",
          "         ",
          "        });"
        ],
        "injectContextObject": true,
        "asyncWait": true,
        "waitMode": "Synchronous"
      },
      {
        "objectType": "Function",
        "active": true,
        "fn": "TcHmi.Functions.TcHmi_ePU10.ToggleSVG",
        "fnParams": [
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%f%%s%PLC.HMI.Monitoringvars::Powerstack::b_DCDetected%/s%%/f%"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": "cell-DCPOWER"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": ""
          }
        ],
        "asyncWait": true
      },
      {
        "objectType": "Function",
        "active": true,
        "fn": "TcHmi.Functions.TcHmi_ePU10.ToggleSVG",
        "fnParams": [
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%f%%s%PLC.HMI.Monitoringvars::Powerstack::b_ACDetected%/s%%/f%"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": "cell-ACPOWER"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": ""
          }
        ],
        "asyncWait": true
      },
      {
        "objectType": "Function",
        "active": true,
        "fn": "TcHmi.Functions.TcHmi_ePU10.ToggleSVG",
        "fnParams": [
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%f%%s%PLC.HMI.Monitoringvars::Powerstack::e_NetContState%/s%== 1;%/f%"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": "cell-RightAC"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": ""
          }
        ],
        "asyncWait": true
      },
      {
        "objectType": "Function",
        "active": true,
        "fn": "TcHmi.Functions.TcHmi_ePU10.ToggleSVG",
        "fnParams": [
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%f%%s%PLC.HMI.Monitoringvars::Powerstack::e_NetContState%/s%==2;%/f%"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": "cell-LeftAC"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": ""
          }
        ],
        "asyncWait": true
      },
      {
        "objectType": "Function",
        "active": true,
        "fn": "TcHmi.Functions.TcHmi_ePU10.ToggleSVG",
        "fnParams": [
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%s%PLC.HMI.Monitoringvars::Switchgear::b_NetContactorState%/s%"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": "cell-NETCONT_close"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": "cell-NETCONT_open"
          }
        ],
        "asyncWait": true
      },
      {
        "objectType": "Function",
        "active": true,
        "fn": "TcHmi.Functions.TcHmi_ePU10.ToggleSVG",
        "fnParams": [
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%s%PLC.HMI.Monitoringvars::Powerstack::b_MasterMCCBfb%/s%"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:general#/definitions/String",
            "value": "cell-MCCB1_close"
          },
          {
