        "fnParams": [
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%s%PLC.HMI.Monitoringvars::Powerstack::b_SlaveMCCBfb%/s%"
          },
          {
