  "trigger": [
    {
      "event": "%s%GetCurrentUser::name%/s%",
      "actions": [
        {
          "objectType": "Condition",
          "active": false,
          "parts": [
            {
              "if": [
                {
                  "compare1": {
                    "objectType": "Symbol",
                    "valueType": "tchmi:general#/definitions/String",
                    "symbolExpression": "%s%GetCurrentUser::name%/s%"
                  },
                  "compare2": {
                    "objectType": "StaticValue",
                    "valueType": "string",
                    "value": "__SystemGuest"
                  },
                  "compareOperator": "!=",
                  "logic": null
                }
              ],
              "then": [
                {
                  "objectType": "WriteToSymbol",
                  "active": true,
                  "symbolExpression": "%s%PLC.HMI.b_ControlAccess%/s%",
                  "value": {
                    "objectType": "StaticValue",
                    "valueType": "tchmi:general#/definitions/BOOL",
                    "value": true
                  },
                  "asyncWait": true
                }
              ]
            },
            {
              "else": []
            }
          ],
          "asyncWait": true
        },
        {
          "objectType": "Condition",
          "active": true,
          "parts": [
            {
              "if": [
                {
                  "compare1": {
                    "objectType": "Symbol",
                    "valueType": "tchmi:general#/definitions/String",
                    "symbolExpression": "%s%ListActiveSessions::clients::10.4.0.41[0]::userName%/s%"
                  },
                  "compare2": {
                    "objectType": "StaticValue",
                    "valueType": "tchmi:general#/definitions/String",
                    "value": "TcHmiUserManagement::__SystemGuest"
                  },
                  "compareOperator": "!=",
                  "logic": null
                }
              ],
              "then": [
                {
                  "objectType": "WriteToSymbol",
                  "active": true,
                  "symbolExpression": "%s%PLC.HMI.b_ControlAccess%/s%",
                  "value": {
                    "objectType": "StaticValue",
                    "valueType": "tchmi:general#/definitions/BOOL",
                    "value": true
                  },
                  "asyncWait": true
                }
              ]
            },
            {
              "else": [
                {
                  "objectType": "WriteToSymbol",
                  "active": true,
                  "symbolExpression": "%s%PLC.HMI.b_ControlAccess%/s%",
                  "value": {
                    "objectType": "StaticValue",
                    "valueType": "tchmi:general#/definitions/BOOL",
                    "value": false
                  },
                  "asyncWait": true
                }
              ]
            }
          ],
