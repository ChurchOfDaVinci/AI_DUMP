<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_OperationVars_System" Id="{25893d51-fce8-4274-92c5-744dc349e369}">
    <Declaration><![CDATA[TYPE ST_OperationVars_System :
STRUCT
	//Powerstack
	r_NominalVoltage				: REAL := Settings.GridParams.r_GridNominalVoltage; //VAC
	r_NominalFrequency				: REAL := Settings.GridParams.r_GridNominalFrequency; //Hz
	
	//Power setpoints
	r_Pset							: REAL;// active power setpoint
	r_Qset							: REAL;// reactive power setpoint
	r_PFset							: REAL := 1;// powerfactor -1 .. 1
	b_PFsetEnable					: BOOL := TRUE;
	
	b_SounderMute					: BOOL;
	b_SounderTest					: BOOL;	
	
	//Mode transition
	b_GenGridModeTrans				: BOOL;	
	b_GridTakeOverEnable			: BOOL;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>