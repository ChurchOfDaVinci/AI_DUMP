  <POU Name="FB_ExternalController" Id="{880336b7-64c3-43a9-a5ed-44c0d1e5f3f6}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ExternalController
VAR_INPUT
