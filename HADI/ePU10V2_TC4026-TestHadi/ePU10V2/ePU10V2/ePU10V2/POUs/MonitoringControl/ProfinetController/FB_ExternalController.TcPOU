    <Method Name="BindControlVars" Id="{2c3f9546-f14d-4bb2-bddd-4551c9931d07}">
      <Declaration><![CDATA[METHOD BindControlVars
VAR_INPUT
	advancedControl: BOOL;
END_VAR

VAR_INST
	defaults			: ST_Softsettings;
	ftrig_AdvancedControl : F_trig;
	rTrig_AdvancedControl : R_Trig;
	
	b_defaultsRestored	: BOOL;
END_VAR



]]></Declaration>
      <Implementation>
        <ST><![CDATA[ftrig_AdvancedControl(CLK:= advancedcontrol);
IF ftrig_advancedControl.Q THEN
	RestoreDefaults(defaults, controlvars.SoftSettings);
END_IF

//advanced control, all IO coupled
IF advancedcontrol THEN
	controlvars.SoftSettings := get.SoftSettings;
	controlvars.Operation := get.Operation;
ELSE
	Storedefaults(defaults, controlvars.SoftSettings);
	//Basic control, only specific IO coupled
	controlvars.softsettings.system.b_EcoModeEnable := get.SoftSettings.system.b_EcoModeEnable;
	Controlvars.operation.system.b_PFsetEnable := get.Operation.system.b_PFsetEnable;
	Controlvars.operation.system.r_PFset := get.Operation.system.r_PFset;
	Controlvars.operation.system.r_Pset:= get.Operation.system.r_Pset;
	Controlvars.operation.system.r_Qset:= get.Operation.system.r_Qset;
	Controlvars.softsettings.PSB.setpointTimeslot1 := get.softsettings.PSB.setpointTimeslot1;
END_IF

a_ControlCommands();


]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckControlMode" Id="{03c93a00-d6b5-411b-9044-14125c81fbb4}">
      <Declaration><![CDATA[METHOD CheckControlMode : BOOL
VAR_INPUT
	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF monitor.controlfb.HardSettings.setup.e_ControlSource = eControlSources.ExternalController THEN
	IF get.b_AdvancedControl THEN
		ExternalControlMode := eExternalControlMode.AdvancedControl;
	ELSE
		ExternalControlMode := eExternalControlMode.BasicControl;
	END_IF
ELSIF st_params.b_MonitoringEnable THEN
	ExternalControlMode := eExternalControlMode.Readonly;
ELSE
	ExternalControlMode := eExternalControlMode.off;
END_IF
	]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckCouplerState" Id="{0398e5ea-cce2-4f30-8cc3-eaa312c29a53}">
      <Declaration><![CDATA[METHOD CheckCouplerState : BOOL
VAR_INPUT

END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//TBD: Verder uitbereiden

IF Inputs.PNIOBoxState = 0 THEN // = No error
	CheckCouplerState := TRUE;
	get.events.b_CouplerError := FALSE;
ELSE
	CheckCouplerState := FALSE;
	get.events.b_CouplerError := TRUE;
//1 = Profinet device state machine is in boot mode
//2 = Device not found
//3 = The stationname is not unique
//4 = IP could not be set
//5 = IP conflict
//6 = DCP set was not successful
//7 = Watchdog error
//8 = Datahold error
//9 = RTC3: Sync mode could not be initiated
//10 = Profinet controller has a link error
//11 = The aliasname is not unique
//12 = The automatic name assignement isn't possible - wrong device type
//13 = IOC-AR is established but no application ready
//14 = IOC-AR is established but module difference
//15 = At least one InputCR is invalid, provider in stop or problemindicator is set
//16 = At least one OutputCR is invalid, provider in stop or problemindicator is set
//31 = Only for EtherCAT gateways: WC-State of cyclic EtherCAT frame is 1
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="DwordEndian" Id="{0de5615b-90e7-4ec8-b449-146abaf62e54}" FolderPath="DataConversion\">
      <Declaration><![CDATA[METHOD DwordEndian : DWORD
VAR_INPUT
	IN		: DWORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF st_params.b_BigEndian THEN
	DwordEndian := HOST_TO_BE32(IN);
ELSE
	DwordEndian := IN;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="DwordToReal" Id="{d0d83304-21dd-42f3-8fbd-ac8193855f75}" FolderPath="DataConversion\">
      <Declaration><![CDATA[METHOD DwordToReal : REAL
VAR_INPUT
	InputVar			:	DWORD;
	b_InputSigned		:	BOOL;
	Stepsize			:	WORD;
end_var]]></Declaration>
      <Implementation>
        <ST><![CDATA[DwordToReal := 1;

IF b_inputSigned AND InputVar.31 THEN
	DwordToReal := -1;
	InputVar.31 := FALSE;
END_IF

DwordToReal := DwordToReal * DWORD_TO_REAL(InputVar)/Stepsize;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GenGridControllerStateMachine" Id="{f6b4168c-fd03-454e-9c38-abd0594c0ba4}">
      <Declaration><![CDATA[METHOD GenGridControllerStateMachine : BOOL
VAR_INPUT
END_VAR

VAR_INST
	State		:	UINT;
	rTrig_Ack	:	R_trig;
	test		:	BOOL;
	AckDelay	:	Ton := (pt := T#1S200ms);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[get.Operation.system.b_GenGridModeTrans := FALSE;
rTrig_Ack(clk := ManualAckState);
AckDelay();
//get.Operation.system.b_GenGridModeTrans := Ackdelay.q;
AckDelay.IN := FALSE;

CASE monitor.system.GenGridController.e_BreakerMode OF
	eBreakerOperationMode.none:
		AckDelay.IN := FALSE;
		//IF monitor.system.GenGridController.b_ModeTransActive THEN
		//	get.Operation.system.b_GenGridModeTrans := TRUE;
		//END_IF
		
	eBreakerOperationMode.GridFeedthrough:
		IF get.SoftSettings.setup.e_AcInputType = eAcInputType.Grid THEN
			IF get.SoftSettings.inputgrid.breaker.AutoConnect THEN	//connect if requested, otherwise hold here
				IF monitor.system.GenGridController.b_ModeTransActive THEN
					get.Operation.system.b_GenGridModeTrans := TRUE;
				END_IF
			ELSE 
				IF monitor.system.GenGridController.e_state = eGenGridSTate.Running then
					get.Operation.system.b_GenGridModeTrans := TRUE;
				END_IF
			END_IF		
		END_IF	
		IF get.SoftSettings.setup.e_AcInputType = eAcInputType.None THEN //transitioning to none
			IF (NOT get.SoftSettings.inputgrid.breaker.AutoConnect OR rTrig_ack.q) AND monitor.ACswitchgear.b_InputContactorfb THEN
				get.Operation.system.b_GenGridModeTrans := TRUE;
			elsIF NOT monitor.ACswitchgear.b_InputContactorfb AND monitor.system.GenGridController.b_ModeTransActive THEN
				AckDelay.in := TRUE;
				get.Operation.system.b_GenGridModeTrans := AckDelay.q;
			END_IF//get.Operation.system.b_GenGridModeTrans := true;//rTrig_Ack.q;
		END_IF
	
	eBreakerOperationMode.GenIso: //eBreakerOperationMode.GenDroop, 
		IF get.SoftSettings.setup.e_AcInputType = eAcInputType.None THEN //transitioning to none	
			IF monitor.ACswitchgear.b_InputContactorfb THEN
				get.Operation.system.b_GenGridModeTrans := rTrig_Ack.Q;
			ELSIF monitor.system.GenGridController.b_ModeTransActive THEN
				AckDelay.in := TRUE;
				get.Operation.system.b_GenGridModeTrans := AckDelay.q;
			END_IF//get.Operation.system.b_GenGridModeTrans := true;//rTrig_Ack.q;
		END_IF
		
	eBreakerOperationMode.GenFix:
		IF get.SoftSettings.setup.e_AcInputType = eAcInputType.None THEN //transitioning to none	
			IF monitor.ACswitchgear.b_InputContactorfb THEN
				IF NOT (monitor.system.GenGridController.e_state = eGenGridState.Cooldown OR 
						monitor.system.GenGridController.e_state = eGenGridState.Running OR
						monitor.system.GenGridController.e_state = eGenGridState.Warmup) THEN
					get.Operation.system.b_GenGridModeTrans := true;
				ELSE	
					get.Operation.system.b_GenGridModeTrans := rTrig_Ack.Q;
				end_if
			ELSIF monitor.system.GenGridController.b_ModeTransActive THEN
				AckDelay.in := TRUE;
				get.Operation.system.b_GenGridModeTrans := AckDelay.q;
			END_IF//get.Operation.system.b_GenGridModeTrans := true;//rTrig_Ack.q;
		END_IF
END_CASE



//get.SoftSettings.inputgenset.b_AutoStartStop := (inputs.General.SecondaryDigOutState = 1 OR inputs.GenControl.ui_StartStopControl = 1);

//IF (inputs.General.SecondaryDigOutState = 2 OR inputs.GenControl.ui_StartStopControl = 2) THEN
//	IF monitor.system.GenGridController.e_RunCondition <> eruncondition.ManuallyStarted THEN
//		get.Operation.Genset.b_manualStart := NOT get.Operation.Genset.b_manualStart;
//	END_IF
//ELSIF (inputs.General.SecondaryDigOutState <> 2 AND inputs.GenControl.ui_StartStopControl <> 2) AND monitor.system.GenGridController.e_RunCondition = eruncondition.ManuallyStarted THEN
//		get.Operation.Genset.b_manualStart := NOT get.Operation.Genset.b_manualStart;
//END_IF

//CASE State OF
//	0: //none
//		Ackdelay.IN := FALSE;
//		CASE get.SoftSettings.setup.e_AcInputType OF
//			eAcInputType.Grid: //transitioning to grid
//				State := 1; //switch to gridInit
//			eAcInputType.Genset: //transitioning to grid
//				State := 3; //switch to gridInit
//		END_CASE
//	1: //gridInit
//		CASE get.SoftSettings.setup.e_AcInputType OF
//			eAcInputType.Grid: //transitioning to grid
//				IF get.SoftSettings.inputgrid.breaker.AutoConnect THEN	//connect if requested, otherwise hold here
//					IF monitor.system.GenGridController.b_ModeTransActive THEN
//						get.Operation.system.b_GenGridModeTrans := TRUE;
//					END_IF
//					State := 2; //SwitchToGridActive	
//				END_IF
				
//			eACInputType.None: //transitioning to none
//				AckDelay.IN := (NOT monitor.system.GenGridController.b_active) AND monitor.system.GenGridController.e_State = eGenGridState.Waiting_Mode_Reconnect;
//				IF AckDelay.q THEN
//					IF monitor.system.GenGridController.b_ModeTransActive THEN
//						get.Operation.system.b_GenGridModeTrans := TRUE;
//					END_IF//get.Operation.system.b_GenGridModeTrans := true;//rTrig_Ack.q;
//				END_IF
				
//				IF monitor.system.GenGridController.e_State = eGenGridState.Init THEN
//					get.Operation.system.b_GenGridModeTrans := FALSE;
//					State := 0;
//				END_IF;
//		END_CASE
		
//	2: //GridModeActive
		
//		//get.Operation.system
//		IF NOT get.SoftSettings.inputgrid.breaker.AutoConnect or rTrig_Ack.q THEN
//			//IF monitor.system.GenGridController.e_state = eGenGridSTate.Running OR 
//				//monitor.system.GenGridController.e_state = eGenGridSTate.Synchronization THEN
//			//	 Ackdelay.IN := TRUE;
//			//ELSE
//			//	Ackdelay.IN := FALSE;
//				get.Operation.system.b_GenGridModeTrans := TRUE;
//				State := 1;
//			//END_IF
//		ELSE
//			IF NOT monitor.ACswitchgear.b_InputContactorfb THEN
//				State := 1;
//			END_IF
//		END_IF
		
//	3:	//GenMode
////		CASE get.SoftSettings.setup.e_AcInputType OF				
////			eACInputType.None: //transitioning to none
////				AckDelay.IN := (NOT monitor.system.GenGridController.b_active) AND monitor.system.GenGridController.e_State = eGenGridState.Waiting_Mode_Reconnect;
////				IF AckDelay.q THEN
////					IF monitor.system.GenGridController.b_ModeTransActive THEN
////						get.Operation.system.b_GenGridModeTrans := TRUE;
////					END_IF//get.Operation.system.b_GenGridModeTrans := true;//rTrig_Ack.q;
////				END_IF
				
////				IF monitor.system.GenGridController.e_State = eGenGridState.Init THEN
////					get.Operation.system.b_GenGridModeTrans := FALSE;
////					State := 0;
////				END_IF;
////		END_CASE

//		//IF rTrig_Ack.Q THEN
//		//	get.Operation.system.b_GenGridModeTrans := TRUE; 
//		//	State := 1;
//		//END_IF
//END_CASE

////CASE WordEndian(Input.InputConnectionType) OF
////		//0:	remain
////		1:	get.SoftSettings.setup.e_AcInputType := eAcInputType.None; 
////		2:	get.SoftSettings.setup.e_AcInputType := eAcInputType.Grid;
////		3:	get.SoftSettings.setup.e_AcInputType := eAcInputType.Genset; 
////	END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetDiagnostics" Id="{abb03d67-08c3-4ff4-8a17-79aed3f40f20}">
      <Declaration><![CDATA[METHOD GetDiagnostics : BOOL
VAR_IN_OUT
	AddError		: ARRAY [*] OF FB_AddErrorST;
	a_ActiveEvents	: ARRAY [*] OF ST_ErrorStruct;
	w_Index			: WORD;
END_VAR

VAR_OUTPUT
	b_errorActive	: BOOL;
	b_warningActive	: BOOL;
END_VAR

VAR_INST
	by_errCt	: BYTE;
	by_warnCt	: BYTE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[	(*Watchdog fault*)	AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_HeartbeatFault,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 1,
			e_ObjectID				:= e_id,
			s_Message				:= 'watchdog fault',
			e_sev					:= eSeverity.warning,	
			b_AutoClear			:= TRUE,
			e_ErrAckAccess		:= eErrAckAccess.Operator,
			);
		w_Index := w_Index +1;
		
	(*Coupler fault*)	AddError[w_Index](
			b_ErrorTrig			:= Get.events.b_CouplerError,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 2,
			e_ObjectID				:= e_id,
			s_Message				:= concat('External control interface error: ', TO_STRING(Inputs.PNIOBoxState)),
			t_TriggerTime			:=	T#30S,
			e_sev					:= eSeverity.info,	
			b_AutoClear				:= TRUE,
			e_ErrAckAccess			:= eErrAckAccess.Operator,
			);
		w_Index := w_Index +1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="HeartBeat" Id="{6069aafa-591d-4a96-9e74-723dfefb86f8}">
      <Declaration><![CDATA[METHOD HeartBeat : UINT
VAR_INPUT
	ui_HeartBeatInput		:	UINT	:=	0;
END_VAR

VAR_OUTPUT
	b_HeartBeatFault		:	BOOL;
END_VAR

VAR_INST
	ui_HeartBeatOutput			:	UINT ; 
	HeartBeatOutputIncTimer		:	TON		:=	(PT := T#500MS);
	HeartBeatInputCheckTimer	:	TON		:=	(PT := T#1S);
	ui_StoredInputValue			:	UINT	:= 	0;

END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
//output value increments every second. Remote party should check if this happens
HeartBeatOutputIncTimer (in := NOT HeartBeatOutputIncTimer.Q);
IF HeartBeatOutputIncTimer.Q THEN
	ui_HeartBeatOutput := ui_HeartBeatOutput +1;
END_IF

//Input value has to change every second as well.
//if stored and Current values are equal, start counting.
HeartBeatInputCheckTimer(in:= (ui_StoredInputValue = ui_HeartBeatInput), PT := TO_TIME(st_params.w_CommTimeOut));
ui_StoredInputValue := ui_HeartBeatInput;
b_heartBeatFault := HeartBeatInputCheckTimer.Q;

Heartbeat := ui_HeartBeatOutput;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IntToReal" Id="{c25e4980-a546-4078-be93-dfc53a58987c}" FolderPath="DataConversion\">
      <Declaration><![CDATA[METHOD IntToReal : BOOL
VAR_INPUT
	in			:	INT;
	Scale		:	UINT := 10;
	LimitLow	: 	REAL := -3.402823E+38;
	LimitHigh	:  	REAL := 3.402823E+38; 
	IgnoreZero	:	BOOL := FALSE;
END_VAR

VAR_OUTPUT
	OutofRange	: BOOL;
END_VAR

VAR
	r_value			: 	REAL;
	test			:	INT;
	test2			:	real;
END_VAR

VAR_IN_OUT
	Out	:	REAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF (NOT IgnoreZero) OR (in <> 0) THEN
	test := WordEndian(in);
	test2 := INT_TO_REAL(test);
	r_value	 := test2/Scale;
	
	OutofRange := ValueOutOfRange(r_value, LimitLow, LimitHigh);
	Out := LIMIT(LimitLow, r_value, LimitHigh);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="MapACDCCharger" Id="{e3a3e606-260f-476c-9a54-42f90d7c8ad4}" FolderPath="DataMappingV2\">
      <Declaration><![CDATA[METHOD MapACDCCharger : BOOL
VAR_IN_OUT CONSTANT
	monitor								: ST_System_Monitor;
END_VAR

VAR_IN_OUT
	events	: 	ST_ExtController_Events;
	Input	:	st_PNInput_ACDCCharger;
	Output	:	st_PNOutput_ACDCCharger;
END_VAR

VAR_INST
	rtrig_openInputBreaker	:	r_trig;
	Rtrig_BreakerToAuto		:	r_trig;
	ftrig_ackDone			:	f_trig;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[


IF NOT settings.MachineParams.ACDCCharger.b_ACDCChargerFitted THEN
	output.w_Status := 0;
ELSE
	output.w_Status.15	:=	settings.MachineParams.ACDCCharger.b_ACDCChargerFitted;
	output.w_Status.10	:=	monitor.AcDcCharger.Events.b_BatteryLimitDeratingActive;
	output.w_Status.9	:=	monitor.AcDcCharger.Events.b_ACUnderVoltageDeratingActive;
	output.w_Status.8	:=	monitor.AcDcCharger.Events.b_TemperatureDeratingActive;
	
	output.w_Status.1	:=	monitor.AcDcCharger.r_DcVoltage > 500;
	output.w_Status.0	:=	monitor.AcDcCharger.ar_ACvoltage[phases.AVG] > 200;
	output.w_Status := wordEndian(output.w_Status);
	
	
	//Fill output data
	Output.w_Warnings.3	:=	monitor.AcDcCharger.ar_ACvoltage[phases.AVG] > 430;
	Output.w_Warnings.2	:=	monitor.AcDcCharger.e_SystemStatus = eACDCChargerState.running AND
							monitor.AcDcCharger.ar_ACvoltage[phases.AVG] < 370;
	Output.w_Warnings.1	:=	monitor.AcDcCharger.Events.b_TemperatureDeratingActive;
	Output.w_Warnings.0	:=	FALSE;//monitor.AcDcCharger.Events.b_CommunicationFault
	Output.w_Warnings	:=  WordEndian(Output.w_Warnings);
	
	
	Output.w_Faults.7	:=	FALSE;//monitor.AcDcCharger.Events.DCOverVoltageFault;
	Output.w_Faults.6	:=	FALSE;//monitor.AcDcCharger.Events.DCUnderVoltageFault;
	Output.w_Faults.5	:=  FALSE;//monitor.AcDcCharger.Events.DCOverVoltageFault;
	Output.w_Faults.4	:=  monitor.AcDcCharger.Events.B_ACPhaselossFault;
	Output.w_Faults.3	:=  monitor.AcDcCharger.Events.B_ACOvervoltage;
	Output.w_Faults.2	:=	monitor.AcDcCharger.Events.B_ACUndervoltage;
	Output.w_Faults.1	:=	FALSE; //overtemperature fault
	Output.w_Faults.0	:=	monitor.AcDcCharger.Events.b_CommunicationFault OR 
							monitor.AcDcCharger.Events.b_BuscouplerNotFound;
	Output.w_Faults		:= 	WordEndian(Output.w_Faults);
	
	
	Output.ui_ChargerStatus := WordEndian(monitor.AcDcCharger.e_SystemStatus);
	
	output.TotalChargerPower := WordEndian(REAL_TO_UINT(monitor.AcDcCharger.by_NoModulesInstalled * 300));
	output.AvailableChargePower := WordEndian(REAL_TO_UINT(monitor.AcDcCharger.r_AvailablePower * 10));
	output.ActivePower	:=	WordEndian(REAL_TO_UINT(monitor.AcDcCharger.ACmeasurements.ar_ActivePower[0]*10));	
	output.Frequency 	:= wordendian(0);
	output.VoltageAB	:=	wordendian(REAL_TO_UINT(monitor.AcDcCharger.ar_ACvoltage[1]*10));
	output.VoltageBC	:=	wordendian(REAL_TO_UINT(monitor.AcDcCharger.ar_ACvoltage[2]*10));	
	output.VoltageCA	:=	wordendian(REAL_TO_UINT(monitor.AcDcCharger.ar_ACvoltage[3]*10));
	
	output.CurrentL1	:= wordendian(REAL_TO_UINT(monitor.acDcCharger.ACmeasurements.ar_Current[1]*10));
	output.CurrentL2	:= wordendian(REAL_TO_UINT(monitor.acDcCharger.ACmeasurements.ar_Current[2]*10));
	output.currentL3	:= wordendian(REAL_TO_UINT(monitor.acDcCharger.ACmeasurements.ar_Current[3]*10));
	
	output.ui_ACCurrentLimitAct := wordendian(REAL_TO_UINT(get.softsettings.ACDCcharger.r_CurrentSetpoint*10));
	output.ui_PSetAct 			:=	wordendian(REAL_TO_UINT(get.SoftSettings.ACDCcharger.r_PowerSetpoint*10));
	output.ui_SocLimitAct		:=	wordendian(REAL_TO_UINT(get.SoftSettings.ACDCcharger.r_SocTarget*10)); 
	output.ui_MinGridVoltageAct	:=	wordendian(REAL_TO_UINT(get.SoftSettings.ACDCcharger.r_MinACVoltage*10));
	
	IF (NOT events.b_HeartbeatFault) AND ExternalControlMode > eExternalControlMode.BasicControl AND monitor.system.GenGridController.e_BreakerMode = eBreakerOperationMode.GridFeedthrough THEN
		input.w_Control := wordEndian(input.w_Control);
		get.SoftSettings.ACDCcharger.b_Enable := input.w_Control.0;
		get.SoftSettings.ACDCcharger.e_ControlType := ePowerControltype.Both;
		
		UIntToReal(	in			:= Input.ui_ACCurrentlimit, 
					scale 		:= 10, 
					limitlow	:= 0,
					limithigh	:= 100,//get.HardSettings.inputgrid.r_FeedInCurrentLimitHard,
					OutOfRange 	=>	,
					IgnoreZero 	:= FALSE,
					Out 		:= get.SoftSettings.ACDCcharger.r_CurrentSetpoint);
		
		UIntToReal(	in			:= Input.UI_Pset, 
					scale 		:= 10, 
					limitlow	:= 0,
					limithigh	:= monitor.AcDcCharger.by_NoModulesInstalled*30,
					OutOfRange 	=>	,
					IgnoreZero 	:= FALSE,
					Out 		:= get.SoftSettings.ACDCcharger.r_PowerSetpoint);
	
		UIntToReal(	in			:= Input.ui_SocMaxLimit, 
					scale 		:= 10, 
					limitlow	:= 0,
					limithigh	:= 100,//get.HardSettings inputgrid.r_SupplyCurrentLimitHard,
					OutOfRange 	=>	,
					IgnoreZero 	:= TRUE,
					Out 		:= get.SoftSettings.ACDCcharger.r_SocTarget);
	
		UIntToReal(	in			:= Input.ui_MinGridVoltage, 
					scale 		:= 10, 
					limitlow	:= 360,
					limithigh	:= 440,//get.HardSettings inputgrid.r_SupplyCurrentLimitHard,
					OutOfRange 	=>	,
					IgnoreZero 	:= TRUE,
					Out 		:= get.SoftSettings.ACDCcharger.r_MinACVoltage);

	ELSE
		get.SoftSettings.ACDCcharger.r_PowerSetpoint := 0;
	END_IF
END_IF
	
]]></ST>
      </Implementation>
    </Method>
    <Method Name="MapBatteryData" Id="{456d4098-6961-4f3a-a9cc-4764667e1715}" FolderPath="DataMappingV2\">
      <Declaration><![CDATA[METHOD MapBatteryData : BOOL
VAR_IN_OUT CONSTANT
	monitor								: ST_System_Monitor;
END_VAR

VAR_IN_OUT
	events	: 	ST_ExtController_Events;
	Input	:	ST_PNInput_Battery;
	Output	:	ST_PNOutput_Battery;

END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
Output.ui_Status := WordEndian(Monitor.battery.BatteryInfo.e_BMS_Status);

Output.w_Warnings.0 := Monitor.battery.events.b_OVER_TEMP_WARNING;	
Output.w_Warnings.1 := Monitor.battery.events.b_UNDER_TEMP_WARNING;			
Output.w_Warnings.2 := Monitor.battery.events.b_OVER_CHARGE_CURRENT_WARNING;	
Output.w_Warnings.3 := Monitor.battery.events.b_OVER_DISCHARGE_CURRENT_WARNING;
Output.w_Warnings.4 := Monitor.battery.events.b_OVER_VOLT_WARNING;		
Output.w_Warnings.5 := Monitor.battery.events.b_UNDER_VOLT_WARNING;		
Output.w_Warnings.6 := Monitor.battery.events.b_UNDER_SOC_MIN_WARNING;		
Output.w_Warnings.7 := Monitor.battery.events.b_OVER_SOC_MAX_WARNING;			
Output.w_Warnings.8 := Monitor.battery.events.b_VOLTAGE_IMBALANCE_WARNING;
Output.w_Warnings.9 := Monitor.battery.events.b_TEMPERATURE_IMBALANCE_WARNING;
Output.w_Warnings.10 := Monitor.battery.events.b_CURRENT_IMBALANCE_WARNING;
Output.w_Warnings.11 := Monitor.battery.events.b_OTHER_WARNING;	
Output.w_Warnings.12 := Monitor.battery.events.b_CONFIGURATION_WARNING;
Output.w_Warnings := WordEndian(Output.w_warnings);

Output.w_Faults.0 := Monitor.battery.Events.b_COMMUNICATION_ERROR;			
Output.w_Faults.1 := Monitor.battery.events.b_OVER_TEMP_ALARM;					
Output.w_Faults.2 := Monitor.battery.events.b_UNDER_TEMP_ALARM;			
Output.w_Faults.3 := Monitor.battery.events.b_OVER_CHARGE_CURRENT_ALARM;		
Output.w_Faults.4 := Monitor.battery.events.b_OVER_DISCHARGE_CURRENT_ALARM;	
Output.w_Faults.5 := Monitor.battery.events.b_OVER_VOLT_ALARM;						
Output.w_Faults.6 := Monitor.battery.events.b_UNDER_VOLT_ALARM;					
Output.w_Faults.7 := Monitor.battery.events.b_UNDER_SOC_MIN_ALARM;				
Output.w_Faults.8 := Monitor.battery.events.b_OVER_SOC_MAX_ALARM;				
Output.w_Faults.9 := Monitor.battery.events.b_TEMPERATURE_IMBALANCE_ALARM;	
Output.w_Faults.10 := Monitor.battery.events.b_CONTACTOR_ERROR;				
Output.w_Faults.11 := Monitor.battery.events.b_FAN_ERROR;						
Output.w_Faults.12 := Monitor.battery.events.b_GROUND_FAULT;					
Output.w_Faults.13 := Monitor.battery.events.b_OPEN_DOOR_ERROR;					
Output.w_Faults.14 := Monitor.battery.events.b_OTHER_ALARM;								
Output.w_Faults.15 := Monitor.battery.events.b_CONFIGURATION_ALARM;	
Output.w_Faults := WordEndian(Output.w_Faults);		
			
Output.ui_SOC 							:= RealToUint(	In	:=	monitor.battery.BatteryInfo.r_SOCScaled, 	Scale	:=	10);
Output.ui_SOH 							:= RealToUint(	In	:=	monitor.battery.BatteryInfo.r_SOH, 	Scale	:=	10);
Output.ui_DClinkVoltage 				:= RealToUint(	In	:=	monitor.battery.BatteryInfo.r_SystemVoltage, Scale	:=	10);				
Output.i_DClinkCurrent 					:= RealToint (	In	:=	monitor.battery.BatteryInfo.r_SystemCurrent, Scale	:=	10);
Output.ui_MaxAllowedDischargeCurrent 	:= RealToUint (	In	:=	monitor.battery.BatteryInfo.r_MaxDischargeCurrentAllowed, Scale	:=	10); 	
Output.ui_MaxAllowedChargeCurrent 		:= RealToUint (	In	:=	-monitor.battery.BatteryInfo.r_MaxchargeCurrentAllowed,	Scale	:=	10); 		
Output.i_MinCellTemperature 			:= RealToint (	In	:=	monitor.battery.BatteryInfo.ar_CellTemperature[0] , Scale	:=	10); 	
Output.i_MaxCellTemperature				:= RealToint (	In	:=	monitor.battery.BatteryInfo.ar_CellTemperature[2], Scale	:=	10); 										                                               
Output.ui_RemainingChargeEnergy 		:= RealToUint(	In	:=	monitor.battery.BatteryInfo.r_RemainingChargeEnergy, Scale	:=	10);
Output.ui_RemainingDischargeEnergy 		:= RealToUint(	In	:=	monitor.battery.BatteryInfo.r_RemainingDischargeEnergy, Scale	:=	10);
Output.ui_CycleCount					:= WordEndian(monitor.battery.BatteryInfo.ui_CycleCount);

//Read regularinputs if allowed
IF (NOT events.b_HeartbeatFault) AND ExternalControlMode > eExternalControlMode.BasicControl THEN
	Input.w_Control := WordEndian(input.W_Control);
	get.Operation.BMS.b_ManualStartHVDC := Input.W_Control.0;
		
	UintToReal(	in			:= 	Input.ui_SocMinLimit, 
				scale 		:= 	10, 
				limitlow	:=	0, 
				limithigh	:=	90, 
				OutOfRange 	=>	events.b_SoCLowLimitOutOfRange,
				IgnoreZero 	:= 	FALSE,
				Out 		:= 	get.softsettings.system.r_SocMin);

	UintToReal(	in			:= 	Input.ui_SocMaxLimit, 
				scale 		:= 	10, 
				limitlow	:=	10, 
				limithigh	:=	100, 
				OutOfRange 	=>	events.b_SoCHighLimitOutOfRange,
				IgnoreZero 	:= 	TRUE,
				Out 		:= 	get.softsettings.system.r_SocMax);	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="MapGeneralData" Id="{2bf8365a-5150-4fbc-af52-7d699045fdee}" FolderPath="DataMappingV2\">
      <Declaration><![CDATA[METHOD MapGeneralData : BOOL
