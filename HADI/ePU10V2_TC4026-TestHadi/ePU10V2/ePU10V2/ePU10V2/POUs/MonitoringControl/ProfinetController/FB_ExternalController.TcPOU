// 		
// 		IF  WordEndian(Input.PrimaryDigInState) > 0 THEN
// 			Settings.MachineParams.HartingIO.PrimaryInputContactSignal := WordEndian(Input.PrimaryDigInState)-1;
// 		END_IF
// 		
// 		IF  WordEndian(Input.SecondaryDigInState) > 0 THEN
// 			Settings.MachineParams.HartingIO.SecondaryInputContactSignal := WordEndian(Input.SecondaryDigInState)-1;
// 		END_IF
// 		
// 	END_IF
// 	
// 
// END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="MapGeneratorControl" Id="{9e579e51-a967-4798-b99f-7ff04731a0c3}" FolderPath="DataMappingV2\">
      <Declaration><![CDATA[METHOD MapGeneratorControl : BOOL
VAR_IN_OUT CONSTANT
	monitor								: ST_System_Monitor;
END_VAR

VAR_IN_OUT
	events	: 	ST_ExtController_Events;
	Input	:	st_PNInput_GenControl;
	Output	:	ST_PNOutput_GenControl;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[	
//Fill output data
Output.w_Status.0	:=	(monitor.system.GenGridController.b_extGensetMode OR
						monitor.system.GenGridController.e_BreakerMode = ebreakeroperationmode.GenIso OR
						monitor.system.GenGridController.e_BreakerMode = ebreakeroperationmode.GenFix OR
						monitor.system.GenGridController.e_BreakerMode = ebreakeroperationmode.GenDroop);
Output.w_Status.1	:= 	Output.w_Status.0 AND (monitor.system.GenGridController.e_state = eGenGridState.Cooldown OR 
						monitor.system.GenGridController.e_state = eGenGridState.Running OR
						monitor.system.GenGridController.e_state = eGenGridState.Warmup);
Output.w_Status		:= WordEndian(Output.w_Status);

Output.w_Warnings.0	:=	monitor.system.GenGridController.events.b_OverFreqTrip;
Output.w_Warnings.1	:=	monitor.system.GenGridController.events.b_UnderFreqTrip;
Output.w_Warnings.2	:=	monitor.system.GenGridController.events.b_OverloadTrip;
Output.w_Warnings.3	:=	monitor.system.GenGridController.events.b_ShutdownTimeOut;
Output.w_Warnings.4	:=	monitor.system.GenGridController.events.b_StartupFault;
Output.w_Warnings.5	:=	monitor.system.GenGridController.events.b_WarmupFault;
Output.w_Warnings.6	:=	monitor.system.GenGridController.events.b_GenDownTrip;
Output.w_Warnings		:= WordEndian(Output.w_Warnings);

Output.w_Faults		:= WordEndian(Output.w_Faults);

IF (monitor.system.GenGridController.b_extGensetMode OR
	monitor.system.GenGridController.e_BreakerMode = ebreakeroperationmode.GenIso OR
	monitor.system.GenGridController.e_BreakerMode = ebreakeroperationmode.GenFix OR
	monitor.system.GenGridController.e_BreakerMode = ebreakeroperationmode.GenDroop) THEN	
	
	CASE monitor.system.GenGridController.e_state OF
		eGenGridState.Waiting_Trigger:			Output.ui_GeneratorStatus := 1;
		eGenGridState.Starting:					Output.ui_GeneratorStatus := 2;
		eGenGridState.Warmup:					Output.ui_GeneratorStatus := 3;
		eGenGridState.Synchronization:			Output.ui_GeneratorStatus := 4;
		eGengridState.Running:					Output.ui_GeneratorStatus := 5;
		eGengridState.stopping:					Output.ui_GeneratorStatus := 6;
		eGengridState.Cooldown:					Output.ui_GeneratorStatus := 7;
	END_CASE
ELSE
	Output.ui_GeneratorStatus := 0;
END_IF
Output.ui_GeneratorStatus := WordEndian(Output.ui_GeneratorStatus);



//process input data, All inputs require Advancedcontrol
IF (NOT events.b_HeartbeatFault) AND ExternalControlMode = eExternalControlMode.AdvancedControl THEN
	input.w_Control := wordEndian(input.w_Control);
	get.SoftSettings.inputgenset.b_HydridMode 			:= input.w_Control.2;
	//3 was external genset. Now moved to general
	get.SoftSettings.inputgenset.b_FreqProtectionEnable	:=	input.w_Control.4;
	get.SoftSettings.setup.b_ExtGenset					:= Input.w_Control.3;
				
	UIntToReal(	in			:= Input.ui_SOCStart, 
				scale 		:= 10, 
				limitlow	:= 10,
				limithigh	:=	get.SoftSettings.inputgenset.setpointTimeslot1.r_SoCStop,
    			OutOfRange 	=>	,
				IgnoreZero 	:= TRUE,
				Out 		:= Get.SoftSettings.inputgenset.setpointTimeslot1.r_SoCStart );
	
	UIntToReal(	in			:= Input.ui_SOCStop, 
				scale 		:= 10, 
				limitlow	:= Get.SoftSettings.inputgenset.setpointTimeslot1.r_SoCStart,
				limithigh	:=	100,
    			OutOfRange 	=>	,
				IgnoreZero 	:= TRUE,
				Out 		:= Get.SoftSettings.inputgenset.setpointTimeslot1.r_SoCStop );
	
	UIntToReal(	in			:= Input.ui_BattLoadStart, 
				scale 		:= 10, 
				limitlow	:= 10,
				limithigh	:=	get.SoftSettings.inputgenset.setpointTimeslot1.r_BatteryloadStop,
    			OutOfRange 	=>	,
				IgnoreZero 	:= TRUE,
				Out 		:= Get.SoftSettings.inputgenset.setpointTimeslot1.r_BatteryloadStart );
	
	UIntToReal(	in			:= Input.ui_BattLoadStop, 
				scale 		:= 10, 
				limitlow	:= Get.SoftSettings.inputgenset.setpointTimeslot1.r_BatteryloadStart,
				limithigh	:=	100,
    			OutOfRange 	=>	,
				IgnoreZero 	:= TRUE,
				Out 		:= Get.SoftSettings.inputgenset.setpointTimeslot1.r_BatteryloadStop );
	
	CASE wordendian(input.ui_GenPowerMode) OF
		1:	get.SoftSettings.inputgenset.Generator.e_GensetMode := eGensetmode.Isochronous;
		2:	get.SoftSettings.inputgenset.Generator.e_GensetMode := eGensetmode.Droop;
		3:	get.SoftSettings.inputgenset.Generator.e_GensetMode := eGensetmode.FixedPower;		
	END_CASE
	
	UIntToReal(	in			:= Input.ui_GenRatedPower, 
				scale 		:= 1, 
				limitlow	:= 0,
				limithigh	:=	1000,
    			OutOfRange 	=>	,
				IgnoreZero 	:= TRUE,
				Out 		:= Get.SoftSettings.inputgenset.Generator.r_RatedPower );		
	
	UIntToReal(	in			:= Input.ui_GenMaxPowerLevel, 
				scale 		:= 10, 
				limitlow	:= get.SoftSettings.inputgenset.Generator.r_PowerloadMin,
				limithigh	:=	100,
    			OutOfRange 	=>	,
				IgnoreZero 	:= TRUE,
				Out 		:= Get.SoftSettings.inputgenset.Generator.r_powerloadMax );		
		
	UIntToReal(	in			:= Input.ui_GenEffPowerLevel, 
				scale 		:= 10, 
				limitlow	:= Get.SoftSettings.inputgenset.Generator.r_powerloadMin,
				limithigh	:= get.SoftSettings.inputgenset.Generator.r_powerloadMax,
    			OutOfRange 	=>	,
				IgnoreZero 	:= FALSE,
				Out 		:= Get.SoftSettings.inputgenset.Generator.r_powerloadEff );			
		
	UIntToReal(	in			:= Input.ui_GenMinPowerLevel, 
				scale 		:= 10, 
				limitlow	:= 0,
				limithigh	:= get.SoftSettings.inputgenset.Generator.r_powerloadMax,
    			OutOfRange 	=>	,
				IgnoreZero 	:= FALSE,
				Out 		:= Get.SoftSettings.inputgenset.Generator.r_powerloadMin );		
				
	get.SoftSettings.inputgenset.Generator.ui_WarmupTime					:=	wordEndian(Input.ui_GenWarmupTime);
	get.SoftSettings.inputgenset.Generator.ui_CooldownTime					:=	wordEndian(Input.ui_GenCooldownTime);
	get.SoftSettings.inputgenset.Generator.r_ramprate						:=	wordEndian(input.ui_IsoPowerRamp)/10;
	//get.Operation.Genset. //.ManualSetpoint									:=	wordEndian(Input.ui_GenCooldownTime);
	
	CASE WordEndian(Input.ui_StartStopControl) OF
		//0:	remain
		1:	get.SoftSettings.inputgenset.b_AutoStartStop := TRUE;
			get.Operation.Genset.b_manualStart := FALSE;
			
		2:	get.SoftSettings.inputgenset.b_AutoStartStop := FALSE;
			get.Operation.Genset.b_manualStart := FALSE;
			IF monitor.system.GenGridController.e_GensetStartStop = egensetstartstop.Stop THEN
 				get.Operation.Genset.b_manualStart := TRUE;
			END_IF
						
		3:	get.SoftSettings.inputgenset.b_AutoStartStop := FALSE;
			get.Operation.Genset.b_manualStart := FALSE;
			IF  monitor.system.GenGridController.e_GensetStartStop = egensetstartstop.Start THEN
				get.Operation.Genset.b_manualStart := TRUE;
			END_IF
	END_CASE
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="MapInputField" Id="{1356d53c-7b54-4131-bbb5-86338c6b5fb5}" FolderPath="DataMappingV2\">
      <Declaration><![CDATA[METHOD MapInputField : BOOL

VAR_IN_OUT CONSTANT
	monitor								: ST_System_Monitor;
END_VAR

VAR_IN_OUT
	events	: 	ST_ExtController_Events;
	Input	:	ST_PNInput_InputField;
	Output	:	ST_PNOutput_InputField;

END_VAR


]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Fill output data
Output.w_Status.0	:=	Monitor.ACswitchgear.b_InputContactorfb;
Output.w_Status.1	:=	Monitor.ACswitchgear.b_InputMCCBfb;
Output.w_Status.2	:=	Monitor.ACswitchgear.b_InputSynchronizerfb;
Output.w_Status.8	:=	get.SoftSettings.setup.e_AcInputType = eACInputtype.None AND monitor.system.GenGridController.b_ModeChanged;
Output.w_Status.9	:=	get.SoftSettings.setup.e_AcInputType = eACInputtype.Genset AND monitor.system.GenGridController.b_ModeChanged;
Output.w_Status.10	:=	get.SoftSettings.setup.e_AcInputType = eACInputtype.Grid AND monitor.system.GenGridController.b_ModeChanged;
Output.w_Status.15	:= 	Monitor.ACswitchgear.b_InputSectionAvailable;
Output.w_Status		:= WordEndian(Output.w_Status);

//input overload warning toevoegen + heroverweeg indeling
Output.w_Warnings.0	:=	monitor.system.GenGridController.events.b_RotationFieldFault;
Output.w_Warnings.1	:=	monitor.system.GenGridController.events.b_CurrentLimitDisconnect;
Output.w_Warnings.2 :=	monitor.system.GenGridController.events.b_EmstopDisconnect;
Output.w_Warnings.3 :=	monitor.system.GenGridController.events.b_ShutdownDisconnect;
Output.w_Warnings.8 :=	monitor.system.GenGridController.events.b_TransToGenFixInhibit;
Output.w_Warnings.9 :=	monitor.system.GenGridController.events.b_TransToGenDroopInhibit;
Output.w_Warnings.10 :=	monitor.system.GenGridController.events.b_TransToGenIsoInhibit;
Output.w_Warnings	:= WordEndian(Output.w_Warnings);

Output.w_Faults.0	:=	monitor.system.GenGridController.events.b_OverloadTrip;
Output.w_Faults.1	:=	Monitor.powermonitor.events.b_MBCommError OR Monitor.powermonitor.events.b_EL3443Error;
Output.w_Faults.2	:= 	FALSE; //synchronizer fault. status doesn't exist yet?
Output.w_Faults.3	:= 	monitor.ACswitchgear.events.b_InputContactorFault;
Output.w_Faults		:= WordEndian(output.w_Faults);

	//not sure if this is the right variable
CASE wordendian(monitor.system.GenGridController.e_PowerControlMode) OF
	ePowerControlMode.None, ePowerControlMode.PeakshaveExt:
		output.ui_InputConnectionType := 1;
	ePowerControlMode.PeakshaveInputGrid:
		output.ui_InputConnectionType := 2;
	ePowerControlMode.PeakshaveInputGen:
		output.ui_InputConnectionType := 3;	
END_CASE
output.ui_InputConnectionType := wordendian(output.ui_InputConnectionType);

Output.i_ActivePower 			:=	RealToint (	In	:= Monitor.powermonitor.InputField.ar_ActivePower[0], 	Scale	:=	10);
Output.i_ReactivePower 			:=	RealToint (	In	:= Monitor.powermonitor.InputField.ar_ReactivePower[0], Scale	:=	10);
Output.i_PowerFactor 			:=	RealToint (	In	:= Monitor.powermonitor.InputField.ar_PowerFactor[0], Scale	:=	100);
Output.ui_frequency				:=	RealToUint(	In	:= Monitor.powermonitor.InputField.ar_Frequency[0], 	Scale	:=	10);
Output.ui_VoltageL1N			:=	RealToUint(	In	:= Monitor.powermonitor.InputField.ar_PhaseVoltage[1], Scale	:=	10);
Output.ui_VoltageL2N			:=	RealToUint(	In	:= Monitor.powermonitor.InputField.ar_PhaseVoltage[2], Scale	:=	10);
Output.ui_VoltageL3N			:=	RealToUint(	In	:= Monitor.powermonitor.InputField.ar_PhaseVoltage[3], Scale	:=	10);
Output.ui_VoltageL1L2			:=	RealToUint(	In	:= Monitor.powermonitor.InputField.ar_LineVoltage[1], Scale	:=	10);
Output.ui_VoltageL2L3			:=	RealToUint(	In	:= Monitor.powermonitor.InputField.ar_LineVoltage[2], Scale	:=	10);
Output.ui_VoltageL3L1			:=	RealToUint(	In	:= Monitor.powermonitor.InputField.ar_LineVoltage[3], Scale	:=	10);
Output.ui_CurrentL1				:=	RealToUint(	In	:= Monitor.powermonitor.InputField.ar_Current[1], 	Scale	:=	10);
Output.ui_CurrentL2				:=	RealToUint(	In	:= Monitor.powermonitor.InputField.ar_Current[2], 	Scale	:=	10);
Output.ui_CurrentL3				:=	RealToUint(	In	:= Monitor.powermonitor.InputField.ar_Current[3], 	Scale	:=	10);
Output.ui_CurrentN				:=	RealToUint(	In	:= Monitor.powermonitor.InputField.ar_Current[4], 	Scale	:=	10);
Output.ui_CurrentLimitField		:=	RealToUint( In	:= Monitor.Protections.OvercurrentProtection.r_TotalinputCurrentLimit, 	scale	:=	1);
Output.udi_TotalEnergyConsumed	:=	RealToUdint(In	:=	monitor.powermonitor.InputField.r_EnergyConsumed, Scale	:=	10);
Output.udi_TotalEnergySupplied	:= 	RealToUdint(In	:=	monitor.powermonitor.InputField.r_EnergySupplied, Scale	:=	10);

Output.ui_Current1L1			:=	RealToUint(	In	:= Monitor.powermonitor.InputField.Powerlock[1].ar_Current[1], 	Scale	:=	10);
Output.ui_Current1L2			:=	RealToUint(	In	:= Monitor.powermonitor.InputField.Powerlock[1].ar_Current[2], 	Scale	:=	10);
Output.ui_Current1L3			:=	RealToUint(	In	:= Monitor.powermonitor.InputField.Powerlock[1].ar_Current[3], 	Scale	:=	10);
Output.ui_Current1N				:=	RealToUint(	In	:= Monitor.powermonitor.InputField.Powerlock[1].ar_Current[4], 	Scale	:=	10);
Output.ui_Current2L1			:=	RealToUint(	In	:= Monitor.powermonitor.InputField.Powerlock[2].ar_Current[1], 	Scale	:=	10);
Output.ui_Current2L2			:=	RealToUint(	In	:= Monitor.powermonitor.InputField.Powerlock[2].ar_Current[2], 	Scale	:=	10);
Output.ui_Current2L3			:=	RealToUint(	In	:= Monitor.powermonitor.InputField.Powerlock[2].ar_Current[3], 	Scale	:=	10);
Output.ui_Current2N				:=	RealToUint(	In	:= Monitor.powermonitor.InputField.Powerlock[2].ar_Current[4], 	Scale	:=	10);

IF (NOT events.b_HeartbeatFault) AND ExternalControlMode > eExternalControlMode.BasicControl THEN
	Input.w_Control := WordEndian(input.w_Control);
	ManualAckState := Input.w_Control.0;
	
	CASE WordEndian(Input.InputConnectionType) OF
		//0:	remain
		1:	get.SoftSettings.setup.e_AcInputType := eAcInputType.None; 
		2:	get.SoftSettings.setup.e_AcInputType := eAcInputType.Grid;
		3:	get.SoftSettings.setup.e_AcInputType := eAcInputType.Genset; 
	END_CASE
	
	GenGridControllerStateMachine();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="MapInputGridControl" Id="{f3c3f57b-89ca-43a1-a28f-1291f1ee9d0b}" FolderPath="DataMappingV2\">
      <Declaration><![CDATA[METHOD MapInputGridControl : BOOL
VAR_IN_OUT CONSTANT
	monitor								: ST_System_Monitor;
END_VAR

VAR_IN_OUT
	events	: 	ST_ExtController_Events;
	Input	:	st_PNInput_InputGridControl;
	Output	:	st_PNOutput_InputGridControl;
END_VAR

VAR_INST
	rtrig_openInputBreaker	:	r_trig;
	Rtrig_BreakerToAuto		:	r_trig;
	ftrig_ackDone			:	f_trig;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[	
//Fill output data
Output.w_Status.0	:=	monitor.system.GenGridController.e_BreakerMode = eBreakerOperationMode.GridFeedthrough;
Output.w_Status		:= WordEndian(Output.w_Status);

Output.w_Warnings.0	:=	monitor.system.GenGridController.events.b_GridLostTrip; //?
Output.w_Warnings		:= WordEndian(Output.w_Warnings);

Output.w_Faults.0	:=	monitor.system.GenGridController.events.b_SynchronisationFault;
Output.w_Faults		:= 	WordEndian(Output.w_Faults);

//Output.ui_InputGridStatus := 0;
IF Output.w_Status.0 THEN	
	CASE monitor.system.GenGridController.e_state OF
		eGenGridState.Waiting_For_AC:			Output.ui_InputGridStatus := 1;
		eGenGridState.Waiting_Mode_Reconnect:	Output.ui_InputGridStatus := 2;
		eGenGridState.Gridcode_Release_Check:	Output.ui_InputGridStatus := 3;
		eGenGridState.Synchronization:			Output.ui_InputGridStatus := 4;
		eGengridState.Running:					Output.ui_InputGridStatus := 5;
		eGengridState.stopping:					Output.ui_InputGridStatus := 6;
	END_CASE
ELSE
	Output.ui_InputGridStatus := 0;
END_IF
Output.ui_InputGridStatus := wordendian(Output.ui_InputGridStatus);

IF (NOT events.b_HeartbeatFault) AND ExternalControlMode > eExternalControlMode.BasicControl AND monitor.system.GenGridController.e_BreakerMode = eBreakerOperationMode.GridFeedthrough THEN
	input.w_Control := wordEndian(input.w_Control);
	//get.SoftSettings.inputgrid.breaker.AutoConnect := input.w_Control.0;
	//get.Operation.inputgrid.b_SyncClose				:= input.w_Control.1;
	
	get.SoftSettings.system.b_AMF	 				:= input.w_Control.2;
	get.SoftSettings.inputgrid.b_GridCodesActive	:= NOT input.w_Control.3;
	
	IF input.w_Control.4 THEN
		get.SoftSettings.inputgrid.PeakshaveMode	:= 	ePeakShaveMode.Singlephase;
	ELSE
		get.SoftSettings.inputgrid.PeakshaveMode	:= 	ePeakShaveMode.Multiphase;		
	END_IF
	
	get.SoftSettings.inputgrid.Breaker.EMstopDisconnect		:= 	Input.w_Control.8;	//Maybe unneccessary to write both?
	get.SoftSettings.inputgrid.Breaker.ShutdownDisconnect	:= 	Input.w_Control.9;
	get.SoftSettings.inputgrid.Breaker.CurrentLimitDisconnect 	:=	Input.w_Control.10;
	
	UIntToReal(	in			:= Input.ui_FeedInCurrentLimit, 
				scale 		:= 10, 
				limitlow	:= 0,
				limithigh	:= 700,//get.HardSettings.inputgrid.r_FeedInCurrentLimitHard,
    			OutOfRange 	=>	,
				IgnoreZero 	:= FALSE,
				Out 		:= get.SoftSettings.inputgrid.setpointTimeslot1.r_FeedInCurrentLimitSoft );		

	UIntToReal(	in			:= Input.ui_SupplyCurrentLimit, 
				scale 		:= 10, 
				limitlow	:= 0,
				limithigh	:= 700,//get.HardSettings inputgrid.r_SupplyCurrentLimitHard,
    			OutOfRange 	=>	,
				IgnoreZero 	:= TRUE,
				Out 		:= get.SoftSettings.inputgrid.setpointTimeslot1.r_SupplyCurrentLimitSoft );		

	get.SoftSettings.inputgrid.breaker.CurrentLimitRetries := UINT_TO_BYTE(wordendian(input.ui_CurrentLimitRetries));	

	CASE wordEndian(input.ui_ContactorControl) OF
		1: get.SoftSettings.inputgrid.breaker.AutoConnect := TRUE;
		2: get.SoftSettings.inputgrid.breaker.AutoConnect := FALSE;
	END_CASE
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="MapOutputField" Id="{cc13c1c5-939a-4e89-b242-57d5651ebfdc}" FolderPath="DataMappingV2\">
      <Declaration><![CDATA[METHOD MapOutputField : BOOL

VAR_IN_OUT CONSTANT
	monitor								: ST_System_Monitor;
END_VAR

VAR_IN_OUT
	Output	:	ST_PNOutput_OutputField;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[

//Fill output data
Output.w_Status.0	:=	Monitor.ACswitchgear.b_OutputMCCBfb;
Output.w_Status.1	:=	Monitor.ACswitchgear.b_PENlinkfb;
Output.w_Status.2	:= 	Monitor.powerstack.b_Gridtied;
Output.w_Status		:= WordEndian(Output.w_Status);

Output.w_Warnings.0	:=	Monitor.ACswitchgear.b_CEEprefuseOK;
Output.w_Warnings.1	:=	Monitor.ACswitchgear.b_OutputMCCBShuntOK;
Output.w_Warnings.2	:=	Monitor.powermonitor.events.b_MBCommWarning OR Monitor.powermonitor.events.b_MBTimeoutWarning;
Output.w_Warnings.3	:=	Monitor.protections.OvercurrentProtection.b_OutputWarning;
Output.w_Warnings	:= WordEndian(Output.w_Warnings);

Output.w_Faults.0	:=	Monitor.protections.OvercurrentProtection.b_OutputAlarm;
Output.w_Faults.1	:=	Monitor.powermonitor.events.b_MBCommError;
Output.w_Faults		:= WordEndian(output.w_Faults);

Output.i_ActivePower 			:=	RealToint (	In	:= Monitor.powermonitor.OutputField.ar_ActivePower[0], 	Scale	:=	10);
Output.i_ReactivePower 			:=	RealToint (	In	:= Monitor.powermonitor.OutputField.ar_ReactivePower[0], Scale	:=	10);
Output.i_PowerFactor 			:=	RealToint (	In	:= Monitor.powermonitor.OutputField.ar_PowerFactor[0], Scale	:=	100);
Output.ui_frequency				:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.ar_Frequency[0] , 	Scale	:=	100);
Output.ui_VoltageL1N			:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.ar_PhaseVoltage[1], Scale:=	10);
Output.ui_VoltageL2N			:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.ar_PhaseVoltage[2], Scale:=	10);
Output.ui_VoltageL3N			:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.ar_PhaseVoltage[3], Scale:=	10);
Output.ui_VoltageL1L2			:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.ar_LineVoltage[1], Scale	:=	10);
Output.ui_VoltageL2L3			:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.ar_LineVoltage[2], Scale	:=	10);
Output.ui_VoltageL3L1			:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.ar_LineVoltage[3], Scale	:=	10);
Output.ui_CurrentL1				:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.ar_Current[1], 	Scale	:=	10);
Output.ui_CurrentL2				:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.ar_Current[2], 	Scale	:=	10);
Output.ui_CurrentL3				:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.ar_Current[3], 	Scale	:=	10);
Output.ui_CurrentN				:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.ar_Current[4], 	Scale	:=	10);
Output.ui_CurrentLimitField		:=	RealToUint (In	:= Monitor.Protections.OvercurrentProtection.r_TotalOutputCurrentLimit, 	scale	:=	1);
Output.udi_TotalEnergyConsumed	:= RealToUdint(	In	:=	monitor.powermonitor.OutputField.r_EnergyConsumed, Scale	:=	10);
Output.udi_TotalEnergySupplied	:= RealToUdint(	In	:=	monitor.powermonitor.OutputField.r_EnergySupplied, Scale	:=	10);

Output.ui_Current1L1			:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.Powerlock[1].ar_Current[1], 	Scale	:=	10);
Output.ui_Current1L2			:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.Powerlock[1].ar_Current[2], 	Scale	:=	10);
Output.ui_Current1L3			:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.Powerlock[1].ar_Current[3], 	Scale	:=	10);
Output.ui_Current1N				:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.Powerlock[1].ar_Current[4], 	Scale	:=	10);
Output.ui_Current2L1			:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.Powerlock[2].ar_Current[1], 	Scale	:=	10);
Output.ui_Current2L2			:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.Powerlock[2].ar_Current[2], 	Scale	:=	10);
Output.ui_Current2L3			:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.Powerlock[2].ar_Current[3], 	Scale	:=	10);
Output.ui_Current2N				:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.Powerlock[2].ar_Current[4], 	Scale	:=	10);
Output.ui_Current3L1			:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.Powerlock[3].ar_Current[1], 	Scale	:=	10);
Output.ui_Current3L2			:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.Powerlock[3].ar_Current[2], 	Scale	:=	10);
Output.ui_Current3L3			:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.Powerlock[3].ar_Current[3], 	Scale	:=	10);
Output.ui_Current3N				:=	RealToUint(	In	:= Monitor.powermonitor.OutputField.Powerlock[3].ar_Current[4], 	Scale	:=	10);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="MapPeakShaveBox" Id="{64b78ff8-d921-459a-b96b-4d0da68281c7}" FolderPath="DataMappingV2\">
      <Declaration><![CDATA[METHOD MapPeakShaveBox : BOOL
VAR_IN_OUT CONSTANT
	monitor								: ST_System_Monitor;
END_VAR

VAR_IN_OUT
	events	: 	ST_ExtController_Events;
	Input	:	ST_PNInput_Peakshavebox;
	Output	:	ST_PNOutput_Peakshavebox;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[	
Output.w_Status.0	:=	Monitor.peakshavebox.b_buscouplerReady;
Output.w_Status.1	:= 	Monitor.peakshavebox.b_DataOK;
Output.w_Status.14	:=	Monitor.peakshavebox.b_active;
Output.w_Status.15	:= settings.Configuration.b_PeakshaverBoxEnable;//	Monitor.controlfb.softSettings.setup.b_peakshaveboxEnable;
Output.w_Status		:= WordEndian(Output.w_Status);

Output.w_Warnings.0	:= Monitor.peakshavebox.PowerStatus.b_GeneralWarning;	
output.w_Warnings.1 := Monitor.peakshavebox.b_SettingsChangePending;
Output.w_Warnings	:= WordEndian(Output.w_Warnings);

Output.w_Faults.0	:=	Monitor.peakshavebox.PowerStatus.b_GeneralFault 
						OR Monitor.peakshavebox.PowerStatus.b_OverCurrent
						OR Monitor.peakshavebox.PowerStatus.b_OverVoltage
						OR Monitor.peakshavebox.PowerStatus.b_UnderVoltage;
Output.w_Faults		:= WordEndian(Output.w_Faults);

Output.i_ActivePower 		:=	RealToint (	In	:= 	Monitor.peakshavebox.Powermonitor.ar_ActivePower[0], 	scale := 10);												
Output.i_ReactivePower 		:=	RealToint (	In	:= 	Monitor.peakshavebox.Powermonitor.ar_ReactivePower[0], scale := 10);
Output.i_PowerFactor 		:=	RealToint (	In	:= Monitor.peakshavebox.Powermonitor.ar_PowerFactor[0], Scale	:=	100);													
Output.ui_frequency			:=	RealToUint(	In	:= Monitor.peakshavebox.Powermonitor.ar_Frequency[0], 		Scale	:=	10);
Output.ui_VoltageL1N		:=	RealToUint(	In	:= Monitor.peakshavebox.Powermonitor.ar_LineVoltage[1], 	Scale	:=	10);
Output.ui_VoltageL2N		:=	RealToUint(	In	:= Monitor.peakshavebox.Powermonitor.ar_LineVoltage[2], 	Scale	:=	10);
Output.ui_VoltageL3N		:=	RealToUint(	In	:= Monitor.peakshavebox.Powermonitor.ar_LineVoltage[3], 	Scale	:=	10);
Output.ui_VoltageL1L2		:=	RealToUint(	In	:= Monitor.peakshavebox.Powermonitor.ar_PhaseVoltage[1], 	Scale	:=	10);
Output.ui_VoltageL2L3		:=	RealToUint(	In	:= Monitor.peakshavebox.Powermonitor.ar_PhaseVoltage[2], 	Scale	:=	10);
Output.ui_VoltageL3L1		:=	RealToUint(	In	:= Monitor.peakshavebox.Powermonitor.ar_PhaseVoltage[3], 	Scale	:=	10);
Output.ui_CurrentL1			:=	RealToUint(	In	:= Monitor.peakshavebox.Powermonitor.ar_Current[1], 		Scale	:=	10);
Output.ui_CurrentL2			:=	RealToUint(	In	:= Monitor.peakshavebox.Powermonitor.ar_Current[2], 		Scale	:=	10);
Output.ui_CurrentL3			:=	RealToUint(	In	:= Monitor.peakshavebox.Powermonitor.ar_Current[3], 		Scale	:=	10);
Output.ui_CurrentN			:=	RealToUint(	In	:= Monitor.peakshavebox.Powermonitor.ar_Current[4], 		Scale	:=	10);


IF (NOT events.b_HeartbeatFault) AND ExternalControlMode > eExternalControlMode.BasicControl THEN
	input.w_Control := wordEndian(input.w_Control);
	get.SoftSettings.setup.b_PeakshaveBoxEnable := 	input.w_Control.0;
	get.SoftSettings.PSB.b_ReverseCTDirection	:=	input.w_Control.1;

	IF input.w_Control.2 THEN
		get.SoftSettings.PSB.PeakshaveMode	:= 	ePeakShaveMode.Singlephase;
	ELSE
		get.SoftSettings.PSB.PeakshaveMode	:= 	ePeakShaveMode.Multiphase;		
	END_IF
	
	UIntToReal(	in			:= Input.ui_FeedInCurrentLimit, 
				scale 		:= 10, 
				limitlow	:= 0,
				limithigh	:= st_params.limits.r_PSBCtLimit,
    			OutOfRange 	=>	events.b_PSBFeedInLimitOutOfRange,
				IgnoreZero 	:= FALSE,
				Out 		:= get.SoftSettings.PSB.setpointTimeslot1.r_FeedInCurrentLimitSoft );		

	UIntToReal(	in			:= Input.ui_SupplyCurrentLimit, 
				scale 		:= 10, 
				limitlow	:= 0,
				limithigh	:= st_params.limits.r_PSBCtLimit,
    			OutOfRange 	=>	events.b_PSBSupplyLimitOutOfRange,
				IgnoreZero 	:= TRUE,
				Out 		:= get.SoftSettings.PSB.setpointTimeslot1.r_SupplyCurrentLimitSoft );
	
	IF wordEndian(input.ui_VTRatio) > 0 THEN
		UIntToReal(	in			:= Input.ui_VTRatio, 
					scale 		:= 100, 
					limitlow	:= 0,
					limithigh	:= 655.35,
					OutOfRange 	=> ,
					IgnoreZero 	:= TRUE,
					Out 		:= get.SoftSettings.PSB.r_VTratio );	
	END_IF

	input.UI_CTRatio := wordEndian(input.UI_CTRatio);
	IF input.UI_CTRatio > 0 THEN		
		get.SoftSettings.PSB.ui_CTrange := input.UI_CTRatio;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="MapPowerSTack" Id="{0df971fe-3444-431c-8e45-cf805b09270b}" FolderPath="DataMappingV2\">
      <Declaration><![CDATA[METHOD MapPowerSTack : BOOL
VAR_IN_OUT CONSTANT
	monitor								: ST_System_Monitor;
END_VAR

VAR_IN_OUT
	events	: 	ST_ExtController_Events;
	Input	:	ST_PNInput_powerstack;
	Output	:	ST_PNOutput_powerstack;
END_VAR

VAR_INST
	test	:	Real;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
//Fill output data
Output.w_Status.0	:=	Monitor.powerstack.Netcontactor.b_NetConFb;
Output.w_Status.1	:=	Monitor.powerstack.b_ACDetected;
Output.w_Status.2	:=	Monitor.powerstack.b_DCDetected;
Output.w_Status.3	:= 	Monitor.powerstack.b_GridTied;
Output.w_Status.4	:=	Monitor.powerstack.b_InverterRunning;
Output.w_Status.5	:=	Monitor.powerstack.b_StartedState;
Output.w_Status.6	:=	Monitor.powerstack.b_ControlEnabled;
Output.w_Status.7	:= 	Monitor.powerstack.b_EcomodeAvailable;
Output.w_Status		:= WordEndian(Output.w_Status);

Output.w_Warnings.0	:=	Monitor.powerstack.Events.b_UndervoltageWarning;
Output.w_Warnings.1	:=	Monitor.powerstack.Events.b_OvervoltageWarning;
Output.w_Warnings.2	:=	Monitor.powerstack.Events.b_overcurrentWarning;
Output.w_Warnings.3	:=	Monitor.powerstack.Events.b_TemperatureWarning OR Monitor.powerstack.Events.b_TemperatureDeviationHigh;
Output.w_Warnings.4	:=	Monitor.powerstack.Events.b_MasterWarning;
Output.w_Warnings.5	:=	Monitor.powerstack.Events.b_SlaveWarning;
Output.w_Warnings.6 := 	Monitor.powerstack.Events.b_GridCodeWarning;
Output.w_Warnings.7 := 	Monitor.powerstack.Netcontactor.events.b_IllegalLeftFieldSelected;
Output.w_Warnings	:= 	WordEndian(Output.w_Warnings);

Output.w_Faults.0	:=	Monitor.powerstack.Events.b_UnderVoltageFault;
Output.w_Faults.1	:=	Monitor.powerstack.Events.b_OverVoltageFault;
Output.w_Faults.2	:=	Monitor.powerstack.Events.b_OvercurrentFault;
Output.w_Faults.3	:=	Monitor.powerstack.Events.b_TemperatureFault;
Output.w_Faults.4	:=	Monitor.powerstack.Events.b_MasterFault;
Output.w_Faults.5	:=	Monitor.powerstack.Events.b_SlaveFault;
Output.w_Faults.6	:=	Monitor.powerstack.Events.b_NetcontactorFault;
//Output.w_Faults.7	:=	monitor.powerstack.Events.b_GridCodeWarning;
Output.w_Faults.8	:=	Monitor.powerstack.Events.b_ShutdownTimeOut OR Monitor.powerstack.Events.b_startupTimeOut;
Output.w_Faults		:= WordEndian(output.w_Faults);

Output.ui_PowerStackStatus			:=  WordEndian(TO_UINT(Monitor.powerstack.e_State));
Output.ui_ACCurrent					:=  RealToUint 	(	In	:= Monitor.powerstack.r_AcCurrent, 		Scale	:=	10);
Output.i_ActivePower				:=  RealToint 	(	In	:= Monitor.powerstack.r_ActivePower, 	Scale	:=	10);
Output.i_ReactivePower 				:= 	RealToint 	(	In	:= Monitor.powerstack.r_ReactivePower, 	Scale	:=	10);
Output.ui_Supplyfrequency 			:=  RealToUint	(	In	:= Monitor.powerstack.r_FrequencyD7, 	Scale	:=	100);
Output.ui_SupplyVoltage				:=  RealToUint 	(	In	:= Monitor.powerstack.r_ACVoltageD7, 	Scale	:=	10);
Output.i_PsetAct 					:=  RealToint 	(	In	:= get.Operation.system.r_Pset, 		Scale	:=	10);
Output.i_QsetAct 					:=  RealToint 	(	In	:= get.Operation.system.r_Qset, 		Scale	:=	10);
Output.i_PFSetAct					:=  RealToUint	( 	In	:= get.Operation.system.r_PFset, 		Scale	:=	10);
Output.ui_LoadPercentage			:=	RealToUint 	( 	IN 	:= Monitor.powerstack.r_LoadPercent, 	Scale	:=	10);
Output.ui_RatedCurrent				:=	RealToUint	( 	In	:= Monitor.powerstack.r_RatedCurrent, 	Scale	:=	10);
Output.ui_RatedPower				:=	RealToUint	( 	In	:= Monitor.powerstack.r_RatedPower, 	Scale	:=	10);
Output.ui_DischargePowerLimit		:= 	RealToUint	( 	In	:= Monitor.powerstack.r_Pmax, 			Scale	:=	10);
Output.ui_ChargePowerLimit			:= 	RealToUint	( 	In	:= ABS(Monitor.powerstack.r_Pmin), 		Scale	:=  10);
Output.ui_ACcurrentLimit			:= 	RealToUint	( 	In	:= Monitor.powerstack.r_ACcurrentLimit, Scale	:=	10);
Output.ui_ApparentPowerLimit		:= 	RealToUint	( 	In	:= Monitor.powerstack.r_Smax, 			Scale	:=	10);
Output.ui_ReactivePowerLimit		:=	RealToUint	(	In  := Monitor.powerstack.r_QMax,			Scale 	:=  10);

//process input data
IF (NOT events.b_HeartbeatFault) THEN
	Input.w_Control := wordEndian(Input.w_Control);
	Get.operation.system.b_PFsetEnable 								:=	Input.w_Control.0;	
	
	IntToReal(	in			:= Input.i_Pset, 
				scale 		:= 10, 
				limitlow	:= -st_params.Limits.r_InverterPowerLimit,
				limithigh	:=	st_params.limits.r_InverterPowerLimit,
    			OutOfRange 	=>	events.b_PsetOutOfRange,
				IgnoreZero 	:= FALSE,
				Out 		:= Get.Operation.system.r_Pset);
				
	IntToReal(	in			:= Input.i_Qset, 
				scale 		:= 10, 
				limitlow	:= -st_params.Limits.r_InverterPowerLimit,
				limithigh	:=	st_params.limits.r_InverterPowerLimit,
    			OutOfRange 	=>	events.b_QsetOutOfRange,
				IgnoreZero 	:= FALSE,
				Out 		:= Get.Operation.system.r_Qset);
	
	IntToReal(	in			:= Input.i_PFset, 
				scale 		:= 100, 
				limitlow	:= -1,
				limithigh	:=	1,
    			OutOfRange 	=>	events.b_PFsetOutOfRange,
				IgnoreZero 	:= TRUE,
				Out 		:= Get.Operation.system.r_PFset);
				
	IF ExternalControlMode > eExternalControlMode.BasicControl THEN
			Settings.MachineParams.system.Powercontroller.SocDroop.enable	:=	Input.w_Control.1;
			Get.SoftSettings.system.b_EcoModeEnable							:= 	Input.w_Control.2;
	
			
		UIntToReal(	in			:= Input.ui_NominalVoltage, 
					scale 		:= 1, 
					limitlow	:= st_params.limits.r_NominalVoltageMin,
					limithigh	:=	st_params.limits.r_NominalVoltageMax,
					OutOfRange 	=>	events.b_NominalVoltageOutOfRange,
					IgnoreZero 	:= TRUE,
					Out 		:= Get.Operation.system.r_NominalVoltage);
		
		UIntToReal(	in			:= Input.ui_NominalFrequency, 
					scale 		:= 100, 
					limitlow	:= st_params.limits.r_NominalFreqMin,
					limithigh	:=	st_params.limits.r_NominalFreqMax,
					OutOfRange 	=>	events.b_NominalFreqOutOfRange,
					IgnoreZero 	:= TRUE,
					Out 		:= Get.Operation.system.r_NominalFrequency);
		
		UIntToReal(	in			:= Input.ui_NominalFrequency, 
					scale 		:= 100, 
					limitlow	:= st_params.limits.r_NominalFreqMin,
					limithigh	:=	st_params.limits.r_NominalFreqMax,
					OutOfRange 	=>	events.b_NominalFreqOutOfRange,
					IgnoreZero 	:= TRUE,
					Out 		:= Get.Operation.system.r_NominalFrequency);
				
		UintToReal(	in			:= Input.ui_FrequencyDroop, 
					scale 		:= 10, 
					limitlow	:=	0, 
					limithigh	:=	st_params.limits.r_DroopMax, 
					OutOfRange 	=>	events.b_FreqDroopOutOfRange,
					IgnoreZero 	:= 	FALSE,
					Out 		:= 	Get.SoftSettings.system.r_FrequencyDroop);
	
		UintToReal(	in			:= 	Input.ui_VoltageDroop, 
					scale 		:= 	10, 
					limitlow	:=	0, 
					limithigh	:=	st_params.limits.r_DroopMax, 
					OutOfRange 	=>	events.b_VoltageDroopOutOfRange,
					IgnoreZero 	:= 	FALSE,
					Out 		:= 	Get.SoftSettings.system.r_VoltageDroop);			
	
//		UintToReal(	in			:= 	Input.ui_PowerRampRate, 
//					scale 		:= 	1, 
//					limitlow	:=	0, 
//					limithigh	:=	st_params.limits.r_PowerRampLimit, 
//					OutOfRange 	=>	events.b_VoltageDroopOutOfRange,
//					IgnoreZero 	:= 	FALSE,
//					Out			:= ?);				
		
				
					
		UintToReal(	in			:= 	Input.ui_SOCDroopUpshiftStart, 
					scale 		:= 	10, 
					limitlow	:=	Settings.MachineParams.system.Powercontroller.SocDroop.SocMinDroopStart, 
					limithigh	:=	get.softsettings.system.r_SocMax, 
					OutOfRange 	=>	events.b_VoltageDroopOutOfRange,
					IgnoreZero 	:= 	TRUE,
					Out 		:= 	Settings.MachineParams.system.Powercontroller.SocDroop.SocMaxDroopStart);
	
		UintToReal(	in			:= 	Input.ui_SOCDroopDownShiftStart, 
					scale 		:= 	10, 
					limitlow	:=	get.softsettings.system.r_SocMin, 
					limithigh	:=	Settings.MachineParams.system.Powercontroller.SocDroop.SocMaxDroopStart, 
					OutOfRange 	=>	events.b_VoltageDroopOutOfRange,
					IgnoreZero 	:= 	TRUE,
					Out 		:= 	Settings.MachineParams.system.Powercontroller.SocDroop.SocMinDroopStart);	
			

	
		CASE input.ui_PowerLimitMode OF
			//	0:	remain 
			1:	get.SoftSettings.system.e_UgridPowerLimitingMode := ePLM.FreqShift;
			2:	get.SoftSettings.system.e_UgridPowerLimitingMode := ePLM.VoltShift;
			3:	get.SoftSettings.system.e_UgridPowerLimitingMode := ePLM.FreqVoltShift;
			4:	get.SoftSettings.system.e_UgridPowerLimitingMode := ePLM.Shutdown;
		END_CASE
		
		UintToReal(	in			:= 	Input.ui_ACCurrentLimit, 
					scale 		:= 	10, 
					limitlow	:=	0, 
					limithigh	:=	monitor.powerstack.r_ACcurrentLimitMax, 
					OutOfRange 	=>	events.b_VoltageDroopOutOfRange,
					IgnoreZero 	:= 	TRUE,
					Out 		:= 	get.SoftSettings.system.r_AMax);
	END_IF
	
ELSE
	//If Heartbeat fails or control is not allowed --> reset Operational values
	// soft settings may remain.
	Get.Operation.system.r_Pset	 :=	0;
	Get.Operation.system.r_Qset	 :=	0;
	Get.Operation.system.r_PFset :=	1;
	Get.Operation.system.r_NominalVoltage := 400;
	get.Operation.system.r_NominalFrequency := 50;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="MapZPT" Id="{71509464-62dc-44d8-a035-abfb1271e6de}" FolderPath="DataMappingV2\">
      <Declaration><![CDATA[METHOD MapZPT : BOOL
VAR_IN_OUT CONSTANT
	monitor								: ST_System_Monitor;
END_VAR

VAR_IN_OUT
	Output	:	ST_PNOutput_ZPT;
END_VAR

VAR
	HighestTemp	:	Real;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[

//Fill output data

Output.w_Status.0 	:= 	Monitor.neutraltransformer.b_active;	//not in use
Output.w_Status 	:= WordEndian(Output.w_Status);

Output.w_Warnings.0	:=	Monitor.neutraltransformer.events.b_OvercurrentWarning;
Output.w_Warnings.1	:=	Monitor.neutraltransformer.events.b_TemperatureHighPhase[phases.L1] OR 
						Monitor.neutraltransformer.events.b_TemperatureHighPhase[phases.L2] OR 
						Monitor.neutraltransformer.events.b_TemperatureHighPhase[phases.L3];
Output.w_Warnings.2	:=	Monitor.neutraltransformer.events.b_VoltageUnbalanceHigh;
Output.w_Warnings.3	:=	Monitor.neutraltransformer.events.b_NeutralCurrentHigh;
Output.w_warnings 	:= WordEndian(Output.w_Warnings);

Output.w_Errors.0	:=	Monitor.neutraltransformer.events.b_OvercurrentAlarm;
Output.w_Errors.1	:=	Monitor.neutraltransformer.events.b_TemperatureTooHighPhase[phases.L1] OR 
						Monitor.neutraltransformer.events.b_TemperatureTooHighPhase[phases.L2] OR 
						Monitor.neutraltransformer.events.b_TemperatureTooHighPhase[phases.L3];
Output.w_Errors.2	:=	Monitor.neutraltransformer.events.b_VoltageUnbalanceTooHigh;
Output.w_Errors.3	:=	Monitor.neutraltransformer.events.b_NeutralCurrentTooHigh;
Output.w_Errors 	:= WordEndian(Output.w_Errors);

Output.ui_RatedPower:=	RealToUint(in:= Monitor.neutraltransformer.r_ratedPower, Scale:=1); //where to find?
Output.ui_Powerload	:=	RealToUint(in:= Monitor.neutraltransformer.r_Powerload, Scale:=10);

HighestTemp := MAX(Monitor.neutraltransformer.r_TemperaturePhase[0], Monitor.neutraltransformer.r_TemperaturePhase[1], Monitor.neutraltransformer.r_TemperaturePhase[2]);
Output.i_TransformerTemperature	:=	RealToint(in:=HighestTemp, Scale:=10);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="RealToInt" Id="{c6787a96-4e41-436f-acb3-e31c3ff1d0d8}" FolderPath="DataConversion\">
      <Declaration><![CDATA[METHOD RealToInt : INT
VAR_INPUT
	In			:	REAL;
	Scale		:	UINT := 10;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT IsNaN(IN) THEN
	RealToInt := WordEndian(REAL_TO_INT(LIMIT(-32768, In*Scale, 32767)));
END_IF




]]></ST>
      </Implementation>
    </Method>
    <Method Name="RealToUDINT" Id="{486c7cc5-cd43-4ab8-8d93-a683d649ac39}" FolderPath="DataConversion\">
      <Declaration><![CDATA[METHOD RealToUDINT : UDINT
VAR_INPUT
	In		:	REAL;
	Scale	:	UINT := 10;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT IsNaN(IN) THEN
	RealToUdint := DwordEndian(REAL_TO_UDINT(LIMIT(0, In*Scale, 16#FFFFFFFF)));
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="RealToUint" Id="{abf975ac-db57-4e02-915d-0affb502c30f}" FolderPath="DataConversion\">
      <Declaration><![CDATA[METHOD RealToUint : UINT
VAR_INPUT
	In		:	REAL;
	Scale	:	UINT := 10;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT IsNaN(IN) THEN
	RealToUint := WordEndian(REAL_TO_UINT(LIMIT(0, In*Scale, 16#FFFF)));
END_IF




]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetJsonDoc" Id="{7e30477d-4df1-4304-93de-ecf90b11ee13}">
      <Declaration><![CDATA[METHOD SetJsonDoc : BOOL
VAR_IN_OUT
	OutputJson       : STRING(2000);
END_VAR


VAR_INST
	fbJson         	: FB_JsonSaxWriter;
  	fbJsonDataType 	: FB_JsonReadWriteDataType;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbJson.ResetDocument();
fbjson.AddKey('General');
fbJsonDataType.AddJsonValueFromSymbol(fbJson, 'ST_PNOutput_General', SIZEOF(Outputs.General), ADR(Outputs.General));
fbjson.AddKey('Battery');
fbJsonDataType.AddJsonValueFromSymbol(fbJson, 'ST_PNOutput_Battery', SIZEOF(Outputs.Battery), ADR(Outputs.Battery));
fbjson.AddKey('Outputfield');
fbJsonDataType.AddJsonValueFromSymbol(fbJson, 'ST_PNOutput_OutputField', SIZEOF(Outputs.OutputField), ADR(Outputs.OutputField));
fbjson.AddKey('Inputfield');
fbJsonDataType.AddJsonValueFromSymbol(fbJson, 'ST_PNOutput_InputField', SIZEOF(Outputs.InputField), ADR(Outputs.InputField));
fbjson.AddKey('Powerstack');
fbJsonDataType.AddJsonValueFromSymbol(fbJson, 'ST_PNOutput_Powerstack', SIZEOF(Outputs.Powerstack), ADR(Outputs.Powerstack));
fbjson.AddKey('PSB');
fbJsonDataType.AddJsonValueFromSymbol(fbJson, 'ST_PNOutput_PeakShaveBox', SIZEOF(Outputs.PSB), ADR(Outputs.PSB));
fbjson.AddKey('ZPT');
fbJsonDataType.AddJsonValueFromSymbol(fbJson, 'ST_PNOutput_ZPT', SIZEOF(Outputs.ZPT), ADR(Outputs.ZPT));
fbjson.AddKey('InputGen');
fbJsonDataType.AddJsonValueFromSymbol(fbJson, 'ST_PNOutput_Gencontrol', SIZEOF(Outputs.GenControl), ADR(Outputs.GenControl));
fbjson.AddKey('InputGrid');
fbJsonDataType.AddJsonValueFromSymbol(fbJson, 'ST_PNOutput_InputGridControl', SIZEOF(Outputs.InputGridControl), ADR(Outputs.InputGridControl));
fbJson.CopyDocument(OutputJson, SIZEOF(OutputJson));
]]></ST>
      </Implementation>
    </Method>
    <Method Name="UintToByte" Id="{1421d367-dc2a-4870-93c3-d9089d108dc3}" FolderPath="DataConversion\">
      <Declaration><![CDATA[METHOD UintToByte : BYTE
VAR_INPUT
	in			:	UINT;
	LimitLow	: 	BYTE;
	LimitHigh	:  	BYTE; 
END_VAR

VAR_OUTPUT
	OutofRange		: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[OutofRange := ValueOutOfRange(TO_REAL(in), TO_REAL(LimitLow), TO_REAL(LimitHigh));

UintToByte := TO_BYTE(LIMIT(LimitLow, in, LimitHigh));
]]></ST>
      </Implementation>
    </Method>
    <Method Name="UintToReal" Id="{d4fe46ec-9b14-4a4b-aa45-c4143183bc5b}" FolderPath="DataConversion\">
      <Declaration><![CDATA[METHOD UintToReal : REAL
VAR_INPUT
	in			:	UINT;
	Scale		:	UINT := 1;
	LimitLow	: 	REAL := 0;
	LimitHigh	:  	REAL := 3.402823E+38; 
	IgnoreZero	:	BOOL := FALSE;
END_VAR

VAR_OUTPUT
	OutofRange	: BOOL;
END_VAR

VAR
	r_value			: REAL;
END_VAR

VAR_IN_OUT
	Out	:	REAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (NOT IgnoreZero) OR (in <> 0) THEN
	r_value	 := UINT_TO_REAL(WordEndian(in))/Scale;
	
	OutofRange := ValueOutOfRange(r_value, LimitLow, LimitHigh);
	Out := LIMIT(LimitLow, r_value, LimitHigh);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="WordEndian" Id="{588bfb4a-75be-4b23-a028-206092985d92}" FolderPath="DataConversion\">
      <Declaration><![CDATA[METHOD WordEndian : WORD
VAR_INPUT
	IN		: WORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF st_params.b_BigEndian THEN
	WordEndian := HOST_TO_BE16(IN);
ELSE
	WordEndian := IN;
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>