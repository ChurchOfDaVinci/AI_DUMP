	BindControlvars				: FB_BindControlvars;
	
	e_ID						: eObject_ID := eObject_ID.PNcontroller;
	
	fTrigTestScript				: F_Trig;
	emptyEventStruct			: ST_ExtController_Events;
	emptyTestStruct				: ST_PNTest;
	TestScript					: FB_ExtControllerTest;
	
	b_enableByteSwap			: BOOL;
END_VAR

