	b_SocStopOutOfRange			: BIT;
	b_PsetOutOfRange			: BIT;
	b_QsetOutOfRange			: BIT;
	b_PFsetOutOfRange			: BIT;
	b_NominalVoltageOutOfRange	: BIT;
	b_NominalFreqOutOfRange		: BIT;
	b_FreqDroopOutOfRange		: BIT;
	b_VoltageDroopOutOfRange	: BIT;
	b_PmaxOutOfRange			: BIT;
	b_PminOutOfRange			: BIT;
	b_SmaxOutOfRange			: BIT;
	b_AmaxOutOfRange			: BIT;
	b_PowerRamprateOutOfRange	: BIT;
	b_PSBFeedInLimitOutOfRange	: BIT;
	b_PSBSupplyLimitOutOfRange: BIT;
	b_PSBIdleChargePowerOutOfRange: BIT;
	b_PSBSoCTargetOutOfRange	: BIT;
