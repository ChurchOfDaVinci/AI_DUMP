<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_ChargerControl" Id="{6cb6ee85-438b-4c58-a884-455d927ce082}">
    <Declaration><![CDATA[TYPE ST_ChargerControl :
STRUCT
    (* Charger control *)
    bStartCharge      : BOOL;   // start charging sequence
    bStopCharge       : BOOL;   // stop charging sequence

    (* Module enable command *)
    bEnableModules    : BOOL;   // CMD 1A

    (* Setpoints *)
    rSetVoltage       : REAL;   // desired voltage [V]
    rSetCurrent       : REAL;   // desired current [A]

    (* Apply commands *)
    bApplyGroupSet    : BOOL;   // CMD 1B (group control)
    bApplyModuleSet   : BOOL;   // CMD 1C (module control)

    (* Target module *)
    ModuleTarget      : BYTE;   // module number (peer-to-peer)

    (* Hardware relay *)
    bSystemRelayCmd   : BOOL;   // command to close system relay
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>