	by_NoModulesActive		: BYTE;	
	by_NoModulesInstalled	: BYTE;
	e_ChargerStatus 		: ARRAY [0..6] OF eAcDcChargerState;
	
	ar_ACvoltage			: ARRAY [0..3] OF REAL;
	r_AvailablePower		: REAL;
	ACmeasurements			: ST_PQPowerData;
	r_DcVoltage	   			: REAL;
	r_DcCurrent				: REAL;
	r_DcPower				: REAL;

	Events					: ST_ACDCCharger_events;	

END_STRUCT
END_TYPE
]]></Declaration>
