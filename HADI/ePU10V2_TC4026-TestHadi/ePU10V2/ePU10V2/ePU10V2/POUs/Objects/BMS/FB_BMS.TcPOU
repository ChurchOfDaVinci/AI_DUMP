<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_BMS" Id="{f84bc1e7-b567-4e5e-b38f-18427cbcc8bc}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_BMS
VAR PERSISTENT
	ui_CycleCount				: UINT;
	r_CumDischargeEnergy		: REAL; // kWh
	r_CumChargeEnergy			: REAL; // kWh
	r_maxVoltageEver	 		: REAL;
	r_maxChargeCurrentEver		: REAL;
	r_maxDischargeCurrentEver	: REAL;
	dt_LastCalibrationDate		: DT;
END_VAR

VAR_IN_OUT CONSTANT
	st_params	: st_BMS_Params;
END_VAR

VAR_IN_OUT
 	st_service	: st_BMS_service;
END_VAR

VAR_OUTPUT
	PowerStatus: eHVDC_Powerstatus := 0;
END_VAR
VAR_INPUT
	Set 					: st_BMS_Set;
	b_HVDCEnable			: BOOL;
	by_NoOfStrings			: BYTE;
END_VAR

VAR_OUTPUT
	get						: st_BMS_Get;
	b_InternalHVDCAllowed	:	BOOL;
END_VAR

VAR	
	InitDone			:	Bool := false;
	b_HVDC_OnRq			: BOOL;	
	FBState					:	ePOUState;
	IO					:	FB_BMS_IO;
	InitTimeout			: 	TON := (PT:=T#3S);
	BMS_24V_StartupTimer : TON := (PT := TIME#2S0MS);
	
	DeviceIDcounter		: WORD;
	
	//SFC
	SFCInit				: BOOL := FALSE;
	SFCReset			: BOOL := FALSE;
	
	//Modbus
	b_MBComErrorActive	: 	BOOL 	:= FALSE;
	ComTimer			:	Ton := (PT := TIME#100MS);
	t_TimeOut			: 	TIME := T#500MS;
	
	ResetBMS	:	Bool; 
	b_BMSShutdownRequested: BOOL;
	
	BMSReadIntervalTimer	 : TON := (PT := TIME#1S0MS);
	
	b_ManualReset	:BOOL;
	BMSDataValid		:	Bool;
	
	arDatalogMBMU	: ARRAY [0..58] OF WORD;
	arDatalogSBMU	: ARRAY[0..3] OF ARRAY[0..55] OF WORD;
	ARDatalogEMS	: ARRAY [0..16] OF WORD;
	
	AutoSOCCalibrationRequired	:	Bool;
END_VAR

VAR CONSTANT
	e_ID 				: eObject_ID := eObject_ID.Battery;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[BMSDatalogger(b_enable := InitDone);
(*
FB_BMS

Inputs
	Set.b_EnableBMS				:	BOOL;
		Start BMS SFC sequence and initializes BMS. False means full BMS powerdown, so no status logging.
		With HVDC enabled, setting this value to False has no effect. Only after HVDC powerdown this value is tested.
		
	Set.b_ClearFault				:	BOOL;
		Clear errors and warning in BMS system. Set to true to initiate reset. Value resets automatically to false.
	
	Set.b_HVDC_Required			: 	BOOL;
		Set by FB_internalPowersupply. True initiates and keeps HVDC on, False initiates and retains powerdown

Outputs
	BMSGET
		-Some general status info
		-BATTinfo	struct with main operation battery data
		-MBMU_Status 	struct with detailed MBMU data
		-SBMU			Struct with detailed data per SBMU
		-Events			Warnings & Errors as per Sunspec list.
*)

IF InitDone THEN
	//INIT step
	//b_MBComErrorActive := FALSE;
	
	//CALL methods/functions
	//Link MBMU data when appropriate
	GetBatteryInfo(in := get.MBMU.BatteryStatus, OUT:= get.BatteryInfo);
	
	IF st_params.b_EnableAutoCalibration THEN
		IF dt_LastCalibrationDate > gvl.dt_SystemDateTime OR 
			(dt_LastCalibrationDate + st_params.T_AutoCalibrationInterval) < gvl.dt_SystemDateTime THEN
			get.T_RemainingTimeToAutoCalibration := T#0S;
			AutoSOCCalibrationRequired := TRUE;
		ELSE
			AutoSOCCalibrationRequired := FALSE;
			get.T_RemainingTimeToAutoCalibration := (dt_LastCalibrationDate + st_params.T_AutoCalibrationInterval) - gvl.dt_SystemDateTime;
		END_IF
	ELSE
		AutoSOCCalibrationRequired := FALSE;
		get.T_RemainingTimeToAutoCalibration := ST_Params.t_AutoCalibrationInterval;
	END_IF

		
	

	//get.LastCalibrationTime := dt_LastCalibrationDate;
	
	IF get.BatteryInfo.r_SOC < st_params.r_InternalConditioningSoCMin OR get.BatteryInfo.ar_CellVoltage[eSubValues.Minimum] < 3 THEN
		b_InternalHVDCAllowed := FALSE;
	ELSE
		b_InternalHVDCAllowed := TRUE;
	END_IF
	
	IO();
	
	BMSReadIntervalTimer(in:= not BMSReadIntervalTimer.Q);
	
	//Reset ErrorActive before entering SFC. 
	//any remaining error in the Modbus methods will set Erroractive again. 
	//This is pushed to events in BMS_Diagnostics
	
	//TEMPBMSHB();
	//hv required not allowed if BMS not enabled
	IF set.b_enable AND FBstate <> epoustate.EMSTOP THEN
		b_HVDC_OnRq := b_HVDCEnable OR st_params.b_forcePrecharging;
		
	ELSE
		b_HVDC_OnRq := FALSE;	
	END_IF
	
	//shutdown allowed if hvdc is offline
	b_BMSShutdownRequested := (NOT Set.b_Enable) AND get.MBMU.BatteryStatus.e_BMS_PowerOnStatus <> ePowerOnStatus.On; 
	
	IF b_ManualReset THEN
		Reset();
	END_IF
	
	//SFC delayed pulse trigger
	BMSSFC();
	
	BMS_Diagnostics();
	
	BMSDataValid := ((NOT get.Events.b_COMMUNICATION_ERROR) AND NOT (get.BatteryInfo.e_BMS_Status = eBMS_Status.Init));
END_IF]]></ST>
    </Implementation>
    <Folder Name="Internal methods" Id="{65537688-ac4f-4f6d-b27a-a80fb821076a}" />
    <Folder Name="SFC" Id="{564b7e00-10ec-45f5-9af8-1415fba4befa}" />
    <Action Name="aBMSPoweroff" Id="{bc94f2c8-8a98-48e3-b5e9-e15077eca8d2}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[IO.b_BMSEnable := FALSE;

get.BatteryInfo.b_BMSHeartBeatOK := FALSE;
get.BatteryInfo.e_BMS_PowerOnStatus := ePowerOnStatus.Off;
get.BatteryInfo.e_BMS_Status := eBMS_Status.Off;

get.MBMU.BatteryStatus.b_BMSHeartBeatOK := FALSE;
get.MBMU.BatteryStatus.e_BMS_PowerOnStatus := ePowerOnStatus.Off;
get.MBMU.BatteryStatus.e_BMS_Status := eBMS_Status.Off;

FBState := ePOUState.OFF;]]></ST>
      </Implementation>
    </Action>
    <Action Name="aBMSPowerOn" Id="{b655e345-07db-4f12-84c2-cfe3522b2cf1}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[
//230V inverter requires some startup time. Start this first to init SBMU before MBMU
//This may not be needed, but the idea is to make sure the MBMU can reach the SBMU's at boot.
FBState := ePOUState.PowerUp;
io.b_BMSEnable := TRUE;
BMS_24V_StartupTimer(IN:=io.b_BMSEnable);
]]></ST>
      </Implementation>
    </Action>
    <Action Name="aClearFaults" Id="{73544eea-c2c5-4fe8-9685-c28fe51514ac}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[SFCTip := ClearBMSFaults(st_params);]]></ST>
      </Implementation>
    </Action>
    <Action Name="aDisableInsulationMonitor" Id="{b0c7eb78-8848-404e-b0c6-de98883fd0a5}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[SFCTip := OpenInsulationSwitch(st_params, TRUE);]]></ST>
      </Implementation>
    </Action>
    <Action Name="aGetMBMUData" Id="{9b9bbfba-6e9f-40a4-9614-b12703001d18}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[SFCTip := GetMBMUData(st_params);]]></ST>
      </Implementation>
    </Action>
    <Action Name="aGetSBMUData" Id="{c2071653-1677-4e1e-b725-cb505e532c67}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[SFCTip := GetSBMUData(st_params);]]></ST>
      </Implementation>
    </Action>
    <Action Name="aGetStaticData" Id="{4c3ada9c-4cf8-4cd8-b7cf-729c47af2d89}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[
IF (DeviceIDcounter=0) THEN
	IF GetMBMUStaticSystemData(st_params) THEN
		DeviceIDcounter:=1;
	END_IF;
ELSE
	IF GetSBMUStaticSystemData(st_params, DeviceIDcounter) THEN
		DeviceIDcounter := DeviceIDcounter+1;
	END_IF
	
	IF DeviceIDcounter > by_NoOfStrings THEN//BMSGet.MBMU_Status.by_NumberOfSubSystems THEN
		DeviceIDcounter:=0;
		SFCtip := NOT SFCtip;
	END_IF
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="aGetStatus" Id="{a90aa134-5027-48a9-8e91-d8356eeffd5b}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[IF GetSystemStatus(st_params) THEN
	IF FBState = ePOUState.PowerUp THEN FBState := ePOUState.Init; END_IF
	SFCtip := NOT SFCtip;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="aInit" Id="{1bf09aae-72dd-46d8-8fb4-afdc9a2999c1}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[DeviceIDcounter := 0;
SFCReset := FALSE;
b_MBComErrorActive := FALSE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="aSetDateTime" Id="{f440fcdb-53bf-4a49-b2b3-caedac4d907e}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[SFCTip := SetBMSDateTime(st_params);]]></ST>
      </Implementation>
    </Action>
    <Action Name="aSetPowerMode" Id="{c0cb5012-948e-4d4c-a5f7-7892e11c8df2}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[SFCTip := SetPowerMode(st_params);]]></ST>
      </Implementation>
    </Action>
    <Action Name="aWatchdog" Id="{4862538b-5535-4b9c-8486-6240a5b4b5f4}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[IF FBState = ePOUState.Init THEN FBState := ePOUState.Normal; END_IF

SFCtip := BMSHeartBeat(st_params);
DeviceIDcounter := 0;]]></ST>
      </Implementation>
    </Action>
    <Method Name="BMS_Diagnostics" Id="{e3c13309-b712-4d57-bb48-1ed0d35570ec}" FolderPath="Internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE BMS_Diagnostics : BOOL
VAR
	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
get.Events.b_COMMUNICATION_ERROR				:=	get.MBMU.GeneralSBMUStatus[6].5 	//SBMU CCAN comm lost
												OR get.MBMU.GeneralSBMUStatus[6].6 	//SBMU SCAN comm lost
												OR get.MBMU.GeneralSBMUStatus[6].7	//SBMU MCAN comm lost
												OR get.MBMU.MBMUStatus[0].6			//MBMU MCAN comm warning
												OR get.MBMU.MBMUStatus[0].7			//MBMU MCAN comm Lost
												OR get.MBMU.MBMUStatus[0].8			//SBMU EMS COMM lost
												OR get.MBMU.MBMUStatus[3].4			//SBMU MBMU comm fault
												OR b_MBComErrorActive;					//One or more Modbus communication errors 
									
get.Events.b_OVER_TEMP_ALARM					:= get.MBMU.GeneralSBMUStatus[2].1;	//single cell Overtemperature warning 4

get.Events.b_OVER_TEMP_WARNING				:= get.MBMU.GeneralSBMUStatus[1].14	//single cell Overtemperature warning 1
												OR get.MBMU.GeneralSBMUStatus[2].0; 	//single cell Overtemperature warning 2

get.Events.b_UNDER_TEMP_ALARM				:= FALSE; //no data

get.Events.b_UNDER_TEMP_WARNING				:= get.MBMU.GeneralSBMUStatus[2].2	//single cell Undertemperature warning 1
												OR get.MBMU.GeneralSBMUStatus[2].3 	//single cell Undertemperature warning 2
												OR get.MBMU.GeneralSBMUStatus[2].4; 	//single cell Undertemperature warning 3

get.Events.b_OVER_CHARGE_CURRENT_ALARM		:= get.MBMU.GeneralSBMUStatus[1].9;	//Charge Overcurrent warning 4

get.Events.b_OVER_CHARGE_CURRENT_WARNING		:= get.MBMU.GeneralSBMUStatus[1].6	//Charge Overcurrent warning 1
												OR get.MBMU.GeneralSBMUStatus[1].7 	//Charge Overcurrent warning 2
												OR get.MBMU.GeneralSBMUStatus[1].8; 	//Charge Overcurrent warning 3
											
get.Events.b_OVER_DISCHARGE_CURRENT_ALARM	:= get.MBMU.GeneralSBMUStatus[1].5;	//Discharge Overcurrent warning 4

get.Events.b_OVER_DISCHARGE_CURRENT_WARNING	:= get.MBMU.GeneralSBMUStatus[1].2	//Discharge Overcurrent warning 1
												OR get.MBMU.GeneralSBMUStatus[1].3 	//Discharge Overcurrent warning 2
												OR get.MBMU.GeneralSBMUStatus[1].4; 	//Discharge Overcurrent warning 3
											
get.Events.b_OVER_VOLT_ALARM					:= get.MBMU.GeneralSBMUStatus[0].6;	//Single cell extreme overVoltage warning

get.Events.b_OVER_VOLT_WARNING				:= get.MBMU.GeneralSBMUStatus[0].0	//Single cell overVoltage warning 1
												OR get.MBMU.GeneralSBMUStatus[0].1 	//Single cell overVoltage warning 2
												OR get.MBMU.GeneralSBMUStatus[0].2 	//Single cell overVoltage warning 3
												OR get.MBMU.GeneralSBMUStatus[0].8 	//Single rack overVoltage warning 1
												OR get.MBMU.GeneralSBMUStatus[0].9; 	//Single rack overVoltage warning 2
												
get.Events.b_UNDER_VOLT_ALARM				:= get.MBMU.GeneralSBMUStatus[0].7;	//Single cell extreme underVoltage warning

get.Events.b_UNDER_VOLT_WARNING				:= get.MBMU.GeneralSBMUStatus[0].3	//Single cell underVoltage warning 1
												OR get.MBMU.GeneralSBMUStatus[0].4 	//Single cell underVoltage warning 2
												OR get.MBMU.GeneralSBMUStatus[0].5 	//Single cell underVoltage warning 3
												OR get.MBMU.GeneralSBMUStatus[0].10 	//Single rack underVoltage warning 1
												OR get.MBMU.GeneralSBMUStatus[0].11; //Single rack underVoltage warning 2
												
get.Events.b_UNDER_SOC_MIN_ALARM				:= get.MBMU.GeneralSBMUStatus[6].14;	//r_SOC low warning 2

get.Events.b_UNDER_SOC_MIN_WARNING			:= get.MBMU.GeneralSBMUStatus[6].13;	//r_SOC low warning 1

get.Events.b_OVER_SOC_MAX_ALARM				:= FALSE; //no data

get.Events.b_OVER_SOC_MAX_WARNING			:= FALSE; //no data

get.Events.b_VOLTAGE_IMBALANCE_WARNING		:= get.MBMU.GeneralSBMUStatus[0].12;	//large voltage difference warning

get.Events.b_TEMPERATURE_IMBALANCE_ALARM		:= FALSE; //no data
												
get.Events.b_TEMPERATURE_IMBALANCE_WARNING	:= get.MBMU.GeneralSBMUStatus[2].5	//Large temperature difference warning 1
												OR get.MBMU.GeneralSBMUStatus[2].6 	//Large temperature difference warning 2
												OR get.MBMU.GeneralSBMUStatus[2].7; 	//Large temperature difference warning 3
												
get.Events.b_CONTACTOR_ERROR					:= get.MBMU.GeneralSBMUStatus[5].1	//Main positive relay sticking
												OR get.MBMU.GeneralSBMUStatus[5].2 	//Main negative relay sticking
												OR get.MBMU.GeneralSBMUStatus[5].3 	//Both main relays sticking
												OR get.MBMU.GeneralSBMUStatus[5].4 	//Main positive relay open
												OR get.MBMU.GeneralSBMUStatus[5].5 	//Main negative relay open
												OR get.MBMU.GeneralSBMUStatus[6].15; //HV open circuit warning
												
get.Events.b_FAN_ERROR						:= get.MBMU.GeneralSBMUStatus[5].7;	//main control box fan warning

get.Events.b_GROUND_FAULT					:= FALSE; //no data

get.Events.b_OPEN_DOOR_ERROR					:= FALSE; //no data

get.Events.b_CURRENT_IMBALANCE_WARNING		:= FALSE; //no data

get.Events.b_OTHER_ALARM						:= get.MBMU.GeneralSBMUStatus[0].13	//Invalid voltage warning
												OR get.MBMU.GeneralSBMUStatus[1].10 	//Current sensor fault
												OR get.MBMU.GeneralSBMUStatus[2].15 //single temperature sampling abnormal value warning
												OR get.MBMU.GeneralSBMUStatus[3].0 	//multiple temperature sampling abnormal value warning
												OR get.MBMU.GeneralSBMUStatus[4].9 	//CSC supply abnormal
												OR get.MBMU.GeneralSBMUStatus[4].10 	//SBMU supply abnormal
												OR get.MBMU.GeneralSBMUStatus[4].14 	//MSD warning
												OR get.MBMU.GeneralSBMUStatus[4].15 	//rack fuse warning
												OR get.MBMU.GeneralSBMUStatus[6].11 	//cell balance circuit short
												OR get.MBMU.GeneralSBMUStatus[7].3 	//precharching failed twice
												OR get.MBMU.MBMUStatus[1].7 			//estop fault
												OR get.MBMU.MBMUStatus[3].3; 		//MBMU 24V fault
												
get.Events.b_OTHER_WARNING					:= get.MBMU.MBMUStatus[0].0 			//insulation warning
												OR get.MBMU.MBMUStatus[1].10 		//rack fan warning
												OR get.MBMU.MBMUStatus[3].7;			//TMS warning

get.Events.b_DISCONNECTOR_OFF				:= get.MBMU.GeneralSBMUStatus[5].0;	//rack isolate switch warning		
					
get.Events.b_CONFIGURATION_ALARM				:= get.MBMU.GeneralSBMUStatus[5].6 	//battery rack door fault
												OR get.MBMU.GeneralSBMUStatus[5].9 	//rack fire system level 1 fault
												OR get.MBMU.GeneralSBMUStatus[5].10 	//smoke detector contact open
												OR get.MBMU.GeneralSBMUStatus[5].11 	//temp detector contact open
												OR get.MBMU.GeneralSBMUStatus[5].14 	//aerosol warning
												OR get.MBMU.GeneralSBMUStatus[6].0 	//rack fire system level 2 fault
												OR get.MBMU.GeneralSBMUStatus[6].10 	//SBMU TMS CCAN comm lost with hv on
												OR get.MBMU.GeneralSBMUStatus[7].0 	//lvl 3 fault tms
												OR get.MBMU.GeneralSBMUStatus[7].1 	//TMS mode conflict
												OR get.MBMU.GeneralSBMUStatus[7].2 	//TMS warning
												OR get.MBMU.GeneralSBMUStatus[8].0 	//Thermal runaway caused fire
												OR get.MBMU.MBMUStatus[0].1	 		//Insulation fault
												OR get.MBMU.MBMUStatus[0].2			//Insulation error
												OR get.MBMU.MBMUStatus[0].3 			//Less HV racks than expected
												OR get.MBMU.MBMUStatus[0].9			//IMM comm fault
												OR get.MBMU.MBMUStatus[0].10 		//Air conditioning comm fault
												OR get.MBMU.MBMUStatus[0].11			//TMS comm fault
												OR get.MBMU.MBMUStatus[0].13			//TMS comm fault lvl 2
												OR get.MBMU.MBMUStatus[0].14 		//TMS mode conflict
												OR get.MBMU.MBMUStatus[0].15			//TMS comm fault level 1
												OR get.MBMU.MBMUStatus[1].3	 		//AUX power DCDC failure
												OR get.MBMU.MBMUStatus[1].4			//Fire system fault lvl 1
												OR get.MBMU.MBMUStatus[1].5 			//Fire system fault lvl 2
												OR get.MBMU.MBMUStatus[1].6			//Fire system failure warning
												OR get.MBMU.MBMUStatus[1].8	 		//client estop fault
												OR get.MBMU.MBMUStatus[1].9			//rack door fault
												OR get.MBMU.MBMUStatus[1].12;		//smoke ex fan body fault
								
get.Events.b_CONFIGURATION_WARNING			:= get.MBMU.GeneralSBMUStatus[6].8	//SBMU TMS CCAN comm lost
												OR get.MBMU.MBMUStatus[0].12	 		//TMS comm warning
												OR get.MBMU.MBMUStatus[1].0			//SPD failure
												OR get.MBMU.MBMUStatus[1].1 			//Aux power DCDC failure
												OR get.MBMU.MBMUStatus[1].2			//AUX power DCDC failure
												OR get.MBMU.MBMUStatus[1].6 			//Fire system failure warning
												OR get.MBMU.MBMUStatus[1].11;		//Smoke exhaust fan body warning

get.Events.b_POWERONFAULT					:= get.MBMU.BatteryStatus.e_BMS_PowerOnStatus = ePoweronstatus.PowerOn_Fault;
get.Events.b_Powerofffault					:= get.MBMU.BatteryStatus.e_BMS_PowerOnStatus = ePoweronstatus.PowerOff_Fault;
										
												
												
												
												
												
												]]></ST>
      </Implementation>
    </Method>
    <Method Name="BMSDatalogger" Id="{b558f9ed-5adf-4844-9721-435d0a77dafd}">
      <Declaration><![CDATA[METHOD BMSDatalogger : BOOL
VAR_INPUT
	b_enable	: BOOL;
END_VAR

VAR_INST
	LogTimer 	: TON := (PT := T#15S);
	ArrayCounter	:	UINT := 0;
	SBMUCounter		:	UINT	:=	0;
	LogStep			:	UINT := 0;	

	s_MBMUData	:	STRING(255);
	s_SBMUData	:	ARRAY[0..3] OF STRING (255);
	s_EMSData	:	STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[LogTimer(in := NOT LogTimer.Q);	//start data logging at interval

CASE logstep OF
	0:	//do nothing
		IF LogTimer.Q THEN
			LogStep	:=	1;
		END_IF
		
	1:	//Write MBMU data
		s_MBMUData := '';
		FOR ArrayCounter := 0 TO 52 DO
			s_MBMUData := Concat(s_MBMUData, Word_to_hexstr(arDatalogMBMU[ArrayCounter], 2, FALSE));
		END_FOR
		Logstep := 2;
		
	2: //Write data of 1 SMBU //required log frequency is lower, so send each separate to save data and cpu load 
		s_SBMUData[SBMUCounter] := '';
		FOR ArrayCounter := 0 TO 50 DO
			s_SBMUData[SBMUCounter] := Concat(s_SBMUData[SBMUCounter], Word_to_hexstr(arDatalogSBMU[SBMUCounter][ArrayCounter], 2, FALSE));
		END_FOR
		
		SBMUCounter := SBMUCounter+1;
		IF SBMUCounter >= by_NoOfStrings THEN
			SBMUCounter := 0;
			Logstep := 3;
		END_IF

	3: //Write data of EMS
		s_EMSData := '';
		FOR ArrayCounter := 0 TO 5 DO
			s_EMSData := Concat(s_EMSData, Word_to_hexstr(arDatalogEMS[ArrayCounter], 2, FALSE));
		END_FOR	
		Logstep := 0;
END_CASE

MQTTComOpenremote.FillBatteryDatalog(s_MBMUData := s_MBMUData, s_SBMUData := s_SBMUData, s_EMSData := s_EMSData);]]></ST>
      </Implementation>
    </Method>
    <Method Name="BMSHeartBeat" Id="{fa0a650b-d9a2-4319-bbf8-8b86e69ebb7d}" FolderPath="Internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE BMSHeartBeat : BOOL

VAR_IN_OUT CONSTANT
	st_params			: ST_BMS_params;
END_VAR

VAR_INST
	WriteReg		:	FB_MBWriteSingleReg;
	ReadReg			:	FB_MBReadRegs;
	
	readbCommBusy		:	BOOL;
	readbComError		:	BOOL;
	readerrID			:	UDINT;
	
	WritebCommBusy		:	BOOL;
	WritebComError		:	BOOL;
	WriteerrID			:	UDINT;
	
	ReadDone			:	F_Trig;
	ReadOK				: 	BOOL;
	WriteDone			:	F_Trig;
	WriteOK				: 	BOOL;
	
	//ComTimer		:	Ton := (PT := TIME#0S200MS);
	
	OldValue		:	WORD := 0;
	BMSHBValue		:	WORD := 0;
	
	WatchdogUpdateTimer	:	Tof := (PT := TIME#3S0MS);
	WatchdogCommTimer	:	Tof := (PT := TIME#3S0MS);
	
	ComRetryCounter	:	USINT := 0;
END_VAR	

]]></Declaration>
      <Implementation>
        <ST><![CDATA[ComTimer(in := NOT(ComTimer.Q OR readbCommBusy OR WritebCommBusy));

ReadReg(
sIPAddr := st_params.IP_BMS,
nTCPPort := 502,
nUnitID := 255,//16#FF;
nMBAddr := 768,
nQuantity := 1,
cbLength := 2,
pDestAddr := ADR(BMSHBValue),
bExecute := ComTimer.Q,
tTimeOut := t_TimeOut,
bBusy => readbCommBusy,
bError => readbComError,
nErrId => readerrID,
cbRead => 
);

ReadDone(clk := readbCommBusy);
ReadOK := ReadDone.Q AND NOT readbComError;

//read value is transmitted back into the write buffer if read is succesful
//BMS increments this value every second.
WriteReg(
sIPAddr := st_params.IP_BMS,
nTCPPort := 502,
nUnitID := 255,//16#FF;
nMBAddr := 896,
nValue := BMSHBValue,
tTimeout := T#1000MS,
bExecute := ReadOK,
bBusy => WritebCommBusy,
bError => WritebComError,
nErrId => WriteerrID,
);

WriteDone(clk := writebCommBusy);
WriteOK := writeDone.Q AND NOT writebComError;

//if written value and BMS value are equal for longer than 3 seconds, the BMS isn't incrementing the value anymore or communication failed.
//BMS itself will throw warning after 30s and disable 10s after that.
WatchdogUpdateTimer(in:= (OldValue <> BMSHBValue));
OldValue := BMSHBValue;

//if modbus communication throws an error retry for 3s, otherwise system failed.
//WatchdogCommTimer(in:= WriteOK);

//both values are normally high and fall away if they timeout
get.BatteryInfo.b_BMSHeartBeatOK := WatchdogUpdateTimer.Q;// OR WatchdogCommTimer.Q;
get.MBMU.BatteryStatus.b_BMSHeartBeatOK := WatchdogUpdateTimer.Q;

IF (ReadDone.Q AND readbComError) OR (WriteDone.Q AND WritebComError) THEN
	ComRetryCounter := ComRetryCounter + 1;
	IF COMRetryCounter > 5 THEN
		b_MBComErrorActive := TRUE;
		get.BatteryInfo.b_BMSHeartBeatOK := FALSE;
	END_IF
END_IF

IF ReadOK THEN
	arDatalogMBMU[47] := BMSHBValue;
END_IF

IF WriteOK THEN
	arDatalogEMS[0] := BMSHBValue;
	ComRetryCounter := 0;
	BMSHeartBeat := TRUE;
	b_MBComErrorActive := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
