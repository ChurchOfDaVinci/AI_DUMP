    <Method Name="CalculateCumulativeValues" Id="{3804fa2a-060f-428b-b8a6-7307214e863c}" FolderPath="Internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE CalculateCumulativeValues
VAR_IN_OUT
	get : st_BMS_BatterySummary;
END_VAR

VAR_INPUT
	t_cycletime			: TIME;
END_VAR

VAR
	timefraction		: REAL;
	millisInHour		: REAL := 3600000;
	ui_cyclecountTemp : UINT;
END_VAR

VAR_INST
	r_trigResetCounters		: r_trig;
	ton_EnergyPulseTimer	: TON := (PT:= T#10MS);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[timefraction := TO_REAL(t_cycletime) / millisInHour;

IF get.r_SystemPower > 0 THEN
	get.r_HistAccDischargeEnergy := get.r_HistAccDischargeEnergy + ABS(get.r_SystemPower) * timefraction;
ELSIF get.r_SystemPower < 0 THEN
	get.r_HistAccChargeEnergy := get.r_HistAccDischargeEnergy + ABS(get.r_SystemPower) * timefraction;
END_IF

//Get current cycle count
get.ui_CycleCount := TO_UINT(get.r_HistAccDischargeEnergy / MAX(1, get.r_ratedEnergyCapacity));



//--- store max charge/discharge current to persistent var ---
IF get.r_SystemCurrent > 0 AND get.r_SystemCurrent > r_maxDischargeCurrentEver THEN
	r_maxDischargeCurrentEver := get.r_SystemCurrent;
ELSIF get.r_SystemCurrent < 0 AND ABS(get.r_SystemCurrent) > r_maxChargeCurrentEver THEN
	r_maxChargeCurrentEver := ABS(get.r_SystemCurrent);
END_IF
//overwrite to original structure
get.r_maxDischargeCurrentEver := r_maxDisChargeCurrentEver;
get.r_maxChargeCurrentEver := r_maxChargeCurrentEver;

//--- store max voltage to persistent var ---
IF get.r_SystemVoltage > 0 AND get.r_Systemvoltage > r_maxVoltageEver THEN
	r_maxVoltageEver := get.r_SystemVoltage;
END_IF
//overwrite to original structure
get.r_maxVoltageEver := r_maxVoltageEver;

r_trigResetCounters(CLK:= st_params.b_ResetPersistentVars);
IF r_trigResetCounters.Q THEN
	r_maxVoltageEver := 0;
	r_maxChargeCurrentEver := 0;
	r_maxDisChargeCurrentEver := 0;
END_IF


]]></ST>
      </Implementation>
    </Method>
    <Method Name="CalculatedRatings" Id="{06d54167-e03f-47a0-9c1f-ca4905f9230b}" FolderPath="Internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE CalculatedRatings : BOOL
VAR_INPUT
	numberofstrings : BYTE;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[get.BatteryInfo.r_ratedEnergyCapacity := st_params.r_kWhperString * numberofstrings;

IF get.BatteryInfo.r_ratedEnergyCapacity <> 0 THEN
	get.BatteryInfo.r_ratedCurrent := st_params.r_CrateBattery * st_params.r_AhperString * numberofstrings;
	get.BatteryInfo.r_ratedPower := st_params.r_CrateBattery * get.BatteryInfo.r_ratedEnergyCapacity;
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="CalculateSoCUser" Id="{e6795d0b-c944-48b9-a172-f83a0022c355}" FolderPath="Internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE CalculateSoCUser : BOOL
VAR_IN_OUT
	get : ST_BMS_get;
	set	: ST_BMS_Set;
END_VAR

VAR_IN_OUT CONSTANT
	st_params	: st_BMS_Params;
END_VAR

VAR_INST
	r_Soc							: REAL;
	fb_SOCLowLimit					: fbValueOutOfRange;
	fb_SOCHighLimit					: fbValueOutOfRange;
	r_SoCMinActual 					: REAL;
	r_SoCMaxActual					: REAL;
	r_deltaSoC						: REAL;
	r_ratio							: REAL;
	r_offset						: REAL;
	
	RS_chargingAllowed				: RS;
	RS_DischargingAllowed			: RS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Calculations
r_deltaSoC:= st_params.r_SoCAbsoluteMax - st_params.r_SoCAbsoluteMin;
r_ratio := 1 / SEL(r_deltaSoC=0,r_deltaSoC/100,1);
r_offset := st_params.r_SoCAbsoluteMin * r_Ratio;


//user soc setpoint, first limit user value with 100% and scale to original battery soc 
r_SoCMinActual := (LIMIT(0, set.r_SocMin, set.r_SocMax) + r_Offset) / r_ratio;
r_SoCMaxActual := sel(AutoSOCCalibrationRequired,(LIMIT(set.r_SocMin,set.r_SocMax,100) + r_Offset) / r_ratio, 100);

//Set limit with error when hard limits exceed absolute VDL limits
fb_SOCLowLimit(
	r_var		:= r_SocMinActual, 
	r_min		:= st_params.r_SoCAbsoluteMin, 
	r_max		:= st_params.r_SoCAbsoluteMax,
	r_WhenError := st_params.r_SoCAbsoluteMin,
	b_IsError	=> get.events.b_SoCLowLimitOutOfRange);

fb_SOCHighLimit(
	r_var		:= r_SocMaxActual, 
	r_min		:= st_params.r_SoCAbsoluteMin, 
	r_max		:= st_params.r_SoCAbsoluteMax,
	r_WhenError := st_params.r_SoCAbsoluteMin,
	b_IsError	=> get.events.b_SoCHighLimitOutOfRange);


//Set scaled soc to monitoring
get.BatteryInfo.r_SOCScaled := F_RoundReal(LIMIT(0, get.BatteryInfo.r_SOC * r_ratio - r_offset, 100),1); // set limit to avoid exceed 0 or 100%.

//set scaled kwh discharging remaining
get.BatteryInfo.r_RemainingDischargeEnergyNett := r_deltaSoC/ 100 * get.BatteryInfo.r_RemainingDischargeEnergy;
get.BatteryInfo.r_RemainingChargeEnergyNett := r_deltaSoC/ 100 * get.BatteryInfo.r_RemainingChargeEnergy;

r_Soc := get.BatteryInfo.r_SoC;
//Set Charge only when soft high limit reached
rs_dischargingAllowed(
	set:=r_SoC > (r_SoCMinActual + st_params.r_SocHysteresis),
	Reset1 := r_SoC <= r_SoCMinActual OR get.BatteryInfo.e_BMS_Status = eBMS_Status.FullDischarge,
	Q1 => get.BatteryInfo.b_dischargingAllowed);

//Set discharge only when soft high limit reached
rs_chargingAllowed(
	SET:= r_SoC < (r_SoCMaxActual - st_params.r_SocHysteresis),
	RESET1:= r_SoC >= r_SoCMaxActual OR get.BatteryInfo.e_BMS_Status = eBMS_Status.FullCharge,
	Q1=> get.BatteryInfo.b_chargingAllowed);




]]></ST>
      </Implementation>
    </Method>
    <Method Name="CalculateTimeRemaining" Id="{bfc8b221-1e23-4f03-a144-9954123c7e90}" FolderPath="Internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE CalculateTimeRemaining : BOOL
VAR_INPUT
END_VAR

VAR_OUTPUT
END_VAR

VAR_INST
	a_PowerArray			: ARRAY [1..20] OF REAL;
	st_Params_MA			: ST_CTRL_MOVING_AVERAGE_PARAMS;
	ui_filterSize			: UINT := 10;
	fb_SmoothPower			: FB_CTRL_MOVING_AVERAGE;
	r_PowerMA				: REAL;
	r_HoursRemaining		: REAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//SMOOTH SETPOINT VALUE SINCE VALUE IS SWITCHED RAPIDLY BETWEEN UPPER AND LOWER GRID LIMIT.
st_Params_MA.tCtrlCycleTime := T#100MS;
	st_Params_MA.tTaskCycleTime := T#1MS;
	st_Params_MA.nWorkArray_SIZEOF := SIZEOF(a_PowerArray);
	st_Params_MA.pWorkArray_ADR	:= ADR(a_PowerArray);
	st_Params_MA.nSamplesToFilter:= ui_filterSize;

fb_SmoothPower(fin:= get.BatteryInfo.r_SystemPower,
				eMode := E_CTRL_MODE.eCTRL_MODE_ACTIVE,
				fout=> r_PowerMA,
				stParams := st_Params_MA);
				
r_HoursRemaining := get.BatteryInfo.r_RemainingDischargeEnergyNett / MAX(1, r_PowerMA); 
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearBMSFaults" Id="{5968c632-fac0-42cc-b87f-bb587cf9f857}" FolderPath="Internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE ClearBMSFaults : BOOL
VAR_IN_OUT CONSTANT
	st_params			: ST_BMS_params;
END_VAR

VAR_INST
	WriteRegSet		:	FB_MBWriteSingleReg;
	WriteRegClear	:	FB_MBWriteSingleReg;
	
	bCommBusy	:	BOOL;
	bComError	:	BOOL;
	errID		:	UDINT;
	b_ClearDone	:	BOOL := FALSE;

	w_ClearFault	:	WORD;
	TX1Done 	: 	f_trig;
	
	bCommBusy2	:	BOOL;
	bComError2	:	BOOL;
	errID2		:	UDINT;
	TX2Done 	: 	f_trig;

	ComRetryCounter	:	USINT := 0;	
	
	ResetDelayTimer	: Tp := (PT:=T#500MS);
END_VAR	
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Catl says we need to write 1 to clear, then write back to 0 to be able to log new errors.
//This method is called continuously when bms is active. It will usually write zero's.
//If set.b_ClearFault is 1, that will be written. The value will be cleared by this method after the write so next write will be a 0 again.
//With this, a reset cycle takes half a second with the current ComTimer.

ClearBMSFaults := FALSE;

ComTimer(in := NOT(ComTimer.Q OR bCommBusy));

//first write clearing register to 1
WriteRegSet(
	sIPAddr := st_params.IP_BMS,
	nTCPPort := 502,
	nUnitID := 255,//16#FF;
	nMBAddr := 908,
	nValue := 1,
	tTimeOut := t_TimeOut,
	bExecute := ComTimer.Q,
	bBusy => bCommBusy,
	bError => bComError,
	nErrId => errID,
);

TX1Done(CLK := bCommBusy);
b_ClearDone	:= 	TX1Done.Q AND NOT bComError;
ResetDelayTimer(in:=b_ClearDone);
//reset value back to 0 afterwards. CATL requirement
WriteRegClear(
	sIPAddr := st_params.IP_BMS,
	nTCPPort := 502,
	nUnitID := 255,//16#FF;
	nMBAddr := 908,
	nValue := 0,
	tTimeout := T#100MS,
	bExecute := NOT ResetDelayTimer.Q,
	bBusy => bCommBusy2,
	bError => bComError2,
	nErrId => errID2
);

TX2Done(CLK := bCommBusy2);

IF (TX1Done.Q AND bComError) OR (TX2Done.Q AND bComError2) THEN
	ComRetryCounter := ComRetryCounter + 1;
	IF COMRetryCounter > 5 THEN
		b_MBComErrorActive := TRUE;
		ClearBMSFaults := TRUE;
	END_IF
END_IF

IF (TX1Done.Q AND NOT bComError) THEN
	arDatalogEMS[4] := 1;	
END_IF

IF TX2Done.Q AND NOT bComError2 THEN
	arDatalogEMS[4] := 0;	
	b_MBComErrorActive := FALSE;
	ComRetryCounter := 0;
	ClearBMSFaults := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="EMSTOP" Id="{2513f3ae-f229-4af9-b6f0-9384f5a93641}">
      <Declaration><![CDATA[METHOD EMSTOP : BOOL

]]></Declaration>
      <Implementation>
        <ST><![CDATA[EMSTOP := FALSE;

FBState := ePOUState.EMSTOP;

IF get.MBMU.BatteryStatus.e_BMS_PowerOnStatus <> ePowerOnStatus.On THEN
	EMSTOP := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetBatteryInfo" Id="{c680a140-f52e-4b81-b2e8-bc3403eb77b3}" FolderPath="Internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE GetBatteryInfo : BOOL

VAR_IN_OUT
	IN : ST_MBMU_BatterySummary;
	OUT: ST_BMS_BatterySummary;
END_VAR


VAR_INST
	ton_syncPulse : TON := (PT := T#100MS);
	t_SyncTimer	: TIME := T#100MS;
	tof_Release : TOF := (PT:= T#2S);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tof_Release(IN:= get.Events.b_COMMUNICATION_ERROR OR get.MBMU.BatteryStatus.r_SOC > 101);

//set batterysummery data if MBMU gives no shit.
IF ton_syncPulse.Q THEN
	IF NOT tof_Release.Q THEN
		//copy inherited data from original location.
 		MEMCPY(ADR(OUT), ADR(IN), SIZEOF(IN));
		//generate additional data
		CalculateSoCUser(get := get, set := set, st_params:=st_params);
		CalculatedRatings(numberOfStrings:= settings.Configuration.by_NoBatteryStrings);
		CalculateCumulativeValues(get := OUT, t_cycleTime := t_syncTimer);
	ELSE
		out.ar_CellTemperature[0] := -273;
		out.ar_CellTemperature[1] := -273;
		out.ar_CellTemperature[2] := -273;
	END_IF
END_IF
 

ton_syncPulse(IN := NOT ton_syncPulse.Q, PT := t_SyncTimer);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetCellData" Id="{398e55a4-76bb-42bf-b2b2-e5c29576043c}" FolderPath="Internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE GetCellData : BOOL
VAR_IN_OUT CONSTANT
	st_params			: ST_BMS_params;
END_VAR

VAR_INPUT
	SBMUID	:	BYTE;	//SBMU 1-#ofstrings
	CSCID	:	BYTE;	//CSC 1-4
END_VAR

VAR_OUTPUT
	CellVoltages		:	ARRAY[1..52] OF REAL;
	Celltemperatures	:	ARRAY[1..16] OF INT;
	BalanceStatus		:	ARRAY[1..4] OF WORD; //bit per cell?
END_VAR

VAR_INST
	MBReadCellVoltages	: 	FB_MBReadRegs;
	MBReadTemperatures	: 	FB_MBReadRegs;
	MBReadCellBalance	: 	FB_MBReadRegs;
	
//	CellVoltageData		: 	ARRAY[1..52] OF WORD;
	TemperatureData		: 	ARRAY[1..16] OF BYTE;
//	CellBalanceData		: 	ARRAY[1..4] OF WORD;
	
	bCommBusy			:	ARRAY[1..3] OF BOOL;
	bComError			:	ARRAY[1..3] OF BOOL;
	errID				:	ARRAY[1..3] OF UDINT;
	cbRead				:	ARRAY[1..3] OF UDINT;
	TransmissionDone	: 	ARRAY[1..3] OF f_trig;
	
	DataComplete		:	ARRAY[1..3] OF BOOL;
	
	//ComTimer			:	Ton := (PT := TIME#0S500MS);
END_VAR

VAR
	LoopCounter			:	INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
GetCellData := FALSE;

IF (SBMUID < 1) OR (SBMUID > get.MBMU.by_NumberOfSubSystems) THEN
	GetCellData := TRUE;
	RETURN;
END_IF
IF (CSCID < 1) OR (CSCID > 4) THEN
	GetCellData := TRUE;
	RETURN;
END_IF

ComTimer(in := NOT(ComTimer.Q OR bCommBusy[1] OR bCommBusy[2] OR bCommBusy[3]));

IF ComTimer.Q THEN
	DataComplete[1] := FALSE;
	DataComplete[2] := FALSE;
	DataComplete[3] := FALSE;
END_IF

MBReadCellVoltages(
sIPAddr := st_params.IP_BMS,
nTCPPort := 502,
nUnitID := 255,//16#FF;
nMBAddr := (SBMUID*1024)+128+(52*(CSCID-1)),	//SBMU 1, module 1, start at 0x0480, increment 52 per module & 1024 per sbmu
nQuantity := 52,
cbLength := SIZEOF(CellVoltages),
pDestAddr := ADR(CellVoltages),
bExecute := ComTimer.Q,
bBusy => bCommBusy[1],
bError => bComError[1],
nErrId => errID[1],
cbRead => cbRead[1],
tTimeOut := t_TimeOut,
);

MBReadTemperatures(
sIPAddr := st_params.IP_BMS,
nTCPPort := 502,
nUnitID := 1,//16#FF;
nMBAddr := (SBMUID*1024)+704+(8*(CSCID-1)),	//SBMU 1, module 1, start at 0x06c0, increment 8 (16 byte) per module & 1024 per sbmu
nQuantity := 8*2,
cbLength := SIZEOF(TemperatureData),
pDestAddr := ADR(TemperatureData),
bExecute := ComTimer.Q,
bBusy => bCommBusy[2],
bError => bComError[2],
nErrId => errID[2],
cbRead => cbRead[2],
tTimeOut := t_TimeOut,
);

MBReadTemperatures(
sIPAddr := st_params.IP_BMS,
nTCPPort := 502,
nUnitID := 1,//16#FF;
nMBAddr := (SBMUID*1024)+912+(4*(CSCID-1)),	//SBMU 1, module 1, start at 0x0790, increment 4 per module & 1024 per sbmu
											//not sure if CSC2 starts at address 4, or immediatly follows after last cell of csc1.
nQuantity := 4*2,
cbLength := SIZEOF(BalanceStatus),
pDestAddr := ADR(BalanceStatus),
bExecute := ComTimer.Q,
bBusy => bCommBusy[3],
bError => bComError[3],
nErrId => errID[3],
cbRead => cbRead[3],
tTimeOut := t_TimeOut,
);

TransmissionDone[1](clk:=bCommBusy[1]);
TransmissionDone[2](clk:=bCommBusy[2]);
TransmissionDone[3](clk:=bCommBusy[3]);

IF TransmissionDone[1].Q AND NOT bComError[1] THEN
	DataComplete[1] := TRUE;
END_IF

IF TransmissionDone[2].Q AND NOT bComError[2] THEN
	FOR loopcounter := 1 TO 16 BY 1 DO
		Celltemperatures[loopcounter] := TemperatureData[loopcounter]-50;
	END_FOR
	DataComplete[2] := TRUE;
END_IF

IF TransmissionDone[1].Q AND NOT bComError[1] THEN
	DataComplete[3] := TRUE;
END_IF

GetCellData := DataComplete[1] AND DataComplete[2] AND DataComplete[3];
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetDiagnostics" Id="{4946c134-241c-4c4f-a711-8dcfd2dcc4b2}">
      <Declaration><![CDATA[METHOD GetDiagnostics 
VAR_IN_OUT
	AddError		: ARRAY [*] OF FB_AddErrorST;
	a_ActiveEvents	: ARRAY [*] OF ST_ErrorStruct;
	w_Index			: WORD;
END_VAR


]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*BMS errors (sunspec)*)
	(*BMS Communication error*)		AddError[w_Index](
			b_ErrorTrig				:= get.Events.b_COMMUNICATION_ERROR,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 1,
			e_ObjectID				:= e_id,						//only first call set object ID.
			s_Message				:= 'communication error',
			e_sev					:= eSeverity.QuickShutdown,	//<-- maybe normal shutdown?
			b_AutoClear				:= FALSE,
			t_TriggerTime			:= TIME#10S,
			e_ErrAckAccess			:= eErrAckAccess.Operator
			);
		w_Index := w_Index +1;
		
	(*Configuration fault*)		AddError[w_Index](
			b_ErrorTrig				:= get.Events.b_CONFIGURATION_ALARM,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 2,
			s_Message				:= 'configuration error',
			e_sev					:= eSeverity.NormalShutdown,
			b_AutoClear				:= FALSE,
			e_ErrAckAccess			:= eErrAckAccess.VDL
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
	
	(*Configuration warning*)		AddError[w_Index](
			b_ErrorTrig				:= get.Events.b_CONFIGURATION_WARNING,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 3,
			s_Message				:= 'configuration error',
			e_sev					:= eSeverity.Warning,
			b_AutoClear				:= FALSE,
			e_ErrAckAccess			:= eErrAckAccess.Operator
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
	(*Contactor fault*)		AddError[w_Index](
			b_ErrorTrig				:= get.Events.b_CONTACTOR_ERROR,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 4,
			s_Message				:= 'contactor fault',
			e_sev					:= eSeverity.QuickShutdown,
			b_AutoClear				:= FALSE,
			e_ErrAckAccess			:= eErrAckAccess.Operator
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
	(*Current imbalance warning*)		AddError[w_Index](						//unused, will always be false
			b_ErrorTrig				:= get.Events.b_CURRENT_IMBALANCE_WARNING,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 5,
			s_Message				:= 'current imbalance warning',
			e_sev					:= eSeverity.Warning,
			b_AutoClear				:= FALSE,
			e_ErrAckAccess			:= eErrAckAccess.General
			//in_t_TriggerTime		:= TIME#500MS,
			);
		w_Index := w_Index +1;
		
	(*Fan error*)		AddError[w_Index](
			b_ErrorTrig				:= get.Events.b_FAN_ERROR,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 6,
			s_Message				:= 'fan error',
			e_sev					:= eSeverity.NormalShutdown,
			b_AutoClear				:= FALSE,
			//in_t_TriggerTime		:= TIME#500MS,
			e_ErrAckAccess			:= eErrackAccess.Operator
			);
		w_Index := w_Index +1;

	(*Ground fault*)		AddError[w_Index](
			b_ErrorTrig			:= get.Events.b_GROUND_FAULT,		//unused, will always be false
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 7,
			s_Message				:= 'insulation fault',
			e_sev					:= eSeverity.Quickshutdown,
			b_AutoClear				:= FALSE,
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;

	(*Door open error*)		AddError[w_Index](							//unused, will always be false
			b_ErrorTrig			:= get.Events.b_OPEN_DOOR_ERROR,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 8,
			s_Message				:= 'door open',
			e_sev					:= eSeverity.NormalShutdown,
			b_AutoClear				:= TRUE,
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;

	(*misc alarm*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_OTHER_ALARM,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 9,
			s_Message				:= 'miscellaneous error',
			e_sev					:= eSeverity.NormalShutdown,
			b_AutoClear				:= FALSE,
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
	(*misc warning*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_OTHER_WARNING,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 10,
			s_Message				:= 'miscellaneous warning',
			e_sev					:= eSeverity.Warning,
			b_AutoClear				:= TRUE,
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;

	(*Overcharge current alarm*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_OVER_CHARGE_CURRENT_ALARM,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 11,
			s_Message				:= 'charge current too high error',
			e_sev					:= eSeverity.NormalShutdown,			
			b_AutoClear				:= FALSE,									
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
	(*Overcharge current warning*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_OVER_CHARGE_CURRENT_WARNING,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 12,
			s_Message				:= 'charge current high warning',
			e_sev					:= eSeverity.Warning,				//<-- Powerstack should lower the power
			b_AutoClear				:= TRUE,								
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
	(*OverDischarge current Alarm*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_OVER_DISCHARGE_CURRENT_ALARM,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 13,
			s_Message				:= 'discharge current too high error',
			e_sev					:= eSeverity.NormalShutdown,				
			b_AutoClear				:= FALSE,								
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);

		w_Index := w_Index +1;
		
	(*OverDischarge current warning*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_OVER_DISCHARGE_CURRENT_WARNING,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 14,
			s_Message				:= 'discharge current high warning',
			e_sev					:= eSeverity.Warning,				//<-- Powerstack should lower the power
			b_AutoClear				:= TRUE,								
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
	(*Overcharge r_SOC error*)		AddError[w_Index](							//unused, will remain false
			b_ErrorTrig			:= get.Events.b_OVER_SOC_MAX_ALARM AND NOT st_params.b_DisableSOCAlarm,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 15,
			s_Message				:= 'SOC too high error',
			e_sev					:= eSeverity.NormalShutdown,				
			b_AutoClear			:= FALSE,								
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
	(*Overcharge r_SOC error*)		AddError[w_Index](							//unused, will remain false
			b_ErrorTrig			:= get.Events.b_OVER_SOC_MAX_WARNING,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 16,
			s_Message				:= 'SOC high warning',
			e_sev					:= eSeverity.Warning,				
			b_AutoClear				:= TRUE,								
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
	(*OverDischarge r_SOC error*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_UNDER_SOC_MIN_ALARM AND NOT st_params.b_DisableSOCAlarm,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 17,
			s_Message				:= 'SOC too low error',
			e_sev					:= eSeverity.NormalShutdown,				
			b_AutoClear			:= FALSE,								
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
	(*OverDischarge r_SOC error*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_UNDER_SOC_MIN_WARNING,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 18,
			s_Message				:= 'SOC low warning',
			e_sev					:= eSeverity.Warning,				
			b_AutoClear				:= TRUE,								
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
	(*OverTemperature error*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_OVER_TEMP_ALARM,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 19,
			s_Message				:= 'overtemperature alarm',
			e_sev					:= eSeverity.NormalShutdown,				
			b_AutoClear			:= FALSE,
			b_SMSEnableVDL		:= TRUE,								
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;		

	(*OverTemperature warning*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_OVER_TEMP_WARNING,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 20,
			s_Message				:= 'overtemperature warning',
			e_sev					:= eSeverity.Warning,				
			b_AutoClear			:= FALSE,								
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
	
	(*OverVoltage error*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_OVER_VOLT_ALARM,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 21,
			s_Message				:= 'overvoltage error',
			e_sev					:= eSeverity.NormalShutdown,
			b_SMSEnableVDL		:= TRUE,				
			b_AutoClear			:= FALSE,								
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;		

	(*OverVoltage warning*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_OVER_VOLT_WARNING,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 22,
			s_Message				:= 'overvoltage warning',
			e_sev					:= eSeverity.Warning,				
			b_AutoClear			:= FALSE,								
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
	(*Temperature imbalance error*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_TEMPERATURE_IMBALANCE_ALARM,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 23,
			s_Message				:= 'temperature imbalance error',
			e_sev					:= eSeverity.NormalShutdown,				
			b_AutoClear			:= FALSE,								
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;		

	(*Temperature imbalance warning*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_TEMPERATURE_IMBALANCE_WARNING,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 24,
			s_Message				:= 'temperature imbalance warning',
			e_sev					:= eSeverity.Warning,				
			b_AutoClear			:= FALSE,								
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;

	(*Under Temperature error*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_UNDER_TEMP_ALARM,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 25,
			s_Message				:= 'temperature low error',
			e_sev					:= eSeverity.NormalShutdown,				
			b_AutoClear			:= FALSE,								
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;		

	(*Under Temperature warning*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_UNDER_TEMP_WARNING,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 26,
			s_Message				:= 'temperature low warning',
			e_sev					:= eSeverity.Warning,				
			b_AutoClear			:= TRUE,								
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;

	(*Under Temperature error*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_UNDER_VOLT_ALARM,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 27,
			s_Message				:= 'undervoltage error',
			e_sev					:= eSeverity.NormalShutdown,				
			b_AutoClear			:= FALSE,								
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;		

	(*Under Temperature warning*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_UNDER_VOLT_WARNING,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 28,
			s_Message				:= 'undervoltage warning',
			e_sev					:= eSeverity.Warning,				
			b_AutoClear			:= FALSE,								
			//in_t_TriggerTime		:= TIME#500MS,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
	(*Battery voltage imbalance warning*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_VOLTAGE_IMBALANCE_WARNING,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 29,
			s_Message				:= 'voltage imbalance warning',
			e_sev					:= eSeverity.Warning,				
			b_AutoClear			:= FALSE,								
			//in_t_TriggerTime		:= TIME#500MS,
			);
		w_Index := w_Index +1;	
		
		(*Battery voltage imbalance warning*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_SocHighLimitOutOfRange,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 30,
			s_Message				:= 'SOC upper limit out of range',
			e_sev					:= eSeverity.info,				
			b_AutoClear			:= TRUE,								
			);
		w_Index := w_Index +1;	
		
				(*Battery voltage imbalance warning*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_SocLowLimitOutOfRange,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 31,
			s_Message				:= 'SOC lower limit out of range',
			e_sev					:= eSeverity.info,				
			b_AutoClear			:= TRUE,								
			);
		w_Index := w_Index +1;	
	
(*Battery PRECHARGE FAULT*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_POWERONFAULT,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 32,
			s_Message				:= 'precharge fault',
			e_sev					:= eSeverity.warning,				
			b_AutoClear			:= TRUE,								
			);
		w_Index := w_Index +1;	
		
(*Battery power off fault*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_POWEROFFFAULT,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 33,
			s_Message				:= 'poweroff fault',
			e_sev					:= eSeverity.Quickshutdown,				
			b_AutoClear			:= FALSE,								
			);
		w_Index := w_Index +1;	
		
(*Disconnector Off*)		AddError[w_Index](							
			b_ErrorTrig			:= get.Events.b_DISCONNECTOR_OFF,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 35,
			s_Message				:= 'HV disconnector(s) off position',
			e_sev					:= eSeverity.Normalshutdown,				
			b_AutoClear			:= FALSE,								
			);
		w_Index := w_Index +1;
		
(*SBMU1 com failed*)		AddError[w_Index](							
			b_ErrorTrig				:= get.Events.b_SBMUCommError[0],
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 36,
			s_Message				:= 'SBMU 1 Com Warning',
			e_sev					:= eSeverity.Warning,				
			b_AutoClear				:= TRUE,
			t_TriggerTime			:= TIME#5S,								
			);
		w_Index := w_Index +1;

(*SBMU2 com failed*)		AddError[w_Index](							
			b_ErrorTrig				:= get.Events.b_SBMUCommError[1],
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 37,
			s_Message				:= 'SBMU 2 Com Warning',
			e_sev					:= eSeverity.Warning,				
			b_AutoClear				:= TRUE,
			t_TriggerTime			:= TIME#5S,								
			);
		w_Index := w_Index +1;

(*SBMU3 com failed*)		AddError[w_Index](							
			b_ErrorTrig				:= get.Events.b_SBMUCommError[2],
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 38,
			s_Message				:= 'SBMU 3 Com Warning',
			e_sev					:= eSeverity.Warning,				
			b_AutoClear				:= TRUE,
			t_TriggerTime			:= TIME#5S,								
			);
		w_Index := w_Index +1;

(*SBMU4 com failed*)		AddError[w_Index](							
			b_ErrorTrig				:= get.Events.b_SBMUCommError[3],
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 39,
			s_Message				:= 'SBMU 4 Com Warning',
			e_sev					:= eSeverity.Warning,				
			b_AutoClear				:= TRUE,
			t_TriggerTime			:= TIME#5S,								
			);
		w_Index := w_Index +1;
		
(*SBMU1 failed to connect HV*)		AddError[w_Index](							
			b_ErrorTrig				:= get.Events.b_SBMUFailedToConnect[0],
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 40,
			s_Message				:= 'SBMU 1 failed to connect to DC bus',
			e_sev					:= eSeverity.Warning,				
			b_AutoClear				:= TRUE,
			t_TriggerTime			:= TIME#5S,								
			);
		w_Index := w_Index +1;

(*SBMU2 com failed*)		AddError[w_Index](							
			b_ErrorTrig				:= get.Events.b_SBMUFailedToConnect[1],
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 41,
			s_Message				:= 'SBMU 2 failed to connect to DC bus',
			e_sev					:= eSeverity.Warning,				
			b_AutoClear				:= TRUE,
			t_TriggerTime			:= TIME#5S,								
			);
		w_Index := w_Index +1;

(*SBMU3 com failed*)		AddError[w_Index](							
			b_ErrorTrig				:= get.Events.b_SBMUFailedToConnect[2],
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 42,
			s_Message				:= 'SBMU 3 failed to connect to DC bus',
			e_sev					:= eSeverity.Warning,				
			b_AutoClear				:= TRUE,
			t_TriggerTime			:= TIME#5S,								
			);
		w_Index := w_Index +1;

(*SBMU4 com failed*)		AddError[w_Index](							
			b_ErrorTrig				:= get.Events.b_SBMUFailedToConnect[3],
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 43,
			s_Message				:= 'SBMU 4 failed to connect to DC bus',
			e_sev					:= eSeverity.Warning,				
			b_AutoClear				:= TRUE,
			t_TriggerTime			:= TIME#5S,								
			);
		w_Index := w_Index +1;
		
		
(*SOC too low for conditioning*)		AddError[w_Index](							
			b_ErrorTrig				:= NOT b_InternalHVDCAllowed,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 44,
			s_Message				:= 'SOC low warning. Internal Conditioning disabled',
			e_sev					:= eSeverity.Warning,				
			b_AutoClear				:= TRUE,
			t_TriggerTime			:= TIME#5S,								
			);
		w_Index := w_Index +1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetMBMUData" Id="{2865fbe8-2bb0-4c3f-9529-febe10dc8e41}" FolderPath="Internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE GetMBMUData : BOOL
VAR_IN_OUT CONSTANT
	st_params			: ST_BMS_params;
END_VAR


VAR_INST
	
	MBReadMBMU			: 	FB_MBReadRegs;
	MBMUData 			: 	ARRAY[0..52] OF WORD;
	bCommBusy			:	BOOL;
	bComError			:	BOOL;
	errID				:	UDINT;
	cbRead				:	UDINT;
	TransmissionDone	: 	f_trig;
	COMretryCounter		:	USINT := 0;
	//ComTimer			:	Ton := (PT := TIME#100MS);
END_VAR

VAR
	Counter				:	INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//read mbmu data every 100ms

GetMBMUData := FALSE;

ComTimer(in := NOT(ComTimer.Q OR bCommBusy));

MBReadMBMU(
sIPAddr := st_params.IP_BMS,
nTCPPort := 502,
nUnitID := 255,//16#FF;
nMBAddr := 0,
nQuantity := 53,
cbLength := SIZEOF(MBMUData),
pDestAddr := ADR(MBMUData),
bExecute := ComTimer.Q,
bBusy => bCommBusy,
bError => bComError,
nErrId => errID,
cbRead => cbRead,
tTimeout := t_TimeOut,
);

TransmissionDone(CLK := bCommBusy);

IF TransmissionDone.Q THEN
	IF NOT bComError THEN
		MEMCPY(ADR(get.MBMU.GeneralSBMUStatus[0]), ADR(MBMUData[0]), 32);	//0x0000 - 0x000f
		MEMCPY(ADR(get.MBMU.MBMUStatus[0]), ADR(MBMUData[16]), 32);			//0x0010 - 0x001f
	
		get.MBMU.BatteryStatus.r_SystemVoltage := WORD_TO_REAL(MBMUData[32])/10; 						//0-1500V with 0.1V/bit
		get.MBMU.BatteryStatus.r_SystemCurrent := WORD_TO_REAL(MBMUData[33])-20000; 					//-20k .. +20k kW in 1kW/bit steps
		
		get.MBMU.BatteryStatus.r_SOC := WORD_TO_REAL(MBMUData[34])/10; 								//0-100% with 0.1%/bit;
		get.MBMU.BatteryStatus.r_SOH := WORD_TO_REAL(MBMUData[35])/10; 								//0-100% with 0.1%/bit;
		
		get.MBMU.BatteryStatus.ar_CellVoltage[eSubValues.Maximum] := WORD_TO_REAL(MBMUData[36])/1000;	//0-5v with 0.001v/bit;
		get.MBMU.BatteryStatus.ar_CellVoltage[eSubValues.Minimum] := WORD_TO_REAL(MBMUData[37])/1000;	//0-5v with 0.001v/bit;
		get.MBMU.BatteryStatus.ar_CellVoltage[eSubValues.Average] := WORD_TO_REAL(MBMUData[38])/1000;	//0-5v with 0.001v/bit;
		
		get.MBMU.BatteryStatus.ar_CellTemperature[eSubValues.Maximum] := WORD_TO_REAL(MBMUData[39])-50;	//-50..200gr with 1gr/bit;
		get.MBMU.BatteryStatus.ar_CellTemperature[eSubValues.Minimum] := WORD_TO_REAL(MBMUData[40])-50;	//-50..200gr with 1gr/bit;
		get.MBMU.BatteryStatus.ar_CellTemperature[eSubValues.Average] := WORD_TO_REAL(MBMUData[41])-50;	//-50..200gr with 1gr/bit;
		
		get.MBMU.BatteryStatus.r_MaxChargeCurrentAllowed := WORD_TO_REAL(MBMUData[42])-20000;			//-20k .. +20k A in 1A/bit steps
		get.MBMU.BatteryStatus.r_MaxDischargeCurrentAllowed := WORD_TO_REAL(MBMUData[43])-20000;			//-20k .. +20k A in 1A/bit steps
		
		get.MBMU.BatteryStatus.r_MaxChargePowerAllowed := WORD_TO_REAL(MBMUData[44])-20000;				//-20k .. +20k kW in 1kW/bit steps
		get.MBMU.BatteryStatus.r_MaxDischargePowerAllowed := WORD_TO_REAL(MBMUData[45])-20000;			//-20k .. +20k kW in 1kW/bit steps
		
		get.MBMU.BatteryStatus.r_SystemPower	:= 	WORD_TO_REAL(MBMUData[46])-20000;						//-20k .. +20k kW in 1kW/bit steps
		get.MBMU.BatteryStatus.r_ChargeSOE	:=	WORD_TO_REAL(MBMUData[47])/10;
		get.MBMU.BatteryStatus.r_DischargeSOE	:=	WORD_TO_REAL(MBMUData[48])/10;
		
		get.MBMU.BatteryStatus.r_RemainingChargeEnergy	:=	WORD_TO_REAL(MBMUData[49]) *2;
		get.MBMU.BatteryStatus.r_RemainingDischargeEnergy	:=	WORD_TO_REAL(MBMUData[50]) *2;
		
		get.MBMU.BatteryStatus.r_MaxSystemVoltageAllowed := WORD_TO_REAL(MBMUData[51])/10; 			//0-1500V with 0.1V/bit
		get.MBMU.BatteryStatus.r_MinSystemVoltageAllowed := WORD_TO_REAL(MBMUData[52])/10; 			//0-1500V with 0.1V/bit
			
		memcpy(ADR(arDatalogMBMU), ADR(MBMUData), 92);	//0-46
		
		GetMBMUData := TRUE;
		COMretryCounter := 0;
		b_MBComErrorActive := FALSE;
	ELSE
		COMretryCounter := COMretryCounter +1;
		IF COMRetryCounter > 5 THEN
			b_MBComErrorActive := TRUE;
		END_IF
	END_IF
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetMBMUStaticSystemData" Id="{a3301c10-905c-443a-9591-87c331836d2e}" FolderPath="Internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE GetMBMUStaticSystemData : BOOL
VAR_IN_OUT CONSTANT
	st_params			: ST_BMS_params;
END_VAR

VAR_INST
	MBReadBMS			: 	FB_MBReadRegs;
	DataBuffer 			: 	ARRAY[0..31] OF WORD;
	
	bCommBusy			:	BOOL;
	bComError			:	BOOL;
	errID				:	UDINT;
	cbRead				:	UDINT;
	
	TransmissionDone 	: 	f_trig;
	COMretryCounter		:	USINT := 0;
	//ComTimer			:	Ton := (PT := TIME#200ms);
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[
//Read ETH+MBMU SW/HW version at init.
GetMBMUStaticSystemData := FALSE;

ComTimer(in := NOT(ComTimer.Q));

MBReadBMS(
sIPAddr := st_params.IP_BMS,
nTCPPort := 502,
nUnitID := 255,//16#FF;
nMBAddr := 256,
nQuantity := 32,
cbLength := SIZEOF(DataBuffer),
pDestAddr := ADR(DataBuffer),
bExecute := ComTimer.Q,
tTimeout := t_TimeOut,
bBusy => bCommBusy,
bError => bComError,
nErrId => errID,
cbRead => cbRead
);

TransmissionDone(CLK := bCommBusy);

IF TransmissionDone.Q THEN
	IF NOT bComError THEN
		memcpy(destAddr := ADR(get.MBMU.s_MBMU_SWVer), SrcAddr := ADR(DataBuffer[0]), n := 16);
		memcpy(destAddr  := ADR(get.MBMU.s_MBMU_HWVer), SrcAddr := ADR(DataBuffer[8]), n := 16);
		memcpy(destAddr  := ADR(get.MBMU.s_ETH_SWVer), SrcAddr := ADR(DataBuffer[16]), n := 16);
		memcpy(destAddr  := ADR(get.MBMU.r_ETH_HWVer), SrcAddr :=ADR( DataBuffer[24]), n := 16);
		GetMBMUStaticSystemData := TRUE;
		COMretryCounter := 0;
		b_MBComErrorActive := FALSE;
	ELSE
		COMretryCounter := COMretryCounter +1;
		IF COMRetryCounter > 5 THEN
			b_MBComErrorActive := TRUE;
		END_IF
	END_IF
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetSBMUData" Id="{87c82cc2-9d5a-42d1-9f20-3277e4813f1b}" FolderPath="Internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE GetSBMUData : BOOL
VAR_IN_OUT CONSTANT
	st_params			: ST_BMS_params;
END_VAR

VAR_INST
	MBReadSBMU		: 	FB_MBReadRegs;
	DataBuffer		:	ARRAY[0..91] OF WORD;
	bCommBusy		:	BOOL;
	bComError		:	BOOL;
	errID			:	UDINT;
	cbRead			:	UDINT;
	CommDone		: 	f_trig;
	tempSBMUStatus	:	WORD;
	SBMUCounter		: 	USINT	:=	0;
	//ComTimer			:	Ton := (PT := TIME#100MS);
END_VAR

VAR
	b_MainRelayClosed 		: 	BOOL;
	b_PrechargeRelayClosed	:	BOOL;
	ui_SBMUCounter			:	uint;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetSBMUData := FALSE;

ComTimer(in := NOT(ComTimer.Q OR bCommbusy));

MBReadSBMU(
	sIPAddr := st_params.IP_BMS,
	nTCPPort := 502,
	nUnitID := 255,//16#FF;
	nMBAddr := 1024*(SBMUcounter+1),
	nQuantity := 91,
	cbLength := SIZEOF(DataBuffer),
	pDestAddr := ADR(DataBuffer),
	bExecute := ComTimer.Q,
	tTimeout := t_TimeOut,
	bBusy => bCommBusy,
	bError => bComError,
	nErrId => errID,
	cbRead => cbRead
);
	
CommDone(CLK := bCommBusy);
	
IF CommDone.Q THEN
	IF NOT bComError THEN
		get.SBMU[SBMUcounter].w_SystemWarning := DataBuffer[0];
		get.SBMU[SBMUcounter].SystemAlarm[0] := DataBuffer[1];
		get.SBMU[SBMUcounter].SystemAlarm[1] := DataBuffer[2];
		get.SBMU[SBMUcounter].SystemAlarm[2] := DataBuffer[3];
		
		get.SBMU[SBMUcounter].b_PrechargeRelayClosed 	:= WORD_TO_BOOL(DataBuffer[16]);
		get.SBMU[SBMUcounter].b_MainPosRelayClosed	 	:= WORD_TO_BOOL(DataBuffer[17]);
		get.SBMU[SBMUcounter].b_MainNegRelayClosed		:= WORD_TO_BOOL(DataBuffer[18]);
		get.SBMU[SBMUcounter].b_ControlBoxFanOn 			:= WORD_TO_BOOL(DataBuffer[19]);
		get.SBMU[SBMUcounter].b_BalanceStatus 			:= WORD_TO_BOOL(DataBuffer[20]);
		
		get.SBMU[SBMUcounter].BatteryStatus.r_SystemVoltage := WORD_TO_REAL(DataBuffer[32])/10;	//0-1500V with 0.1V/bit
		get.SBMU[SBMUcounter].BatteryStatus.r_SystemCurrent := (WORD_TO_REAL(DataBuffer[34])/10)-2000; 	//-2k .. +2k A in 0.1A/bit steps
		
		get.SBMU[SBMUcounter].BatteryStatus.r_SOC := WORD_TO_REAL(DataBuffer[35])/10; 			//0-100% with 0.1%/bit;
		get.SBMU[SBMUcounter].BatteryStatus.r_SOH := WORD_TO_REAL(DataBuffer[36])/10;				//0-100% with 0.1%/bit;
		
		get.SBMU[SBMUcounter].BatteryStatus.ar_CellVoltage[eSubValues.Maximum] := WORD_TO_REAL(DataBuffer[37])/1000;	//0-5v with 0.001v/bit;
		get.SBMU[SBMUcounter].BatteryStatus.ar_CellVoltage[eSubValues.Minimum] := WORD_TO_REAL(DataBuffer[38])/1000;	//0-5v with 0.001v/bit;
		get.SBMU[SBMUcounter].BatteryStatus.ar_CellVoltage[eSubValues.Average] := WORD_TO_REAL(DataBuffer[39])/1000;	//0-5v with 0.001v/bit;
		
		get.SBMU[SBMUcounter].BatteryStatus.ar_CellTemperature[eSubValues.Maximum] := WORD_TO_REAL(DataBuffer[40])-50;	//-50..200gr with 1gr/bit;
		get.SBMU[SBMUcounter].BatteryStatus.ar_CellTemperature[eSubValues.Minimum] := WORD_TO_REAL(DataBuffer[41])-50;	//-50..200gr with 1gr/bit;
		get.SBMU[SBMUcounter].BatteryStatus.ar_CellTemperature[eSubValues.Average] := WORD_TO_REAL(DataBuffer[42])-50;	//-50..200gr with 1gr/bit;
		
		get.SBMU[SBMUcounter].BatteryStatus.r_MaxChargeCurrentAllowed := 		(WORD_TO_REAL(DataBuffer[43])/10)-2000;	//-2k .. +2k A in 0.1A/bit steps
		get.SBMU[SBMUcounter].BatteryStatus.r_MaxDischargeCurrentAllowed := 		(WORD_TO_REAL(DataBuffer[44])/10)-2000;	//-2k .. +2k A in 0.1A/bit steps
		
		get.SBMU[SBMUcounter].BatteryStatus.w_MaxVoltageCellLocation := DataBuffer[48];
		get.SBMU[SBMUcounter].BatteryStatus.w_MinVoltageCellLocation := DataBuffer[49];
		
		get.SBMU[SBMUcounter].BatteryStatus.w_MaxTempCellLocation := DataBuffer[50];
		get.SBMU[SBMUcounter].BatteryStatus.w_MinTempCellLocation := DataBuffer[51];
	
		
		//Collect dataset for CATL datalog
		memcpy(ADR(arDatalogSBMU[SBMUcounter][0]), ADR(DataBuffer[0]), 32); 	//0-15
		tempSBMUStatus.0		:= WORD_TO_BOOL(DataBuffer[16]);
		tempSBMUStatus.1	 	:= WORD_TO_BOOL(DataBuffer[17]);
		tempSBMUStatus.2		:= WORD_TO_BOOL(DataBuffer[18]);
		tempSBMUStatus.3 		:= WORD_TO_BOOL(DataBuffer[19]);
		tempSBMUStatus.4 		:= WORD_TO_BOOL(DataBuffer[20]); 
		tempSBMUStatus.5 		:= WORD_TO_BOOL(DataBuffer[21]);
		arDatalogSBMU[SBMUcounter][16] := tempSBMUStatus;						//16
		memcpy(ADR(arDatalogSBMU[SBMUcounter][17]), ADR(DataBuffer[32]), 44);	//17-38
		arDatalogSBMU[SBMUcounter][39] := DataBuffer[56];						//39
		arDatalogSBMU[SBMUcounter][40] := DataBuffer[57];						//40
		arDatalogSBMU[SBMUcounter][41] := DataBuffer[58];						//41
		arDatalogSBMU[SBMUcounter][42] := DataBuffer[59];						//42
		memcpy(ADR(arDatalogSBMU[SBMUcounter][43]), ADR(DataBuffer[54]), 16);	//43

	(* GIVES RUNTIME EXCEPTION !!! NaN value coming from bms making a runtime exception*)
		//MEMCPY(ADR(get.SBMU[SBMUcounter].BatteryStatus.r_HistAccChargeEnergy), ADR(DataBuffer[85]), 2);  // low word
		//MEMCPY(ADR(get.SBMU[SBMUcounter].BatteryStatus.r_HistAccChargeEnergy)+2, ADR(DataBuffer[84]), 2);  // high word
		//get.SBMU[SBMUcounter].BatteryStatus.r_HistAccChargeEnergy := get.SBMU[SBMUcounter].BatteryStatus.r_HistAccChargeEnergy/10; //0-449GHW with 0.1kWh/bit
		
		//MEMCPY(ADR(get.SBMU[SBMUcounter].BatteryStatus.r_HistAccDischargeEnergy), ADR(DataBuffer[87]), 2);  // low word
		//MEMCPY(ADR(get.SBMU[SBMUcounter].BatteryStatus.r_HistAccDischargeEnergy)+2, ADR(DataBuffer[86]), 2);  // high word
		//get.SBMU[SBMUcounter].BatteryStatus.r_HistAccDischargeEnergy := get.SBMU[SBMUcounter].BatteryStatus.r_HistAccDischargeEnergy/10; //0-449GHW with 0.1kWh/bit
	
		
		get.events.b_SBMUCommError[SBMUCounter] := FALSE;
		
		SBMUCounter := SBMUCounter +1;
		
		IF SBMUCounter >= by_NoOfStrings THEN//BMSGet.MBMU_Status.by_NumberOfSubSystems THEN
			GetSBMUData := TRUE;
			SBMUCounter := 0;
		END_IF
		
		IF 		(get.SBMU[0].b_MainPosRelayClosed AND get.SBMU[0].b_MainNegRelayClosed) OR 
				(get.SBMU[1].b_MainPosRelayClosed AND get.SBMU[1].b_MainNegRelayClosed) OR
				(get.SBMU[2].b_MainPosRelayClosed AND get.SBMU[2].b_MainNegRelayClosed) OR
				(get.SBMU[3].b_MainPosRelayClosed AND get.SBMU[3].b_MainNegRelayClosed) THEN
			PowerStatus := eHVDC_PowerStatus.On;
		ELSIF 	get.SBMU[0].b_PrechargeRelayClosed OR 
				(get.SBMU[1].b_PrechargeRelayClosed AND (by_NoOfStrings > 1)) OR 
				(get.SBMU[2].b_PrechargeRelayClosed AND (by_NoOfStrings > 2))  OR 
				(get.SBMU[3].b_PrechargeRelayClosed AND (by_NoOfStrings > 3)) THEN
			PowerStatus := eHVDC_PowerStatus.Precharging;
		ELSE
			PowerStatus := eHVDC_PowerStatus.Off;
		END_IF	
		
		get.events.b_SBMUFailedToConnect[0] := PowerStatus = eHVDC_PowerStatus.On AND NOT (get.SBMU[0].b_MainPosRelayClosed AND get.SBMU[0].b_MainNegRelayClosed);
		get.events.b_SBMUFailedToConnect[1] := PowerStatus = eHVDC_PowerStatus.On AND (NOT (get.SBMU[1].b_MainPosRelayClosed AND get.SBMU[1].b_MainNegRelayClosed)) AND by_NoOfStrings > 1;
		get.events.b_SBMUFailedToConnect[2] := PowerStatus = eHVDC_PowerStatus.On AND (NOT (get.SBMU[2].b_MainPosRelayClosed AND get.SBMU[2].b_MainNegRelayClosed)) AND by_NoOfStrings > 2;
		get.events.b_SBMUFailedToConnect[3] := PowerStatus = eHVDC_PowerStatus.On AND (NOT (get.SBMU[3].b_MainPosRelayClosed AND get.SBMU[3].b_MainNegRelayClosed)) AND by_NoOfStrings > 3;
		
	ELSE
		get.events.b_SBMUCommError[SBMUCounter] := TRUE;
		SBMUCounter := SBMUCounter +1;
	END_IF
END_IF



]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetSBMUStaticSystemData" Id="{83657047-15fc-4e44-a2cb-fc7cbd873b56}" FolderPath="Internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE GetSBMUStaticSystemData : BOOL
VAR_IN_OUT CONSTANT
	st_params			: ST_BMS_params;
END_VAR


VAR_INPUT
	SBMU_ID				:	uint;	
END_VAR

VAR_INST
	MBReadBMS			: 	FB_MBReadRegs;
	DataBuffer 			: 	ARRAY[0..31] OF WORD;
	
	bCommBusy			:	BOOL;
	bComError			:	BOOL;
	errID				:	UDINT;
	cbRead				:	UDINT;
	
	TransmissionDone 	: 	f_trig;
	ComretryCounter		:	USINT := 0;
	
	//ComTimer			:	Ton := (PT := TIME#0S200MS);
END_VAR


VAR
	SBMU: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Read ETH+MBMU SW/HW version at init.
GetSBMUStaticSystemData := FALSE;

IF (SBMU_ID<1) OR (SBMU>4)then //BMSGET.MBMU_Status.by_NumberOfSubSystems) THEN
	GetSBMUStaticSystemData := TRUE;
	RETURN;
END_IF

ComTimer(in := NOT(ComTimer.Q OR bCommbusy));

MBReadBMS(
sIPAddr := st_params.IP_BMS,
nTCPPort := 502,
nUnitID := 255,//16#FF;
nMBAddr := 960 + (SBMU_ID*1024),
nQuantity := 32,
cbLength := SIZEOF(DataBuffer),
pDestAddr := ADR(DataBuffer),
bExecute := ComTimer.Q,
tTimeout := t_TimeOut,
bBusy => bCommBusy,
bError => bComError,
nErrId => errID,
cbRead => cbRead
);

TransmissionDone(CLK := bCommBusy);

IF TransmissionDone.Q THEN
	IF NOT bComError THEN
	//werkt niet. Bij de MBMU gek genoeg wel
	//	memcpy(destAddr := ADR(BMSGet.SBMU[SBMU_ID].s_SBMU_SWVer), SrcAddr := ADR(DataBuffer[0]), n := 16);
	//	memcpy(destAddr  := ADR(BMSGet.SBMU[SBMU_ID].s_SBMU_HWVer), SrcAddr := ADR(DataBuffer[8]), n := 16);
	//	memcpy(destAddr  := ADR(BMSGet.SBMU[SBMU_ID].s_CSC_SWVer), SrcAddr := ADR(DataBuffer[16]), n := 16);
	//	memcpy(destAddr  := ADR(BMSGet.SBMU[SBMU_ID].s_CSC_HWVer), SrcAddr := ADR(DataBuffer[24]), n := 16);
		GetSBMUStaticSystemData := TRUE;
		get.events.b_SBMUCommError[SBMU_ID] := FALSE;
	ELSE
		get.events.b_SBMUCommError[SBMU_ID] := TRUE;
	END_IF
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetSystemStatus" Id="{3238feeb-548c-429e-ba4f-29bd654b5254}" FolderPath="Internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE GetSystemStatus : BOOL
VAR_IN_OUT CONSTANT
	st_params			: ST_BMS_params;
END_VAR

VAR_INST
	MBReadBMS			: 	FB_MBReadRegs;
	DataBuffer 			: 	ARRAY[0..5] OF WORD;
	
	bCommBusy			:	BOOL;
	bComError			:	BOOL;
	errID				:	UDINT;
	cbRead				:	UDINT;
	
	TransmissionDone 	: 	f_trig;
	
	//ComTimer			:	Ton := (PT := TIME#0S200MS);
	
	ComretryCounter	:	USINT := 0;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
//Read general BMS status
GetSystemStatus := FALSE;

ComTimer(in := NOT (ComTimer.Q OR bCommBusy));

MBReadBMS(
sIPAddr := st_params.IP_BMS,
nTCPPort := 502,
nUnitID := 255,//16#FF;
nMBAddr := 769,
nQuantity := 6,
cbLength := SIZEOF(DataBuffer),
pDestAddr := ADR(DataBuffer),
bExecute := ComTimer.Q,
bBusy => bCommBusy,
bError => bComError,
nErrId => errID,
cbRead => cbRead,
tTimeout := t_TimeOut,
);

TransmissionDone(CLK := bCommBusy);

IF TransmissionDone.Q THEN
	IF NOT bComError THEN
		CASE DataBuffer[0] OF
			0: get.MBMU.BatteryStatus.e_BMS_PowerOnStatus := ePowerOnStatus.Off;
			1: get.MBMU.BatteryStatus.e_BMS_PowerOnStatus := ePowerOnStatus.On;
			2: get.MBMU.BatteryStatus.e_BMS_PowerOnStatus := ePowerOnStatus.PowerOn_Fault;
			3: get.MBMU.BatteryStatus.e_BMS_PowerOnStatus := ePowerOnStatus.PowerOff_Fault;
		END_CASE
		
		get.BatteryInfo.e_BMS_PowerOnStatus := get.MBMU.BatteryStatus.e_BMS_PowerOnStatus;
		
		CASE DataBuffer[1] OF
			0: get.MBMU.BatteryStatus.e_BMS_Status := eBMS_Status.Init;
			1: get.MBMU.BatteryStatus.e_BMS_Status := eBMS_Status.Normal;
			2: get.MBMU.BatteryStatus.e_BMS_Status := eBMS_Status.FullCharge;
			3: get.MBMU.BatteryStatus.e_BMS_Status := eBMS_Status.FullDischarge;
			4: get.MBMU.BatteryStatus.e_BMS_Status := eBMS_Status.Warning;
			5: get.MBMU.BatteryStatus.e_BMS_Status := eBMS_Status.Fault;
		END_CASE
		
		get.BatteryInfo.e_BMS_Status := get.MBMU.BatteryStatus.e_BMS_Status;
		
		arDatalogMBMU[48] := DataBuffer[0];
		arDatalogMBMU[49] := DataBuffer[1];
		arDatalogMBMU[50] := DataBuffer[3];
		arDatalogMBMU[51] := DataBuffer[4];
		arDatalogMBMU[52] := DataBuffer[5];	

		
		get.MBMU.by_NumberOfSubSystems := WORD_TO_BYTE(DataBuffer[3]);
		GetSystemStatus := TRUE;
		ComretryCounter := 0;
		b_MBComErrorActive := FALSE;
	ELSE
		COMretryCounter := COMretryCounter +1;
		IF COMRetryCounter > 5 THEN
			b_MBComErrorActive := TRUE;
		END_IF
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetWearCounters" Id="{a4e51fcd-c5c4-40b1-9675-e15be5162629}">
      <Declaration><![CDATA[METHOD GetWearCounters : BOOL
VAR_INST
	PowerOnTimeLogger		:	FB_Varlogger;
	PowerOnCycleLogger		:	FB_Varlogger;
	PrechargeCycleLogger	:	FB_Varlogger;
	OvertempCountLogger		:	FB_Varlogger;
	OverTempTimeLogger		:	FB_Varlogger;
	UnderTempCountLogger	:	FB_Varlogger;
	UnderTempTimeLogger		:	FB_Varlogger;
	
	SlowDataTimer				:	TON := (PT := T#2M);
	rtrig_SOCCalibrationDone	: 	r_trig;
	ton_prechargeDelay			:	ton := (Pt := T#30S);
	
	LastCalibrationTime		:	STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//only log data when BMS communication is actually working
SlowDataTimer(in := NOT SlowDataTimer.q AND BMSDataValid);

PowerOnTimeLogger(		TriggerInput := get.BatteryInfo.e_BMS_PowerOnStatus = ePowerOnStatus.On, 
						LogItemGroup :=  eLogItemGroupID.BMS, 
						LogItemName := 'HVOnHrs', 
						LogType := eLogTypes.TrackOnTime);

PowerOnCycleLogger(		TriggerInput := PowerStatus = eHVDC_PowerStatus.ON, 
						LogItemGroup :=  eLogItemGroupID.BMS, 
						LogItemName := 'HvOnCnt', 
						LogType := eLogTypes.TrackCycles);	

PrechargeCycleLogger(	TriggerInput := PowerStatus = eHVDC_PowerStatus.Precharging, 
						LogItemGroup :=  eLogItemGroupID.BMS, 
						LogItemName := 'PrechargeCnt', 
						LogType := eLogTypes.TrackCycles);	
												
OvertempCountLogger(	TriggerInput := get.Events.b_OVER_TEMP_WARNING, 
						LogItemGroup :=  eLogItemGroupID.BMS, 
						LogItemName := 'OverTempCnt', 
						LogType := eLogTypes.TrackCycles);	

OverTempTimeLogger(		TriggerInput := get.Events.b_OVER_TEMP_WARNING, 
						LogItemGroup :=  eLogItemGroupID.BMS, 
						LogItemName := 'OverTempHrs', 
						LogType := eLogTypes.TrackOnTime);			

UndertempCountLogger(	TriggerInput := get.Events.b_UNDER_TEMP_WARNING, 
						LogItemGroup :=  eLogItemGroupID.BMS, 
						LogItemName := 'UnderTempCnt', 
						LogType := eLogTypes.TrackCycles);	

UnderTempTimeLogger(	TriggerInput := get.Events.b_UNDER_TEMP_WARNING, 
						LogItemGroup :=  eLogItemGroupID.BMS, 
						LogItemName := 'UnderTempHrs', 
						LogType := eLogTypes.TrackOnTime);	

IF BMSDataValid THEN 
	Wearlogging.SetFloat(	eLogItemGroupID.BMS, 	'BattSOH', 				eLogTypes.WriteValue, 			REAL_TO_LREAL(get.BatteryInfo.r_SOH));
	Wearlogging.SetInteger(	eLogItemGroupID.BMS, 	'BattCycles', 			eLogTypes.WriteValue, 			UINT_TO_LINT(get.BatteryInfo.ui_CycleCount));
	Wearlogging.SetFloat(	eLogItemGroupID.BMS, 	'EnergyIn', 			eLogTypes.KeepHighestValue, 	REAL_TO_LREAL(get.BatteryInfo.r_HistAccChargeEnergy));
	Wearlogging.SetFloat(	eLogItemGroupID.BMS, 	'EnergyOut', 			eLogTypes.KeepHighestValue, 	REAL_TO_LREAL(get.BatteryInfo.r_HistAccDischargeEnergy));
	Wearlogging.SetFloat(	eLogItemGroupID.BMS, 	'MaxTempEver', 			eLogTypes.KeepHighestValue, 	REAL_TO_LREAL(get.BatteryInfo.ar_CellTemperature[eSubValues.Maximum]));
	
	IF get.BatteryInfo.ar_CellTemperature[eSubValues.Minimum] > -50 THEN
		Wearlogging.SetFloat(	eLogItemGroupID.BMS, 	'MinTempEver', 			eLogTypes.KeepLowestValue, 		REAL_TO_LREAL(get.BatteryInfo.ar_CellTemperature[eSubValues.Minimum]));
	END_IF
	
	Wearlogging.SetFloat(	eLogItemGroupID.BMS, 	'MaxStringVoltageEver', eLogTypes.KeepHighestValue, 	REAL_TO_LREAL(get.BatteryInfo.r_maxVoltageEver));
END_IF

ton_prechargeDelay(in := get.BatteryInfo.e_BMS_PowerOnStatus = ePowerOnStatus.On);
IF ton_prechargeDelay.Q THEN
	Wearlogging.SetFloat(	eLogItemGroupID.BMS, 	'MinStringVoltageEver', 		eLogTypes.KeepLowestValue, 	REAL_TO_LREAL(get.BatteryInfo.r_SystemVoltage));
END_IF


rtrig_SOCCalibrationDone(clk := get.BatteryInfo.e_BMS_Status = eBMS_Status.FullCharge);		
IF rtrig_SOCCalibrationDone.Q THEN
	dt_LastCalibrationDate := gvl.dt_SystemDateTime;
	LastCalibrationTime:= DT_TO_STRING(gvl.dt_SystemDateTime);
	Wearlogging.SetString(eLogItemGroupID.BMS, 'LastSocCalibration', 	LastCalibrationTime);
END_IF

IF slowDataTimer.Q THEN
	slowDataTimer.Q;
END_IF
							
//Add: Last calibration date]]></ST>
      </Implementation>
    </Method>
    <Method Name="Init" Id="{0aceaa9b-4149-4430-9b55-09d9d046f8c9}">
      <Declaration><![CDATA[METHOD Init : BOOL
VAR_INPUT
END_VAR

VAR
	temp1	:	LREAL;
	temp2	:	LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT InitDone THEN
	Wearlogging.GetFloatValue(eLogItemGroupID.BMS, 	'EnergyIn', CurrentLogValue => temp1);
	get.BatteryInfo.r_HistAccDischargeEnergy := LREAL_TO_REAL(temp1);
	get.MBMU.BatteryStatus.r_HistAccDischargeEnergy := LREAL_TO_REAL(temp1);
	
	Wearlogging.GetFloatValue(eLogItemGroupID.BMS, 	'EnergyOut', CurrentLogValue => temp2);
	
	get.BatteryInfo.r_HistAccChargeEnergy := LREAL_TO_REAL(temp2);
	get.MBMU.BatteryStatus.r_HistAccChargeEnergy := LREAL_TO_REAL(temp2);

	Wearlogging.SetInteger(	eLogItemGroupID.BMS, 	'nameplateEnergyCapacity', 			eLogTypes.WriteValue, 			REAL_TO_LINT(Settings.Properties.r_RatedEnergyCapacity));
	InitDone := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OpenInsulationSwitch" Id="{f96dd416-96e6-41c4-9643-9e191e336a6b}" FolderPath="Internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE OpenInsulationSwitch : BOOL
VAR_IN_OUT CONSTANT
	st_params			: ST_BMS_params;
END_VAR

VAR_INPUT
	OpenSwitch : BOOL;
END_VAR

VAR_INST
	WriteReg	:	FB_MBWriteSingleReg;
	Value 		:	WORD 	:= 0;
	StartWrite	:	BOOL	:= FALSE;
	
	bCommBusy	:	BOOL;
	bComError	:	BOOL;
	errID		:	UDINT;

	TransmissionDone 	: 	f_trig;
	ComRetryCounter	:	USINT;
	
	ComTimer			:	Ton := (PT := TIME#0S200MS);
END_VAR	
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
ComTimer(in := NOT(ComTimer.Q));

OpenInsulationswitch := FALSE;

IF OpenSwitch THEN
	Value := 1;
ELSE
	Value := 0;
END_IF

WriteReg(
sIPAddr := st_params.IP_BMS,
nTCPPort := 502,
nUnitID := 255,//16#FF;
nMBAddr := 907,
nValue := Value,
tTimeout := T#0S100MS,
bExecute := ComTimer.q,
bBusy => bCommBusy,
bError => bComError,
nErrId => errID,
);

TransmissionDone(CLK := bCommBusy);

IF TransmissionDone.Q THEN
	IF NOT bComError THEN
		arDatalogEMS[3] := 1;	
		get.MBMU.b_InsulationSwitchOpen := OpenSwitch;
		ComRetryCounter := 0;
		OpenInsulationSwitch := TRUE;
		b_MBComErrorActive := FALSE;
	ELSE
		COMretryCounter := COMretryCounter +1;
		IF COMRetryCounter > 5 THEN
			b_MBComErrorActive := TRUE;
		END_IF
	END_IF
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{7b3ba1ee-cf3d-4d9d-a084-997be89556e2}">
      <Declaration><![CDATA[METHOD Reset : BOOL
VAR_INPUT
	//BMSSET	:	st_BMS_Set;
	//ResetIn	:	BOOL;
END_VAR

VAR_INST
	ResetTrigger		:	Ton := (PT := TIME#1S0MS);
	ResetVar			:	BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[b_MBComErrorActive := FALSE;
Reset := ClearBMSFaults(st_params);

FBState := ePOUState.Normal;




]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetBMSDateTime" Id="{9849d9aa-aeea-4099-8bb3-523b243ba620}" FolderPath="Internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE SetBMSDateTime : BOOL
VAR_IN_OUT CONSTANT
	st_params			: ST_BMS_params;
END_VAR

VAR
	SystemTimeData	:	Timestruct;
	RTCData	:	ARRAY[0..6] OF WORD;	
	
END_VAR
VAR_INST
	//ComTimer			:	Ton := (PT := TIME#0S200MS);
	WriteRegs		:	FB_MBWriteRegs;
	SystemTime		:	FB_LocalSystemTime;
	TransmissionDone 	: 	f_trig;
	SystemTimeDataValid	:	BOOL;
	bCommBusy		:	BOOL;
	bComError		:	BOOL;
	errID			:	UDINT;
	COMRetryCounter	:	USINT := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ComTimer(in := NOT(ComTimer.Q OR bCommBusy));

//write PLC system time to BMS RTC
SetBMSDateTime := FALSE;


//retrieve system time struct
SystemTime(
	sNetID := '',
	bEnable := TRUE,
	dwCycle := 1,
	dwOpt	:= 1,
	tTimeout := t_TimeOut,
	bValid => SystemtimeDataValid,
	systemTime => SystemTimeData
);

//parse system time to BMS data array
IF SystemTimeDataValid THEN
	RTCData[0] := 2024;//SystemTimeData.wYear;
	RTCData[1] := 03;//SystemTimeData.wMonth;
	RTCData[2] := 26;//SystemTimeData.wDay;
	RTCData[3] := 13;//SystemTimeData.wHour;
	RTCData[4] := 52;//SystemTimeData.wMinute;
	RTCData[5] := 00;//SystemTimeData.wSecond;
	RTCData[6] := 1;//can this value remain at 1? or reset to 0 after write?
	
	//write data to BMS
	WriteRegs(	
	sIPAddr := st_params.IP_BMS,
	nTCPPort := 502,
	nUnitID := 255,//16#FF;
	nMBAddr := 900,
	nQuantity := 7,
	pSrcAddr := ADR(RTCData),
	cbLength := SIZEOF(RTCData),
	bExecute := ComTimer.Q,
	tTimeout := TIME#100MS,
	bBusy => bCommBusy,
	bError => bComError,
	nErrId => errID,
	);
	
	TransmissionDone(CLK := bCommBusy);
	
	//return true if tranmission succeeds
	IF TransmissionDone.Q THEN
		IF NOT bComError THEN
			SetBMSDateTime := TRUE;
			ComRetryCounter := 0;
			b_MBComErrorActive := FALSE;
		ELSE
			COMretryCounter := COMretryCounter +1;
			IF COMRetryCounter > 5 THEN
				b_MBComErrorActive := TRUE;
			END_IF
		END_IF
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetPowerMode" Id="{7f32a673-5053-4103-9dc6-69d9f8152fc9}" FolderPath="Internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE SetPowerMode : BOOL
VAR_IN_OUT CONSTANT
	st_params			: ST_BMS_params;
END_VAR

VAR_INST
	WriteReg	:	FB_MBWriteSingleReg;
	Value 		:	WORD 	:= 1;
	StartWrite	:	BOOL	:= FALSE;
	bCommBusy	:	BOOL;
	bComError	:	BOOL;
	errID		:	UDINT;
	TransmissionDone 	: 	f_trig;
	//ComTrigger	:	Ton := (PT := TIME#200MS);
	ComRetryCounter	:	USINT	:= 0;
	
	b_HVRequest			: BOOL;
	ton_StartRetrigger	: ton :=(PT := T#5S);
END_VAR	

VAR_INST
	rtrigPowerOn		: R_trig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
//Value := ePowerControl.Stay; //default command is: Do nothing
//it may also work if we just keep sending "poweron" if b_HVDC_Required is true. But this doesn't seem to be the way they intended.
b_HVRequest := b_HVDC_OnRq AND NOT ton_StartRetrigger.Q AND get.BatteryInfo.e_BMS_PowerOnStatus <> ePowerOnSTatus.On;
ton_StartRetrigger(IN:=b_HVRequest);
rtrigPowerOn(CLK:= ton_StartRetrigger.Q);



IF NOT b_HVDC_OnRq AND get.BatteryInfo.e_BMS_PowerOnStatus <> ePowerOnSTatus.Off THEN
	Value := ePowerControl.PowerOff;
ELSIF rtrigPowerOn.Q THEN
	Value := ePowerControl.PowerOn;
END_IF

//Write this register every second, regardless of change.
ComTimer(in := NOT(ComTimer.Q OR bCommBusy));

//IF BMSGet.BattInfo.ui_BMS_Status < 5 THEN
WriteReg(
	sIPAddr := st_params.IP_BMS,
	nTCPPort := 502,
	nUnitID := 255,//16#FF;
	nMBAddr := 897,
	nValue := Value,
	tTimeout := t_TimeOut,
	bExecute := ComTimer.Q,
	bBusy => bCommBusy,
	bError => bComError,
	nErrId => errID,
);
//ELSE
//	SetPowerMode := TRUE;
//END_IF

TransmissionDone(CLK := bCommBusy);
	
//return true if tranmission succeeds
IF TransmissionDone.Q THEN
	IF NOT bComError THEN
		arDatalogEMS[1] := Value;	
	
		SetPowerMode := TRUE;
		ComRetryCounter := 0;
		Value := ePowerControl.Stay;
		b_MBComErrorActive := FALSE;
	ELSE
		COMretryCounter := COMretryCounter +1;
		IF COMRetryCounter > 5 THEN
			b_MBComErrorActive := TRUE;
		END_IF
	END_IF
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Action Name="SFCTipReset" Id="{bd39e870-0e61-4d10-baf7-1dc4d7417da6}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[SFCTip := FALSE;
]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>