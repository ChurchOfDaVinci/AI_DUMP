]]></Declaration>
      <Set Name="Set" Id="{62b10459-d0f5-4794-9532-97c680ef1c2c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[RequestedSetpoint := Setpoint;]]></ST>
        </Implementation>
      </Set>
    </Property>
