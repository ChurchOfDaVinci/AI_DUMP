    <Action Name="aCycleDone" Id="{6f5637c4-82c5-4db3-a3a5-94a5b6a9f3b0}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[CommIntervalTimer.IN := false;]]></ST>
      </Implementation>
    </Action>
    <Action Name="aInit" Id="{b520c0bc-0d30-4337-8514-2643e28d8253}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[get.HeatPumpState := eHeatpumpstate.OFF;
SFCReset := FALSE;
get.Events.b_CommWarning := FALSE;
MBRetryCount := 0;]]></ST>
      </Implementation>
    </Action>
    <Action Name="aReadCoils" Id="{480b44c7-8b45-44b2-8af4-28913a469df9}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[CommIntervalTimer.IN := TRUE;

TransmissionDone(clk := ReadCoils.bBusy);

ReadCoils(sIPAddr	:=	st_params.IO_IPaddress,
						nTCPPort	:=	502,
						nUnitID 	:=  HeatpumpID,
						nQuantity 	:= 	5,
						nMBAddr		:=	0,
						cbLength 	:= 	6,
						pDestAddr	:=	ADR(CoilStatus),
						tTimeout	:=	T#100ms,//st_params.t_ModbusTimeOut,
						bExecute	:=	NOT (ReadCoils.bbusy OR TransmissionDone.Q),
				);
	

IF TransmissionDone.q THEN
	IF NOT ReadCoils.bError THEN
		//Full datastruct for debug purposes. Can be removed later
		Coils.b_EnableOperation := CoilStatus.0;
		Coils.b_EnableSwwOperation := CoilStatus.1;
		Coils.b_EnableSilentMode := CoilStatus.2;
		Coils.b_EnableDesinfectionMode := Coilstatus.3;
		Coils.b_EmstopActive := CoilStatus.4;
		Coils.b_EnableEmStop := CoilStatus.5;
		//Full datastruct for debug purposes. Can be removed later
		
	ELSE
		MBRetryCount := MBRetryCount + 1;
	END_IF
	
	sfctip := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="aReadDiscreteInputs" Id="{e4474896-6018-47e7-8337-929cbf135883}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[TransmissionDone(clk := Readinputs.bBusy);

Readinputs(				sIPAddr		:=	st_params.IO_IPaddress,
						nTCPPort	:=	502,
						nUnitID 	:= 	HeatpumpID,
						nQuantity 	:= 	16,
						nMBAddr		:=	0,
						cbLength 	:= 	SIZEOF(Databuffer),
						pDestAddr	:=	ADR(Databuffer),
						tTimeout	:=	T#100ms,//st_params.t_ModbusTimeOut,
						bExecute	:=	NOT (Readinputs.bbusy OR TransmissionDone.Q),
				);


IF TransmissionDone.q THEN
	IF NOT ReadInputs.bError THEN
		//Full datastruct for debug purposes. Can be removed later
		Statusbits.b_WaterFlowNOK := DataBuffer[0].0;
		Statusbits.b_WaterPumpOn := DataBuffer[0].1;
		Statusbits.b_ExtWaterPumpOn := DataBuffer[0].2;
		Statusbits.b_CompressorOn := DataBuffer[0].3;
		Statusbits.b_DefrostOn := DataBuffer[0].4;
		Statusbits.b_SWWModeOn := DataBuffer[0].5;
		Statusbits.b_SWWTankDesinfectionActive := DataBuffer[0].6;
		Statusbits.b_SilentModeOn := DataBuffer[0].7;
		Statusbits.b_CoolingActive := DataBuffer[0].8;
		Statusbits.b_SolarPumpActive := DataBuffer[0].9;
		Statusbits.b_BackupHeater1Active := DataBuffer[0].10;
		Statusbits.b_BackupHeater2Active := DataBuffer[0].11;
		Statusbits.b_SWWBoostHeaterActive := DataBuffer[0].12;
		Statusbits.b_ErrorActive := DataBuffer[0].13;
		Statusbits.b_EMOperationAvailable := DataBuffer[0].14;
		Statusbits.b_EMSWWOperationAvailable := DataBuffer[0].15;
		Statusbits.b_MixPumpActive := DataBuffer[1].0;
		//Full datastruct for debug purposes. Can be removed later
		
		get.Events.b_PumpError := DataBuffer[0].0;
		get.events.b_DefrostingActive := DataBuffer[0].4;
		
		
		//error active and no em operation allowed
		IF DataBuffer[0].13 THEN
			get.HeatPumpState := eHeatpumpstate.ERROR;
			IF NOT DataBuffer[0].14 THEN
				HeatpumpEMOperationAvailable := FALSE;
			ELSE
				HeatpumpEMOperationAvailable := TRUE;
			END_IF
		ELSIF get.HeatPumpState = eHeatpumpstate.ERROR THEN
			get.HeatPumpState := eHeatpumpstate.Initializing;
			HeatpumpEMOperationAvailable := FALSE;
		END_IF
		
		//done, preset for next step
		MBRetryCount := 0;
	ELSE
		MBRetryCount := MBRetryCount + 1;
	END_IF
	sfctip := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="aReadHolding" Id="{5bc44733-ddd6-4c88-99cc-6a0e0ffa9900}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[TransmissionDone(clk := Readregs.bBusy);

Readregs(	sIPAddr		:=	st_params.IO_IPaddress,
			nTCPPort	:=	502,
			nUnitID 	:= 	HeatpumpID,
			nQuantity 	:= 	10,
			nMBAddr		:=	0,
			cbLength 	:= 	SIZEOF(Databuffer),
			pDestAddr	:=	ADR(Databuffer),
			tTimeout	:=	T#100ms,//st_params.t_ModbusTimeOut,
			bExecute	:=	NOT (ReadRegs.bbusy OR TransmissionDone.Q),
		);


IF TransmissionDone.q THEN
	IF NOT Readregs.bError THEN
		Controlregs.ui_OperatingMode := Databuffer[0];
		Controlregs.ui_ControlMode := Databuffer[1];
		Controlregs.r_Setpoint1 := (WORD_TO_REAL(Databuffer[2])/10);
		Controlregs.r_RoomSetpoint := (WORD_TO_REAL(Databuffer[3])/10);
		Controlregs.ui_TempShiftValue := Databuffer[4];
		Controlregs.r_Setpoint2 := (WORD_TO_REAL(Databuffer[5])/10);
		Controlregs.r_RoomSetpoint2 := (WORD_TO_REAL(Databuffer[6])/10);
		Controlregs.ui_TempShiftValue2 := Databuffer[7];
		Controlregs.r_DHWgoalTemp := (WORD_TO_REAL(Databuffer[8])/10);
		Controlregs.ui_EnergyStatus := Databuffer[9];
		
		get.Setpoint := (WORD_TO_REAL(Databuffer[2])/10);


		IF get.HeatPumpState <> eHeatpumpstate.ERROR THEN
			CASE get.HeatPumpState OF
				0:
					get.HeatPumpState := eHeatpumpstate.Standby;
				1:
					get.HeatPumpState := eHeatpumpstate.Active_Cooling;
				2:
					get.HeatPumpState := eHeatpumpstate.Active_Heating;
			END_CASE
		END_IF
	
		//done, preset for next step
		MBRetryCount := 0;

	ELSE
		MBRetryCount := MBRetryCount + 1;
		
	END_IF
	sfctip := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="aReadInputRegs" Id="{0d10d18f-2eb3-46cc-8c37-3163a39fe615}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[TransmissionDone(clk := ReadInputregs.bBusy);

ReadInputregs(	sIPAddr		:=	st_params.IO_IPaddress,
				nTCPPort	:=	502,
				nUnitID 	:= 	HeatpumpID,
				nQuantity 	:= 	14,
				nMBAddr		:=	0,
				cbLength 	:= 	SIZEOF(Databuffer),
				pDestAddr	:=	ADR(Databuffer),
				tTimeout	:=	T#100ms,//st_params.t_ModbusTimeOut,
				bExecute	:=	NOT (ReadInputRegs.bbusy OR TransmissionDone.Q),
		);


IF TransmissionDone.q THEN
	IF NOT ReadInputregs.bError THEN		
	//Full datastruct for debug purposes. Can be removed later
		Inputs.UI_ErrorCode := Databuffer[0];	
		Inputs.ui_OperationalMode := (Databuffer[1]);	
		Inputs.r_CoolantInletTemp := WORD_TO_REAL((Databuffer[2]))/10;	
		Inputs.r_CoolantOutletTemp := WORD_TO_REAL((Databuffer[3]))/10;
		Inputs.r_BackupHeaterTemp := WORD_TO_REAL((Databuffer[4]))/10;
		Inputs.r_SWWTankTemp :=  WORD_TO_REAL((Databuffer[5]))/10;
		Inputs.r_SolarCollectorTemp := WORD_TO_REAL((Databuffer[6]))/10;
		Inputs.r_RoomTemp1 := WORD_TO_REAL((Databuffer[7]))/10;
		Inputs.r_FlowRate := WORD_TO_REAL((Databuffer[8]))/10;
		Inputs.r_FlowTempCircuit2 := WORD_TO_REAL((Databuffer[9]))/10;
		Inputs.r_RoomTemp2 := WORD_TO_REAL((Databuffer[10]))/10;
		Inputs.UI_EnergyStatus := (Databuffer[11]);
		Inputs.r_OutsideTemp := WORD_TO_REAL((Databuffer[12]))/10;
		Inputs.r_CoolantPressure := WORD_TO_REAL((Databuffer[13]))/10;
	//full datastruct for debug purposes. can be removed later	
	ELSE
		MBRetryCount := MBRetryCount + 1;
	END_IF
	sfctip := TRUE;
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="aUpdateDone" Id="{c7ee4eed-870c-4c80-8651-797a33905e61}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[SFCTip := FALSE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="aWriteCoils" Id="{f448ba5f-1f27-4aee-becd-f71a6120ff5a}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[

CoilStatus.0 := requestedOperationMode <> eHeatpumpMode.Standby; // operation off

CoilStatus.5 := EMHeatingModeRequired();



TransmissionDone(clk := WriteCoils.bBusy);

WriteCoils		(sIPAddr	:=	st_params.IO_IPaddress,
				nTCPPort	:=	502,
				nUnitID 	:= 	HeatpumpID,
				nQuantity 	:= 	5,
				nMBAddr		:=	0,
				cbLength 	:= 	1,
				pSrcAddr	:=	ADR(CoilStatus),
				tTimeout	:=	T#100ms,
				bExecute	:=	NOT (WriteCoils.bbusy OR TransmissionDone.Q),
		);
	

IF TransmissionDone.q THEN
	IF NOT WriteCoils.bError THEN
			sfctip := TRUE;
			
		ELSE
			MBRetryCount := MBRetryCount + 1;
			sfctip := NOT sfctip;
		END_IF
	END_IF
//ELSE
//	sfctip := NOT sfctip;
//END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="aWriteHolding" Id="{57eede86-613d-402a-93a6-ecf38cadf25e}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[
CASE requestedOperationMode OF
	eHeatpumpMode.Cooling:
		Databuffer[0] := 0; // cooling mode
		Databuffer[2] := REAL_TO_WORD(requestedSetpoint*10);
	eHeatpumpMode.Heating:
		Databuffer[0] := 4; // Heating mode
		Databuffer[2] := REAL_TO_WORD(requestedSetpoint*10);	
END_CASE
		
Databuffer[1] := 1; // inlet temperature control
Databuffer[3] := 0;
Databuffer[4] := 0;
Databuffer[5] := 0;
Databuffer[6] := 0;
Databuffer[7] := 0;
Databuffer[8] := 0;
Databuffer[9] := 2; // normal operation



TransmissionDone(clk := WriteRegs.bBusy);

WriteRegs		(sIPAddr	:=	st_params.IO_IPaddress,
				nTCPPort	:=	502,
				nUnitID 	:= 	HeatpumpID,
				nQuantity 	:= 	10,
				nMBAddr		:=	0,
				cbLength 	:= 	SIZEOF(Databuffer),
				pSrcAddr	:=	ADR(Databuffer),
				tTimeout	:=	T#100ms,
				bExecute	:=	NOT (WriteRegs.bbusy OR TransmissionDone.Q)
		);
	

IF TransmissionDone.q THEN
	IF NOT WriteRegs.bError THEN
		//done, preset for next step
		MBRetryCount := 0;;
	ELSE
		MBRetryCount := MBRetryCount + 1;
	END_IF
	sfctip := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="ContinousActions" Id="{49fa7889-7826-4903-bdeb-22e572981f82}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[
CommIntervalTimer();

IF SFCError THEN
	SFCError := FALSE;
	get.Events.b_CommWarning := TRUE;
END_IF

IF NOT ACPowerStatus THEN
	IF get.HeatPumpState <> eHeatpumpstate.OFF THEN
		SFCReset := TRUE;
	END_IF
ELSIF get.HeatPumpState = eHeatpumpState.OFF THEN
	get.HeatPumpState := eHeatpumpState.Initializing;

	
	//reset mb master if stuck in busy
	ton_MBBUSYTimeOut(IN :=	ReadCoils.bBusy OR ReadInputs.bBusy OR ReadRegs.bBusy OR ReadInputRegs.bBusy OR WriteCoils.bBusy OR writeregs.bBusy);
	IF ton_MBBUSYTimeOut.Q THEN
		ReadCoils();
		ReadInputs();
		ReadRegs();
		ReadInputRegs();
		WriteCoils();
		WriteRegs();
	END_IF
	
	{warning 'todo: universele warmtepomp datastruct opzetten'}
	get.Setpoint				:=	controlregs.r_Setpoint1;
	get.HeatpumpData.r_InletWaterTemp		:=	Inputs.r_CoolantInletTemp;
	get.HeatpumpData.r_OutletWaterTemp		:=	Inputs.r_CoolantOutletTemp;
	//get.HeatpumpData.r_FlowRate				:=	Inputs.r_FlowRate;
	//get.HeatpumpData.UI_EnergyStatus			:=	Inputs.UI_EnergyStatus;
	get.HeatpumpData.r_OutdoorTemp			:=	Inputs.r_OutsideTemp;
	get.events.b_PressureError 	:=	Inputs.r_Coolantpressure < st_params.r_MinimumSystemBasePressureErrorLevel;
	get.events.b_TooColdForHeatpumpHeating := Inputs.r_CoolantInletTemp < 15;
	
	//get.Events.b_CommWarning := MBRetryCount > st_params.i_modbusRetries;

END_IF

IF TRUE THEN
	CASE RequestedOperationMode OF
		eHeatPumpMode.Standby:
			Coils.b_EnableOperation := FALSE;
			ControlRegs.ui_OperatingMode := 3;
			get.HeatPumpState := eHeatpumpMode.Standby;
		eHeatPumpMode.Cooling:
			Coils.b_EnableOperation := TRUE;
			ControlRegs.r_Setpoint1 := RequestedSetpoint;
			ControlRegs.ui_OperatingMode := 0;
			get.HeatPumpState := eHeatpumpMode.Cooling;
		eHeatPumpMode.Heating:
			Coils.b_EnableOperation := TRUE;
			ControlRegs.r_Setpoint1 := RequestedSetpoint;
			ControlRegs.ui_OperatingMode := 4;
			get.HeatPumpState := eHeatpumpMode.Heating;
	END_CASE
END_IF


]]></ST>
      </Implementation>
    </Action>
    <Method Name="EMHeatingModeRequired" Id="{dc74603f-70fb-446b-949c-90e5312c3a12}">
      <Declaration><![CDATA[METHOD EMHeatingModeRequired : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//some heatpump faults allow for emergency heating operation. If this occurs and heating is required, switch to emergency heating mode to keep the system warm.
//Cooling operation is not available in this mode.

IF Statusbits.b_EMOperationAvailable AND operationmode = eHeatpumpmode.Heating THEN
	EMHeatingModeRequired := TRUE;
ELSE
	EMHeatingModeRequired := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="EMStop" Id="{97968dc4-bbc7-4d8f-8918-cdcb970a3fed}">
      <Declaration><![CDATA[METHOD EMStop : BOOL

]]></Declaration>
      <Implementation>
        <ST><![CDATA[RequestedOperationMode := eHeatpumpMode.Standby;
EMstop := b_Emstop := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="getDiagnostics" Id="{c98abc38-1041-4146-831a-17074b3bbc02}">
      <Declaration><![CDATA[METHOD GetDiagnostics 
VAR_IN_OUT
	AddError		: ARRAY [*] OF FB_AddErrorST;
	a_ActiveEvents	: ARRAY [*] OF ST_ErrorStruct;
	w_Index			: WORD;
END_VAR

VAR
	by_errCt	: BYTE;
	by_warnCt	: BYTE;
	HPErrorText	: STRING;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[	(*Modbus comm fault*)	AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_commwarning,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 10 + ((HeatPumpID-1)*10),
			e_ObjectID				:= eObject_ID.HeatPump,
			s_Message				:= 'Modbus communication fault',
			e_sev					:= eSeverity.Warning,	
			b_AutoClear			:= TRUE,
			t_TriggerTime		:=	T#60s,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
CASE Inputs.UI_ErrorCode OF
	0:										HPErrorText := '';
	1:										HPErrorText	:= 'Room temperature sensor error';
	8, 13, 19, 44:						HPErrorText := 'Misc Sensor error';
	2, 6, 16, 17, 18, 41, 45, 46, 65, 114:	HPErrorText := 'Temperature sensor error';
	10:										HPErrorText := 'Water pump blocked';
	3, 5, 53, 52:							HPErrorText := 'Internal comm error';
	9, 60:									HPErrorText := 'Eeprom error';
	14:										HPErrorText := 'Flow error';
	15:										HPErrorText := 'Water outlet overheat';
	20:										HPErrorText := 'Heater thermal fuse failed';
	21, 22, 27, 29:							HPErrorText := 'Compressor overcurrent';
	26: 									HPErrorText := 'Compressor fault';
	32: 									HPErrorText := 'Compressor output overtemperature';
	23: 									HPErrorText := 'DC Voltage error';
	35: 									HPErrorText := 'Low pressure error';
	43:   									HPErrorText := 'refrigerant pressure sensor error';
	54:   									HPErrorText := 'Input phase error';
	61:   									HPErrorText := 'condensor overtemperature error';
	62:   									HPErrorText := 'heatsink overtemperature error'; 
	67:  									HPErrorText := 'Fan blocked error';
	231:									HPErrorText := 'Water pressure sensor error';
	232:									HPErrorText := 'Water flow sensor error';
ELSE
	HPErrorText := 'Unknown error';
END_CASE


		
	(*Heatpump fault*)	AddError[w_Index](
			b_ErrorTrig				:= get.HeatpumpData.w_ErrorList[1] <> 0,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 11 + ((HeatPumpID-1)*10),
			s_Message				:= concat(concat(concat('Heatpump fault: ', TO_STRING(get.HeatpumpData.w_ErrorList[1])), ' :'), HPErrorText),
			e_sev					:= eSeverity.Warning,	
			b_AutoClear				:= True,
			t_TriggerTime			:=	T#1S,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
	
	
	(*Heatpump warning*)			AddError[w_Index](
			b_ErrorTrig			:= Coils.b_EnableSwwOperation AND Statusbits.b_EMOperationAvailable,
			out_ST_Error		:= a_ActiveEvents[w_Index],
			w_ErrorID			:= 12 + ((HeatPumpID-1)*10),
			s_Message			:= 'Emergency operation active, performance may be restricted',
			e_sev				:= eSeverity.Warning,	
			b_AutoClear			:= FALSE,
			t_TriggerTime		:=	T#1S,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		

	(*Heatpump Pump fault*)			AddError[w_Index](
			b_ErrorTrig				:= Get.Events.b_PressureError,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 13 + ((HeatPumpID-1)*10),
			s_Message				:= 'Coolant pressure low',
			e_sev					:= eSeverity.Warning,	
			b_AutoClear				:= FALSE,
			t_TriggerTime			:=	T#1S,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;	
]]></ST>
      </Implementation>
    </Method>
