<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_LGThermaV" Id="{f7d951ca-38b2-4caf-969c-0440a565acad}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LGThermaV implements ItF_Heatpump

VAR
	ReadCoils		:	FB_MBReadCoils;
	ReadInputs		:	FB_MBReadInputs;
	Readregs		:	FB_MBReadregs;
	ReadInputRegs	:	FB_MBReadInputRegs;
	WriteCoils		:	FB_MBWriteCoils;
	WriteRegs		:	FB_MBWriteRegs;
	
END_VAR

VAR_OUTPUT
	Get				:	st_heatpump_Get;
END_VAR

VAR_IN_OUT CONSTANT
	st_params		: 	ST_Coolingsystem_params;
END_VAR

VAR_INPUT
	ACPowerStatus	:	BOOL;
	HeatPumpID		:	BYTE;
END_VAR
		
VAR
	ton_MBBUSYTimeOut		: TON := (PT := T#10s);
	DataBuffer				:	ARRAY[0..50] OF WORD;
	Ton_ErrorTimer			:	Ton := (PT := T#5M);
	MBRetryCount			:	BYTE;
	TransmissionDone		:	F_Trig;
	CommIntervalTimer		:	Ton	:=	(PT := T#5S);
END_VAR

VAR
	b_EMStop						:	BOOL;
	b_resetErrors					:	BOOL;
	sPressureErrorText				:	STRING;
	sCompressorErrorText			:	STRING;
	sPumpErrorText					:	STRING;
	sWaterTempErrorText				:	STRING;
	
	Coils		: 	LG_Coils;
	Inputs 		: 	LG_Inputregs;
	Statusbits	:	LG_StatusBits;
	ControlRegs	:	LG_Controlregs;
END_VAR

VAR
	CoilStatus		:	BYTE;

	RequestedOperationMode	:	eHeatpumpMode;
	RequestedSetpoint		:	Real;

	HeatpumpEMOperationAvailable	:	Bool;
END_VAR]]></Declaration>
