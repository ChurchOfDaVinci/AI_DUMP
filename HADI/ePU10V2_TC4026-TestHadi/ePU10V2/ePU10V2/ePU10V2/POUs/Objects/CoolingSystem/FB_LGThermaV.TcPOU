    <Method Name="Reset" Id="{a04d23d6-1609-4365-9d01-c83980dc9203}">
      <Declaration><![CDATA[METHOD Reset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//until restarting the heatpump we don't know if errors are gone. So clear them for now.

get.events.b_TooColdForHeatpumpHeating := FALSE;
get.Events.b_PressureError := FALSE;
get.Events.b_CommWarning := FALSE;
b_Emstop := FALSE;

MBRetryCount := 0;
Reset := true;
	]]></ST>
      </Implementation>
    </Method>
    <Property Name="Setpoint" Id="{309d90a6-9573-4f90-af2c-c40748cddef0}">
