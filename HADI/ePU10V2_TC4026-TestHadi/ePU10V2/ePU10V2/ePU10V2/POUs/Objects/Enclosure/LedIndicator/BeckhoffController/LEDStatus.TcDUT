  <DUT Name="LEDStatus" Id="{496674da-5a14-43f2-b0cc-ced2ef910a89}">
    <Declaration><![CDATA[TYPE LEDStatus :
STRUCT
	busy				: BIT;
	transmit			: BIT;
	sendAcknowledge 	: BIT;
	updateAcknowledge	: BIT;
	commandAcknowledge	: BIT;
	commandReject		: BIT;
	warning				: BIT;
	error				: BIT;
	InputCycleCounter	: USINT;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>