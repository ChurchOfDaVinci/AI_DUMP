<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="eSystemStatus" Id="{ef330382-c3b5-410b-87dd-a6bb27d14e4a}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE eSystemStatus :
(
	off			:= 0,	// off
	neutral 	:= 1, 	(*white*)
	normal		:= 2, 	// green
	attention	:= 3,	// blue 100charge 0discharge
	warning		:= 4,	// yellow
	error		:= 5	// red	
) BYTE;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>