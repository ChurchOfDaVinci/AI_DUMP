<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="st_InterMachineCom_Slave" Id="{676a1489-f58f-40a7-8439-72519c8a8b96}">
    <Declaration><![CDATA[TYPE st_InterMachineCom_Slave :
STRUCT
	ACP : UINT; //available charge power [kW]
	ADP	: UINT; //available discharge power [kW]
	AQ	: UINT; //available Reactive Power [kvar]
	SW	: WORD; //status word: b0: standby, b1: running, b2: Stopped, b3: Discharge Only, b4: Charge Only, b5: warning active, b6: Alarm active, b7: EMstop active, b15: watchdogbit
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>