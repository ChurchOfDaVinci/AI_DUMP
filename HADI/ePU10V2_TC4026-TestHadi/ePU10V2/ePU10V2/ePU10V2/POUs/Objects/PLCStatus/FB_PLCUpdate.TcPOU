<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_PLCUpdate" Id="{e4ff7459-8d30-4724-8ede-2cd7d462c6a2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PLCUpdate

VAR_INPUT
	bUpdate				: BOOL;
	bAbortUpdate		: BOOL;
END_VAR

VAR_OUTPUT
	FTPState			: eFTPstate;
	InstalState			: eInstalState;
	BackupState			: eInstalState;
	sLogMessage 		: STRING(255);
	bCheckUpdates		: BOOL;	
	bUpdateAvailable 	: BOOL;
END_VAR

VAR	
	rTrig_CheckUpdate	: R_Trig;
	
    fbFileDelete 		: FB_FileDelete;  (* Om oude bestanden te verwijderen *)
    
    sJsonUrl      		: STRING := 'http://server.com/updates.json'; (* JSON met update-info *)
    sUpdateUrl    		: STRING := '';  (* URL van het updatebestand uit JSON *)
    sLocalPath    		: STRING := '/usr/local/updates/update.tsmpkg';
    sBackupPath   		: STRING := '/usr/local/backup/old_version.tsmpkg';
    
    sCurrentVersion 	: STRING := '1.2.0';  (* Huidige versie van de PLC *)
    sNewVersion     	: STRING := '';       (* Nieuwe versie uit JSON *)

   
    bDownloadComplete 	: BOOL;
    bInstallComplete 	: BOOL;
    bRollbackNeeded 	: BOOL;
    eState 				: INT := 0;
    iRetryCount 		: INT := 0;
END_VAR




]]></Declaration>
    <Implementation>
      <ST><![CDATA[


CASE eState OF
    0: // Controleer op update via JSON
		rTrig_CheckUpdate(CLK := bUpdate);
		IF rTrig_CheckUpdate THEN
			bCheckUpdates := TRUE;
		END_IF
		
		IF 
		CheckForUpdates();
        

    1: // Maak een backup van de huidige versie
		BackupState := Copy(sSrcPath := sLocalPath, sDestPath := sBackupPath);
		
        IF BackupState = eInstalState.Success THEN
            eState := 2;
		ELSIF BackupState = eInstalState.Failure OR bAbortUpdate THEN
			eState := 99;
        END_IF

    2: // Download de nieuwe update via FTP
		FTPState := DownloadUpdate(
			sHost := 'temp',
			sUsername := 'tempuser',
			sPassword := 'tempPass',
			sSrcFile := 'path/1',
			sDesFile := 'path/2',
			start :=  bUpdateAvailable);

        IF FTPState = eFTPState.Success THEN
            bDownloadComplete := TRUE;
            eState := 3;
        ELSIF FTPState = eFTPState.Failure OR bAbortUpdate THEN
                eState := 99; // Ga naar fallback
        END_IF

    3: // Wachten op bevestiging van de gebruiker via HMI
        IF bUpdate THEN
			bUpdateStarted := TRUE;
            eState := 4;
        END_IF

    4: // Installeer de update
		InstalState := Copy(sSrcPath := sLocalPath, sDestPath := 'path/2');
		IF InstalState = eInstalState.Success THEN
			bInstallComplete := TRUE;
			eState := 5;
		ELSIF InstalState = eInstalState.Failure OR bAbortUpdate THEN
			bRollbackNeeded := TRUE;
            eState := 6; // Ga naar rollback
		END_IF

    5: // Herstart de PLC na succesvolle update
        SystemReboot();

    6: // Rollback uitvoeren als de update is mislukt
		InstalState := Copy(sSrcPath := sBackupPath,  sDestPath := '/usr/local/boot/update.tsmpkg');

		IF InstalState = eInstalState.Success THEN
			SystemReboot();  // Herstart de PLC met oude versie
		ELSIF InstalState = eInstalState.Failure OR bAbortUpdate THEN
			eState := 99;  // Fallback activeren als rollback mislukt
		END_IF

    99: // Fallback: Stop het updateproces en meld de fout
        bUpdateAvailable := FALSE;
		bUpdateStarted := FALSE;
        bRollbackNeeded := FALSE;
        iRetryCount := 0;
END_CASE

CASE eState OF
    0:	sLogMessage := 'Check if update is available';
        WriteLog(sLogMessage);
        
   1:	sLogMessage := 'Create backup of current software';
        WriteLog(sLogMessage);

    2:	sLogMessage := 'Downloading update';
        WriteLog(sLogMessage);
		
	3:	sLogMessage := 'Update ready for installation';
		WriteLog(sLogMessage);
		
	4:	sLogMessage := 'Installing update';
		WriteLog(sLogMessage);
		
	5:	sLogMessage := 'Rebooting system';
		WriteLog(sLogMessage);    
		
    6:	sLogMessage := 'Update failed, rollback started';
         WriteLog(sLogMessage);
		 
    99:
        sLogMessage := 'Update mislukt, fallback geactiveerd';
        WriteLog(sLogMessage);
END_CASE

]]></ST>
    </Implementation>
    <Method Name="CheckForUpdates" Id="{bc0098cd-04de-4a7f-a933-bbb626b95dde}">
      <Declaration><![CDATA[METHOD CheckForUpdates : BOOL
VAR_INPUT
	sServerUrl   : STRING := 'http://server.com/updates.json'; (* Volledige URL *)
END_VAR

VAR_INST
	fbHttpClient 		: FB_IotHttpClient;  (* Voor JSON versiecontrole *)
	     
    sResponse    : STRING(1024);  (* Buffer voor de server response *)
    bExecute     : BOOL := TRUE;
    bDone        : BOOL;
    bError       : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbHttpClient(
	sHostName := sHostName,
	


fbHttpClient.sHost := 'server.com';  // Vervang met je eigen server
fbHttpClient.sResource := '/updates.json';  // JSON-bestand
fbHttpClient.eMethod := E_HttpMethod.GET;
fbHttpClient.bExecute := TRUE;

IF fbHttpClient.eState = E_HttpRequestState.Done THEN
	sNewVersion := ExtractJsonValue(fbHttpClient.sResponseContent, 'latest_version');
	sUpdateUrl := ExtractJsonValue(fbHttpClient.sResponseContent, 'update_file');
	
	IF sNewVersion > sCurrentVersion THEN
		bUpdateAvailable := TRUE;
		eState := 1;
	END_IF
END_IF


(* Stap 1: HTTP Request starten *)
IF bExecute THEN
    fbHttpClient. := sServerUrl;   (* Geef de volledige URL mee *)
    fbHttpClient.eMethod := T_IotHttpMethod.Get;  (* HTTP GET Methode *)
    fbHttpClient.bExecute := TRUE;
    bExecute := FALSE; (* Voorkomt dat het telkens opnieuw start *)
END_IF

(* Stap 2: Wachten op antwoord *)
IF fbHttpClient.bDone THEN
    sResponse := fbHttpClient.sResponse;  (* Server response opslaan *)
    bDone := TRUE;
ELSIF fbHttpClient.bError THEN
    bError := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Copy" Id="{17d19351-8ac3-4592-9a4f-e2e1b1514065}">
      <Declaration><![CDATA[METHOD Copy : eInstalstate
VAR_INPUT
	sSrcPath : STRING;
	sDestPath: STRING;
END_VAR

VAR_OUTPUT
	Busy 		: BOOL;
    Error 		: BOOL;
	ErrID 		: UDINT;
END_VAR

VAR_INST
	ton_waitRetry		: ton := (pt := T#2S);
	fbFileCopy   		: FB_FileCopy;    (* Voor het maken van een backup *)
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbFileCopy(
	sSrcPathName := sSrcPath,
	sDestPathName := sDestPath,
	tTimeOut := T#15S,
	bBusy => Busy,
	bError => Error,
	nErrId => ErrID);
	
ton_waitRetry(Q => fbFileCopy.bExecute);

IF Error THEN
	Copy := eInstalState.Failure;
ELSIF busy THEN
	Copy := eInstalState.InProgress;
	ton_waitRetry.IN := FALSE;
ELSE
	IF NOT fbFileCopy.bExecute THEN
		Copy := eInstalState.Success;
	END_IF
	ton_waitRetry.IN := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="DownloadUpdate" Id="{69f6e51c-27fd-4aff-93d1-aa070540db41}">
      <Declaration><![CDATA[METHOD DownloadUpdate : eFTPState

VAR_INPUT
	sHost 			: STRING := 'ftp.example.com';
	sUsername		: STRING;
	sSrcFile		: STRING;
	sDesFile		: STRING;
	sPassword		: STRING;
	Start			: BOOL;
END_VAR

VAR_OUTPUT
	Busy 		: BOOL;
    Error 		: BOOL;
	ErrID 		: UDINT;
END_VAR

VAR_INST
	bRetry			: BOOL;
	byMaxRetries	: BYTE := 3;
	byRetryCounter	: BYTE;
	StartTrigger : R_TRIG;	
	FTPstate 	: eFTPState;
	ftpOpen 	: FB_FTP_Open; 			// Function block om verbinding te openen.
	ftpDownload : FB_FTP_FileDownload; 	// Function block om het bestand te downloaden
    ftpClose 	: FB_FTP_Close;  			// Function block om de verbinding te sluiten
    hFTP 		: T_HFTP; //FTP handle / identifyer
	RTrig_Error	: R_Trig;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[StartTrigger(CLK:= start);

CASE FTPState OF
      eFTPState.Disconnected:
			IF StartTrigger.Q OR bRetry THEN
				bRetry := FALSE;
      			FTPState := eFTPState.Connecting;
			END_IF
			
     eFTPState.Connecting:
         ftpOpen(
			sHost:= sHost,
			nPort:= 21,
			sUsername:= sUsername,
			sPassword:= sPassword,
			tTimeout:= T#15S,
			bExecute := TRUE,
			hFTP=> hFTP,
			bBusy => busy,
			bError => Error,
			nErrID=> ErrID
			);
         IF NOT Busy AND NOT Error THEN
             ftpOpen(bExecute:= FALSE);
             FTPState := eFTPstate.Downloading;
         END_IF
		 
     eFTPstate.Downloading:
		ftpDownload(
			sNetID:= '',              // Lokale machine
			hFTP:= hFTP,              // Gebruik de handle van de geopende verbinding
			sSrcFile:= '\TestFolder\File1.txt',
            sDesFile:= '\Program Files\TestFile1.txt',
			tTimeout:= T#15S,         // Timeout
			bexecute := TRUE,
			bBusy => busy,
            bError => error,
			nErrID=> ErrID
		);
         IF NOT busy AND NOT Error THEN
             ftpDownload(bExecute:= FALSE);
             FTPState := eFTPState.Success;
         END_IF
     eFTPState.Success:
		ftpClose(
			sNetID:= '',              // Lokale machine
			hFTP:= hFTP,              // Gebruik de handle van de geopende verbinding
			bExecute:= TRUE,      // Start het sluiten van de verbinding
			bBusy => busy,
            bError => error,
			tTimeout:= T#15S,         // Timeout
			nErrID=> ErrID
		);
	 	
       	 IF NOT busy AND NOT Error THEN
             ftpClose(bExecute:= FALSE);
             FTPstate := eFTPState.Disconnected;
			 byRetryCounter := 0;
         END_IF
		
	eFTPState.Failure:
		IF StartTrigger.Q THEN
			FTPState := eFTPState.Connecting;
		END_IF	 	
END_CASE

//Retry on error trigger
RTrig_Error(CLK:= Error);
IF RTrig_Error.Q THEN
	IF ByRetryCounter < byMaxRetries THEN
		FTPstate := eFTPState.Disconnected;
		bRetry := TRUE;
		byRetryCounter := byRetryCounter +1;
	ELSE
		FTPstate := eFTPState.Failure;
	END_IF
END_IF

DownloadUpdate := FTPState;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="SystemReboot" Id="{b22a7453-0bab-4a01-b841-7a155b2b3cd3}">
      <Declaration><![CDATA[METHOD SystemReboot : BOOL
VAR_INPUT
END_VAR

VAR_INST
    fbSysRestart 		: TC_Restart; (* Systeemherstartfunctie *)
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbSysRestart();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="WriteLog" Id="{e6cedf14-d7c3-4b70-a4a2-6d73ad5cf5fc}">
      <Declaration><![CDATA[METHOD WriteLog : BOOL
VAR_INPUT
    sMessage : STRING;
END_VAR

VAR_INST
    fbLogWriter 		: FB_FileWrite;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbLogWriter(
fbLogWriter.sFileName := '/usr/local/logs/update_log.txt';
fbLogWriter.sData := sMessage + Char(13) + Char(10);
fbLogWriter.bExecute := TRUE;
WriteLog := fbLogWriter.bDone;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>