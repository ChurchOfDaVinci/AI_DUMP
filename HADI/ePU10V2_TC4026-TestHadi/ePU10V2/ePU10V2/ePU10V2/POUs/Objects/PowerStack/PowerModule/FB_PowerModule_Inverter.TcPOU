<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_PowerModule_Inverter" Id="{d46c8828-6aa7-4a54-9bde-058bed937b2a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PowerModule_Inverter
VAR_IN_OUT
	get									: ST_PowerModule_Get;
	set									: ST_Powermodule_Set;
END_VAR

VAR_IN_OUT CONSTANT
	st_params							: ST_PowerModule_params;									
END_VAR

VAR_INPUT
	b_parallelDrive						: BOOL;
	ControlWord							: ST_InverterControlWord;
	r_InputActiveCurrentLimit			: REAL;
	r_OutputActiveCurrentLimit			: REAL;
	
//current refs for power calc
	r_BaseCurrentRef					: REAL;
	r_BaseRefRampRate					: REAL;
	r_ReactiveCurrentRef				: REAL;
	r_FrequencyDroopOffset				: REAL;
	r_VoltageCorrection					: REAL;
	Powermode							: ePowermodes;
	StartMode							: BOOL;
END_VAR	

VAR
	// Local variables
	//IO variables
	a_StatusDataIN					AT %I* : ARRAY[1..2] OF UINT;
	a_ProcessDataIN					AT %I* : ARRAY[1..16] OF INT;
	a_ControlDataOUT				AT %Q* : ARRAY[1..1] OF UINT;
	a_ProcessDataOUT				AT %Q* : ARRAY[1..16] OF INT;
	
	i_InverterMode					: INT; // 0= AFE, 1= ugrid	
END_VAR

VAR_STAT
	r_DroopMax						: REAL;
	r_DroopMin						: REAL;
	r_DroopIsland					: REAL;
	
	//Power mode final
	w_StartPowerMode				: WORD;  // 0= Zero D7, 1= Zero Supply, 2= Droop, 3= iso
	w_StartVoltageMode				: WORD;	// 0= Zero D7, 1= Droop, 2= Keep reactive Ref (iso)
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[
// Read data
Read();

//Watchdog Feedback and pulse
WatchdogTimer();

//Setpowermode
SetPowermode();

//Write data
Write(get, st_params);
]]></ST>
    </Implementation>
    <Folder Name="PrivatMethods" Id="{c46ffe50-53d5-43ad-90a9-e5122e92fd0b}" />
    <Method Name="AFE" Id="{6e1851d7-f357-44eb-9fc2-e91b62157531}" FolderPath="PrivatMethods\">
      <Declaration><![CDATA[METHOD AFE : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[i_invertermode	:= 0; //AFE
r_DroopMin := set.r_DroopMaximum;
r_DroopMax := set.r_DroopMaximum;]]></ST>
      </Implementation>
    </Method>
