    <Method Name="Write" Id="{b5780ef4-affa-497c-8de8-e7f6587f30c9}">
      <Declaration><![CDATA[METHOD Write : BOOL
VAR_IN_OUT
	get : ST_Powermodule_get;
END_VAR

VAR_IN_OUT CONSTANT
	st_params							: ST_PowerModule_params;									
END_VAR

VAR_INST
	b_rampEnable						: BOOL := TRUE;		
	fb_Ramp_OutactLim					: FB_Ramp := (r_RampRate:=100);
	fb_Ramp_InActLim					: FB_Ramp := (r_RampRate:=100);	
	
	r_FreqDroopAct						: REAL;
	r_VoltDroopAct						: REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fb_Ramp_OutActLim(IN:=r_OutputActiveCurrentLimit, b_enable:= b_rampEnable);
fb_Ramp_InActLim(IN:=r_InputActiveCurrentLimit, b_enable:= b_rampEnable);

IF get.e_PowerMode = ePowerModes.Isochronous OR startmode THEN
	r_FreqDroopAct := set.r_DroopMaximum;
	r_VoltDroopAct := set.r_DroopMaximum;
ELSE
	r_FreqDroopAct := LIMIT(r_DroopMin, set.r_FrequencyDroop, r_DroopMax);
	r_VoltDroopAct := LIMIT(r_DroopMin, set.r_VoltageDroop, r_DroopMax);
END_IF

//get
get.controldata.Controlword := controlword;
get.controldata.i_invertermode := i_invertermode;
get.controldata.i_BaseCurrentRef := RealToInt(r_BaseCurrentRef, 0.1, 0);
get.controldata.i_ReactiveCurrentRef:= RealToInt(-r_ReactiveCurrentRef, 0.1, 0);
get.controldata.i_FrequencyDroop := RealToInt(r_FreqDroopAct , 0.002, 0); // Convert percentage to  mHz and rescale. So +100% ==> +5000.0 mHz
get.controldata.i_VoltageDroop := RealToInt(r_VoltDroopAct, 0.01, 0);
get.controldata.i_FrequencyDroopOffset := RealToInt(r_FrequencyDroopOffset, 0.01, 0);
get.controldata.i_VoltageCorrection := RealToInt(r_VoltageCorrection, 1, 0);
get.controldata.i_BaseRefRampRate := LIMIT(-1, RealToInt(r_BaseRefRampRate, 1, 0),10000);
get.controldata.i_StartPowerMode := WORD_TO_INT(w_StartPowerMode);
get.controldata.i_StartVoltageMode := WORD_TO_INT(w_StartVoltageMode);
get.controldata.i_OutActCurrentLimit := RealToInt(fb_Ramp_OutActLim.Q, 0.1, 0);
get.controldata.i_InActCurrentLimit := RealToInt(fb_Ramp_InActLim.Q, 0.1, 0);
get.controldata.i_DCVramprate :=  LIMIT(-1, st_params.i_DCVramprate, 10000);
get.r_FrequencyDroop := r_FreqDroopAct;
get.r_VoltageDroop := r_VoltDroopAct;



get.controldata.ui_controlwordvalue	:= PackWord(
	b0:=ControlWord.b_ChargeDC,
	b1:= TRUE, //b_MccbCloseEnable,
	b2:= TRUE,//set.b_QuickstopInactive,
	b3:= SEL(set.b_RunEnable, FALSE, ControlWord.b_Run),
	b4:=TRUE, //b_OutputpowerLimits,
	b5:=TRUE, //b_PowerIncreaseEnable,
	b6:=TRUE,//b_InputpowerLimits,
	b7:= ControlWord.b_Reset,
	b8:=0,
	b9:=0,
	b10:= ControlWord.b_FieldbusControlEnable,
	b11:= ControlWord.b_WatchdogPulse,
	b12:= ControlWord.b_ParallelAFE, // ID1501
	b13:= ControlWord.b_GridCodeEnable,
	b14:= ControlWord.b_ExtGridcodeTrip, // ID3310
	b15:=0
);

a_ControlDataOUT[1]	:= get.controldata.ui_controlwordvalue;
a_ProcessDataOUT[1] := get.controldata.i_invertermode;
a_ProcessDataOUT[2] := get.controldata.i_BaseCurrentRef;
a_ProcessDataOUT[3] := get.controldata.i_ReactiveCurrentRef;
a_ProcessDataOUT[4]	:= get.controldata.i_FrequencyDroop;
a_ProcessDataOUT[5]	:= get.controldata.i_VoltageDroop;
a_ProcessDataOUT[6]	:= get.controldata.i_FrequencyDroopOffset;
a_ProcessDataOUT[7]	:= get.controldata.i_VoltageCorrection;
a_ProcessDataOUT[8]	:= get.controldata.i_BaseRefRampRate;
a_ProcessDataOUT[9]	:= get.controldata.i_StartPowerMode;
a_ProcessDataOUT[10]:= get.controldata.i_StartVoltageMode;
a_ProcessDataOUT[11]:= get.controldata.i_OutActCurrentLimit;
a_ProcessDataOUT[12]:= get.controldata.i_InActCurrentLimit;
a_ProcessDataOUT[13]:= get.controldata.i_DCVramprate;
//a_ProcessDataOUT[14]	:= RESERVE;
//a_ProcessDataOUT[15]	:= RESERVE;
//a_ProcessDataOUT[16]	:= RESERVE;

(*
INVERTER CONTROLS:
FBFixedCW				: ID1160, Vacon AFE 2 Profile (3) to be set in NCDRIVE
1.ControlMode				: ID1531, 0: AFE, 1: Ugrid, 2: Island
2.BaseCurrentReference		: ID1533, unit: % of rated power
3.ReactiveCurrentReference	: ID1459, unit: % of rated power
4.FrequencyDroop			: ID1534, unit: Hz
5.VoltageDroop				: ID1535, unit: % of Nominal Voltage
6.FrequencyDroopOffset		: ID1791, unit: Hz
7.VoltageCorrection			: ID1790, unit: V
8.BaseRefRampRate			: ID1536, unit: % base current ref / s 
9.StartPowerMode			: ID1503, 0: Start zero activePower D7 card, 1: start zero activepower drive, 2: Droop, 3: Isochronous (keep reference)
10.StartVoltageMode			: ID1641, 0:Start zero reactive power D7 card, 1: Droop, 2: Keep Reference
11.OutputActivePowerLimit	: ID1288, unit: % of rated current
12.InputActivePowerLimit 	: ID1287, unit: % of rated current
13.							: SPARE
14.							: SPARE
15.							: SPARE	
16.							: SPARE



OPTIONALLY:
IF above Powerlimit is not working in ugrid mode:
CurrentLimitMin
CurrentLimitMax
IF HV ramp is not working in ugrid, add
BaseCurrentRefRampRate 	:ID1536



DESCRIPTION:
Als er geen communicatie tussen parallele power systemen is: Droop mode of start zero Q/P
Als er WEL communicatie tussen parallele power systemen is: Keep reference 

*)]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>