    <Method Name="SetPowerMode" Id="{3ac5dfe4-1775-4bfb-ba4e-f10beeccc96c}" FolderPath="PrivatMethods\">
      <Declaration><![CDATA[METHOD PRIVATE SetPowerMode : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[// SET Powermodes
CASE Powermode OF
	ePowermodes.DroopZeroStart : 
		get.e_PowerMode			:= ePowerModes.DroopZeroStart;
		w_StartPowerMode		:= 0;
		w_StartVoltageMode		:= 0;
	ePowermodes.Droop :
		get.e_PowerMode			:= ePowerModes.Droop;
		w_StartPowerMode		:= 2;
		w_StartVoltageMode		:= 1;
	ePowermodes.Isochronous :
		get.e_PowerMode			:= ePowerModes.Isochronous;
		w_StartPowerMode		:= 3;
		w_StartVoltageMode		:= 2;
END_CASE

IF startmode THEN
	get.e_PowerMode			:= ePowerModes.DroopZeroStart;
	w_StartPowerMode		:= 0;
	w_StartVoltageMode		:= 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="UnpackWord" Id="{28e30671-aa1c-4cfc-8824-52aa81bbf96a}" FolderPath="PrivatMethods\">
      <Declaration><![CDATA[METHOD PRIVATE UnpackWord : BOOL
VAR_INPUT
	w_IN			: WORD;
END_VAR

VAR_OUTPUT
	b0			: BOOL;
	b1			: BOOL;
	b2			: BOOL;
	b3			: BOOL;
