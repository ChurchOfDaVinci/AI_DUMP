	b11			: BOOL;
	b12			: BOOL;
	b13			: BOOL;
	b14			: BOOL;
	b15			: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[b0 := w_IN.0;
b1 := w_IN.1;
b2 := w_IN.2;
b3 := w_IN.3;
b4 := w_IN.4;
b5 := w_IN.5;
b6 := w_IN.6;
b7 := w_IN.7;
b8 := w_IN.8;
b9 := w_IN.9;
b10 := w_IN.10;
b11 := w_IN.11;
b12 := w_IN.12;
b13 := w_IN.13;
b14 := w_IN.14;
b15 := w_IN.15;]]></ST>
      </Implementation>
    </Method>
    <Method Name="WatchdogTimer" Id="{8113bd2a-2c68-4e84-96e6-9fd696c997a3}">
      <Declaration><![CDATA[METHOD PRIVATE WatchdogTimer : BOOL 

VAR_INST
	t_WatchdogFb1				: TON;
	t_WatchdogFB2				: TON;
	t_WatchdogTimer1			: TON;
	t_WatchdogTimer2			: TON;
	b_WatchdogPulseFalse		: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <NWL>
