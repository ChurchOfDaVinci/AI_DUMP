    <Method Name="Island" Id="{9c55efe6-ad1f-4387-9c8f-81ad1bf9e9ee}" FolderPath="PrivatMethods\">
      <Declaration><![CDATA[METHOD Island : BOOL
VAR_INPUT
	soft	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[i_invertermode := 2; //Ugrid
r_DroopMin:= set.r_DroopIslandMode;
r_DroopMax:= set.r_DroopIslandMode;


IF soft THEN
	powermode := ePowermodes.DroopZeroStart;
	r_DroopMin:= 1;
	r_DroopMax:= 1;
ELSE
	powermode := ePowermodes.Droop;
	r_DroopMin:= set.r_DroopIslandMode;
	r_DroopMax:= set.r_DroopIslandMode;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Microgrid" Id="{8bd047ba-18ed-47f3-a41f-37ef4f331b80}" FolderPath="PrivatMethods\">
      <Declaration><![CDATA[METHOD Microgrid : BOOL

VAR_INPUT
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[i_invertermode := 2; //Ugrid
r_DroopMin := set.r_DroopMinimum;
r_DroopMax := set.r_DroopMaximum;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Read" Id="{8bf5c4f9-5a9b-4433-8d20-c099c96fde9a}">
      <Declaration><![CDATA[METHOD Read : BOOL

VAR_INST
	w_MicrogridStatusWord		: WORD;
	w_FaultStatusWord1			: WORD;
	w_FaultStatusWord2			: WORD;
	w_GridcodeStatusWord		: WORD;
	w_ModulationIndex			: WORD;
	ModulationIndexMA			: fb_MovingAverage := (enable := TRUE,  length:= 100);
END_VAR


]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Convert get.RawReadData to right data type and range.
	w_MicrogridStatusWord		:= TO_WORD(a_ProcessDataIn[1]); 
	get.r_DCVoltage 			:= INT_TO_REAL(a_ProcessDataIn[2]);
	get.r_DCCurrent				:= -INT_TO_REAL(a_ProcessDataIn[3]);
	get.r_D7SyncError			:= scale(r_in:= INT_TO_REAL(a_ProcessDataIn[4]), In_min :=-3072, In_max:=3071, Out_min:=-180, Out_max:= 180);
	get.r_ActiveCurrent			:= IntPercentageToReal(a_ProcessDataIn[5], st_params.r_InverterRatedCurrent);
	get.r_ReactiveCurrent		:= IntPercentageToReal(a_ProcessDataIn[6], st_params.r_InverterRatedCurrent);
	get.r_ACVoltageD7			:= INT_TO_REAL(a_ProcessDataIn[7]);
	get.r_FrequencyD7			:= MAX(0, INT_TO_REAL(a_ProcessDataIn[8]))/100;
	get.r_TemperatureInverter	:= INT_TO_REAL(a_ProcessDataIn[9]);
	get.r_ACVoltageSupply		:= INT_TO_REAL(a_ProcessDataIn[10])/10;
	get.r_FrequencySupply		:= MAX(0, INT_TO_REAL(a_ProcessDataIn[11]))/100;
	get.r_ACCurrent				:= INT_TO_REAL(a_ProcessDataIn[12]);
	w_FaultStatusWord1			:= TO_WORD(a_ProcessDataIn[13]);
	w_FaultStatusWord2			:= TO_WORD(a_ProcessDataIn[14]);
	w_GridcodeStatusWord		:= TO_WORD(a_processDataIN[15]);
	w_modulationIndex			:= TO_WORD(a_processDataIN[16]);

ModulationIndexMA(IN := TO_REAL(w_modulationIndex)/ 10, Q => get.r_ModulationIndex);

//UNPACK General Status Word
UnpackWord(
	w_IN:= TO_WORD(a_StatusDataIn[1]),
	b0=>get.StatusWord.b_ReadyToDCCharge,
	b1=>get.StatusWord.b_ReadyToOperate,
	b2=>get.StatusWord.b_Running,
	b3=>get.StatusWord.b_Fault,
	b4=>get.StatusWord.b_RunEnabled,
	b5=>get.StatusWord.b_QuickstopNotActive,
	b6=>get.StatusWord.b_MCCBControlNotOK,
	b7=>get.StatusWord.b_Warning,
	b8=>get.StatusWord.b_DCAtReference,
	b9=>,
	b10=>get.StatusWord.b_DCAboveLimit,
	b11=>,
	b12=>,
	b13=>,
	b14=>,
	b15=>get.StatusWord.b_WatchdogFeedback,
);

get.ui_InverterCommStatus := a_StatusDataIn[2];

//UNPACK Ugridword 
UnpackWord(
	w_IN:= w_MicrogridStatusword,
	b0=>Get.UgridStatusWord.b_ChargeControlActive,
	b1=>get.UgridStatusWord.b_InternalChargingSwitchStatus,
	b2=>get.UgridStatusWord.b_MCBcontrol,
	b3=>Get.UgridStatusWord.b_MCBStatus,
	b4=>Get.UgridStatusWord.b_RunEnabled,
	b5=>Get.UgridStatusWord.b_DriveReady,
	b6=>Get.UgridStatusWord.b_AFEmodeActive,
	b7=>Get.UgridStatusWord.b_IslandModeActive,
	b8=>Get.UgridStatusWord.b_MicrogridModeActive,
	b9=>Get.UgridStatusWord.b_RunRequestActive,
	b10=>Get.UgridStatusWord.b_DriveInRunState,
	b11=>Get.UgridStatusWord.b_FaultActive,
	b12=>Get.UgridStatusWord.b_SynchronizedToD7,
	b13=>,
	b14=>Get.UgridStatusWord.b_D7MeasurementsOK,
	b15=>
);

//get mccbfb from inverter ugrid word.
Get.b_MccbFb := get.UgridStatusWord.b_MCBStatus;

//UNPACK Fault Word
UnpackWord(
	w_IN:= w_FaultStatusWord1,
	b0=>get.Events.b_F1OverCurrent,
	b1=>get.Events.b_F2OverVoltage,
	b2=>get.Events.b_F9UnderVoltage,
	b3=>get.Events.b_F91ShortCircuit,
	b4=>get.Events.b_F3EarthFault,
	b5=>,
	b6=>get.Events.b_F14UnitOverTemperature,
	b7=>get.Events.b_F56TemperatureFault,
	b8=>get.Events.b_F10LineSynchFault,
	b9=>,
	b10=>,
	b11=>get.Events.b_F52KeypadOCCommFault,
	b12=>get.Events.b_F53FieldbusFault,
	b13=>get.Events.b_F59SystembusFault,
	b14=>get.Events.b_F54SlotCommunicationFault,
	b15=>get.Events.b_F50Meas4mAFault
);

UnpackWord(
	w_IN:= w_FaultStatusWord2,
	b0=>get.Events.b_F11OutputPhaseFault,
	b1=>get.Events.b_F80ChargeFault,
	b2=>,
	b3=>,
	b4=>,
	b5=>,
	b6=>get.Events.b_F51ExternalFault,
	b7=>,
	b8=>,
	b9=>get.Events.b_F31IGBTFault,
	b10=>,
	b11=>,
	b12=>,
	b13=>,
	b14=>get.Events.b_F64MCBstateFault,
	b15=>
);

UnpackWord(
	w_IN:= w_GridcodeStatusWord,
	b0=>get.GridcodeStatusWord.b_LineVoltTripLimHigh,
	b1=>get.GridcodeStatusWord.b_LineVoltTripLimLow,
	b2=>get.GridcodeStatusWord.b_LineFreqTripLimHigh,
	b3=>get.GridcodeStatusWord.b_LineFreqTripLimLow,
	b4=>,
	b5=>,
	b6=>,
	b7=>,
	b8=>,
	b9=>,
	b10=>,
	b11=>get.GridcodeStatusWord.b_LineFreqOK,
	b12=>get.GridcodeStatusWord.b_LineVoltOK,
	b13=>get.GridcodeStatusWord.b_FRTActive,
	b14=>,
	b15=>get.GridcodeStatusWord.b_GridCodeTripActive
);


(*
INFO VACON IDs

Status word				: ID68, see ARFIF106 manual
1.Line state word		: ID3547,  (gridcode state) --> shift down
1.MicroGridSW			: ID1701, see ARFIF106 manual
2.DCVoltage				: ID1108, unit: VDC
3.DCCurrent				: ID72, Unit: Ampere DC
4.D7 Sync Error 		: ID1659, Unit: degree -3072...+3071 = -180...180 degrees.
5.ActiveCurrent			: ID1125, Unit: % of rated current
6.ReactiveCurrent 		: ID1157, Unit: % of rated current 
7.Line Voltage D7		: ID1650, Unit: VAC
8.Frequency D7			: ID1654, Unit: Hz
9.Unit temperature		: ID1109, Unit: C
10.Line voltage Supply	: ID1107, Unit: VAC
11.Frequency Supply		: ID1	, Unit: Hz
12.Total current 		: ID1104, Unit: A
13.
14.Fault Word 1		: ID1172, See ARFIF106 manual
15. 
16.

*)

]]></ST>
      </Implementation>
    </Method>
