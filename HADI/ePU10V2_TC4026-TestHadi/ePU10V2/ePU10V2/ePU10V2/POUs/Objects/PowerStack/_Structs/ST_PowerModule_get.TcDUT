  <DUT Name="ST_PowerModule_get" Id="{446db9b4-4881-4ed6-ae13-906a384fa929}">
    <Declaration><![CDATA[TYPE ST_PowerModule_get :
STRUCT
	b_online						: BOOL;

	r_ApparentPower					: REAL;
	r_ActivePower					: REAL;
	r_ReactivePower					: REAL;
	r_ACVoltageD7					: REAL;
	r_VoltageDroop					: REAL;
	r_ACVoltageSupply				: REAL;
	r_FrequencyD7					: REAL;
	r_FrequencyDroop				: REAL;
	r_FrequencySupply				: REAL;
	r_CurrentUnbalance				: REAL;
	r_DCPower						: REAL;
	r_DCVoltage						: REAL;
	r_DCCurrent						: REAL;
	r_ACCurrent						: REAL;
	r_ActiveCurrent					: REAL;
	r_ReactiveCurrent				: REAL;
	r_LoadPercent					: REAL; //%
	r_D7SyncError					: REAL;
	r_Pmin							: REAL;
	r_Pmax							: REAL;
	r_QMax							: REAL;
	r_Qmin							: REAL;
	r_Pset							: REAL;
	r_Qset							: REAL;
	r_ACcurrentLimit				: REAL; 
	r_OverCurrentValue				: REAL; // overcurrent ratio 0 .. 1.25 x rated current
	r_ModulationIndex				: REAL;
	
	r_TemperatureInverter			: REAL;
	r_TemperatureGridChoke			: ARRAY [1..3] OF REAL;
	r_TemperatureCMChoke			: ARRAY [1..4] OF REAL;
	r_TemperatureMax				: REAL;
	AddTemperatures					: ST_Inverter_additionalTemperatures;
	w_TemperatureFaultWord			: WORD;
	w_OperationHours				: WORD;
	
	e_PowerMode						: ePowerModes;
	e_InverterMode					: eInverterModes;
	e_Status						: eStatusPowermodule;
	e_ThrottlingStatus					: ePowerModuleThrottlingState;		
	ui_InverterCommStatus			: UINT;
	ui_BuscouplerCommStatus			: UINT;
	
	b_MccbTripOK					: BOOL;
	b_MccbUvr24VdcOK				: BOOL;
	b_MccbFb						: BOOL;
	b_FanFb							: BOOL;
	b_DCcontactorFb					: BOOL;
	b_PrechargeContactor			: BOOL;
	b_LimiterActive					: BOOL;
	eConditioningRequirement		: eConditioningRequirement;
	b_FlowSwitchOK					: Bool;
	
	StatusWord						: ST_Inverter_StatusWord;
	UgridStatusWord					: ST_Inverter_UgridStatusWord;
	GridcodeStatusWord				: ST_Inverter_LineState;
	Events							: ST_Powermodule_Events;
	controldata						: ST_Inverter_write;
	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
