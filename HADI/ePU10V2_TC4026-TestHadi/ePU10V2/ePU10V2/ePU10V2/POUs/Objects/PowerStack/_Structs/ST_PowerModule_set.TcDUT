  <DUT Name="ST_PowerModule_set" Id="{ac985310-bb4c-47ce-a1a3-deb434b463ac}">
    <Declaration><![CDATA[TYPE ST_PowerModule_set :
STRUCT
	//commands
	b_RunEnable						: BOOL;
	r_ActivePower					: REAL;
	r_ReactivePower					: REAL;
	r_NomFrequency					: REAL;
	r_NomVoltage					: REAL;
	r_FrequencyDroop				: REAL;
	r_VoltageDroop					: REAL;
	r_Pmax							: REAL;
	r_Pmin							: REAL;
	r_ACcurrentLimit				: REAL;
	i_PowerChangeRate				: INT; // % nominal power / s
	r_overcurrentFactor				: REAL;
	r_DroopMinimum					: REAL := 0.1;
	r_DroopIslandMode				: REAL := 0.1;
	r_DroopMaximum					: REAL := 10; //%
	
	//WRITE DATA Buscoupler
	b_FanContactor					: BOOL;
	b_D7SyncRequest					: BOOL;
	b_QuickstopInactive				: BOOL;
	b_gridcodeEnable				: BOOL;
	b_ExtgridCodeTrip				: BOOL;
END_STRUCT
END_TYPE
]]></Declaration>
