<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_SystemControl" Id="{80088fce-282f-4b1a-b9ec-9bb5f8a72aa2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_SystemControl
VAR_IN_OUT
	st_params								: ST_System_params;
	st_calibration							: ST_System_calibration;
	monitor								   	: ST_System_Monitor;
	control									: ST_System_Control;
END_VAR

VAR
	//fbs
	b_calibrationRunning					: BOOL;
	PowerControl							: FB_PowerControl;
	GenGridControl							: FB_GenGridController;
	r_trigStoreMachineSettings				: R_TRIG;
	
	b_skipPowerTest								: BOOL := TRUE;
	b_StoreMachineSettings						: BOOL;
	b_loadonly									: BOOL;
	sMessage									: STRING;	

	buffer										: ARRAY [0..24] OF WORD;		

END_VAR

VAR_OUTPUT
	toSystem								: ST_System_set();
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//call methods
CalculateEfficiency(
	powerstack := monitor.powerstack, 
	powermonitor := monitor.powermonitor, 
	system := monitor.system,
	battery := monitor.battery);
	
FillSystemMonitoringVars();

MapUsercontrolsToSystemVars();

GetEvents();

//store machine settings
r_trigStoreMachineSettings(CLK := settings.Save OR settings.Load);
IF r_trigStoreMachineSettings.Q THEN
	b_StoreMachineSettings := TRUE;
END_IF

IF b_StoreMachineSettings AND_THEN storeSettings(TRUE, settings.Save) THEN;
	b_StoreMachineSettings := FALSE;
END_IF

//calibration script
IF NOT st_calibration.Powerstack.Slave.b_StartCalibration THEN
	PowerstackCalibration(start := st_calibration.Powerstack.Master.b_StartCalibration, skippowertest := b_skipPowerTest, loadonly := b_loadonly,   
		powerstack := monitor.powerstack,
		powermoduleCalib := st_calibration.Powerstack.Master,
		PMeasured := monitor.powermonitor.OutputField.ar_ActivePower[0],
		QMeasured := monitor.powermonitor.OutputField.ar_ReactivePower[0],
		sMessage => sMessage);
ELSIF NOT st_calibration.Powerstack.Master.b_StartCalibration THEN
	PowerstackCalibration(start := st_calibration.Powerstack.Slave.b_StartCalibration, skippowertest := b_skipPowerTest, loadonly := b_loadonly,   
		powerstack := monitor.powerstack,
		powermoduleCalib := st_calibration.Powerstack.Slave,
		PMeasured := monitor.powermonitor.OutputField.ar_ActivePower[0],
		QMeasured := monitor.powermonitor.OutputField.ar_ReactivePower[0],
		sMessage => sMessage);
END_IF
b_calibrationRunning := settings.Calibration.Powerstack.Master.b_StartCalibration OR settings.Calibration.Powerstack.Slave.b_StartCalibration;


UpdateSystemTime();]]></ST>
    </Implementation>
    <Folder Name="MapUserControls" Id="{e317cc20-b8c7-40c1-90fb-f89a885a87cd}" />
    <Folder Name="Nested Methods" Id="{91f678d8-34d0-4f15-851f-53116a7d863f}">
      <Folder Name="CalibrationData" Id="{4a10be61-d1c6-4857-bb52-89910a20f797}" />
    </Folder>
    <Method Name="CalculateEfficiency" Id="{b9132480-21ec-4ac3-8cdc-f0a527c48fe2}" FolderPath="Nested Methods\">
      <Declaration><![CDATA[METHOD PRIVATE CalculateEfficiency : BOOL
VAR_IN_OUT
	powerstack 				: st_Powerstack_get;
	powermonitor			: st_powermonitor_get;
	system					: ST_system_get;
	battery					: ST_bms_get;
END_VAR

VAR_INST
	r_RawEfficiency	: REAL;
	r_AverageEfficiency: REAL;
	r_RoundtripEfficiency: REAL;
	
	
	ton_SumTimer			: TON :=(PT := T#100ms);
	r_EfficiencySum			: REAL;
	w_AverageSumCounter			: WORD;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[r_RawEfficiency := ABS(powerstack.r_DCPower) / MAX(1,ABS(powermonitor.InputField.ar_ActivePower[0] + powermonitor.OutputField.ar_ActivePower[0])) * 100;

system.r_CurrentEfficiency := LIMIT(0, r_rawEfficiency, 99.8);

//manual averaging of the last hour of operation
ton_SumTimer(IN := NOT ton_SumTimer.Q);
IF powerstack.b_StartedState AND ton_SumTimer.Q THEN
	//reset counter and sum after 3000 samples +- 5min.
	IF w_AverageSumCounter = 3000 THEN
		//increment array index to add new efficiency value until upperbound has been reached.
		r_efficiencySum := r_efficiencySum - r_AverageEfficiency + system.r_CurrentEfficiency;
	ELSE
		//add new value to the summation
		w_AverageSumCounter := w_AverageSumCounter +1;
		r_EfficiencySum := r_efficiencySum + system.r_CurrentEfficiency;
	END_IF
	
	//System average efficiency during operation
	r_AverageEfficiency := r_EfficiencySum / MAX(1, w_AverageSumCounter);
	system.r_AvgEfficiency := r_AverageEfficiency;
	r_RoundtripEfficiency := LIMIT(0, powermonitor.Inverter.r_EnergySupplied / MAX(1,powermonitor.Inverter.r_EnergyConsumed - Battery.BatteryInfo.r_RemainingDischargeEnergyNett) * 100, 99);
	System.r_RoundtripEfficiency := r_RoundtripEfficiency;
END_IF





]]></ST>
      </Implementation>
    </Method>
    <Method Name="ConfigureOutputContact" Id="{4e9210a3-d285-4c3d-bd99-cd0cd99c0a84}" FolderPath="Nested Methods\">
      <Declaration><![CDATA[METHOD ConfigureOutputContact : BOOL
VAR_INPUT
	SignalSelect			: eOutputContactSignal;
	GensetStartStop			: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE SignalSelect OF
	eOutputContactSignal.FireAlarm 		: ConfigureOutputContact:= monitor.protections.FireDetection.b_FireAlarm;
	eOutputContactSignal.GenStartStop 	: ConfigureOutputContact:= GensetStartStop;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="EMstop" Id="{604c76fd-14d0-4f9f-9eed-a29665787efd}">
      <Declaration><![CDATA[METHOD EMstop : BOOL
VAR_INPUT
END_VAR

VAR_INST
	ton_FBdelay : TON := (PT:= T#20MS);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[EMstop := FALSE;
ton_FBdelay(IN:= TRUE);

IF ton_FBdelay.Q THEN
	ton_FBdelay.IN := FALSE;
	EMstop := TRUE;
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="FillSystemMonitoringVars" Id="{960a52bb-9693-4a14-9722-711dbd0dc6dd}">
      <Declaration><![CDATA[METHOD FillSystemMonitoringVars : BOOL

VAR_INST
	st_Params_MA			: ST_CTRL_MOVING_AVERAGE_PARAMS;
	ui_filterSize			: UINT := 50;
	fb_AverageEff			: FB_CTRL_MOVING_AVERAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[monitor.b_modeSwitchEnable := monitor.system.e_State = eSystemstate.Off OR 
	monitor.system.e_State = eSystemstate.StandBy OR
	monitor.system.e_State = eSystemstate.Init OR
	monitor.system.e_State = eSystemstate.Conditioning OR
	monitor.system.e_State = eSystemstate.Transport OR 
	monitor.system.e_State = eSystemstate.Dehumidifying OR
	monitor.system.e_State = eSystemState.EMstop; 

//Effiencies
monitor.system.b_StartAllowed := 
	control.HardSettings.system.e_EarthingSystem <> 0 AND
	monitor.powerstack.b_StartEnabled AND monitor.Cooling.ui_DehumRemainingTime = 0;
monitor.system.s_SystemName := Monitor.Router.Mobile.s_EmergencySMSDevName;

CASE toSystem.powerstack.e_Powermode OF
	ePowermodes.Droop: monitor.system.e_UgridPowermode := eUgridPowermode.Droop;
	ePowermodes.DroopZeroStart: monitor.system.e_UgridPowermode := eUgridPowermode.DroopZeroStart;
	ePowermodes.Isochronous: monitor.system.e_UgridPowermode := eUgridPowermode.Isochronous;
END_CASE

CASE toSystem.powerstack.e_InverterMode OF
	eInvertermodes.Afe : 
		monitor.system.e_gridmode := eGridmode.following;
		monitor.system.e_UgridPowermode := eUgridPowermode.None;
	eInvertermodes.Microgrid : monitor.system.e_gridmode := eGridmode.forming;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetDiagnostics" Id="{d9c5c631-8daf-4557-b7ee-b75fbce17ea6}">
      <Declaration><![CDATA[METHOD GetDiagnostics
VAR_IN_OUT
	AddError		: ARRAY [*] OF FB_AddErrorST;
	a_ActiveEvents	: ARRAY [*] OF ST_ErrorStruct;
	w_Index			: WORD;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[GenGridControl.GetDiagnostics(AddError, a_ActiveEvents, w_Index);
PowerControl.GetDiagnostics(AddError, a_ActiveEvents, w_Index);

(*Machine name update pending*) 	AddError[w_Index](
		b_ErrorTrig				:= monitor.system.events.b_RestartRequiredMachineName,
		out_ST_Error			:= a_ActiveEvents[w_Index],
		w_ErrorID				:= 1,
		e_ObjectID				:= eObject_ID.system,
		s_Message				:= 'Machinename update pending in VDL Powernet: System restart required',
		e_sev					:= eseverity.Info
		);
	w_Index := w_Index +1;
	
(*Machine name update pending*) AddError[w_Index](
		b_ErrorTrig				:= monitor.HartingIO.b_ExtSystemShutdownRequest,
		out_ST_Error			:= a_ActiveEvents[w_Index],
		w_ErrorID				:= 2,
		e_ObjectID				:= eObject_ID.system,
		s_Message				:= 'External IO initiated system shutdown',
		e_sev					:= eseverity.NormalShutdown,
		b_autoclear				:= FALSE
		);
	w_Index := w_Index +1;
	
(*time update failed*)	AddError[w_Index](
			b_ErrorTrig				:= monitor.system.events.b_TimeUpdateFailed,
			b_SMSEnableVDL			:= FALSE,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 3,					
			s_Message				:= 'System time update failed',
			e_sev					:= eSeverity.info,
			b_AutoClear				:= TRUE,
			e_ErrAckAccess			:= eErrAckAccess.General
			);
		w_Index := w_Index +1;	]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetEvents" Id="{3333007a-2c08-44e7-9058-6a89010670fd}" FolderPath="Nested Methods\">
      <Declaration><![CDATA[METHOD GetEvents : BOOL
VAR_INPUT
END_VAR

VAR_INST
	s_machineNameOld : STRING;
	initdone		: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT initdone AND monitor.system.s_SystemName <> '' THEN
	s_machineNameOld := monitor.system.s_SystemName;
	initdone := TRUE;
END_IF

monitor.system.events.b_RestartRequiredMachineName := s_machineNameOld <> monitor.system.s_SystemName;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="JsonFileToStruct" Id="{3da0cc58-6182-449d-ad88-97a711d43219}" FolderPath="Nested Methods\CalibrationData\">
      <Declaration><![CDATA[METHOD JsonFileToStruct : BOOL
VAR_INPUT
	bExecute			: BOOL;
	sJsonPathname		: STRING := 'C:\PLC_Utility\CalData_Powerstack.json';
	sStructName			: STRING;
	pStruct				: PVOID;
	nStruct				: UDINT;
	WriteMode			: BOOL;
	
END_VAR

VAR_OUTPUT
	Busy			: BOOL;
	Error			: BOOL;
	sMessage		: STRING;
END_VAR

VAR_INST
	bEnableCreateFile 	: BOOL := TRUE;
	SfcstepPrev		: BYTE;
	SFCTransAllowed	: BOOL;
	tofSFCstepDelay	: TOF := (PT := T#20MS);
	fbFileRead 		: FB_FileRead;
	fbFileWrite		: FB_FileWrite;
	fbFileOpen		: FB_FileOpen;
	fbFileClose		: FB_FileClose;
	sErrorMessage	: STRING;
	bLoading 		: BOOL;
	ton_executedelay	: TON := (PT := T#10MS);
	SFCstep			: BYTE;
	bLoad			: BOOL;
	bError			: BOOL;
	bfileOpened		: BOOL;
	hrErrorCode		: HRESULT;
	fbJson         : FB_JsonSaxWriter;
  	fbJsonDataType : FB_JsonReadWriteDataType;
  	sJsonDoc     	: STRING(10000);
	nBytesRead		: UDINT;
	b_CreateNewFile 	: BOOL;
	bOpenExecute		: BOOL;
	bReadExecute		: BOOL;
	bWriteExecute		: BOOL;
	bCloseExecute		: BOOL;
	nModeSel			: DWORD;	
	udLength			: UDINT;
	tDelayWriting		: TON := (PT := T#50MS);
	bEnable : BOOL := FALSE;
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ 

IF NOT ton_executedelay.Q THEN
	sfcstep := 0;
END_IF

IF pStruct = 0 THEN
	sfcstep := 99;
	sErrorMessage := 'Invalid pointer to struct';
ELSIF nStruct = 0 THEN
	sfcstep := 99;
	sErrorMessage := 'Invalid size of struct';
END_IF

//transition delay logic.
tofSFCstepDelay(IN := SFCstep <> SFCstepPrev);
SFCTransAllowed := NOT tofSFCstepDelay.Q AND bLoading;

CASE SFCstep OF
0: //idle
bEnable := FALSE;
	bLoading := FALSE;
	bError := FALSE;
	SFCTransAllowed := FALSE;
	bOpenExecute 			:= FALSE;
	bReadExecute 			:= FALSE;
	bWriteExecute 			:= FALSE;
	bCloseExecute 			:= FALSE;
	bEnableCreateFile 		:= FALSE;
	
	ton_executedelay(IN := bExecute);
	
	IF ton_executedelay.Q THEN
		sfcstep := SEL(writemode OR b_CreateNewFile, 1, 2);
		nModeSel 		:= SEL(sfcstep = 1, FOPEN_MODEWRITE,FOPEN_MODEREAD);
		sErrorMessage := '';
		bLoading := TRUE;	
	END_IF
	
1: 	//open file
	sJsonDoc := '';
	nModeSel 				:= FOPEN_MODEREAD;
	bReadExecute 			:= FALSE;
	bWriteExecute 			:= FALSE;
	bCloseExecute 			:= FALSE;
	bOpenExecute 			:= SFCTransAllowed;
	
	
	IF bEnable THEN 
	//IF SFCTransAllowed THEN
		IF fbFileOpen.hfile <> 0 AND NOT fbFileOpen.bBusy AND NOT fbFileOpen.bError THEN
			SFCstep := 10;
			bEnable := FALSE;
		ELSIF fbFileOpen.bError THEN
			sErrorMessage := CONCAT('Error opening file: sfc step ', TO_STRING(sfcstep));
			sfcstep := SEL(bEnableCreateFile, 97, 2);
		END_IF
	END_IF
	
2: //create file if non existing
	sJsonDoc := '';
	b_createNewFile := FALSE;
	nModeSel 				:= FOPEN_MODEWRITE;
	bReadExecute 			:= FALSE;
	bWriteExecute 			:= FALSE;
	bCloseExecute 			:= FALSE;
	bOpenExecute 			:= SFCTransAllowed;

	
	IF bEnable THEN 
		IF fbFileOpen.hfile <> 0 AND NOT fbFileOpen.bBusy AND NOT fbFileOpen.bError THEN
			sErrorMessage := 'New file created';
			sJsonDoc 		:= '';
			MEMSET(ADR(sJsonDoc), 0, SIZEOF(sJsonDoc));
			SFCstep := 3;
			bEnable := FALSE;
		ELSIF fbFileOpen.bError THEN
			sErrorMessage := CONCAT('Error opening and creating file: sfc step ', TO_STRING(sfcstep));
			sfcstep := 97;
		END_IF
	END_IF
	
3: //Write current struct values to new Json string
//	IF LEN(sJsonDoc) = 0 THEN
		fbJson.ResetDocument();
		fbJsonDataType.AddJsonValueFromSymbol(fbJson, sStructName, nStruct, pStruct, hrErrorCode => hrErrorCode);
		udLength := fbJson.GetDocumentLength();
		fbJson.CopyDocument(sJsonDoc, udLength);
//	END_IF
	
	IF SFCTransAllowed THEN
		IF hrErrorCode = 0 THEN
			bError := FALSE;
			sfcstep := 4; //final step
		ELSE
			bError := TRUE;
			sErrorMessage := CONCAT('Error generating json string: SFC step ', TO_STRING(sfcstep));
			sfcstep := 97; //error step
		END_IF
	END_IF
	
4: //write json string to file
	bReadExecute 	:= FALSE;
	bOpenExecute 	:= FALSE;
	bCloseExecute 	:= FALSE;
	bWriteExecute 	:= SFCTransAllowed;
	
	IF SFCTransAllowed THEN
		IF NOT fbFileWrite.bBusy AND NOT fbFileWrite.bError THEN
			SFCstep := 97;
			bEnable := FALSE;
		ELSIF fbFileWrite.bError THEN
			sErrorMessage := CONCAT('Error writing file: sfc step ', TO_STRING(sfcstep));
			sfcstep := 97;
		END_IF
	END_IF
		
10: //Read File
	sJsonDoc 		:= '';
	bOpenExecute 	:= FALSE;
	bWriteExecute 	:= FALSE;
	bCloseExecute 	:= FALSE;
	bReadExecute 	:= SFCTransAllowed;
	
	IF SFCTransAllowed THEN
		IF NOT fbFileRead.bBusy AND NOT fbFileRead.bError THEN
			SFCstep := 11;
			bEnable := FALSE;
		ELSIF fbFileRead.bError THEN
			sErrorMessage := CONCAT('Error reading file: sfc step ', TO_STRING(sfcstep));
			sfcstep :=  97;
			b_createNewFile := bEnableCreateFile;
		END_IF
	END_IF

	
11: //Convert buffer to struct
	fbJsonDataType.SetSymbolFromJson(sJsonDoc, sStructName, nStruct, pStruct, hrErrorCode => hrErrorCode);
	
	IF SFCTransAllowed THEN
		
		IF hrErrorCode = 0 THEN
			bError := FALSE;
			sfcstep := 97; //final step
		ELSE
			bError := TRUE;
			sErrorMessage := CONCAT('Error writing file to struct: sfc step ', TO_STRING(sfcstep));
			sfcstep := 97;
			b_createNewFile := bEnableCreateFile;	
		END_IF
	END_IF

97: // file opened
	
	bWriteExecute 	:= FALSE;
	bOpenExecute 	:= FALSE;
	bReadExecute 	:= FALSE;
	bCloseExecute 	:= bfileOpened := fbFileOpen.hFile <> 0;

	
	IF SFCTransAllowed THEN
		IF NOT fbFileClose.bBusy AND NOT fbFileClose.bError THEN
			bfileOpened := FALSE;
			sfcstep := 98;
			bEnable := FALSE;
		ELSIF fbFileClose.bError THEN
			sErrorMessage := CONCAT('Error closing file ', TO_STRING(sfcstep));
			bError := TRUE;
			sfcstep := 98;
		END_IF
	END_IF
	
98: 	//feedback and reset method for next request
	IF NOT bError THEN
		sErrorMessage := 'SUCCES';
	ELSE
		Error := TRUE;
	END_IF
	bEnable := FALSE;
	bOpenExecute 		:= FALSE;
	bReadExecute 		:= FALSE;
	bWriteExecute 		:= FALSE;
	bCloseExecute 		:= FALSE;
	ton_executedelay.IN := FALSE;
	sfcstep := 99;
	
	
99: //once here, reset SFC
	IF NOT b_CreateNewFile THEN
		JsonFileToStruct := TRUE;
	END_IF
	sfcstep := 0;
END_CASE
	


fbFileOpen(sPathName:= sJsonPathname , nMode := nModeSel ,bExecute:= bOpenExecute);
fbFileWrite(hFile := fbFileOpen.hFile , pWriteBuff := ADR(sJsonDoc),bExecute := bWriteExecute , cbWriteLen := udLength);
fbFileRead(hFile := fbFileOpen.hFile, pReadBuff := ADR(sJsonDoc), cbReadLen := SIZEOF(sJsonDoc),bExecute := bReadExecute, cbRead => nBytesRead);
fbFileClose(hFile := fbFileOpen.hFile, bExecute := bCloseExecute);

IF fbFileOpen.bBusy AND bOpenExecute THEN
	bOpenExecute := FALSE;
	bEnable := TRUE;
END_IF
//	rTrigExecute(CLK := FALSE);
//	IF NOT rTrigExecute.CLK THEN
//		JsonFileToStruct := TRUE;
SFCstepPrev := SFCstep;

//output data
busy := bLoading;
sMessage := sErrorMessage;



]]></ST>
      </Implementation>
    </Method>
