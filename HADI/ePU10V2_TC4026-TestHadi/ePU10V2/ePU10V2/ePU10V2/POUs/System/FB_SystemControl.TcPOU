    </Method>
    <Method Name="SetPQLimits" Id="{0a2e50ba-aca0-428c-a77c-a40ef6705f6c}" FolderPath="Nested Methods\">
      <Declaration><![CDATA[METHOD SetPQLimits

VAR_INPUT
	r_BatPchargeLim			: REAL;
	r_BatPdischargeLim		: REAL;
	b_BatteryFull			: BOOL;
	b_BatteryEmpty			: BOOL;
	r_ACLinevoltage			: REAL;
	r_PchargeLimHard		: REAL;
	r_PchargeLimSoft		: REAL;
	r_PDischargeLimHard		: REAL;
	r_PDischargeLimSoft		: REAL;
	r_SmaxHard				: REAL;	//kVA
	r_AmaxHard				: REAL; //current
	r_AmaxSoft				: REAL; //current
END_VAR

VAR_OUTPUT
	r_Pmin				: REAL;
	r_PMax				: REAL;
	r_AMax				: REAL;
END_VAR

VAR_INST
	fb_rampPcharge						: FB_ramp := (b_enable := TRUE, r_ramprate := 25);
	fb_rampPdischarge					: FB_ramp := (b_enable := TRUE, r_ramprate := 25);
	fb_rampCurrentLimit					: FB_ramp := (b_enable := TRUE, r_ramprate := 100);
	
	r_BatChargeCorrectionFactor			: REAL := 0.98; // compensates inverter losses and BMS measurement errors
	r_BatDischargeCorrectionFactor		: REAL := 0.99;
	r_Smax								: REAL;
	r_PDischargeLimitUser				: REAL; //Discharging
	r_PChargeLimitUser					: REAL; //Charging
	r_AmaxLimitUser						: REAL;
	r_PmaxbySmax						: REAL;
	r_BatChargePowerLimitCalc			: REAL;
	r_BatDischargePowerLimitCalc		: REAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//user soft limit
fb_rampPcharge(IN := LIMIT(0 ,r_PchargeLimSoft, r_PchargeLimHard));
fb_rampPdischarge(IN := LIMIT(0,r_PDischargeLimSoft, r_PDischargeLimHard));

//current limit
r_AmaxLimitUser := MAX(0, KwToCurrent(r_SmaxHard,r_acLineVoltage), r_AmaxHard);
fb_rampCurrentLimit(IN := LIMIT(0,r_Amaxsoft, r_AmaxLimitUser), Q=> r_AMax);

r_Smax:= CurrentToKw(r_Amax, r_AClinevoltage);
r_PmaxbySmax := r_SMax; //SQRT(MAX(EXPT(r_Smax,2) - EXPT(r_ReaPower, 2),0));

//Set system Variable
r_Pmin := -MIN(ABS(r_BatPchargeLim / r_BatChargeCorrectionFactor), fb_rampPcharge.Q, r_PmaxbySmax);
r_Pmax := MIN(ABS(r_BatPdischargeLim * r_BatDischargeCorrectionFactor),  fb_rampPdischarge.Q, r_PmaxbySmax);

IF b_BatteryFull THEN
	r_Pmin := 0;
ELSIF b_BatteryEmpty THEN
	r_Pmax := 0; //overwrite value from input to 0.
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="shutdown" Id="{d476ef20-e6dd-456d-9d5b-e628a2578fb8}">
      <Declaration><![CDATA[METHOD shutdown : BOOL
VAR_INPUT
END_VAR

VAR_INST
	started : BOOL;
	ton_RetryDelay : TON := (PT := T#2s);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ton_RetryDelay(IN := TRUE);

IF storeSettings(ton_RetryDelay.Q, FALSE) THEN
	shutdown := TRUE;
	ton_RetryDelay(IN := FALSE);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StoreSettings" Id="{213388af-3df9-4880-9930-c0e2dce77aca}" FolderPath="Nested Methods\">
      <Declaration><![CDATA[METHOD StoreSettings : BOOL
VAR_INPUT
	execute : BOOL;
	writeMode: BOOL;
END_VAR

VAR_INST
	rTrigExecute	: R_TRIG;
	b_next : BOOL;
	sfcStep	: BYTE;
	tDelaySFCstep		: TON :=(PT := T#10MS);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[rTrigExecute(CLK := execute);
IF rTrigExecute.Q THEN
	SFCstep := 1;
END_IF

CASE SFCstep OF
	1: b_next := JsonFileToStruct(
		bExecute := TRUE,
		sJsonPathName := 'C:\PLCUtility\MachineSettings.json',
		sStructName := 'ST_System_MachineParams',
		pStruct := ADR(settings.MachineParams),
		nStruct := SIZEOF(settings.MachineParams),
		WriteMode := writeMode,
		sMessage => sMessage
		);
	2: b_next := JsonFileToStruct(
		bExecute := TRUE,
		sJsonPathName := 'C:\PLCUtility\MachineConfig.json',
		sStructName := 'ST_System_Config',
		pStruct := ADR(settings.Configuration),
		nStruct := SIZEOF(settings.Configuration),
		WriteMode := writeMode,
		sMessage => sMessage
		);
	 3: b_next := JsonFileToStruct(
		bExecute := TRUE,
		sJsonPathName := 'C:\PLCUtility\GridSettings.json',
		sStructName := 'ST_System_GridCodeParams',
		pStruct := ADR(settings.GridParams),
		nStruct := SIZEOF(settings.GridParams),
		WriteMode := writeMode,
		sMessage => sMessage
		);
	 4: b_next := JsonFileToStruct(
		bExecute := TRUE,
		sJsonPathName := 'C:\PLCUtility\MachineProperties.json',
		sStructName := 'ST_System_Properties',
		pStruct := ADR(settings.Properties),
		nStruct := SIZEOF(settings.Properties),
		WriteMode := writeMode,
		sMessage => sMessage
		);
	5: b_next := JsonFileToStruct(
		bExecute := TRUE,
		sJsonPathName := 'C:\PLCUtility\CalDat_Powerstack.json',
		sStructName := 'ST_System_Calibration',
		pStruct := ADR(settings.Calibration),
		nStruct := SIZEOF(settings.Calibration),
		WriteMode := FALSE,
		sMessage => sMessage
		);
	ELSE
		SFCstep := 0;
		rTrigExecute(CLK := FALSE);
		StoreSettings := TRUE;	
END_CASE


IF b_next THEN 
	tDelaySFCstep(IN := TRUE);
 	IF tDelaySFCstep.q THEN 
	SFCstep := SFCstep + 1;
		tDelaySFCstep(IN := FALSE);
	END_IF 
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="UpdateSystemTime" Id="{c3cb0c87-8a74-4cfc-a557-923712f0b417}" FolderPath="Nested Methods\">
      <Declaration><![CDATA[METHOD UpdateSystemTime : BOOL
VAR_INST
	SetTime :	NT_SetLocalTime();
	rtrig_AutoUpdate	:	r_Trig;
	ftrig_UpdateDone	:	f_Trig;
	systime				:	Timestruct;

	SystemTimeStamp		:	DINT;
	GPSTimeStamp		:	DINT;
	TON_GpsUpdateReq	:	TON := (PT := T#5M); 
	
	NewTimeString		:	STRING;
	NewTimeStruct		:	Timestruct;

	
	UpdateRequired		:	BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
monitor.system.DT_SystemTime := GVL.dt_SystemDateTime;

//first fix datetime format from teltonika.
IF st_params.SystemTime.AutoSyncToGPS THEN 
	TON_GpsUpdateReq(in := ABS(DT_TO_DINT(monitor.router.GPS.DateTime) - DT_TO_DINT(gvl.dt_SystemDateTime)) > 30);
	IF ton_gpsUpdateReq.Q THEN
		NewTimeStruct := DT_TO_Systemtime(monitor.Router.GPS.DateTime);
		UpdateRequired	:=	TRUE;
	ELSE
		UpdateRequired	:=	FALSE;
	END_IF
ELSE
	IF st_params.SystemTime.ManualSync THEN
		st_params.SystemTime.ManualSync := FALSE;
		NewTimeStruct := DT_TO_SYSTEMTIME(st_params.SystemTime.ManSyncValue);
		UpdateRequired	:=	TRUE;
	END_IF
END_IF
	
SetTime(	TimeSTR := NewTimeStruct, //convert to Systemtime struct and write to plc
	start	:= UpdateRequired,
	TMOUT	:= T#1S);

			
ftrig_UpdateDone(clk := SetTime.BUSY);

IF ftrig_UpdateDone.Q THEN
	UpdateRequired := FALSE;
	monitor.system.events.b_TimeUpdateFailed := FALSE;
	IF SetTime.ERR THEN
		monitor.system.events.b_TimeUpdateFailed := TRUE;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>