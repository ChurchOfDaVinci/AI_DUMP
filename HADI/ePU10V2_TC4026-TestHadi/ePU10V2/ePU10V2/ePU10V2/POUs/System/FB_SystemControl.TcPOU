    <Method Name="PowerstackCalibration" Id="{8b81fc85-34cc-4f1d-81f1-6ff0da9baa8c}" FolderPath="Nested Methods\CalibrationData\">
      <Declaration><![CDATA[METHOD PowerstackCalibration : BOOL

VAR_INPUT
	start 						: BOOL;
	skippowertest				: BOOL;
	loadonly					: BOOL;
END_VAR

VAR_IN_OUT CONSTANT
	powerstack					: ST_Powerstack_get;
END_VAR


VAR_IN_OUT
	powermoduleCalib				: ST_Powermodule_Calibration;
END_VAR

VAR_IN_OUT CONSTANT
	PMeasured					: REAL;
	QMeasured					: REAL;
END_VAR

VAR_OUTPUT
	Error : BOOL;
	Busy : BOOL;
	sMessage : STRING;
END_VAR

VAR_INST
	PSetPoints : ARRAY[0..4] OF REAL := [-250, -125, 0, 125, 250];
    QSetPoints : ARRAY[0..4] OF REAL := [-250, -125, 0, 125, 250];
	
	fTrigStop					: f_TRIG;
	rTrigExecute				: r_trig;
	fbExecuteCalibrationFit 	: NT_StartProcess;
	bFileDeleted				: BOOL;
	fbFileDelete				: FB_FileDelete;
	ton_FileNotExising			: TON := (PT := T#60S);
	bError						: BOOL;
	bBusy						: BOOL;
	
	
	pulseTimer					: TON := (PT := T#1S);
	DelayTimer					: TON := (PT := T#5S);
	i 							: INT 			:=0;
	j 							: INT 			:=0;
	SFCstep						: INT;
	Message					: STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Pset+
IF NOT start THEN
	i 		:= 0;
	j 		:= 0;
END_IF

fTrigStop(CLK := start);
IF fTrigStop.Q THEN
	sfcstep := 99;
END_IF
	

CASE SFCstep OF
	0: 
		ton_FileNotExising(IN := FALSE);
		pulseTimer.IN := FALSE;
		DelayTimer(IN := FALSE);
		rTrigExecute(CLK := START);
		IF rTrigExecute.Q THEN
			IF loadonly THEN
				SFCstep := 4;
			ELSIF skippowertest THEN
				SFCstep := 2;
			ELSE
				SFCstep := 1; 
			END_IF
		END_IF
		
	1: // do calibration and get data
		powermoduleCalib.b_StartCalibration := start AND NOT powerstack.b_InverterGridFormingMode AND powerstack.b_StartedState;
		DelayTimer(IN:=NOT delaytimer.Q AND start);
		powermoduleCalib.CalibrationData.Pset[i]:= powermoduleCalib.r_Pset;
		powermoduleCalib.CalibrationData.Qset[j] := powermoduleCalib.r_Qset;
		powermoduleCalib.r_Pset := PSetPoints[i];
		powermoduleCalib.r_Qset := QSetPoints[j];
		IF delaytimer.Q THEN
			j := j +1;
			
			IF j = 5 THEN
				i := i +1;
				j := 0;
				IF i = 5 THEN
					i 		:= 0;
					j 		:= 0;
					powermoduleCalib.r_Pset := 0;
					powermoduleCalib.r_Qset := 0;
					sfcstep := 2;
					RETURN;
				END_IF
			END_IF
		END_IF
		powermoduleCalib.CalibrationData.Pmeas[i][j] := PMeasured;
		powermoduleCalib.CalibrationData.Qmeas[i][j] := QMeasured;

	
	2:	//export data to json
		powermoduleCalib.b_StartCalibration := TRUE;
		pulseTimer(IN := NOT JsonFileToStruct(
			bExecute := pulseTimer.Q,
			sJsonPathName := 'C:\PLCUtility\CalDat_Powerstack.json',
			sStructName := 'ST_Powerstack_Calibration',
			pStruct := ADR(st_calibration.Powerstack),
			nStruct := SIZEOF(st_calibration.Powerstack),
			WriteMode := TRUE,
			sMessage => Message
			));
		IF NOT pulseTimer.IN THEN
			SFCstep := 3;
		END_IF
	3: //execute calibration python script
		fbExecuteCalibrationFit(
			NETID		:= '',
			PATHSTR		:= 'C:\PLCUtility\CalibrationFit.exe',
			DIRNAME		:= 'C:\PLCUtility',
			START		:= TRUE,
			COMNDLINE	:= '',
			TMOUT		:= T#60S,
			BUSY		=> bBusy,
			ERR			=> bError
		);
		
		ton_FileNotExising(IN := TRUE);
		pulseTimer(IN := NOT fbFileDelete.bExecute AND NOT fbFileDelete.bBusy);
		fbFileDelete(
			sPathName := 'C:\PLCUtility\caliblog.txt');
		fbFileDelete.bExecute := pulsetimer.Q;

		IF fbFileDelete.bExecute AND NOT fbFileDelete.bBusy THEN
			bFileDeleted := NOT fbFileDelete.bERROR;
		END_IF
		
		IF bFileDeleted THEN
			bFileDeleted := FALSE;	
			SFCstep := 4;
			pulseTimer.IN := FALSE;
		ELSIF bError OR ton_FileNotExising.Q THEN
			SFCstep := 99;
		END_IF
	
	4: //Read back calibration file
		powermoduleCalib.b_StartCalibration := FALSE;
		pulseTimer(IN := NOT JsonFileToStruct(
			bExecute := pulseTimer.Q,
			sJsonPathName := 'C:\PLCUtility\CalDat_Powerstack.json',
			sStructName := 'ST_Powerstack_Calibration',
			pStruct := ADR(st_calibration.Powerstack),
			nStruct := SIZEOF(st_calibration.Powerstack),
			WriteMode := FALSE,
			sMessage => Message,
			Error => bError,
			Busy => bBusy
			));
		IF NOT pulseTimer.IN THEN
			SFCstep := 99;
		END_IF
		
	99: //clear all states for next round
		Error := bError; 
		sMessage := Message;
		pulseTimer.IN := FALSE;
		fbExecuteCalibrationFit(START := FALSE);
		DelayTimer.IN := FALSE;
		fbExecuteCalibrationFit.START := FALSE;
		PowerstackCalibration := TRUE;
		SFCstep := 0;
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{ad65bbc2-7efb-47ba-b576-ea2f90bb992f}">
      <Declaration><![CDATA[METHOD Reset : BOOL

]]></Declaration>
