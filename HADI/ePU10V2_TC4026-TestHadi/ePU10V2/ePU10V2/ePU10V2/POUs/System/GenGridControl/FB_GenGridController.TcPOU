<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_GenGridController" Id="{a63d5ed0-c6cf-4c4f-86fc-7fad2a0575f5}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GenGridController
VAR_IN_OUT CONSTANT
	monitor						: ST_System_Monitor;
	st_params					: ST_GenGridController_params;
	control						: ST_System_Control;
END_VAR

VAR_INPUT
	Enable						: BOOL;
	b_ForceOperate				: BOOL;
	b_EMSTOP					: BOOL;
END_VAR

VAR_OUTPUT
	TargetData					: ST_PowerControl_Target;
	InverterMode				: eInverterModes;
	PowerMode					: ePowermodes;
	b_inputContactorClose		: BOOL;
	b_inputContactorOpen		: BOOL;
	b_InputSyncEnable			: BOOL;
	b_ExtContactorClose			: BOOL;
	b_IOStartStop				: BOOL;
	b_NetcontactorHoldClose		: BOOL;
	b_ExtGridConnected			: BOOL;
	b_slowLom					: BOOL;
	get							: ST_GenGridController_get;
END_VAR

VAR
	InputContactor				: FB_ContactorControl;
	ExtContactor				: FB_ContactorControl;
	LoadStart					: FB_StartStop := (GreaterThan := TRUE);
	SocStart					: FB_StartStop := (GreaterThan := FALSE);
	ChargeLoadStart				: FB_StartStop := (GreaterThan := TRUE);
	BatFullStart				: FB_StartStop := (GreaterThan := TRUE);	
		
	b_BreakerACok				: BOOL;
	b_BreakerCMDfb				: BOOL;
	b_Breakerfb 				: BOOL;
	ar_BreakerCurrent			: ARRAY[0..4] OF REAL;
	b_InputACOK					: BOOL;
	b_InputMCCBfb				: BOOL;
	b_BusbarACOK				: BOOL;
	b_ExtACOK					: BOOL;
	b_SFCmodetransInhibit		: BOOL;
	b_GridCodeTripInverter		: BOOL;
	b_GridCodeActive			: BOOL;
	b_GridACDetected			: BOOL;
	b_SkipGensetCooldown		: BOOL;
	b_loadbankEnable			: BOOL;
	b_hybridMode				: BOOL;
	b_ManGenStartStop			: BOOL;
	b_GridTakeOverMode			: BOOL;
	b_AMFEnabled				: BOOL;
	b_autoSwitching				: BOOL;
	b_GenStarted				: BOOL;
	b_GenfreqProtection			: BOOL;
	GenFailCounter				: CTU;
	b_GridcodeOK				: BOOL;
	b_AFEActive					: BOOL;
	r_Soc						: REAL;
	r_ACVoltageBusbar			: REAL;
	b_PSBActive					: BOOL;	
	b_BESSReady					: BOOL;		
	 
	//Scheduler
	b_TimeSlot1					: BOOL;
	b_TimeSlot2					: BOOL;
	
	//Signals
	SFCEnable					: BOOL := TRUE;
	b_StartCondition			: BOOL;
	SFCTransTrigger			: TON := (PT :=T#10MS);
	SFCResetTrigger				: BOOL; // from inside SFC itself
	
	//Genset
	GensetSetpoints				: ST_Genset_Setpoints;
	t_CooldownTime				: TIME;
	t_WarmupTime				: TIME;
	
	//ControlModes
	b_ActivateTransition		: BOOL;
	b_ActivatePowerControl		: BOOL;
	eModeLocal 					: (AFE, UgridDroop, UgridIso, UgridIsland);
	PowerControlMode			: ePowerControlmode;
	BreakerOperationMode		: eBreakerOperationMode;
	ExtGensetEnable				: BOOL;
	
	// future work : eGenPowerTarget 				: (minimum, efficiency, maximum);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//FIRST SETUP IO
InputContactor(monitor := monitor, control := control, SyncData := targetdata.Syncdata, st_params := st_params.Contactor,
	b_FbIn := monitor.ACswitchgear.b_InputContactorfb,
	r_AcVoltageRef := monitor.powermonitor.InputField.ar_LineVoltage[0],
	r_AcFreqRef := monitor.powermonitor.InputField.ar_Frequency[0],
	li_VoltCrossRef := monitor.powermonitor.InputField.li_TimeVoltZeroCrossup,
	li_VoltCrossBus := monitor.peakshavebox.Powermonitor.li_TimeVoltZeroCrossup,
	e_AcRotationRef := monitor.powermonitor.InputField.e_ACrotationStatus,
	e_AcRotationBus := monitor.powermonitor.Outputfield.e_ACrotationStatus,
	b_SyncOK := monitor.ACswitchgear.b_InputSynchronizerfb,
	b_deloadEnable := TRUE,
	ar_current := Monitor.powermonitor.InputField.ar_Current,
	r_Power := Monitor.powermonitor.InputField.ar_ActivePower[0],
	CloseCMD => b_inputContactorClose,
	OpenCMD	=> b_inputContactorOpen,
	SyncEnable => b_InputSyncEnable,
	RotationFault => get.events.b_RotationFieldFault,
	b_deadbus := NOT b_BusbarACOK,
);

ExtContactor(monitor := monitor, control := control, syncdata := targetdata.Syncdata, st_params := st_params.Contactor,
	b_FbIn := monitor.peakshavebox.b_ContactorFb,	 
	r_AcVoltageRef:= monitor.peakshavebox.Powermonitor.ar_LineVoltage[0],
	r_AcFreqRef := monitor.peakshavebox.Powermonitor.ar_Frequency[0],
	li_VoltCrossRef := monitor.peakshavebox.Powermonitor.li_TimeVoltZeroCrossup,
	b_SyncOK := monitor.peakshavebox.b_SyncFb,
	b_deloadEnable := FALSE,
	ar_current := Monitor.peakshavebox.Powermonitor.ar_Current,
	CloseCMD => b_ExtContactorClose,
	b_deadbus := NOT b_BusbarACOK
);

//Map monitor vars to local vars for clearity.
b_ExtACOK := ExtContactor.ACok;
b_InputACOK := InputContactor.ACok AND monitor.ACswitchgear.b_InputMCCBfb AND NOT InputContactor.RotationFault;
b_InputMCCBfb := monitor.ACswitchgear.b_InputMCCBfb;
b_BusbarACOK :=  ACcheck(monitor.powerstack.r_ACVoltageD7 , monitor.powerstack.r_FrequencyD7);
r_ACVoltageBusbar := monitor.powerstack.r_ACVoltageD7;
b_AFEActive	:= monitor.powerstack.b_StartedState AND monitor.powerstack.e_InverterMode = einvertermodes.Afe;
b_TimeSlot1 := control.SoftSettings.system.ScheduleTimeSlot1.b_active;
b_TimeSlot2 := control.SoftSettings.system.ScheduleTimeSlot2.b_active;
SFCEnable := BreakerOperationMode <> eBreakerOperationMode.none AND enable AND NOT get.b_faultActive AND NOT b_EMStop;
b_GridCodeTripInverter := NOT monitor.powerstack.b_GridCodeOK;
b_loadbankEnable := control.softSettings.inputgenset.Loadbank.b_Enable;
b_hybridMode := control.softsettings.inputgenset.b_HydridMode;
b_GridTakeOverMode := (control.Operation.system.b_GridTakeOverEnable AND control.SoftSettings.setup.e_AcInputType = eACInputType.Grid);
get.e_GensetStartStop := GensetStartStop(control.softSettings.inputgenset.b_AutoStartStop, control.Operation.Genset.b_manualStart); 
b_AMFEnabled := control.SoftSettings.system.b_AMF;
//b_AutoResyncGridReco := control.SoftSettings.inputgrid.b_AutoResyncAfterGridRecovery;
b_autoSwitching	:= control.SoftSettings.inputgrid.breaker.AutoConnect;
t_CooldownTime := TO_TIME(TO_DINT(control.softSettings.inputgenset.Generator.ui_CooldownTime) * 60000);
t_WarmUpTime := TO_TIME(TO_DINT(control.softSettings.inputgenset.Generator.ui_WarmupTime) * 60000);
b_GenfreqProtection	:= control.SoftSettings.inputgenset.b_FreqProtectionEnable;
r_soc := Monitor.battery.BatteryInfo.r_SOCScaled;
b_GridCodeActive := control.SoftSettings.inputgrid.b_GridCodesActive;//monitor.powerstack.b_GridCodeCheckActive;
b_GridAcDetected := monitor.powerstack.b_GridACdetected;
b_BreakerACok := SEL(BreakerOperationMode = eBreakerOperationMode.ExtGrid, b_InputACOK, b_ExtACOK);
b_BreakerCMDfb := SEL(BreakerOperationMode = eBreakerOperationMode.ExtGrid, b_inputContactorClose, b_ExtContactorClose);
b_Breakerfb := SEL(BreakerOperationMode = eBreakerOperationMode.ExtGrid, inputcontactor.b_fb, extcontactor.b_fb);
ar_BreakerCurrent := SEL(BreakerOperationMode = eBreakerOperationMode.ExtGrid, inputcontactor.ar_current, extcontactor.ar_current);
b_ActivateTransition := control.Operation.system.b_GenGridModeTrans;
b_PSBActive := monitor.peakshavebox.b_active;
b_BESSReady := monitor.powerstack.b_StartedState;
StartStopConditions((SFCenable OR control.softSettings.setup.b_ExtGenset) AND monitor.powerstack.b_ControlEnabled);

GetControlTarget(
	control:= control,
	monitor := monitor,
	PowerControlMode := PowerControlMode,
	TargetData := TargetData,
	GensetSetpoints := GensetSetpoints,
	b_SFCPIDActivation:= b_ActivatePowerControl,
	b_deload := Inputcontactor.b_Deload OR ExtContactor.b_Deload,
	b_PSBactive := b_PSBactive);

SetBreakerAndPowercontrolMode(
	ACInputType := control.SoftSettings.setup.e_AcInputType,
	GridMode:= control.SoftSettings.setup.e_Gridmode,
	GensetMode := control.softSettings.inputgenset.Generator.e_GensetMode,
	PSBMode := monitor.peakshavebox.PSBmode,
	PSBenable := b_PSBActive, // control.SoftSettings.setup.b_PeakshaveBoxEnable,
	b_Extgenset := control.SoftSettings.setup.b_ExtGenset,
	PowerControlMode := PowerControlMode,
	ExtGensetMode := ExtGensetEnable);
	
SetInverterMode(
	Gridmode := control.SoftSettings.setup.e_Gridmode,
	UgridPowerMode := control.SoftSettings.system.e_UgridPowerMode,
	BreakerMode := BreakerOperationMode,
	PSBMode := monitor.peakshavebox.PSBmode,
	b_inputGridCodeEnabled := b_GridCodeActive AND NOT b_GridTakeOverMode,
	b_gridacDetected := b_GridACDetected, 
	b_PowerstackStarted := monitor.powerstack.b_StartedState,
	b_extFb := ExtContactor.b_fb,
	b_InputFb := InputContactor.b_fb,
	b_AMF := b_AMFEnabled)
;

//SFC actions
SFCtransTrigger(); //timer
GenGridSFC();

//ExtGenset control
ExtGensetControl(
	soft := control.SoftSettings.inputgenset,
	setpoints := gensetsetpoints,
	ExtGensetEnable);

//Get events that give fault states and reset SFC
BundleFaultEvents(events := get.events);

//some resets
SFCReset := NOT SFCEnable OR SFCResetTrigger;
IF NOT monitor.powerstack.b_StartedState THEN
	Genfailcounter.RESET := TRUE;
END_IF
]]></ST>
    </Implementation>
    <Folder Name="ControlTarget Methods" Id="{ead89aff-de93-4c70-a582-b4ea6fc2c144}" />
    <Folder Name="Future Work" Id="{2968c542-117e-4863-ae5e-caa0b8749307}" />
    <Folder Name="Nested Methods" Id="{c1c4e82e-8459-46f1-b4f2-d414785d427e}" />
    <Folder Name="SFC" Id="{9b153395-94b7-4124-aa4b-c8df91853bfd}" />
    <Method Name="BundleFaultEvents" Id="{567f3acc-48d3-44ae-97bd-6228e7e5171d}" FolderPath="Nested Methods\">
      <Declaration><![CDATA[METHOD BundleFaultEvents : BOOL
VAR_IN_OUT
	events : ST_GenGridController_Events;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[get.b_faultActive := 
	//events.b_OverFreqTrip 				OR
	//events.b_UnderFreqTrip				OR
	events.b_StartupFault				OR
	events.b_SynchronisationFault 		OR
	events.b_WarmupFault;
	//events.b_OverloadTrip;

IF get.b_faultActive THEN
	get.e_state := eGenGridState.Init;
END_IF

IF BreakerOperationMode <> eBreakerOperationmode.GridFeedthrough OR BreakerOperationMode <> eBreakerOperationmode.ExtGrid THEN
	events.b_GridLostTrip := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Action Name="ContinousActions" Id="{62eeff78-aee4-4a38-8edf-45381e48b6fa}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[//if AMF is enabled, netcontactor must always stay closed.
IF monitor.powerstack.b_ControlEnabled AND (BreakerOperationMode <> eBreakerOperationMode.None AND BreakerOperationMode <> eBreakerOperationMode.GenFix) THEN
	b_NetcontactorHoldClose := b_AMFEnabled;
ELSE
	b_NetcontactorHoldClose := FALSE;
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Method Name="Cooldown" Id="{50f2983a-cd41-4aeb-8138-53d7a2686a22}" FolderPath="Nested Methods\">
      <Declaration><![CDATA[METHOD Cooldown : BOOL
VAR_INPUT
	SynchroneGenMode	: BOOL;
END_VAR

VAR_INST
	t_time				: TIME;
	b_stopfb			: BOOL;
	ton_StopTimeOut		: TON;
	ton_CoolDownTimeOut	: TON;
	tp_releaseTimer		: Tp := (PT := T#20MS);
	r_CurrentThresholdShutdown: REAL := 10;
	b_CurrentDown		: BOOL;
	b_release			: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[get.e_state := eGenGridState.Cooldown;
b_release := FALSE;

IF b_SkipGensetCooldown THEN
	ton_StopTimeOut.PT := T#0S;
ELSE
	ton_StopTimeOut.PT :=t_CooldownTime;
END_IF

//Set timers for cooldown and cooldown time out (if nothing happens when stop is given).
ton_StopTimeOut(IN := b_breakerACOK AND b_CurrentDown AND NOT ton_StopTimeOut.Q); 
b_CurrentDown := monitor.powermonitor.InputField.ar_Current[0] < r_CurrentThresholdShutdown;
ton_CoolDownTimeOut(IN:= NOT b_CurrentDown AND NOT b_IOStartStop AND NOT ton_CoolDownTimeOut.Q, PT:=t_CooldownTime + T#3M);

IF SynchroneGenMode THEN
	b_IOStartStop := FALSE;
	get.b_gensetHot := FALSE;
	b_release := NOT b_IOStartStop AND b_CurrentDown OR ton_CoolDownTimeOut.Q;
ELSE
	IF ton_StopTimeOut.Q OR NOT b_breakerACOK THEN
		ton_StopTimeOut.IN := FALSE;
		b_IOStartStop := FALSE;	
		b_release := TRUE;
		get.b_gensetHot := FALSE;
	END_IF
END_IF

IF ton_CoolDownTimeOut.Q THEN
	get.events.b_ShutdownTimeOut := TRUE;	
END_IF

tp_releaseTimer(IN :=b_release AND NOT tp_releaseTimer.Q, Q => COOLDOWN);
//cooldown := b_release;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CurrentLimitProtection" Id="{071db2d4-0863-4796-85e0-1ee3ea030d8e}" FolderPath="Nested Methods\">
      <Declaration><![CDATA[METHOD CurrentLimitProtection : BOOL
VAR_INPUT
	enable				: BOOL;
	FeedinLimit 		: REAL;
	SupplyLimit			: REAL;
	Current				: REAL;
	Power				: REAL;
	TripDelay			: TIME := T#5S;
END_VAR

VAR_INST
	Direction			: SINT;
	ton_DelayTimer		: TON;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ton_DelayTimer(PT := TripDelay, Q => CurrentLimitProtection);

IF Current * LIMIT(-1, power, 1) < 0 AND enable THEN
	ton_DelayTimer.IN := ABS(Current) > ABS(supplyLimit + st_params.by_CurrentLimitMargin);
ELSIF Current * LIMIT(-1, power, 1) > 0 AND enable THEN
	ton_DelayTimer.IN := ABS(Current) > ABS(feedinLimit + st_params.by_CurrentLimitMargin);
ELSE
	ton_DelayTimer.IN := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExtGensetControl" Id="{aa23766a-22fe-4b57-b35f-aac428f9eabe}" FolderPath="Nested Methods\">
      <Declaration><![CDATA[METHOD ExtGensetControl : BOOL

VAR_IN_OUT CONSTANT
	soft		: ST_SoftSettings_Genset;
END_VAR

VAR_IN_OUT
	setpoints 	: ST_Genset_setpoints;
END_VAR

VAR_INPUT
	enable				: BOOL;
END_VAR

VAR_INST
	trip				: BOOL;
	rtrigreset			: R_TRIG;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF enable THEN
	get.e_GensetMode := eGensetmode.FixedPower;
	IF b_TimeSlot2 THEN
		setpoints := soft.setpointTimeslot2;
	ELSE 
		setpoints := soft.setpointTimeslot1;
	END_IF
	
	//set trip
	trip := GenFreqVoltProtections(TRUE, TRUE ,NOT enable OR control.control.b_Reset, 0);
	
	IF trip THEN
		b_IOstartstop := FALSE;
	ELSE
		b_IOstartStop := b_startcondition;
	END_IF	
END_IF
 
	//Reset OCP trip
rTrigReset(CLK := NOT enable OR control.control.b_Reset);
IF rtrigReset.Q THEN
	b_IOstartstop := FALSE;
END_IF
	]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExtIOControl" Id="{e65d5cdd-afb1-4525-a0b5-da6e6ea3967e}" FolderPath="Future Work\">
      <Declaration><![CDATA[METHOD ExtIOControl : BOOL
VAR_INPUT
	r_Power	: REAL;
	r_RatedPower : REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="GenDownCheck" Id="{ce419edb-2ed4-49ed-a1db-2010618df4f7}" FolderPath="Nested Methods\">
      <Declaration><![CDATA[METHOD GenDownCheck : BOOL
VAR_INPUT
	enable				: BOOL;
	reset				: BOOL;
END_VAR

VAR_INST
	GenFailLimitReached			: BOOL;
	r_ActivePower				: REAL;
	ton_FlatZeroPowerTimeOut 	: TON := (PT:= T#3S);
	ton_reversePowerTrip		: TON := (PT:= T#1S);
	ton_EnableRelease			: TON := (PT:= T#2S);
	ton_GenStartTimeOut			: TON := (PT:= T#1M);
	
	rTrigStarted				: R_Trig;
	
	GenDown						: BOOL;
	i_reversePowerThreshold		: INT := 10; 
	r_FreqLowLimit				: REAL := 49;
	
	GendownTrigger				: STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[r_ActivePower := monitor.powermonitor.InputField.ar_ActivePower[0];

//rTrigStarted(CLK :=  r_ActivePower > 1 OR r_ActivePower < -1);
IF r_ActivePower > 1 OR r_ActivePower < -1 THEN
	b_genStarted := TRUE;
END_IF

ton_GenStartTimeOut(IN := ton_EnableRelease.Q AND NOT b_genStarted);
IF ton_GenStartTimeOut.Q THEN
	get.events.b_StartupFault := TRUE;
END_IF

IF reset AND NOT get.events.b_GenDownTrip THEN
	GenDown := FALSE;
	GendownTrigger := '';
	ton_FlatZeroPowerTimeOut.IN := FALSE;
	ton_reversePowerTrip.IN := FALSE;
END_IF

ton_EnableRelease(IN := enable);
ton_reversePowerTrip();
ton_FlatZeroPowerTimeOut();

IF ton_EnableRelease.Q THEN
	ton_reversePowerTrip.IN := NOT b_loadbankEnable AND r_ActivePower > i_reversePowerThreshold;
	ton_FlatZeroPowerTimeOut.IN := LIMIT(-0.5, r_ActivePower, 0.5) = r_ActivePower AND NOT RESET AND b_breakerFB AND b_IOStartStop AND b_GenStarted;
ELSE
	ton_reversePowerTrip.IN := FALSE;
	ton_FlatZeroPowerTimeOut.IN := FALSE;
END_IF

IF (*ton_FlatZeroPowerTimeOut.Q*) ZeroCurrentDisconnect() THEN
	GenDownTrigger := 'zero power trigger';
ELSIF ton_reversePowerTrip.Q THEN
	GenDownTrigger := 'reverse power trigger';
ELSIF SEL(b_GenfreqProtection, FALSE, GenFreqVoltProtections(FALSE, GenFailLimitReached, reset, r_ActivePower)) THEN
	GenDownTrigger := 'Frequency protections trigger';
END_IF

IF GenDownTrigger <> '' THEN	
	IF GenFailLimitReached THEN
		get.events.b_GenDownTrip := TRUE;
	END_IF	 
	GenDown := TRUE;
	b_genStarted := FALSE;
END_IF

GenFailCounter(CU := GenDown, PV := st_params.Genset.GenDownRetries, Q=>GenFailLimitReached, RESET := reset AND get.events.b_GenDownTrip);

IF NOT b_IOStartStop THEN
	b_genStarted := FALSE;
END_IF
GenDownCheck := GenDown;
 ]]></ST>
      </Implementation>
    </Method>
    <Method Name="GenFreqVoltProtections" Id="{a8a20dfe-25e8-4463-911a-a5b1a631debc}" FolderPath="Nested Methods\">
      <Declaration><![CDATA[METHOD GenFreqVoltProtections : BOOL
VAR_INPUT
	FixedPowerOverloadProtect : BOOL;
	enableEvents	: BOOL;
	reset : BOOL;
	Power : REAL;
END_VAR

VAR_INST
	ton_OCPDelay			: TON := (PT := T#3S);
	ton_OverFreqTripDelay 	: TON := (PT := T#3S);
	ton_UnderFreqTripDelay 	: TON := (PT := T#3S);
	ton_OverVoltTripDelay 	: TON := (PT := T#3S);
	ton_UnderVoltTripDelay 	: TON := (PT := T#3S);
	b_TripDetected			: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ton_UnderFreqTripDelay(PT := TO_TIME(ST_params.Genset.UnderfrequencyTripDelay));
ton_OverFreqTripDelay(PT := TO_TIME(ST_params.Genset.OverfrequencyTripDelay));
ton_UnderVoltTripDelay(PT := TO_TIME(ST_params.Genset.UnderVoltageTripDelay));
ton_OverVoltTripDelay(PT := TO_TIME(ST_params.Genset.OverVoltageTripDelay));
ton_OCPDelay(PT := TO_TIME(ST_params.Genset.OverloadTripDelay));

IF reset THEN
	ton_OverFreqTripDelay.IN := FALSE;
	ton_UnderFreqTripDelay.IN := FALSE;
	ton_OverVoltTripDelay.IN := FALSE;
	ton_UnderVoltTripDelay.IN := FALSE;
	ton_OCPDelay.IN := FALSE;
ELSIF monitor.powerstack.b_StartedState THEN
	//Overfrequency protection
	ton_OverFreqTripDelay.IN := monitor.powerstack.r_FrequencyD7 > st_params.Genset.OverFrequencyLimit;
	IF ton_OverFreqTripDelay.Q THEN
		get.events.b_OverFreqTrip := TRUE;
	END_IF
	
	ton_UnderFreqTripDelay.IN := monitor.powerstack.r_FrequencyD7 < st_params.Genset.UnderFrequencyLimit;
	IF ton_UnderFreqTripDelay.Q THEN
		get.events.b_UnderFreqTrip := TRUE;
	END_IF
	
	ton_OvervoltTripDelay.IN := monitor.powerstack.r_ACVoltageD7 > st_params.Genset.OverVoltageLimit AND NOT FixedPowerOverloadProtect;
	IF ton_OverVoltTripDelay.Q THEN
		get.events.b_OverVoltTrip := TRUE;
	END_IF
	
	ton_UnderVoltTripDelay.IN := monitor.powerstack.r_ACVoltageD7 < st_params.Genset.UnderVoltageLimit AND NOT FixedPowerOverloadProtect;
	IF ton_UnderVoltTripDelay.Q THEN
		get.events.b_UnderVoltTrip := TRUE;
	END_IF
	
	//Overcurrent protection
	ton_OCPDelay.IN := FixedPowerOverloadProtect AND monitor.powerstack.r_LoadPercent > monitor.powerstack.r_OvercurrentValueAct * 100 AND monitor.powerstack.e_PowerState = ePowerstate.Charging;
	IF ton_OCPDelay.Q THEN
		get.events.b_OverloadTrip := TRUE;
	END_IF
END_IF

b_TripDetected := get.events.b_OverloadTrip 
	OR get.events.b_OverFreqTrip 
	OR get.events.b_UnderFreqTrip
	OR get.events.b_OverVoltTrip
	OR get.events.b_UnderVoltTrip;

IF NOT enableEvents THEN
	get.events.b_OverFreqTrip := FALSE;
	get.events.b_OverloadTrip := FALSE;
	get.events.b_OverVoltTrip := FALSE;
	get.events.b_UnderVoltTrip := FALSE;
	get.events.b_UnderFreqTrip := FALSE;
END_IF

GenFreqVoltProtections := b_TripDetected;]]></ST>
      </Implementation>
    </Method>
    <Action Name="GenGridSFC" Id="{7b135b84-cd18-4d6a-b3d2-35f15ae5881a}" FolderPath="SFC\">
      <Implementation>
        <SFC>
          <XmlArchive>
            <Data>
              <o xml:space="preserve" t="SFCImplementationObject">
                <o n="Root" t="SFCSegment">
                  <o n="ElementList" t="SFCElementList">
                    <l2 n="InnerList">
                      <o t="SFCStep">
                        <n n="EmbeddedMainAction" />
                        <n n="EmbeddedEntryAction" />
                        <n n="EmbeddedExitAction" />
                        <l2 n="EmbeddedMainActionProperties" />
                        <l2 n="EmbeddedEntryActionProperties" />
                        <l2 n="EmbeddedExitActionProperties" />
                        <o n="ElementList" t="SFCElementList">
                          <l2 n="InnerList" />
                        </o>
                        <l2 n="Attributes" cet="SFCAttribute">
                          <o>
                            <v n="AttributeId">{38391c6d-6d4a-42f8-8ee7-9f45e5adafa8}</v>
