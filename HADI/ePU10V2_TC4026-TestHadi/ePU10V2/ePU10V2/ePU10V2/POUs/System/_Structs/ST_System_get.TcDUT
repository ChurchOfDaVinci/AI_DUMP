<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_System_get" Id="{abdaeeb7-e5d1-4e3a-afd4-b87fe65a9ce8}">
    <Declaration><![CDATA[TYPE ST_System_get :
STRUCT
	b_SMSnumberConfigured		: BOOL;
	b_CustomNameConfigured		: BOOL;
	s_SystemName				: STRING(20);
	b_TransportModePending		: BOOL;
	b_DehumModePending			: BOOL;
	
	
	//Statuss
	e_State						: eSystemState; //0:Idle, 1: Stand-by, 2:Conditioning, 3:Dry-Cycle, 4: Running, 5: Charging only, 6: Discharging only, 7: Stopped 8:Fault, 10: Reset
	e_gridmode					: eGridmode;
	e_UgridPowermode			: eUgridPowermode;
	b_StartAllowed				: BOOL;
	r_CurrentEfficiency			: REAL;
	r_AvgEfficiency				: REAL;
	r_RoundtripEfficiency		: REAL;
	DT_SystemTime				: DT;
	
	PowerController				: ST_PowerControl_get;	
	GenGridController			: ST_GenGridController_get;	
	
	events						: ST_System_events;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>