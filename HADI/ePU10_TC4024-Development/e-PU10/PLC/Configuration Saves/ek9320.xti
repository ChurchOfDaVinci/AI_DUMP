			</GsdmlValue>
			<GsdmlValue HelpInfo="At the release of the AR take the fallback values that are configured from profinet. If no fallback value available the outputs would be set to zero. If that fetaure is disabled the output values are frozen." Id="EnumList_1" Content="00000100">
				<RecordText>Off</RecordText>
				<RecordText>On</RecordText>
			</GsdmlValue>
			<GsdmlValue HelpInfo="Define the data presentation format." Id="EnumList_2" Content="00000100">
				<RecordText>Intel Format</RecordText>
				<RecordText>Motorola Format</RecordText>
			</GsdmlValue>
			<GsdmlValue HelpInfo="Define the behavior of the IOs if the EBus frame is incorrect. The &quot;Legacy&quot; mode means that the Outputs will be updated and the inputs will be frozen (it depends from the location of the EBus error). The &quot;Set IOs to 0&quot; mode means that the IOs set to zero and automatic restart of EBus if the error disappear. Other than the &quot;Set IOs to 0 without EBus restart&quot; option, the EBus will not automatic restarted." Id="EnumList_3" Content="000001000200">
				<RecordText>Legacy</RecordText>
				<RecordText>Set IOs to 0</RecordText>
				<RecordText>Set IOs to 0 without EBus restart</RecordText>
			</GsdmlValue>
			<GsdmlValue HelpInfo="Define the cycle time of the EBus. The default is 1ms, but it's possible to trigger it with the PN cycle (max 64 ms)." Id="EnumList_4" Content="00000100">
				<RecordText>Internal Task cycle</RecordText>
				<RecordText>PN cycle</RecordText>
			</GsdmlValue>
