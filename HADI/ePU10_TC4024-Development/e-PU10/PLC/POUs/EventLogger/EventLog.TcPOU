    <Folder Name="private" Id="{39773113-d3ca-4aed-b4c6-9841f9e50aea}" />
    <Action Name="aCheckFileSize" Id="{58585cd0-1a18-4507-ae00-a1805d81c4ea}" FolderPath="private\">
      <Implementation>
        <ST><![CDATA[

FileInfoDone(clk := fbFileInfo.bbusy);
FileActionDelay(in:= NOT (fbFileInfo.bbusy OR FileInfoDone.Q));

fbFileInfo(sPathname:= Stparams.LogFileName,
		bExecute := FileActionDelay.Q,
		eCMD := eEnumCmd_First,
		tTimeout := T#100MS);


IF FileInfoDone.q THEN
	FileSize := 0;
	IF NOT fbFileInfo.bError THEN
		IF NOT fbfileInfo.bEOE THEN
			stFiledata := fbFileinfo.stFindFile;
			FileSize := ULARGE_TO_ULINT(stFiledata.fileSize);
		END_IF
	END_IF
	SFCTip := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="aCloseFile" Id="{ea5efb7d-ae55-4798-83dd-00d5a01807ec}" FolderPath="private\">
      <Implementation>
        <ST><![CDATA[
FileCloseDone(clk := fbCloseFile.bbusy);

FileActionDelay(in := NOT (fbCloseFile.bbusy OR FileCloseDone.Q));


fbCloseFile(Hfile := FileHandle,
		bExecute   := FileActionDelay.q,
    	tTimeout   := T#100MS);


IF FileCloseDone.q THEN
	IF NOT fbCloseFile.bError THEN
		filehandle := 0;
		SFCTip := TRUE;
	END_IF
END_IF


			]]></ST>
      </Implementation>
    </Action>
    <Action Name="aCloseFileChecker" Id="{cffd68e5-23a5-4609-90f6-a609898df913}" FolderPath="private\">
      <Implementation>
        <ST><![CDATA[

FileInfoDone(clk := fbFileInfo.bbusy);
FileActionDelay(in:= not (fbFileInfo.bbusy OR FileInfoDone.Q));

fbFileInfo(sPathname:= Stparams.LogFileName,
		bExecute := FileActionDelay.Q,
		eCMD := eEnumCmd_Abort,
		tTimeout := T#100MS);


IF FileInfoDone.q THEN
	FileSize := 0;
	IF NOT fbFileInfo.bError THEN
		SFCTip := TRUE;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="AddEvent" Id="{32cb5227-5b76-4542-a4a3-ceb6eedbd564}">
      <Declaration><![CDATA[METHOD AddEvent : BOOL
VAR_INPUT
	LogMessage	:	STRING;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Stop_logging THEN	
	MemoryBuffer.A_AddTail(putValue := LogMessage);
end_if]]></ST>
      </Implementation>
    </Method>
    <Action Name="aDeleteOldest" Id="{3e17bcae-26df-43ff-b063-d7004346f315}" FolderPath="private\">
      <Implementation>
        <ST><![CDATA[
FileDeleteDone(clk := fbDeleteFile.bbusy);
FileActionDelay(in:=NOT (fbDeleteFile.bbusy OR FileDeleteDone.Q));
	
fbDeleteFile(sPathname:= concat(concat(Stparams.LogFileName, '.'),TO_STRING(stparams.MaxFileCount-1)),
		bExecute := FileActionDelay.q,
		tTimeout := T#100MS);


IF FileDeleteDone.q THEN
	//could end in error if file doesn't exist. This is fine.
	FileCounter := stparams.MaxFileCount-2;
	SFCTip := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="aIdle" Id="{30d500f2-9720-4731-a0c6-2f3df7932a4e}" FolderPath="private\">
      <Implementation>
        <ST><![CDATA[tonGeneralWriteDelay.IN := true;]]></ST>
      </Implementation>
    </Action>
    <Action Name="aOpenLogFile" Id="{cb185fb2-912d-4e72-b610-3cad69402948}" FolderPath="private\">
      <Implementation>
        <ST><![CDATA[bEMStopWrite := FALSE;
tonGeneralWriteDelay.IN := FALSE;
FileOpenDone(clk := fbOpenFile.bbusy);

FileActionDelay(in := NOT (fbOpenFile.bbusy OR FileOpenDone.Q));

fbOpenFile(sPathName := Stparams.LogFileName,
		nMode := FOPEN_MODEAPPEND OR FOPEN_MODETEXT,
		bExecute   :=  FileActionDelay.Q,
    	tTimeout   := T#100MS);


IF FileOpenDone.q THEN
	FileHandle := fbOpenFile.hFile;
	IF FileHandle <> 0 THEN
		MemoryBuffer.A_RemoveHead(getValue => WriteString);
		SFCTip := TRUE;
	END_IF
END_IF


			]]></ST>
      </Implementation>
    </Action>
    <Action Name="aOpenLogFile_entry" Id="{d319d2ef-8988-4c8d-bad7-a84e46814636}" FolderPath="private\">
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Action>
    <Action Name="aRenameExisting" Id="{73354ae8-5d50-4c42-ab51-78b56e0ea2e3}" FolderPath="private\">
      <Implementation>
        <ST><![CDATA[
FileRenameDone(clk := fbRenameFile.bbusy);
FileActionDelay(in:= NOT (fbDeleteFile.bbusy OR FileDeleteDone.Q));

fbRenameFile(
		bExecute := FileActionDelay.Q,
		tTimeout := T#100MS);


IF FileRenameDone.q THEN
	//could end in error if file doesn't exist. This is fine.
	FileCounter := FileCounter-1;
	SFCTip := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="aWriteData" Id="{a30c5a53-376d-4075-ad71-90040a3b5b86}" FolderPath="private\">
      <Implementation>
        <ST><![CDATA[
//add entry action with initial Writestring fill
filehandle;

FileWriteDone(clk := fbWriteFile.bbusy);

FileActionDelay(in := NOT (fbWriteFile.bbusy OR FileWriteDone.Q));

fbWriteFile(hfile := filehandle,
			sLine := WriteString,
			BExecute := FileActionDelay.Q,
			tTimeout := T#500MS);


IF FileWriteDone.q THEN
	IF MemoryBuffer.nCount > 0 THEN //Still data present, continue writing
		MemoryBuffer.A_RemoveHead(getValue => WriteString);
	ELSE //file not opened, back to start?
		SFCTip := TRUE;
	END_IF
END_IF			]]></ST>
      </Implementation>
    </Action>
    <Action Name="ContinuousActions" Id="{6ab03acc-c81e-4be5-914d-eb93b7fac4cc}" FolderPath="private\">
      <Implementation>
        <ST><![CDATA[MemoryBuffer(bOverwrite := TRUE, pBuffer := ADR(DataBuffer), cbBuffer := SIZEOF(DataBuffer));
tonEMstopDelay(in := bEMstopWrite, pt:= stparams.EMstopWriteDelay);
tonGeneralWriteDelay(in:= MemoryBuffer.nCount > 0, Pt:=stparams.LogWriteInterval);

IF WriteTest THEN
	WriteLogItem(Source := eObject_ID.System, Severity := eSeverity.Warning, LogText := 'testtesttest');
	WriteTest := FALSE;
	bEMstopWrite := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="EMstop" Id="{2864481c-1419-4b09-8c6e-efbb21d146a6}">
      <Declaration><![CDATA[METHOD EMstop : BOOL
VAR_INPUT
END_VAR

VAR
	LogText	:	String;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF memorybuffer.nCount > 0 THEN
	bEMstopWrite := TRUE;
END_IF

EMStop := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Action Name="Idle_entry" Id="{d5f7fac5-8387-4d6f-be5f-57dfbc81f95a}" FolderPath="private\">
      <Implementation>
        <ST><![CDATA[bEMStopWrite := FALSE;
bForceWrite := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="RenameExisting_entry" Id="{6f3681b5-e206-409f-bc97-e8cdd8d50fb1}" FolderPath="private\">
      <Implementation>
        <ST><![CDATA[
IF FileCounter = 0 THEN 
	fbRenameFile.sOldName := Stparams.LogFileName;
ELSE
	fbRenameFile.sOldName := concat(concat(Stparams.LogFileName, '.'),TO_STRING(FileCounter));
END_IF
fbRenameFile.sNewName	:= concat(concat(Stparams.LogFileName, '.'),TO_STRING(FileCounter+1));
]]></ST>
      </Implementation>
    </Action>
    <Action Name="SFCTipReset" Id="{1162c354-8e0f-41e9-b76e-d82acb041b53}" FolderPath="private\">
      <Implementation>
        <ST><![CDATA[FileActionDelay(in := FALSE);
SFCTip := false;]]></ST>
      </Implementation>
    </Action>
    <Method Name="Shutdown" Id="{66d78e64-779f-4597-a532-ba74365e3190}">
      <Declaration><![CDATA[METHOD Shutdown : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF memorybuffer.nCount > 0 THEN
	bForceWrite := TRUE;
END_IF

Shutdown := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Transition Name="StartWriteOut" Id="{f3d5451a-7330-4920-99a0-9c375ad1e788}" FolderPath="private\">
      <Implementation>
        <ST><![CDATA[//Flush logs to file if
MemoryBuffer.cbSize > TO_UDINT(stparams.MaxFillGrade*MemoryBuffer.cbBuffer) OR //buffer gets full
tonGeneralWriteDelay.Q  OR //fixed interval
tonEmstopDelay.Q OR //just after emstop
bForceWrite; //at systemshutdown

]]></ST>
      </Implementation>
    </Transition>
