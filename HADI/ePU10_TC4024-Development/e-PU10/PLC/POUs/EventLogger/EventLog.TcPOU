<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="EventLog" Id="{9182a965-c0a3-47fb-8d9e-fc3986a324a0}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM EventLog


VAR
	WriteTest		:	BOOL;
	fbOpenFile 		: FB_Fileopen;
	fbWriteFile		: FB_FilePuts;
	fbCloseFile 	: FB_FileClose;
	fbRenameFile	: FB_FileRename;
	fbDeleteFile	: FB_FileDelete;
	fbFileInfo		:	FB_EnumFindFileEntry;
	stFiledata		:	ST_FindFileEntry;
	FileOpenDone		:	F_TRIG;
	FileWriteDone		:	F_TRIG;
	FileCloseDone		:	F_TRIG;
	FileRenameDone		:	F_TRIG;
	FileDeleteDone		:	F_TRIG;
	FileInfoDone		:	F_TRIG;
	FileSize			:	ULINT;
	FileCounter			:	INT;
	Filehandle 			: UINT;
	
	bForceWrite 			:	BOOL;	//immediately flush out buffer on shutdown
	bEMstopWrite			:	BOOL;	//Flush out after EMStop, but give some time for final logs to come in 
	tonEMstopDelay			:	TON;
	tonGeneralWriteDelay	:	Ton;
	FileActionDelay			:	TON := (PT := T#30MS);

	MemoryBuffer	:	FB_StringRingBuffer;
	DataBuffer		:	ARRAY[0..100000] OF BYTE; //100kb to start
	WriteString	:	t_MAXSTRING;

	
	
	Stop_logging	:	Bool;
	
END_VAR

VAR_IN_OUT CONSTANT
	STParams : ST_EventLoggerParams;
END_VAR
]]></Declaration>
