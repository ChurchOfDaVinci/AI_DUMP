<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="Fb_BindControlVars" Id="{2582c493-ebec-4155-9106-ed507abe1cad}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Fb_BindControlVars
VAR_INPUT
	AdvancedControl : BOOL;
END_VAR

VAR_IN_OUT
	SystemControlVars : ST_System_Control;
	ExtControlVars		: ST_ExtController_get;
END_VAR

VAR
	defaults			: ST_Softsettings;
	ftrig_AdvancedControl : F_trig;
	rTrig_AdvancedControl : R_Trig;
	
	b_defaultsRestored	: BOOL;
END_VAR

VAR
	WoE_Start		:	WriteOnEdge;
	WoE_Stop		:	WriteOnEdge;
	WoE_Activate	:	WriteOnEdge;
	WoE_Shutdown	:	WriteOnEdge;
	WoE_ClearHistory	:	WriteOnEdge;
	WoE_EMstop		:	WriteOnEdge;
	WoE_DehumStart	:	WriteOnEdge;
	WoE_Reset		:	WriteOnEdge;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[ftrig_AdvancedControl(CLK:= advancedcontrol);
IF ftrig_advancedControl.Q THEN
	RestoreDefaults(defaults, Systemcontrolvars.SoftSettings);
END_IF

//advanced control, all IO coupled
IF advancedcontrol THEN
	SystemControlVars.SoftSettings := ExtControlVars.SoftSettings;
	SystemControlVars.Operation := ExtControlVars.Operation;
ELSE
	Storedefaults(defaults, Systemcontrolvars.SoftSettings);
	//Basic control, only specific IO coupled
	Systemcontrolvars.softsettings.system.b_EcoModeEnable := ExtControlVars.SoftSettings.system.b_EcoModeEnable;
	SystemControlvars.operation.system.b_PFsetEnable := ExtControlVars.Operation.system.b_PFsetEnable;
	SystemControlvars.operation.system.r_PFset := ExtControlVars.Operation.system.r_PFset;
	SystemControlvars.operation.system.r_Pset:= ExtControlVars.Operation.system.r_Pset;
	SystemControlvars.operation.system.r_Qset:= ExtControlVars.Operation.system.r_Qset;
	SystemControlvars.softsettings.PSB.setpointTimeslot1 := ExtControlVars.softsettings.PSB.setpointTimeslot1;
END_IF

a_ControlCommands();]]></ST>
    </Implementation>
