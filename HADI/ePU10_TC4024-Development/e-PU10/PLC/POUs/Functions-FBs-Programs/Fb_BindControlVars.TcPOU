    <Method Name="RestoreDefaults" Id="{bd8642b8-6375-4475-935d-96b5f2275b03}">
      <Declaration><![CDATA[METHOD RestoreDefaults
VAR_IN_OUT
	defaults 		: ST_Softsettings;
	softsettings	: ST_Softsettings;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF memcmp(pBuf1 := ADR(defaults), pBuf2:= ADR(softsettings), n:= SIZEOF(defaults)) <> 0 THEN
	softsettings := defaults;
END_IF


]]></ST>
      </Implementation>
    </Method>
    <Method Name="StoreDefaults" Id="{dcd571db-791f-447d-ae89-e1b6e012a7b0}">
      <Declaration><![CDATA[METHOD StoreDefaults : BOOL
VAR_IN_OUT
	defaults 		: ST_Softsettings;
	softsettings	: ST_Softsettings;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[StoreDefaults := FALSE;

IF memcmp(pBuf1 := ADR(defaults), pBuf2:= ADR(softsettings), n:= SIZEOF(defaults)) <> 0 THEN
	defaults := softsettings;
ELSE
	StoreDefaults := TRUE;
END_IF


]]></ST>
      </Implementation>
    </Method>
