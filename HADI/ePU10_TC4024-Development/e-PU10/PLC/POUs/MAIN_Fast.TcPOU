    <Action Name="NormalOperation_active" Id="{56d2521e-6356-496d-8aa8-0d2424f5790f}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[powerstack.startcmd();

IF powerstack.get.e_State = eStatusPowerstack.running THEN
	IF NOT bms.get.BatteryInfo.b_chargingAllowed THEN
		Monitor.system.e_State := eSystemState.Discharging_Only;
	ELSIF NOT bms.get.BatteryInfo.b_DischargingAllowed THEN
		Monitor.system.e_State := eSystemState.Charging_Only;
	ELSE
		Monitor.system.e_State := eSystemState.Running;
	END_IF
ELSE
	IF powerstack.get.e_State = eStatusPowerstack.idle OR powerstack.get.e_State = eStatusPowerstack.GridCodeStop THEN
		Monitor.system.e_State := eSystemState.Stopped;	
	ELSE
		Monitor.system.e_State := eSystemState.Starting;	
	END_IF	
END_IF
	








]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="Normalshutdown_active" Id="{4d0315ce-a511-4ec5-8ddf-10cce2cbe602}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[SFCReset := TRUE;
b_shutdownCompleted := Powerstack.Shutdowncmd();
Monitor.system.e_State := eSystemState.shutdown;
]]></ST>
      </Implementation>
    </Action>
    <Method Name="Reset" Id="{7a48efb2-2c09-45a8-bebd-e7f87f31865d}">
      <Declaration><![CDATA[METHOD PUBLIC Reset : BOOL
VAR_INPUT
	b_reset	: BOOL;
	b_force : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tp_ResetDuration(IN := b_reset OR b_Force);

//reinitiliaze reset statuss if reset is retriggered
IF tp_resetDuration.Q = FALSE THEN
	w_MethodFbs := 0;
END_IF


//Everything that is not automatically reset
IF tp_ResetDuration.Q AND w_MethodFbs <> 16#FF THEN
	monitor.system.e_State := eSystemState.Reset;
	
	IF NOT w_MethodFbs.0 AND b_force THEN w_MethodFbs.0 := Safety.Reset(TRUE); END_IF
	IF NOT w_MethodFbs.1 THEN w_MethodFbs.1 := InternalPowerSupply.Reset(); END_IF
	IF NOT w_MethodFbs.2 THEN w_MethodFbs.2 := Powerstack.Reset(); END_IF
	IF NOT w_MethodFbs.3 THEN w_MethodFbs.3 := protectionSystems.Reset(); END_IF
	IF NOT w_MethodFbs.4 THEN w_MethodFbs.4 := Powermonitor.Reset(); END_IF 
	IF NOT w_MethodFbs.5 THEN w_MethodFbs.5 := BMS.Reset(); END_IF 
	IF NOT w_MethodFbs.6 THEN w_MethodFbs.6 := Neutraltransformer.Reset(); END_IF
	IF NOT w_MethodFbs.7 THEN w_MethodFbs.7 := Coolingsystem.Reset(); END_IF
	IF NOT w_MethodFbs.8 THEN w_MethodFbs.8 := Router.Reset(); END_IF
	IF NOT w_MethodFbs.9 THEN w_MethodFbs.9	:= systemcontrol.Reset(); END_IF
	IF NOT w_MethodFbs.10 THEN w_MethodFbs.10:= ACDCCharger.Reset(); END_IF
	IF NOT w_MethodFbs.11 THEN w_MethodFbs.11:= TRUE; END_IF
	IF NOT w_MethodFbs.12 THEN w_MethodFbs.12:= TRUE; END_IF
	IF NOT w_MethodFbs.13 THEN w_MethodFbs.13:= TRUE; END_IF
	IF NOT w_MethodFbs.14 THEN w_MethodFbs.14:= TRUE; END_IF
	IF NOT w_MethodFbs.15 THEN w_MethodFbs.15:= TRUE; END_IF
END_IF

//Everything that is automatically reset one in error state
Reset := w_MethodFbs = 255;




]]></ST>
      </Implementation>
    </Method>
    <Action Name="SetConfig" Id="{d70e48b1-da73-45d4-a3da-134966cb20f4}">
      <Implementation>
        <ST><![CDATA[{IF defined (ePU10_360_N_DC_IO_PSB)}
	settings.Configuration.b_PeakshaverBoxEnable 	:= TRUE;
	settings.Configuration.b_DCbuscoupling 			:= FALSE; //TRUE;
	settings.Configuration.b_NeutralTransformer		:= TRUE;
	settings.Configuration.b_ACInputConnection		:= TRUE;
	settings.Properties.s_ConfigurationCode 		:= 'ePU10_360_N_DC_IO_PSB';
{END_IF}

{IF defined (ePU10_360_N_IO_PSB)}
	settings.Properties.s_ConfigurationCode 		:= 'ePU10_360_N_IO_PSB';
	settings.Configuration.b_ACInputConnection		:= TRUE;
	settings.Configuration.b_NeutralTransformer		:= TRUE;
	settings.Configuration.b_PeakshaverBoxEnable 	:= TRUE;
{END_IF}

{IF defined (ePU10_360_N_IO)}
	settings.Properties.s_ConfigurationCode 		:= 'ePU10_360_N_IO';
	settings.Configuration.b_ACInputConnection		:= TRUE;
	settings.Configuration.b_NeutralTransformer		:= TRUE;
{END_IF}

{IF defined (ePU10_368_3P_O_PSB)}
	settings.Properties.s_ConfigurationCode 		:= 'ePU10_368_3P_O_PSB';
	settings.Configuration.b_PeakshaverBoxEnable 	:= TRUE;
{END_IF}

{IF defined (ePU10_360_3P_O)}
	settings.Properties.s_ConfigurationCode 		:= 'ePU10_360_3P_O';
{END_IF}

IF enclosure.get.ledstrip.BeckhoffLed AND FIND(settings.Properties.s_ConfigurationCode,'_BL') = 0 THEN
	settings.Properties.s_ConfigurationCode := CONCAT(settings.Properties.s_ConfigurationCode, '_BL');
END_IF

settings.Properties.by_SWverMajor	:=	1;	
settings.Properties.by_SWverMinor	:=	6;	
settings.Properties.by_SWverPatch	:=	1;	
settings.Properties.by_SWverBuild	:=	1;	

//Set properties
settings.Properties.s_SWversionNumber				:= 	concat('V', TO_STRING(settings.Properties.by_SWverMajor));
settings.Properties.s_SWversionNumber				:=	concat(settings.Properties.s_SWversionNumber, '.');
settings.Properties.s_SWversionNumber				:= 	concat(settings.Properties.s_SWversionNumber, TO_STRING(settings.Properties.by_SWverMinor));
settings.Properties.s_SWversionNumber				:=	concat(settings.Properties.s_SWversionNumber, '.');
settings.Properties.s_SWversionNumber				:= 	concat(settings.Properties.s_SWversionNumber, TO_STRING(settings.Properties.by_SWverPatch));
IF settings.Properties.by_SWverBuild > 0 THEN
	settings.Properties.s_SWversionNumber				:=	concat(settings.Properties.s_SWversionNumber, '_');
	settings.Properties.s_SWversionNumber				:= 	concat(settings.Properties.s_SWversionNumber, TO_STRING(settings.Properties.by_SWverBuild));
END_IF
	
settings.Properties.r_RatedEnergyCapacity 			:= BMS.get.BatteryInfo.r_ratedEnergyCapacity;
settings.Properties.r_RatedActivePower 				:= MIN(BMS.get.BatteryInfo.r_ratedPower, powerstack.get.r_ratedPower);
settings.Properties.r_RatedApparentPower			:= TO_INT(powerstack.get.r_RatedCurrent * 400 * 1.73 / 1000);
settings.Properties.r_Ratedcurrent 					:= powerstack.get.r_RatedCurrent;
settings.Properties.r_ratedCurrentInput				:= SEL(settings.Configuration.b_ACInputConnection, 0, 700);
settings.Properties.r_ratedCurrentOutput			:= SEL(settings.Configuration.b_ThirdOutputConnection, 800, 1200);


CASE settings.Configuration.by_NoBatteryStrings OF
	2: settings.Properties.s_Weight					:= '7000 kg';
	3: settings.Properties.s_Weight					:= '8500 kg';
	4: settings.Properties.s_Weight					:= '9500 kg';
END_CASE

]]></ST>
      </Implementation>
    </Action>
    <Action Name="SetSystemMonitorControlvars" Id="{ee1ac32e-4a18-4b7d-a1ed-f24635a6285c}">
      <Implementation>
        <ST><![CDATA[//First bind references
Monitor.safety := Safety.get;
Monitor.powerstack REF= Powerstack.get;
Monitor.AcDcCharger REF= AcDcCharger.get;
Monitor.powermonitor REF= Powermonitor.get;
Monitor.neutraltransformer REF= neutraltransformer.get;
Monitor.protections REF= ProtectionSystems.get;
Monitor.battery REF= BMS.get;
Monitor.ACswitchgear REF= ACswitchgear.get;
Monitor.DCswitchgear REF= DCswitchgear.get;
Monitor.peakshavebox REF= Peakshavebox.get;
Monitor.enclosure REF= Enclosure.get;
Monitor.internalpsu REF= Internalpowersupply.Get;
Monitor.PLC REF= PLCstate.get;
Monitor.Cooling REF= coolingsystem.Get;
Monitor.Router REF= Router.Get;
Monitor.Generator REF= Gencomm.Get;
Monitor.HartingIO REF= HartingIO.Get;

]]></ST>
      </Implementation>
    </Action>
    <Action Name="StartUpRequest_active" Id="{090a0f6e-3020-4e2f-b065-9b9ede2298d7}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[b_MethodStartFB	:= Powerstack.Startcmd();
Monitor.system.e_State:= eSystemState.Starting;]]></ST>
      </Implementation>
    </Action>
    <Method Name="SystemShutdown" Id="{5d76c95d-5fda-40b0-8826-8b775359b161}">
      <Declaration><![CDATA[METHOD SystemShutdown : BOOL
VAR_INPUT
	b_execute			: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//write persisten data
fb_WritePersistentData(NETID := '', PORT:= 851, START:=b_execute,  TMOUT := T#5S);

//set force shutdown timer
ton_ForceShutdown(IN:= b_execute);
ton_shutdownDelay(IN:= b_execute);

IF ton_shutdownDelay.Q THEN
	b_shutdownInitiated := TRUE;
END_IF

//Everything that is not automatically reset
IF b_shutdownInitiated THEN
	settings.Save := TRUE;
	Monitor.system.e_State := eSystemState.shutdown;
	IF NOT w_MethodFbs.0 THEN w_MethodFbs.0 := Powerstack.Shutdowncmd(); END_IF	
	IF NOT w_MethodFbs.1 THEN w_MethodFbs.1 := SystemControl.shutdown(); END_IF
	IF NOT w_MethodFbs.2 THEN w_MethodFbs.2 := CoolingSystem.shutdown(); END_IF;
	w_MethodFbs.3 := TRUE;	
	w_MethodFbs.4 := TRUE; 
	w_MethodFbs.5 := TRUE; 
	w_MethodFbs.6 := TRUE; 
	w_MethodFbs.7 := TRUE;
ELSE
	w_MethodFbs := 0;
END_IF

IF w_MethodFbs = 255 OR ton_ForceShutdown.Q THEN
	settings.Save := FALSE;
	MqttComOpenRemote.shutdown();
	ton_NUCshutdownDelay(IN:=TRUE);
	IF ton_NUCshutdownDelay.Q THEN
		Monitor.system.e_State := eSystemState.off;
		InternalPowerSupply.SystemShutdown(timedshutdown := FALSE);
		b_shutdownInitiated := FALSE;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
