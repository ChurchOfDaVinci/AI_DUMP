<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="MAIN_Fast" Id="{c3f9cfcc-0865-4c2f-9fe3-3cc41bfe2f16}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN_Fast
VAR
	Router														: FB_Teltonika;
	SystemControl												: FB_SystemControl;
	AcDcCharger													: FB_AcDcCharger;
	ACswitchgear												: FB_ACSwitchgear;
	DCswitchgear												: FB_DCswitchgear;
	HartingIO													: FB_HartingIO;
	NeutralTransformer											: FB_NeutralTransformer;
	Coolingsystem												: FB_Coolingsystem;
	PowerStack													: FB_PowerStack;
	PowerMonitor												: FB_PowerQualityMonitoring;
	InternalPowerSupply											: FB_InternalPowerSupply;
	BMS															: FB_BMS;
	ProtectionSystems											: FB_ProtectionSystems;
	Enclosure													: FB_enclosure;
	PLCstate													: FB_PLCState;
	Peakshavebox												: FB_peakshavebox;
	GenComm														: FB_GenComm;				
END_VAR

VAR // structures containing all system control/monitoring vars and are exchanged with other task.
	{ attribute 'TcHmiSymbol.Hide' }
	monitor						: ST_System_Monitor;
	{ attribute 'TcHmiSymbol.Hide' }
	control						: REFERENCE TO ST_System_Control;

	fb_WritePersistentData		: WritePersistentData;
END_VAR

VAR
	//Reset function
	b_ResetManual			: BOOL;
	ton_EMstopTimeOut		: TON := (PT:= T#30S);
	w_MethodFbs				: WORD;
	tp_ResetDuration		: TP := (PT:= T#2S);
	ton_ForceShutdown		: ton := (PT := T#10S);
	ton_shutdownDelay		: ton := (PT := T#3S);
	b_shutdownInitiated		: BOOL;
	ton_NUCshutdownDelay	: ton := (PT := T#20S);
	
	//Method feedbacks
	EMstopFb				: BYTE;		
	b_EMstopCompleted		: BOOL;
	b_shutdownCompleted		: BOOL;
	b_MethodStartFB			: BOOL;
	r_trigInitialReset		: R_TRIG;
END_VAR


]]></Declaration>
    <Implementation>
      <ST><![CDATA[control REF= MAIN_Slow.control;

WearLogging();
SetConfig();
SetSystemMonitorControlvars();
BMS.Init();	//init method to initialize persistent variables from wearlogging

IF __ISVALIDREF(control) THEN

	PLCstate();
	
	Safety(b_extEmstopTrigger := SystemControl.toSystem.control.b_EMStop,
		b_enable := GVL.b_SystemReady
		);
		Safety.EDMSignals.b_NetcontactorEDM := Powerstack.b_NetcontEDM;
		Safety.EDMSignals.b_MccbMasterEDM:= Powerstack.b_MasterMccbEDM;
		Safety.EDMSignals.b_MccbSlaveEDM:= Powerstack.b_SlaveMccbEDM;
		
	//call FB
	
	PowerStack(
			e_ACRotationStateExt			:= powermonitor.get.OutputField.e_ACrotationStatus,
			r_PLossInternal					:= powermonitor.get.InternalSupply.ar_ActivePower[0],
			r_QLossInternal					:= powermonitor.get.InternalSupply.ar_ReactivePower[0],
			st_params						:= settings.MachineParams.Powerstack,
			st_calibration 					:= settings.Calibration.Powerstack,
			set								:= SystemControl.toSystem.Powerstack,
			b_transportMode					:= systemcontrol.toSystem.b_TransportMode,
			b_DoublePowermodule				:= settings.Configuration.b_DoublePowerModule,
			by_coolingPowerRequest			:= coolingsystem.by_PSPowerRequest,
			b_BatteryDCReady				:= BMS.PowerStatus = eHVDC_Powerstatus.ON,
			r_BatteryDCvoltage				:= BMS.get.MBMU.BatteryStatus.r_SystemVoltage,
			b_RotationswitchEnable			:= settings.Configuration.b_AutomaticACrotation,
			b_ExtgridCodeTrip				:= Powermonitor.get.OutputField.r_CurrentUnbalance > settings.GridParams.r_CurrentUnbalanceLimit AND Powermonitor.get.OutputField.ar_Current[0] > 20 AND NOT settings.Configuration.b_NeutralTransformer,
			b_EnableFan						:= coolingsystem.b_FanPowerstackEnable,
			b_OutputConnected				:= ACswitchgear.get.b_OutputMCCBfb,
			b_InputConnected				:= ACswitchgear.get.b_inputMCCBfb,// AND ACswitchgear.get.b_InputContactorfb
			b_InternalACRequired			:= InternalPowerSupply.b_PowerStackACRequired
		);

	PowerMonitor(
		b_enable:= TRUE,
		powerstackGet := powerstack.get,
		b_TNModeActive:= Monitor.protections.Insulation.e_EarthingSystemDetected <> eEarthingsystems.IT,
		b_thirdOutputfieldAvailable := settings.Configuration.b_ThirdOutputConnection,
		b_NeutralTransformerAvailable := settings.Configuration.b_NeutralTransformer,
		b_InputFieldsAvailable := settings.Configuration.b_ACInputConnection
		);
	
	InternalPowerSupply(
			st_PowerstackDemandSupply := Powerstack.st_InternalPsuSupplyRequest, 
			st_CoolingDemandSupply := Coolingsystem.IPSRequest,
			b_BusbarACAvailable := powerstack.get.b_ACdetected,
			b_PowerstackACavailable := powerstack.b_InternalPsuACOk,
			st_params:=Settings.MachineParams.Interpowersupply,
			e_BMSPowerState := BMS.PowerStatus,
			b_ConditioningOnBatteryAllowed := BMS.b_InternalHVDCAllowed
		);

	BMS(
		st_params 		:= settings.MachineParams.BMS,
		b_HVDCEnable	:= Internalpowersupply.b_HVDC_Enable,
		set 			:= Systemcontrol.toSystem.BMS,
		by_NoOfStrings	:= Settings.Configuration.by_NoBatteryStrings
	);	

	Enclosure(st_params := Settings.MachineParams.Enclosure, set := SystemControl.toSystem.Enclosure);
		Enclosure.ledstrip.SetMachineStatus(
			b_Error := GVL.b_QuickshutdownActive OR GVL.b_EmergencyShutdownActive OR GVL.b_NormalShutdownActive,
			b_warning := GVL.b_WarningActive,
			b_attention := NOT BMS.get.BatteryInfo.b_chargingAllowed OR NOT BMS.get.BatteryInfo.b_dischargingAllowed,
			b_Normal := BMS.PowerStatus = eHVDC_powerstatus.ON,
			b_off :=  Monitor.system.e_State = eSystemState.Transport,
			r_Soc := BMS.get.BatteryInfo.r_SOCScaled,
			r_DCcurrent := Powerstack.get.r_DCcurrent);

	CoolingSystem(
		st_params := settings.MachineParams.Coolingsystem,
		by_PSsetCooling:= powerstack.by_CoolingControl,
		b_InverterRunning:= powerstack.get.b_InverterRunning,
		r_InverterLoad := powerstack.get.r_LoadPercent,
		b_24v_Available := internalpowersupply.Get.b_24VdcAvailable,
		b_400v_Available := internalpowersupply.Get.b_400VACAvailable,
		e_400vSupplySource := internalpowersupply.Get.e_400VSupplySource,
		r_BMSAverageBattTemp := BMS.get.BatteryInfo.ar_CellTemperature[eSubvalues.Average],
		r_BMSMaxBattTemp := BMS.get.BatteryInfo.ar_CellTemperature[eSubvalues.Maximum],
		b_DehumStart := systemcontrol.toSystem.control.b_startDeHum,
		r_enclosureHumidity := enclosure.get.climate.r_Humidity,
		r_enclosureTemperature := enclosure.get.climate.r_Temperature,
		r_InverterTemp := Powerstack.get.PowermoduleMaster.r_TemperatureInverter,
		b_ConditioningOnBatteryAllowed := BMS.b_InternalHVDCAllowed
		);
		
	
	NeutralTransformer(
		b_enable:= settings.Configuration.b_NeutralTransformer,
		r_currentN := Powermonitor.get.BESS.ar_Current[phases.N],
		r_linevoltage := powermonitor.get.OutputField.ar_LineVoltage[Phases.AVG],
		r_voltageUnbalance := Powermonitor.get.Outputfield.r_VoltageUnbalance,
		b_NetcontactorFB := Powerstack.get.Netcontactor.b_NetConFb,
		st_params := settings.MachineParams.NeutralTransformer
		);
	
		
	ProtectionSystems(
		st_params := settings.MachineParams.Protections,
		powermonitor := Powermonitor.get,
		b_batteryAlarm := BMS.get.Events.b_OVER_TEMP_ALARM
	);
		ProtectionSystems.ToInsuMon.b_MccbfbMaster := Powerstack.get.PowermoduleMaster.b_MccbFb;
		ProtectionSystems.ToInsuMon.b_MccbfbSlave := Powerstack.get.PowermoduleSlave.b_MccbFb;
		ProtectionSystems.ToInsuMon.b_NetContFB := Powerstack.get.Netcontactor.b_NetConFb;
		ProtectionSystems.ToInsuMon.b_ACdetected := Powerstack.get.b_ACdetected;
		ProtectionSystems.ToInsuMon.b_PENlinkFB := AcSwitchgear.get.b_PENlinkfb;
		ProtectionSystems.set := systemcontrol.toSystem.Protections;
		
	ACswitchgear(
		b_inputAvailable:= settings.Configuration.b_ACInputConnection,
		b_NeutralTransformerAvailable := settings.Configuration.b_NeutralTransformer, 
		b_MCCBinputShuntTrip := protectionsystems.get.OvercurrentProtection.b_InputAlarm,
		b_MCCBOutputShuntTrip:= protectionsystems.get.overcurrentprotection.b_OutputAlarm,
		b_TransportMode := Monitor.system.e_State = eSystemState.Transport,
		set := Systemcontrol.toSystem.ACSwitchgear,
		st_params := settings.MachineParams.ACswitchgear,
		);
		
	AcDcCharger(
		st_params := settings.MachineParams.ACDCCharger,
		enable:= Settings.Configuration.b_DcCharger,
		set := systemcontrol.tosystem.AcDcCharger,(*BMS := BMS.get.BatteryInfo,*) 
		r_Soc := BMS.get.BatteryInfo.r_SOCScaled, 
		r_SystemVoltage := BMS.get.BatteryInfo.r_SystemVoltage,
		r_SystemCurrent := BMS.get.BatteryInfo.r_SystemCurrent,
		r_MaxChargeCurrent := BMS.get.BatteryInfo.r_MaxChargeCurrentAllowed,
		b_BatteryOn := (BMS.get.BatteryInfo.e_BMS_PowerOnStatus = ePowerOnSTatus.On), 
		b_BatteryFullyCharged := (BMS.get.BatteryInfo.e_BMS_Status = eBMS_status.FullCharge)
		);
		
	
	HartingIO(
		st_params := settings.MachineParams.HartingIO,
		set := systemcontrol.toSystem.HartingIO,
		SystemOperating := Powerstack.get.b_StartedState,
		SystemEmStop := Monitor.system.e_State = eSystemState.EMstop,
		);
		
	GenComm(
		st_params := settings.MachineParams.GenComm,
		set := systemcontrol.toSystem.GenComm);
	
	//external measurement box (PSB)	
	Peakshavebox(st_params := settings.MachineParams.PSB,
		b_enable:= settings.Configuration.b_PeakshaverBoxEnable AND Control.SoftSettings.setup.b_PeakshaveBoxEnable);
	PeakshaveBox.set := systemcontrol.toSystem.Peakshavebox;

	
	//Router --> GPS, 4G, SMS etc.
	Router(s_message := errorhandling.a_SMSEventBuffer, 
		st_params := Settings.MachineParams.Router,
		s_SerialNumber := settings.Properties.s_SerialNumber);
	monitor.system.b_SMSnumberConfigured := Router.SetSMSNumber(control.SoftSettings.system.s_SMSnumber);
	monitor.system.b_CustomNameConfigured:= Router.SetDevName(control.SoftSettings.system.s_SystemName);

	//FB with connection from user to system vars
	SystemControl(
		st_params := settings.MachineParams.system,
		st_calibration := settings.Calibration,
		monitor:= monitor, control:= control);
	

//CALL MAIN FUNCTIONS
	Reset(SystemControl.toSystem.control.b_Reset, NOT GVL.b_SystemReady OR settings.MachineParams.system.b_VDLReset);
	MainSFC();
	//System shutdown --> manually or by firesystem
	SystemShutdown(Systemcontrol.toSystem.control.b_SystemShutdown OR ProtectionSystems.b_SystemShutdownCMD);
END_IF
]]></ST>
    </Implementation>
    <Folder Name="SFC" Id="{e3e26b5f-f1e8-47e6-a64d-4aa0da400882}" />
    <Action Name="_aErrorSequence_entry" Id="{1b93d4fa-78ca-47ae-85b4-4ece75f01b15}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[SFCReset := TRUE;]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aInit_active" Id="{effe53df-6a9d-4897-a064-92b16ed612db}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[//INIT state
b_EMstopCompleted :=  FALSE;
Monitor.system.e_State:= eSystemState.Init;

]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aStandBy_active" Id="{8b351738-c15a-40bc-af25-8570c9331b8e}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[Powerstack.Standbycmd();
Internalpowersupply.HVDC_Enable();

IF systemcontrol.toSystem.b_TransportMode THEN
	IF Coolingsystem.Shutdown() THEN
		powerstack.Shutdowncmd();
	END_IF
	AcSwitchgear.set.b_inputContactorOpen := TRUE;
	Monitor.system.e_State:= eSystemState.Transport;
ELSE
	Monitor.system.e_State:= eSystemState.Init;
	Coolingsystem.Start();
	IF coolingsystem.Get.CoolingSystemMode = eCoolingSystemState.EnclosureConditioning OR 
	coolingsystem.Get.CoolingSystemMode = eCoolingSystemState.BatteryConditioning OR
	coolingsystem.Get.CoolingSystemMode = eCoolingSystemState.InverterConditioning THEN
		Monitor.system.e_State:= eSystemState.Conditioning;
	ELSIF coolingsystem.Get.CoolingSystemMode = eCoolingSystemState.DeHum OR
	coolingsystem.Get.CoolingSystemMode = eCoolingSystemState.DehumEnding THEN
		Monitor.system.e_State := eSystemState.Dehumidifying;	 
	ELSE
		Monitor.system.e_State:= eSystemState.StandBy;
	END_IF
END_IF
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="a_ContinousActions" Id="{05c6989e-311b-4791-aca1-bb295fcfd946}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[ErrorSFC();
]]></ST>
      </Implementation>
    </Action>
    <Action Name="a_EmergencyShutdown_active" Id="{b86c67cf-82ba-4cb1-ad85-40515fa44753}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[SFCReset := TRUE;
b_EMstopCompleted := EMStop();
Monitor.system.e_State := eSystemState.EMstop;
InternalPowersupply.HVDC_disable();


]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="a_ErrorSequence_active" Id="{8c0a0457-7263-4e49-add3-136bfbc6663a}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[// SFC IDENTIFICATION
Powerstack.Shutdowncmd();
Reset(FALSE, systemcontrol.toSystem.control.b_Reset);

IF GVL.b_EmergencyShutdownActive THEN
	InternalPowersupply.HVDC_disable();
	Monitor.system.e_State := eSystemState.EMstop;
END_IF]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="a_ErrorSequence_exit" Id="{edde1199-4f99-4b0f-b15c-c5f29e8fc03b}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[//RELEASE MAINSEQUENCE AFTER ALL ERROR ARE CLEARED
Reset(FALSE, FALSE);
SFCReset := FALSE;]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Method Name="CheckDCcurrent" Id="{894e27fd-7344-41a9-87ad-52eadf33d1ca}">
      <Declaration><![CDATA[METHOD PUBLIC CheckDCcurrent : BOOL
VAR_INPUT
	r_in			: REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//checkcurrent is below limit.
CheckDCcurrent := (BMS.get.BatteryInfo.r_SystemCurrent < r_in AND powerstack.get.r_DCcurrent < r_in);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="EMstop" Id="{d110c828-9456-4fbe-bfdd-d6633d4c6709}">
      <Declaration><![CDATA[METHOD EMstop : BOOL

VAR
	EMstopDone	: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//EMstopDone := Powerstack.EMstop() AND 
//	Coolingsystem.EMSTOP() AND 
//	Internalpowersupply.EMstop() AND 
//	BMS.EMSTOP() AND 
//	systemcontrol.EMstop();
	
EMstopFb.0 := Powerstack.EMstop();
EMstopFb.1 := Coolingsystem.EMSTOP();
EMstopFb.2 := Internalpowersupply.EMstop();
EMstopFb.3 := BMS.EMSTOP();
EMstopFb.4 := systemcontrol.EMstop();
EMstopFb.5 := ACDCCharger.EMSTOP();;
EMstopFb.6 := TRUE;
EMstopFb.7 := TRUE;

EMstopDone:= EMstopFb = 255;

ton_EMstopTimeOut(IN:= NOT EMstopDone);
EMstop := EMstopDone; //OR ton_EMstopTimeOut.Q;

IF EMstopDone THEN
	EMstopFb := 0;
END_IF

//IF ton_EMstopTimeOut.Q THEN
//	InternalPowersupply.SystemShutdown(FALSE);
//END_IF



]]></ST>
      </Implementation>
    </Method>
    <Action Name="ErrorSFC" Id="{0329997e-c4aa-4da2-8bb2-5babd452e15d}" FolderPath="SFC\">
      <Implementation>
        <SFC>
          <XmlArchive>
            <Data>
              <o xml:space="preserve" t="SFCImplementationObject">
                <o n="Root" t="SFCSegment">
                  <o n="ElementList" t="SFCElementList">
                    <l2 n="InnerList">
                      <o t="SFCStep">
                        <n n="EmbeddedMainAction" />
