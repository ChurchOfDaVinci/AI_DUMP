    <Method Name="GetextcontrolData" Id="{edbeba57-aa21-4dbb-962f-3598133f7234}" FolderPath="ArrayDataMethods\">
      <Declaration><![CDATA[METHOD GetextcontrolData : ST_HMI_Monitor_ArrayDataFormat
VAR_IN_OUT CONSTANT
	data : ST_ExtController_get;
END_VAR


VAR_INPUT
	id: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE ID OF 
	1: 		GetextcontrolData.s_Name:= 'Start';
			GetextcontrolData.s_Type:= 'general';
			GetextcontrolData.s_unit:= TO_STRING(data.control.b_start);
	2: 		GetextcontrolData.s_Name:= 'Shutdown';
			GetextcontrolData.s_Type:= 'general';
			GetextcontrolData.s_unit:= TO_STRING(data.control.b_shutdown);		
	3: 		GetextcontrolData.s_Name:= 'Emstop';
			GetextcontrolData.s_Type:= 'general';
			GetextcontrolData.s_unit:= TO_STRING(data.control.b_EMstop);
	4: 		GetextcontrolData.s_Name:= 'Reset';
			GetextcontrolData.s_Type:= 'general';
			GetextcontrolData.s_unit:= TO_STRING(data.control.b_reset);
	5: 		GetextcontrolData.s_Name:= 'Activate settings';
			GetextcontrolData.s_Type:= 'general';
			GetextcontrolData.s_unit:= TO_STRING(data.control.b_ActivateSettings);
	6: 		GetextcontrolData.s_Name:= 'Automatic switching';
			GetextcontrolData.s_Type:= 'general';
			GetextcontrolData.s_unit:= TO_STRING(data.SoftSettings.system.b_AutomaticSwitching);
	7:		GetextcontrolData.s_Name:= 'Condition mode';
			GetextcontrolData.s_Type:= 'general';
			GetextcontrolData.s_Unit:= TO_STRING(data.SoftSettings.system.b_EnableTransportMode);
	8:		GetextcontrolData.s_Name:= 'Start Dehumid';
			GetextcontrolData.s_Type:= 'general';
			GetextcontrolData.s_Unit:= TO_STRING(data.control.b_startDeHum);
	9:		GetextcontrolData.s_Name:= 'SOC min';
			GetextcontrolData.s_Type:= 'battery';
			GetextcontrolData.s_Unit:= '%';
			GetextcontrolData.i_precision:= 0;
			GetextcontrolData.r_Data:= data.SoftSettings.system.r_SocMin;
			GetextcontrolData.b_warning:= data.events.b_SoCLowLimitOutOfRange;
	10:		GetextcontrolData.s_Name:= 'SOC max';
			GetextcontrolData.s_Type:= 'battery';
			GetextcontrolData.s_Unit:= '%';
			GetextcontrolData.i_precision:= 0;
			GetextcontrolData.r_Data:= data.SoftSettings.system.r_SocMax;
			GetextcontrolData.b_warning:= data.events.b_SoCHighLimitOutOfRange;
	11: 	GetextcontrolData.s_Name:= 'PFset enable';
			GetextcontrolData.s_Type:= 'powerstack';
			GetextcontrolData.s_Unit:= TO_STRING(data.operation.system.b_PFsetEnable);
	13: 	GetextcontrolData.s_Name:= 'Reserved';
			GetextcontrolData.s_Type:= 'powerstack';
			GetextcontrolData.s_Unit:= '-';
	14: 	GetextcontrolData.s_Name:= 'Gridmode';
			GetextcontrolData.s_Type:= 'general';
			GetextcontrolData.b_warning := data.events.b_GridModeValueOutOfRange;
			GetextcontrolData.s_Unit:= TO_STRING(data.SoftSettings.setup.e_Gridmode);
	15: 	GetextcontrolData.s_Name:= 'Powermode';
			GetextcontrolData.s_Type:= 'general';
			GetextcontrolData.b_warning := data.events.b_PowerModeValueOutOfRange;
			GetextcontrolData.s_Unit:= TO_STRING(data.SoftSettings.system.e_UgridPowerMode);
	16:		GetextcontrolData.s_Name:= 'Pset';
			GetextcontrolData.s_Type:= 'powerstack';
			GetextcontrolData.s_Unit:= 'kW';
			GetextcontrolData.i_precision:= 1;
			GetextcontrolData.b_warning := data.events.b_PsetOutOfRange;
			GetextcontrolData.r_Data:= data.Operation.system.r_Pset;
	17:		GetextcontrolData.s_Name:= 'Qset';
			GetextcontrolData.s_Type:= 'powerstack';
			GetextcontrolData.s_Unit:= 'kvar';
			GetextcontrolData.i_precision:= 1;
			GetextcontrolData.b_warning := data.events.b_QsetOutOfRange;
			GetextcontrolData.r_Data:= data.Operation.system.r_Qset;
	18:		GetextcontrolData.s_Name:= 'PFset';
			GetextcontrolData.s_Type:= 'powerstack';
			GetextcontrolData.s_Unit:= '-';
			GetextcontrolData.i_precision:= 2;
			GetextcontrolData.b_warning := data.events.b_PFsetOutOfRange;
			GetextcontrolData.r_Data:= data.Operation.system.r_PFset;
	19:		GetextcontrolData.s_Name:= 'Nom voltage';
