			GetAcOutputArrayData.i_precision:= 1;
			GetAcOutputArrayData.b_warning := data.r_EnergySupplied < 0;              
			GetAcOutputArrayData.r_Data:= data.r_EnergySupplied;
ELSE	
		RETURN;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetActiveTimeSlotScheduler" Id="{c40a78b0-a172-4c0a-8e39-5cb8d688ec4d}" FolderPath="SchedulerMethods\">
      <Declaration><![CDATA[METHOD GetActiveTimeSlotScheduler
VAR_INPUT
	enable			: BOOL;
END_VAR

VAR_IN_OUT
	timeslot1 : ST_scheduleTimeslot;
	timeslot2 : ST_scheduleTimeslot;
END_VAR

VAR
	w_targetToW1 : WORD; //time of week
	w_targetToW2 : WORD;
	w_CurrentToW : WORD;
	w_CurrentDoW : WORD; 
	w_CurrentToD : WORD; // in minutes\
END_VAR

VAR
	w_MillisInMinute: WORD := 60000;
	w_MinutesInHour	: WORD := 60;
	w_MinutesInDay	: WORD := w_MinutesInHour * 24;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF enable THEN
	//enable weekly evaluation
	IF timeslot1.usi_DayOfWeek = 0 THEN
		w_CurrentDoW := 0;
		timeslot2.usi_DayOfWeek := 0;
	ELSE
		w_CurrentDoW := F_GetDayOfWeek(IN:=GVL.dt_SystemDateTime);
	END_IF

	w_CurrentToD := TO_WORD(TO_DWORD(TO_TOD(GVL.dt_SystemDateTime))/w_MillisInMinute);
	w_CurrentToW := w_CurrentToD + w_CurrentDoW * w_MinutesInDay;
	w_targetToW1 := Hour_Minute_To_TOW(timeslot1.usi_DayOfWeek,timeslot1.usi_HourOfDay, timeslot1.usi_MinuteOfHour);
	w_targetToW2 := Hour_Minute_To_TOW(timeslot2.usi_DayOfWeek,timeslot2.usi_HourOfDay, timeslot2.usi_MinuteOfHour);
	
	IF w_targetToW1 < w_targetToW2 THEN
		Timeslot1.b_active := w_CurrentToW >= w_targetToW1 AND w_CurrentToW < w_targetToW2;
		Timeslot2.b_active := NOT timeslot1.b_active;
	ELSE
		Timeslot2.b_active := w_CurrentToW >= w_targetToW2 AND w_CurrentToW < w_targetToW1;
		Timeslot1.b_active := NOT timeslot2.b_active;
	END_IF	
ELSE
	Timeslot2.b_active := FALSE;
	Timeslot1.b_active := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetCoolingData" Id="{2d57157c-057a-44c2-b8b2-465df3409131}" FolderPath="ArrayDataMethods\">
      <Declaration><![CDATA[METHOD GetCoolingData : ST_HMI_Monitor_ArrayDataFormat
VAR_IN_OUT CONSTANT
	data			: ST_CoolingSystem_get;
END_VAR

VAR_INPUT
	id: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE ID OF 
	1: 		GetCoolingData.s_Name:= 'Mode';
			GetCoolingData.s_Type:= 'status';
			GetCoolingData.s_unit:= TO_STRING(data.CoolingSystemMode);
	2: 		GetCoolingData.s_Name:= 'Heatpump status';
			GetCoolingData.s_Type:= 'status';
			GetCoolingData.s_unit:= TO_STRING(data.HeatPumpStatus);
	3: 		GetCoolingData.s_Name:= 'Coolant pressure';
			GetCoolingData.s_Type:= 'measure';
			GetCoolingData.s_Unit:= 'bar';
			GetCoolingData.i_precision:= 2;
			GetCoolingData.r_data:= data.r_CoolantPressure;
	4: 		GetCoolingData.s_Name:= 'Coolant temperature';
			GetCoolingData.s_Type:= 'measure';
			GetCoolingData.s_Unit:= '°C';
			GetCoolingData.i_precision:= 1;
			GetCoolingData.r_data:= data.r_CoolantTemperature;
	5:		GetCoolingData.s_Name:= 'Enclosure Dewpoint';
			GetCoolingData.s_Type:= 'measure';
			GetCoolingData.s_Unit:= '°C';
			GetCoolingData.i_precision:= 1;
			GetCoolingData.r_Data:= data.r_EnclosureDewpoint;
	ELSE	
		RETURN;			
END_CASE]]></ST>
      </Implementation>
    </Method>
