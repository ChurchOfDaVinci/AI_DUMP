			GetAcOutputArrayData.s_Unit:= 'A';                 
			GetAcOutputArrayData.i_precision:= 1; 
			GetAcOutputArrayData.b_warning := monitor.protections.OvercurrentProtection.Events.Output[2][phases.L2].b_warning;             
			GetAcOutputArrayData.r_Data:=  data.powerlock[2].ar_Current[phases.L2];
	28: 	GetAcOutputArrayData.s_Name:= 'L3';                
			GetAcOutputArrayData.s_Type:= 'AC Current 2'; 
			GetAcOutputArrayData.s_Unit:= 'A';                 
			GetAcOutputArrayData.i_precision:= 1;
			GetAcOutputArrayData.b_warning := monitor.protections.OvercurrentProtection.Events.Output[2][phases.L3].b_warning;              
			GetAcOutputArrayData.r_Data:=  data.powerlock[2].ar_Current[phases.L3];
	29: 	GetAcOutputArrayData.s_Name:= 'N';                 
			GetAcOutputArrayData.s_Type:= 'AC Current 2'; 
			GetAcOutputArrayData.s_Unit:= 'A';                 
			GetAcOutputArrayData.i_precision:= 1;
			GetAcOutputArrayData.b_warning := monitor.protections.OvercurrentProtection.Events.Output[2][phases.N].b_warning;              
			GetAcOutputArrayData.r_Data:=  data.powerlock[2].ar_Current[phases.N];
	30: 	GetAcOutputArrayData.s_Name:= 'L1';
			GetAcOutputArrayData.s_Type:= 'AC Current 3';
			GetAcOutputArrayData.s_Unit:= 'A';
			GetAcOutputArrayData.i_precision:= 1;
			GetAcOutputArrayData.b_warning := monitor.protections.OvercurrentProtection.Events.Output[3][phases.L1].b_warning;
			GetAcOutputArrayData.r_Data:=   data.powerlock[3].ar_Current[phases.L1];
	31: 	GetAcOutputArrayData.s_Name:= 'L2';                
			GetAcOutputArrayData.s_Type:= 'AC Current 3'; 
			GetAcOutputArrayData.s_Unit:= 'A';                 
			GetAcOutputArrayData.i_precision:= 1;     
			GetAcOutputArrayData.b_warning := monitor.protections.OvercurrentProtection.Events.Output[3][phases.L2].b_warning;         
			GetAcOutputArrayData.r_Data:=  data.powerlock[3].ar_Current[phases.L2];
	32: 	GetAcOutputArrayData.s_Name:= 'L3';                
			GetAcOutputArrayData.s_Type:= 'AC Current 3'; 
			GetAcOutputArrayData.s_Unit:= 'A';                 
			GetAcOutputArrayData.i_precision:= 1;    
			GetAcOutputArrayData.b_warning := monitor.protections.OvercurrentProtection.Events.Output[3][phases.L3].b_warning;          
			GetAcOutputArrayData.r_Data:=  data.powerlock[3].ar_Current[phases.L3];
	33: 	GetAcOutputArrayData.s_Name:= 'N';                 
			GetAcOutputArrayData.s_Type:= 'AC Current 3'; 
			GetAcOutputArrayData.s_Unit:= 'A';                 
			GetAcOutputArrayData.i_precision:= 1;
			GetAcOutputArrayData.b_warning := monitor.protections.OvercurrentProtection.Events.Output[3][phases.N].b_warning;              
			GetAcOutputArrayData.r_Data:= data.powerlock[3].ar_Current[phases.N];
	34:		GetAcOutputArrayData.s_Name:= 'Rotation field';
			GetAcOutputArrayData.s_Type:= 'AC';
			GetAcOutputArrayData.s_Unit:= TO_STRING(data.e_ACrotationStatus);
	35: 	GetAcOutputArrayData.s_Name:= 'Energy in';                 
			GetAcOutputArrayData.s_Type:= 'Energy'; 
			GetAcOutputArrayData.s_Unit:= 'kWh';                 
			GetAcOutputArrayData.i_precision:= 1;
