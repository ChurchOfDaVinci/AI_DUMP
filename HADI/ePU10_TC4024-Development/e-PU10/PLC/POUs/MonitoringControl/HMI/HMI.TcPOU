<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="HMI" Id="{60dc6bb9-8218-49aa-8772-c76a0aa4b773}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM HMI

VAR_IN_OUT CONSTANT
	{ attribute 'TcHmiSymbol.Hide' }
	monitor								: ST_System_Monitor;
	{ attribute 'TcHmiSymbol.Hide' }
	PNcontrolvars						: ST_ExtController_get;
	{ attribute 'TcHmiSymbol.Hide' }
	Iotcontrolvars						: ST_ExtController_get;	
	{ attribute 'TcHmiSymbol.Hide' }
	PLCpersistvars						: ST_PLCPersistentvars;
END_VAR

VAR
	{ attribute 'TcHmiSymbol.ShowRecursively' }
	Monitoringvars		: ST_HMI_Monitor;
	{ attribute 'TcHmiSymbol.ShowRecursively' }
	Controlvars			: ST_HMI_Control;
	{ attribute 'TcHmiSymbol.ShowRecursively' }
	Historizevars		: ST_HMI_Historize;
	{ attribute 'TcHmiSymbol.Show' }
	b_refreshHMIdata			: BOOL;
	{ attribute 'TcHmiSymbol.Show' }
	b_settingschanged			: BOOL;
	{ attribute 'TcHmiSymbol.Show' }
	b_ControlAccess				: BOOL;		
END_VAR

VAR
	t_refreshtime				: TIME:= T#1S;
	ton_refreshtimer			: TON;	
	b_initCycle					: BOOL := TRUE;
	buttons						: FB_HMIButtons;
	rTrigResetPowerSetpoints	: R_TRIG;
	
	//HMI Start/Quit vars
	fbHMIstart : NT_StartProcess;
	b_hmistart	: BOOL := TRUE;
	ton_HmiStart: TON;
	fbTaskKill	: NT_StartProcess;
	b_taskKill	: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//hard settings PLC to HMI at init
CopyActSettingsFromPLC(b_initCycle);
b_settingschanged := (MEMCMP(ADR(controlvars.HardSettings), ADR(PLCpersistvars.Hardsettings), SIZEOF(PLCpersistvars.Hardsettings)) <> 0);


//HMI REFRESH SIGNAL
ton_refreshtimer(IN:= NOT ton_refreshtimer.Q, PT:=t_refreshtime);
IF ton_refreshtimer.Q THEN
	 b_refreshHMIdata := NOT b_refreshHMIdata;
END_IF

//Read variables mapping
MapPLCVarsToHMIVars();
//ResetHMIVars when event happens.
ResetHMIvarsOnEvent();
ResetControlvarsOnVariant();

//Set array data AND LINK HMI VARIABLES
SetArraydata(arrays := monitoringvars.Arraydata, b_sync := ton_refreshtimer.Q, init := b_initCycle);


//CALL METHODS AND NESTED FUNCTIONBLOCK
buttons(controlvars := controlvars, monitoringvars := monitoringvars, b_controlaccess := b_controlaccess);
//PSB scheduler function functionaly
GetActiveTimeSlotScheduler(enable:= controlvars.SoftSettings.System.b_EnableSchedule,
	timeslot1 := controlvars.SoftSettings.system.ScheduleTimeSlot1,
	timeslot2 := controlvars.SoftSettings.system.ScheduleTimeSlot2);

b_InitCycle := FALSE;
]]></ST>
    </Implementation>
    <Folder Name="ArrayDataMethods" Id="{4ca66fc5-9f33-4dca-94c9-22713e87623e}" />
    <Folder Name="ControlsHandlingMethods" Id="{9743a59c-d1d0-4ad7-887d-018a332e942f}" />
    <Folder Name="MonitorHandlingMethods" Id="{f7a6b299-03d7-4dfc-855c-1ddf6bc9d2c5}" />
    <Folder Name="SchedulerMethods" Id="{60f9e2bb-db1c-4499-af8b-7b0818bd2dca}" />
    <Method Name="ConditionalFormatting" Id="{d5e65d05-5d3d-4e50-b7f2-4282fc4c1310}" FolderPath="MonitorHandlingMethods\">
      <Declaration><![CDATA[METHOD ConditionalFormatting 
VAR_IN_OUT
	data : ST_HMI_ConditionalFormatting;
	controls : ST_HMI_control;
END_VAR

VAR
	b_GridTakeover	: BOOL;
	b_inputgenset	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[b_GridTakeover := monitor.controlfb.Operation.system.b_GridTakeOverEnable AND monitor.system.GenGridController.e_BreakerMode = eBreakerOperationMode.GridFeedthrough;

IF monitor.controlfb.HardSettings.setup.e_ControlSource = 0 AND
	 NOT Monitor.powerstack.b_InverterGridFormingMode AND Monitor.powerstack.b_StartedState OR b_GridTakeover THEN
		data.b_ShowPset := (NOT monitor.peakshavebox.b_active AND NOT monitor.system.GenGridController.b_active) OR b_GridTakeover;
		data.b_ShowQset := NOT Monitor.controlfb.operation.system.b_PFsetEnable;
		data.b_showPFset := Monitor.controlfb.operation.system.b_PFsetEnable AND monitor.controlfb.HardSettings.setup.e_ControlSource = 0 AND Monitor.controlfb.SoftSettings.setup.e_AcInputType <> eACInputType.Genset;
ELSE
	data.b_ShowPset := FALSE;
	data.b_ShowQset := FALSE;
	data.b_ShowPFset := FALSE;
END_IF

data.b_showPSBData := monitor.system.GenGridController.e_PowerControlMode = ePowercontrolmode.PeakshaveExt;
data.b_ShowInputDisconnect := monitor.system.GenGridController.e_BreakerMode <> eBreakerOperationMode.None;
data.b_ShowModeTransButton := monitor.system.GenGridController.b_ShowModeTrans;

(*monitor.system.GenGridController.b_ModeTransActive OR NOT monitor.system.GenGridController.b_ModeTransInhibit AND 
	monitor.system.GenGridController.e_BreakerMode <> eBreakerOperationMode.GenFeedthrough AND monitor.system.GenGridController.e_BreakerMode <> eBreakerOperationMode.none AND monitor.system.GenGridController.e_BreakerMode <> eBreakerOperationMode.GenIso;

*)
b_inputgenset := monitor.system.GenGridController.e_BreakerMode = eBreakerOperationMode.GenDroop OR
							monitor.system.GenGridController.e_BreakerMode = eBreakerOperationMode.GenFix OR
							monitor.system.GenGridController.e_BreakerMode = eBreakerOperationMode.GenIso;
data.b_ShowShowGensetInfo := b_inputgenset OR monitor.system.GenGridController.b_extGensetMode;
data.b_ShowGenManStartStop := NOT Monitor.controlfb.SoftSettings.inputgenset.b_AutoStartStop AND data.b_ShowShowGensetInfo OR monitor.system.GenGridController.e_GensetStartStop = eGensetstartstop.Start;
data.b_ShowExtgenset := NOT b_inputgenset AND monitor.controlfb.SoftSettings.setup.e_AcInputType <> eAcInputType.Genset;
data.b_ShowGensetHybridMode := monitor.system.GenGridController.e_BreakerMode = eBreakerOperationMode.GenIso AND NOT monitor.system.GenGridController.b_extGensetMode; ]]></ST>
      </Implementation>
    </Method>
    <Method Name="CopyActSettingsFromPLC" Id="{326a3b2c-f369-49e3-87db-495557214cc2}" FolderPath="ControlsHandlingMethods\">
      <Declaration><![CDATA[METHOD CopyActSettingsFromPLC : BOOL

VAR_IN_OUT
	init	: BOOL;
END_VAR

VAR
	udi_pointer		: POINTER TO ST_Softsettings;
	b_Onchange 		: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF init THEN
	controlvars.HardSettings := PLCpersistvars.Hardsettings;
	controlvars.SoftSettings := PLCpersistvars.Softsettings;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="DataToHMIArrayFormat" Id="{a405edf0-461d-4789-82bf-da80802179a8}" FolderPath="ArrayDataMethods\">
      <Declaration><![CDATA[METHOD PRIVATE DataToHMIArrayFormat
VAR_INPUT
	data								: ST_HMI_Monitor_ArrayDataFormat;
	init								: BOOL;
END_VAR

VAR_IN_OUT
	st_DataOut							: ST_HMIData;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// first cycle only
IF init THEN
	st_DataOut.s_Type := data.s_Type;
	st_DataOut.s_Name := data.s_Name;
	IF data.i_precision <> -1 THEN
		st_DataOut.s_unit := data.s_unit;
	END_IF
	
END_IF


IF data.i_precision = -1 THEN
	st_DataOut.s_Data := data.s_unit;
ELSE
	st_DataOut.s_Data := LREAL_TO_FMTSTR(in:=data.r_Data, iprecision := data.i_precision, bRound := TRUE);
END_IF

IF data.b_warning <> st_DataOut.b_warning THEN
	st_DataOut.b_warning := data.b_warning;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetAcInputArrayData" Id="{fb71ac2a-7058-4dff-8f7d-bb974837d144}" FolderPath="ArrayDataMethods\">
      <Declaration><![CDATA[METHOD GetAcInputArrayData : ST_HMI_Monitor_ArrayDataFormat
VAR_IN_OUT CONSTANT
	data : ST_Powermonitor_Inputfield;
END_VAR

VAR_INPUT
	id: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE ID OF 
	1: 		GetAcInputArrayData.s_Name:= 'MCCB State';
			GetAcInputArrayData.s_Type:= 'Status';
			GetAcInputArrayData.s_unit:= TO_STRING(monitor.ACswitchgear.b_inputMCCBfb);
	2: 		GetAcInputArrayData.s_Name:= 'MCCB Shunt State';
			GetAcInputArrayData.s_Type:= 'Status';
			GetAcInputArrayData.s_unit:= TO_STRING(monitor.ACswitchgear.b_InputMCCBshuntOK);
	3:		GetAcInputArrayData.s_Name:= 'Apparent Power';
			GetAcInputArrayData.s_Type:= 'AC';
			GetAcInputArrayData.s_Unit:= 'kVA';
			GetAcInputArrayData.i_precision:= 0;
			GetAcInputArrayData.r_Data:= data.ar_ApparentPower[0];
	4:		GetAcInputArrayData.s_Name:= 'Active Power';
			GetAcInputArrayData.s_Type:= 'AC';
			GetAcInputArrayData.s_Unit:= 'kW';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.r_Data:= data.ar_ActivePower[0];
	5:		GetAcInputArrayData.s_Name:= 'Reactive Power';
			GetAcInputArrayData.s_Type:= 'AC';
			GetAcInputArrayData.s_Unit:= 'kvar';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.r_Data:= data.ar_ReactivePower[0];
	6:		GetAcInputArrayData.s_Name:= 'Current';
			GetAcInputArrayData.s_Type:= 'AC';
			GetAcInputArrayData.s_Unit:= 'A';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.r_Data:= data.ar_Current[Phases.AVG];
	7:		GetAcInputArrayData.s_Name:= 'Line Voltage';
			GetAcInputArrayData.s_Type:= 'AC';
			GetAcInputArrayData.s_Unit:= 'VAC';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.r_Data:= data.ar_LineVoltage[phases.AVG];
	8:		GetAcInputArrayData.s_Name:= 'Frequency';
			GetAcInputArrayData.s_Type:= 'AC';
			GetAcInputArrayData.s_Unit:= 'Hz';
			GetAcInputArrayData.i_precision:= 2;
			GetAcInputArrayData.r_Data:= data.ar_Frequency[0];
	9: 		GetAcInputArrayData.s_Name:= 'Power factor';
			GetAcInputArrayData.s_Type:= 'AC';
			GetAcInputArrayData.s_Unit:= '-';
			GetAcInputArrayData.i_precision:= 2;
			GetAcInputArrayData.r_Data:= data.ar_PowerFactor[phases.AVG];
	10:		GetAcInputArrayData.s_Name:= 'Voltage Unbalance';
			GetAcInputArrayData.s_Type:= 'AC';
			GetAcInputArrayData.s_Unit:= '%';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.r_Data:= data.r_VoltageUnbalance;
	11:		GetAcInputArrayData.s_Name:= 'THD';
			GetAcInputArrayData.s_Type:= 'AC';
			GetAcInputArrayData.s_Unit:= '%';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.r_Data:= data.ar_THD[phases.AVG];
	12:		GetAcInputArrayData.s_Name:= 'L1';
			GetAcInputArrayData.s_Type:= 'AC Current';
			GetAcInputArrayData.s_Unit:= 'A';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.r_Data:= data.ar_Current[phases.L1];
	13:		GetAcInputArrayData.s_Name:= 'L2';
			GetAcInputArrayData.s_Type:= 'AC Current';
			GetAcInputArrayData.s_Unit:= 'A';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.r_Data:= data.ar_Current[phases.L2];
	14:		GetAcInputArrayData.s_Name:= 'L3';
			GetAcInputArrayData.s_Type:= 'AC Current';
			GetAcInputArrayData.s_Unit:= 'A';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.r_Data:= data.ar_Current[phases.L3];
	15:		GetAcInputArrayData.s_Name:= 'N';
			GetAcInputArrayData.s_Type:= 'AC Current';
			GetAcInputArrayData.s_Unit:= 'A';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.r_Data:= data.ar_Current[phases.N];	
	16:		GetAcInputArrayData.s_Name:= 'L1-L2';
			GetAcInputArrayData.s_Type:= 'AC Linevoltage';
			GetAcInputArrayData.s_Unit:= 'VAC';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.r_Data:= data.ar_LineVoltage[phases.L1];
	17:		GetAcInputArrayData.s_Name:= 'L2-L3';
			GetAcInputArrayData.s_Type:= 'AC Linevoltage';
			GetAcInputArrayData.s_Unit:= 'VAC';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.r_Data:= data.ar_LineVoltage[phases.L2];
	18:		GetAcInputArrayData.s_Name:= 'L3-L1';
			GetAcInputArrayData.s_Type:= 'AC Linevoltage';
			GetAcInputArrayData.s_Unit:= 'VAC';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.r_Data:= data.ar_LineVoltage[phases.L3];
	19:		GetAcInputArrayData.s_Name:= 'L1-N';
			GetAcInputArrayData.s_Type:= 'AC Phasevoltage';
			GetAcInputArrayData.s_Unit:= 'VAC';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.r_Data:= data.ar_PhaseVoltage[phases.L1];	
	20:		GetAcInputArrayData.s_Name:= 'L2-N';
			GetAcInputArrayData.s_Type:= 'AC Phasevoltage';
			GetAcInputArrayData.s_Unit:= 'VAC';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.r_Data:= data.ar_PhaseVoltage[phases.L2];
	21:		GetAcInputArrayData.s_Name:= 'L3-N';
			GetAcInputArrayData.s_Type:= 'AC Phasevoltage';
			GetAcInputArrayData.s_Unit:= 'VAC';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.r_Data:= data.ar_PhaseVoltage[phases.L3];
	22: 	GetAcInputArrayData.s_Name:= 'Contactor state';
			GetAcInputArrayData.s_Type:= 'Status';
			GetAcInputArrayData.s_Unit:= TO_STRING(monitor.ACswitchgear.b_InputContactorfb);
	23: 	GetAcInputArrayData.s_Name:= 'Sync state';
			GetAcInputArrayData.s_Type:= 'Status';
			GetAcInputArrayData.s_Unit:= TO_STRING(monitor.ACswitchgear.b_InputSynchronizerfb);
	24: 	GetAcInputArrayData.s_Name:= 'L1';
			GetAcInputArrayData.s_Type:= 'AC Current 1';
			GetAcInputArrayData.s_Unit:= 'A';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.b_warning := monitor.protections.OvercurrentProtection.Events.Input[1][phases.L1].b_warning;
			GetAcInputArrayData.r_Data:= data.powerlock[1].ar_Current[phases.L1];
	25: 	GetAcInputArrayData.s_Name:= 'L2';
			GetAcInputArrayData.s_Type:= 'AC Current 1';
			GetAcInputArrayData.s_Unit:= 'A';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.b_warning := monitor.protections.OvercurrentProtection.Events.Input[1][phases.L2].b_warning;
			GetAcInputArrayData.r_Data:= data.powerlock[1].ar_Current[phases.L2];
	26: 	GetAcInputArrayData.s_Name:= 'L3';
			GetAcInputArrayData.s_Type:= 'AC Current 1';
			GetAcInputArrayData.s_Unit:= 'A';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.b_warning := monitor.protections.OvercurrentProtection.Events.Input[1][phases.L3].b_warning;
			GetAcInputArrayData.r_Data:= data.powerlock[1].ar_Current[phases.L3];
	27: 	GetAcInputArrayData.s_Name:= 'N';
			GetAcInputArrayData.s_Type:= 'AC Current 1';
			GetAcInputArrayData.s_Unit:= 'A';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.b_warning := monitor.protections.OvercurrentProtection.Events.Input[1][phases.N].b_warning;
			GetAcInputArrayData.r_Data:= data.powerlock[1].ar_Current[phases.N];
	28: 	GetAcInputArrayData.s_Name:= 'L1';
			GetAcInputArrayData.s_Type:= 'AC Current 2';
			GetAcInputArrayData.s_Unit:= 'A';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.b_warning := monitor.protections.OvercurrentProtection.Events.Input[2][phases.L1].b_warning;
			GetAcInputArrayData.r_Data:= data.powerlock[2].ar_Current[phases.L1];
	29: 	GetAcInputArrayData.s_Name:= 'L2';
			GetAcInputArrayData.s_Type:= 'AC Current 2';
			GetAcInputArrayData.s_Unit:= 'A';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.b_warning := monitor.protections.OvercurrentProtection.Events.Input[2][phases.L2].b_warning;
			GetAcInputArrayData.r_Data:= data.powerlock[2].ar_Current[phases.L2];
	30: 	GetAcInputArrayData.s_Name:= 'L3';
			GetAcInputArrayData.s_Type:= 'AC Current 2';
			GetAcInputArrayData.s_Unit:= 'A';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.b_warning := monitor.protections.OvercurrentProtection.Events.Input[2][phases.L3].b_warning;
			GetAcInputArrayData.r_Data:= data.powerlock[2].ar_Current[phases.L3];
	31: 	GetAcInputArrayData.s_Name:= 'N';
			GetAcInputArrayData.s_Type:= 'AC Current 2';
			GetAcInputArrayData.s_Unit:= 'A';
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.b_warning := monitor.protections.OvercurrentProtection.Events.Input[2][phases.N].b_warning;
			GetAcInputArrayData.r_Data:= data.powerlock[2].ar_Current[phases.N];
	32: 	GetAcInputArrayData.s_Name:= 'Energy in';                 
			GetAcInputArrayData.s_Type:= 'Energy'; 
			GetAcInputArrayData.s_Unit:= 'kWh';                 
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.b_warning := data.r_EnergyConsumed < 0;              
			GetAcInputArrayData.r_Data:= data.r_EnergyConsumed;
	33: 	GetAcInputArrayData.s_Name:= 'Energy out';                 
			GetAcInputArrayData.s_Type:= 'Energy'; 
			GetAcInputArrayData.s_Unit:= 'kWh';                 
			GetAcInputArrayData.i_precision:= 1;
			GetAcInputArrayData.b_warning := data.r_EnergySupplied < 0;              
			GetAcInputArrayData.r_Data:= data.r_EnergySupplied;
	ELSE	
		RETURN;			
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetAcOutputArrayData" Id="{c030486a-4ccb-4aa0-a2f3-74a767b1f472}" FolderPath="ArrayDataMethods\">
      <Declaration><![CDATA[METHOD	GetAcOutputArrayData : ST_HMI_Monitor_ArrayDataFormat
VAR_IN_OUT CONSTANT
	data : ST_Powermonitor_Outputfield;
END_VAR

VAR_INPUT
	id: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE ID OF 
	1: 		GetAcOutputArrayData.s_Name:= 'MCCB State';
			GetAcOutputArrayData.s_Type:= 'Status';
			GetAcOutputArrayData.s_Unit:= TO_STRING(monitor.ACswitchgear.b_outputMCCBfb);
	2: 		GetAcOutputArrayData.s_Name:= 'MCCB Shunt State';
			GetAcOutputArrayData.s_Type:= 'Status';
			GetAcOutputArrayData.s_Unit:= TO_STRING(monitor.ACswitchgear.b_outputMCCBshuntOK);
	3:		GetAcOutputArrayData.s_Name:= 'Apparent Power';
			GetAcOutputArrayData.s_Type:= 'AC';
			GetAcOutputArrayData.s_Unit:= 'kVA';
			GetAcOutputArrayData.i_precision:= 0;
			GetAcOutputArrayData.r_Data:= data.ar_ApparentPower[0];
	4:		GetAcOutputArrayData.s_Name:= 'Active Power';
			GetAcOutputArrayData.s_Type:= 'AC';
			GetAcOutputArrayData.s_Unit:= 'kW';
			GetAcOutputArrayData.i_precision:= 1;
			GetAcOutputArrayData.r_Data:= data.ar_ActivePower[0];
	5:		GetAcOutputArrayData.s_Name:= 'Reactive Power';
			GetAcOutputArrayData.s_Type:= 'AC';
			GetAcOutputArrayData.s_Unit:= 'kvar';
			GetAcOutputArrayData.i_precision:= 1;
			GetAcOutputArrayData.r_Data:= data.ar_ReactivePower[0];
	6:		GetAcOutputArrayData.s_Name:= 'Current';
			GetAcOutputArrayData.s_Type:= 'AC';
			GetAcOutputArrayData.s_Unit:= 'A';
			GetAcOutputArrayData.i_precision:= 1;
			GetAcOutputArrayData.r_Data:= data.ar_Current[Phases.AVG];
	7:		GetAcOutputArrayData.s_Name:= 'Line Voltage';
			GetAcOutputArrayData.s_Type:= 'AC';
			GetAcOutputArrayData.s_Unit:= 'VAC';
			GetAcOutputArrayData.i_precision:= 1;
			GetAcOutputArrayData.r_Data:= data.ar_LineVoltage[phases.AVG];
	8:		GetAcOutputArrayData.s_Name:= 'Frequency';
			GetAcOutputArrayData.s_Type:= 'AC';
			GetAcOutputArrayData.s_Unit:= 'Hz';
			GetAcOutputArrayData.i_precision:= 2;
			GetAcOutputArrayData.r_Data:= data.ar_Frequency[0];
	9: 		GetAcOutputArrayData.s_Name:= 'Power factor';
			GetAcOutputArrayData.s_Type:= 'AC';
			GetAcOutputArrayData.s_Unit:= '-';
			GetAcOutputArrayData.i_precision:= 2;
			GetAcOutputArrayData.r_Data:= data.ar_PowerFactor[phases.AVG];
	10:		GetAcOutputArrayData.s_Name:= 'Voltage Unbalance';
			GetAcOutputArrayData.s_Type:= 'AC';
			GetAcOutputArrayData.s_Unit:= '%';
			GetAcOutputArrayData.i_precision:= 1;
			GetAcOutputArrayData.r_Data:= data.r_VoltageUnbalance;
	11:		GetAcOutputArrayData.s_Name:= 'THD';
			GetAcOutputArrayData.s_Type:= 'AC';
			GetAcOutputArrayData.s_Unit:= '%';
			GetAcOutputArrayData.i_precision:= 1;
			GetAcOutputArrayData.r_Data:= data.ar_THD[phases.AVG];
	12:		GetAcOutputArrayData.s_Name:= 'L1';
			GetAcOutputArrayData.s_Type:= 'AC Current';
			GetAcOutputArrayData.s_Unit:= 'A';
			GetAcOutputArrayData.i_precision:= 1;
			GetAcOutputArrayData.r_Data:= monitor.powermonitor.outputfield.ar_Current[phases.L1];
	13:		GetAcOutputArrayData.s_Name:= 'L2';                            
			GetAcOutputArrayData.s_Type:= 'AC Current';                    
			GetAcOutputArrayData.s_Unit:= 'A';                            
			GetAcOutputArrayData.i_precision:= 1;                          
			GetAcOutputArrayData.r_Data:= monitor.powermonitor.outputfield.ar_Current[phases.L2];
	14:		GetAcOutputArrayData.s_Name:= 'L3';                            
			GetAcOutputArrayData.s_Type:= 'AC Current';                    
			GetAcOutputArrayData.s_Unit:= 'A';                             
			GetAcOutputArrayData.i_precision:= 1;                          
			GetAcOutputArrayData.r_Data:= monitor.powermonitor.outputfield.ar_Current[phases.L3];
	15:		GetAcOutputArrayData.s_Name:= 'N';                             
			GetAcOutputArrayData.s_Type:= 'AC Current';                    
			GetAcOutputArrayData.s_Unit:= 'A';                            
			GetAcOutputArrayData.i_precision:= 1;                          
			GetAcOutputArrayData.r_Data:= data.ar_Current[phases.N];	
	16:		GetAcOutputArrayData.s_Name:= 'L1-L2';
			GetAcOutputArrayData.s_Type:= 'AC Linevoltage';
			GetAcOutputArrayData.s_Unit:= 'VAC';
			GetAcOutputArrayData.i_precision:= 1;
			GetAcOutputArrayData.r_Data:= data.ar_LineVoltage[phases.L1];
	17:		GetAcOutputArrayData.s_Name:= 'L2-L3';
