<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_HardSettings_System" Id="{98034fe6-4735-4709-bdd7-9c2c662e90e9}">
    <Declaration><![CDATA[TYPE ST_HardSettings_System :
STRUCT
	//limits
	r_PDischargeLimit					: REAL := 360; 
	r_PChargeLimit						: REAL := 360;
	r_SMax								: REAL := 480;// 1.25* (settings.MachineParams.Powerstack.PowermoduleMaster.r_InverterRatedPower + SEL(settings.Configuration.b_DoublePowerModule, 0, settings.MachineParams.Powerstack.PowermoduleSlave.r_InverterRatedPower));
	r_Amax								: REAL := 650; //1.25* (settings.MachineParams.Powerstack.PowermoduleMaster.r_InverterRatedcurrent  + SEL(settings.Configuration.b_DoublePowerModule, 0, settings.MachineParams.Powerstack.PowermoduleSlave.r_InverterRatedCurrent));	
	
	//Protections
	e_EarthingSystem					: eEarthingSystems := eEarthingSystems.TN;
	
	//powerlock OCP settings
	a_ui_InputCurrentLimit				: ARRAY [1..2] OF UINT := [400, 400];     
	a_ui_OutputCurrentLimit				: ARRAY [1..3] OF UINT := [400, 400, 400];	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>