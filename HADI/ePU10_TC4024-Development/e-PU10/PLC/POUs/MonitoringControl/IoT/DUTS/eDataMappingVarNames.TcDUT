<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="eDataMappingVarNames" Id="{5ee32b74-8fd4-4bb0-b3f8-4847515968ac}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'to_string'}

TYPE eDataMappingVarNames :
(*
 * Enumeration for mapping every variable in ST_System_Monitor to a fixed
 * monitoring ID.  The hierarchy is fully expanded at every nesting level.
 *
 * Naming convention:
 *   Structs : <topLevel>_<field>_<subField>_..._<leafField>
 *   Arrays  : <path>_<indexName>  where the index names are:
 *               _AVG      (index 0)
 *               _L1       (index 1)
 *               _L2       (index 2)
 *               _L3       (index 3)
 *               _N        (index 4)
 *               _minimum  (index 5)
 *               _maximum  (index 6)
 *   Only electrical measurement arrays are individually expanded:
 *   ar_ActivePower, ar_ReactivePower, ar_ApparentPower,
 *   ar_PhaseVoltage, ar_LineVoltage, ar_Current,
 *   ar_Frequency, ar_THD, ar_PowerFactor.
 *   The aggregate array variable is NOT included; only individual
 *   per-index entries are present (e.g. ar_Current_AVG, ar_Current_L1).
 *
 *)
(	
None													:= 0,
	(*═════════════════════════════════════════════════════════*)
	(*  Safety and System State    *)
	(*═════════════════════════════════════════════════════════*)
	safety_b_SafetyOK                                          , (* BOOL *)
	safety_b_EstopChannelAOK                                   , (* BOOL *)
	safety_b_EstopChannelBOK                                   , (* BOOL *)
	safety_b_InsulationMonitorOK                               , (* BOOL *)
	safety_b_MRCDBOK                                           , (* BOOL *)
	safety_b_InverterDoorOK                                    , (* BOOL *)
