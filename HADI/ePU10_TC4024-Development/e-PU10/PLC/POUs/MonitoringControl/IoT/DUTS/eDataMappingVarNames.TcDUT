	system_b_SMSnumberConfigured                               , (* BOOL *)
	system_b_CustomNameConfigured                              , (* BOOL *)
	system_s_SystemName                                        , (* STRING(20) *)
	system_b_TransportModePending                              , (* BOOL *)
	system_b_DehumModePending                                  , (* BOOL *)
	system_e_State                                             , (* eSystemState *)
	system_e_gridmode                                          , (* eGridmode *)
	system_e_UgridPowermode                                    , (* eUgridPowermode *)
	system_b_StartAllowed                                      , (* BOOL *)
	system_r_CurrentEfficiency                                 , (* REAL *)
	system_r_AvgEfficiency                                     , (* REAL *)
	system_r_RoundtripEfficiency                               , (* REAL *)
