  <DUT Name="eUpdate" Id="{2e93e0de-8e6a-49d4-8cb5-14b0d17879d8}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
TYPE eUpdate :
(
	Fast			:= 0,
	Slow			:= 1,
	OnChange 		:= 2, //Updates only of variable has changed from previous value, but additionaly exactly once at system startup.
	Daily			:= 3
)UINT;
END_TYPE]]></Declaration>
  </DUT>
