<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_IotController" Id="{be59cf65-5d67-432f-ba98-50b129dd2217}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_IotController
VAR_OUTPUT
	get								: ST_ExtController_get;
END_VAR

VAR_IN_OUT CONSTANT
	{ attribute 'TcHmiSymbol.Hide' }
	monitor								: ST_System_Monitor;
END_VAR

//HMI controls to be overwritten from get if controller is allowed.
VAR_IN_OUT
	controlvars							: ST_System_Control;
	st_params							: ST_IOT_params;
	a_activeEvents						: ARRAY [*] OF ST_errorstruct;
END_VAR


VAR
	BindControlVars						: FB_BindControlvars;
	ListUpdated							: BOOL;
	FBAssetConfig						: RestComOpenremote;
END_VAR

VAR PERSISTENT
	{ attribute 'TcHmiSymbol.ShowRecursively' }
	IotDataSharingList					: ARRAY [1..2000] OF ST_IoTDataHMI;
	{ attribute 'TcHmiSymbol.ShowRecursively' }
	CreditCoverage						: ST_IotData_credits;
END_VAR

VAR
	FBJSON	 : FB_JsonDomParser;
	bWriteToFile	:	BOOL;
	bresult	:	BOOL;
	error : HRESULT;
	length : UDINT;
	output	:	STRING(10000);
	filename	:STRING :='C:\PLCUtility\IoTDataSharing.json';
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Fill IotDatasharing array
IF CreateIoTDataList(SaveJson := controlvars.control.b_ActivateIotSettings, aData:= IotDataSharingList) THEN
	Listupdated:= TRUE;
	controlvars.control.b_ActivateIotSettings := FALSE;
END_IF

//Provisioning
FBAssetConfig(monitor:= monitor, controlvars:= get, st_params:= st_params, HMILogData := IotDataSharingList, UpdateConfiguration := Listupdated, IOTCredits := CreditCoverage);

IF FBAssetConfig.ConfigurationDone THEN
	get.LoggingBudgetOK := (CreditCoverage.RemainingCredits >= 0);
		
	// CALL MQTT PROGRAM
	MqttComOpenremote(updatetrigger:= listupdated, monitor:= monitor, controlvars:= get, st_params:= st_params, aData:= IotDataSharingList);
	Listupdated := FALSE;
	//Build message for MQTT
	MessageBuilder(SIZEOF(MqttComOpenremote.sEventMsg), ADR(MqttComOpenremote.sEventMsg), a_activeEvents, MqttComOpenRemote.eActiveMsg);
	
	//BIND CONTROLVARS TO HMI CONTROL VARS IF IOT CONTROL IS ENABLED BY USER
	IF st_params.b_controlEnable AND monitor.controlfb.HardSettings.setup.e_ControlSource = eControlsources.PowerNet THEN
		BindControlvars(
				advancedcontrol := get.b_AdvancedControl, 
				Systemcontrolvars := controlvars,
				ExtControlvars := get);
	END_IF
	
	//GET FEEDBACK OF STATE.3
	get.b_Active := MqttComOpenremote.fbMqttClient.bConnected;
	get.e_ConnectionState := mqttComOpenRemote.e_state;
END_IF

]]></ST>
    </Implementation>
    <Method Name="CreateIoTDataList" Id="{0ec57b82-d338-4e06-8edd-a9b7d0c36fa5}">
      <Declaration><![CDATA[METHOD CreateIoTDataList : BOOL
VAR_INPUT
	saveJson	: BOOL;
END_VAR

VAR_INST
	init :BOOL := TRUE;
	initJson :BOOL := TRUE;
	executeJson : BOOL;
END_VAR
VAR_IN_OUT
	aData			: ARRAY [*] OF ST_IotDataHMI;
END_VAR

VAR
	index			: DINT;
END_VAR

VAR_INST
	b_loaded : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
CreateIoTDataList := FALSE;
IF init THEN
	// Set varnames in array slots
	FOR index := (eDataMappingVarNames.none +1) TO MIN(UPPER_BOUND(aData,1), eDataMappingVarNames.last -1) DO
		aData[index].Varname := index;
		IF FIND(TO_STRING(aData[index].varname), 'controlfb') = 1 THEN
			aData[index].b_IOTWriteAllowed := TRUE;
		END_IF	
	END_FOR;
	init := FALSE;
	initJson := TRUE;
END_IF




CreateIoTDataList := DiskToFromJsonFile(
		PathName 	:= filename,
		read 			:= initJson OR settings.Load, 
		write 			:= SaveJson, 
		aData 			:= aData
) OR SaveJson;
//CreateIoTDataList :=  SaveJson;

IF CreateIoTDataList THEN
	initJson := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="DiskToFromJsonFile" Id="{aba41194-6f80-4b24-a538-1e1d28c3ed99}">
      <Declaration><![CDATA[METHOD DiskToFromJsonFile : BOOL
VAR_INPUT
	Pathname	: STRING := 'C:\PLCUtility\IoTDataSharing.json';
	write			: BOOL;
	read			: BOOL;
END_VAR

VAR_IN_OUT
	aData			: ARRAY [*] OF ST_IotDataHMI;
END_VAR

VAR_INST
	sJsonPathname	: STRING := 'C:\PLCUtility\IoTDataSharing.json';
    // Triggers
    TrigReadFromDisk  : R_TRIG;
    TrigWriteToDisk   : R_TRIG;

    // Status / result
    b_Error           : BOOL;
    Error             : HRESULT;
    Counter           : UINT;

    // Async control
    WriteToDisk       : BOOL;
    ReadFromDisk      : BOOL;

    // State machine
    State             : UINT;   // 0=idle, 10=prepare save, 20=save busy, 30=load busy, 40=parse loaded json, 900=error
    MaxIndex          : DINT;

    // JSON handling
    version           : STRING(4) := '1.0';
   // fbJson            : FB_JsonDomParser;
    jsonDoc           : SJsonValue;
    jsonRoot          : SJsonValue;
    jsonItem          : SJsonValue;
	jsonSubItem		  : SJsonValue;

    // Temp vars
    tempString        : STRING(255);
	structname			: STRING := 'ST_IotDataHMI';
    sJson             : STRING(2000);
    index             : DINT;
    bOk               : BOOL;
	
	length	:	UDINT;

	b_Saved           : BOOL;
    b_Loaded          : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// -----------------------------------------------------------------------------
// Edge detection
// -----------------------------------------------------------------------------
TrigReadFromDisk(CLK := read);
TrigWriteToDisk(CLK := write);

IF TrigReadFromDisk.q THEN
	b_loaded := FALSE;
	//sJsonPathName := Pathname;
END_IF

IF TrigWriteToDisk.Q THEN
	b_saved := FALSE;
	//sJsonPathName := Pathname;
END_IF

// -----------------------------------------------------------------------------
// Default return
// -----------------------------------------------------------------------------
//DiskToFromJsonFile := FALSE;

// -----------------------------------------------------------------------------
// State machine
// -----------------------------------------------------------------------------
CASE State OF

    // -------------------------------------------------------------------------
    // IDLE
    // -------------------------------------------------------------------------
    0:
        // Clear one-shot result flags only when idle
        b_Error := FALSE;
        Error := 0;
        Counter := 0;

        // Compute upper loop bound once
        MaxIndex := UPPER_BOUND(aData, 1);
        IF MaxIndex > (TO_DINT(eDataMappingVarNames.last) - 1) THEN
            MaxIndex := TO_DINT(eDataMappingVarNames.last) - 1;
        END_IF;
		
       IF read AND NOT b_loaded THEN
		   ReadFromDisk := TRUE;
           State := 30;
	   ELSIF write AND NOT b_saved THEN
		   State := 10;
	   END_IF
	  


    // -------------------------------------------------------------------------
    // PREPARE SAVE DOCUMENT
    // -------------------------------------------------------------------------
    10:
        fbJson.NewDocument();
        jsonRoot := fbJson.GetDocumentRoot();

        // Root must be an object before adding members
       //JsonObject = fbJson.SetObject(jsonRoot);

        tempString := CONCAT(gvl.s_SystemDate, ' ');
        tempString := CONCAT(tempString, gvl.s_SystemTime);

        fbJson.AddStringMember(jsonRoot, 'creationDate', tempString);
        fbJson.AddStringMember(jsonRoot, 'version', version);

        FOR index := TO_DINT(eDataMappingVarNames.none) + 1 TO MaxIndex DO
            IF aData[index].Varname <> 0 THEN
                tempString := TO_STRING(aData[index].Varname);
                jsonItem := fbJson.AddObjectMember(jsonRoot, tempString);
				fbJson.AddStringMember(jsonItem, 'Label', aData[index].Label);
                fbJson.AddUintMember(jsonItem, 'LogType', aData[index].LogType);
                fbJson.AddUintMember(jsonItem, 'LogInterval', aData[index].LogInterval);
				fbJson.AddStringMember(jsonItem, 'Unit', aData[index].Unit); 
            END_IF
        END_FOR

        //WriteToDisk := TRUE;
		bWriteToFile := TRUE;
        State := 20;


    // -------------------------------------------------------------------------
    // SAVE BUSY
    // Keep WriteToDisk TRUE until operation finishes or errors
    // -------------------------------------------------------------------------
    20:

		//IF bWriteToFile THEN
			bresult := fbJson.SaveDocumentToFile(
				sFile      := sJsonPathname,
				bExec      := bWriteToFile,
				hrErrorCode => Error
			);
		IF NOT bWriteToFile THEN//WriteToDisk THEN
			IF Error = 0 THEN
				b_Saved := TRUE;
				//DiskToFromJsonFile := TRUE;
				State := 0;
			ELSE
				b_Error := TRUE;
				State := 900;
			END_IF
        END_IF


    // -------------------------------------------------------------------------
    // LOAD BUSY
    // Keep ReadFromDisk TRUE until operation finishes or errors
    // -------------------------------------------------------------------------
    30:
        bOk := fbJson.LoadDocumentFromFile(
            sFile      := sJsonPathname,
            bExec      := ReadFromDisk,
            hrErrorCode => Error
        );

        IF NOT ReadFromDisk THEN
            IF Error = 0 THEN
            	State := 40;
			ELSE
				// Optional: if file missing / invalid, regenerate from current data
				// Keep this only if you really want auto-create behavior
				IF (Error = -1743714548 ) OR (Error = 16#00000001) THEN //16#9811070C
					Error := 0;
					State := 10; // create and save a fresh file
				ELSE
					b_Error := TRUE;
					State := 900;
				END_IF
			END_IF
        END_IF


    // -------------------------------------------------------------------------
    // PARSE LOADED JSON INTO ARRAY
    // -------------------------------------------------------------------------
    40:
        jsonRoot := fbJson.GetDocumentRoot();
        Counter := 0;
        //b_Loaded := FALSE;

        FOR index := TO_DINT(eDataMappingVarNames.none) + 1 TO MaxIndex DO
            IF aData[index].Varname <> 0 THEN
                tempString := TO_STRING(aData[index].Varname);
                jsonItem := fbJson.findMember(jsonRoot, tempString);

                IF jsonItem <> 0 THEN
					 // LogType
					jsonSubItem := fbJson.FindMember(jsonItem, 'LogType');
					IF jsonSubItem <> 0 THEN
						aData[index].LogType := TO_UINT(fbJson.GetUint(jsonSubItem));
					END_IF
	
					// LogInterval
					jsonSubItem := fbJson.FindMember(jsonItem, 'LogInterval');
					IF jsonSubItem <> 0 THEN
						aData[index].LogInterval := TO_UINT(fbJson.GetUint(jsonSubItem));
					END_IF
	
					// Unit
					jsonSubItem := fbJson.FindMember(jsonItem, 'Unit');
					IF jsonSubItem <> 0 THEN
						aData[index].Unit := fbJson.GetString(jsonSubItem);
					END_IF
	
					// Label
					jsonSubItem := fbJson.FindMember(jsonItem, 'Label');
					IF jsonSubItem <> 0 THEN
						aData[index].Label := fbJson.GetString(jsonSubItem);
					END_IF
	
					Counter := Counter + 1;
                END_IF
            END_IF
        END_FOR

        // Consider load successful if at least one item was restored
        IF Counter > 0 THEN
            b_Loaded := TRUE;
            DiskToFromJsonFile := TRUE;
            State := 0;
        ELSE
            // If file loaded but no matching members found, recreate it
            State := 10;
        END_IF


    // -------------------------------------------------------------------------
    // ERROR
    // -------------------------------------------------------------------------
    900:
        b_Error := TRUE;
       // DiskToFromJsonFile := TRUE;
       // State := 0;

END_CASE;]]></ST>
      </Implementation>
    </Method>
