VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetDiagnostics" Id="{35cb449a-019e-4ea8-9d7c-c285a528422e}">
      <Declaration><![CDATA[METHOD GetDiagnostics 
VAR_IN_OUT
	AddError		: ARRAY [*] OF FB_AddErrorST;
	a_ActiveEvents	: ARRAY [*] OF ST_ErrorStruct;
	w_Index			: WORD;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*IPS*)
	(*AC PSU fault*)		AddError[w_Index](
			b_ErrorTrig			:= NOT get.LoggingBudgetOK,
			out_ST_Error		:= a_ActiveEvents[w_Index],
			w_ErrorID			:= 1,
			e_objectID			:= eObject_ID.IotController,
			s_Message			:= 'Logging budget exceeded. Logging halted until configuration is valid',
			e_sev				:= eSeverity.Warning,
			t_triggerTime		:= T#1S,
			b_AutoClear			:= TRUE
			);
		//w_Index := w_Index +1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="MessageBuilder" Id="{59b943d4-bf48-4d8f-941e-52c9a9b7f15c}">
      <Declaration><![CDATA[METHOD MessageBuilder

VAR_INPUT
	nSize								: UDINT;
	sMsg 								: POINTER TO STRING;
END_VAR

VAR_IN_OUT
	a_activeEvents						: ARRAY [*] OF ST_errorstruct;
	eActiveMsg							: eSeverity; // range from 0 to 5. 0 = none, 1 info, ... 5 em shutdown
END_VAR

VAR_INST
	i_RequiredLength			: INT; //Messages from Emergency Shutdown, Quick Shutdown and Normal Shutdown.
	w_MessageCheckSum			: WORD;
	w_MessageCheckSumLast		: WORD;
	bMsgFull					: BOOL;
	di_nElements				: DINT;
	bOnChange					: BOOL;
	//sMsg						: STRING(1000);
	s_EndMessage				: STRING(13):= ', and more...';
	s_messageBreak				: STRING(3) := '\n'; 
	s_messageSeparation			: STRING(3) := ',  '; 
	b_ClearMessage				: BOOL;
	
	by_currentIndex				: BYTE;
	a_ErrorIndex				: ARRAY[0..10] OF WORD;
	by_SortedIndex				: BYTE;
	a_ErrorIndexSorted			: ARRAY[0..10] OF WORD;
END_VAR



VAR
	s_ErrorMessage	: STRING(256);
	s_sevtemp		: STRING(256) ;
	i 				: DINT;
	j 				: INT;
	s_filterName	: STRING;
	w_ErrorIndex	: WORD;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[di_nElements := TO_DINT(nSize);// / SIZEOF(STRING(1));
by_currentIndex := 0; 
w_MessageCheckSum := 0; 


IF b_ClearMessage THEN
	sMsg^ := '';
END_IF

MEMSET(ADR(a_ErrorIndex), 0, SIZEOF(a_ErrorIndex));

//FIRST CHECK SOMETHING HAS CHANGED AND SAVE THE CORRESPONDING INDEXES SORTED BY SEVERITY
FOR i:= 0 TO UPPER_BOUND(a_ActiveEvents,1) DO
	IF a_ActiveEvents[i].b_ErrorActive AND a_ActiveEvents[i].s_Severity <> TO_STRING(eSeverity.Info) THEN
		//max 10 messages will be evaluated
		w_MessageCheckSum := w_MessageCheckSum + TO_WORD(i);
		IF by_currentIndex < 10 THEN
			a_ErrorIndex[by_CurrentIndex] := TO_WORD(i);
			by_currentIndex := by_currentIndex + 1;
		END_IF
	END_IF
END_FOR

bOnChange := w_MessageCheckSum <> w_MessageCheckSumLast;
w_MessageCheckSumLast := w_MessageCheckSum;

//IF CHANGED, SET STRINGS
IF bOnChange THEN
	//SORT on severity
	MEMSET(ADR(a_ErrorIndexSorted), 0, SIZEOF(a_ErrorIndexSorted));
	by_SortedIndex := 0; 
	FOR j:= 1 TO 4 DO
		//select filter
		CASE j OF
			1 : s_filterName := TO_STRING(eSeverity.EmergencyShutdown);
			2 : s_filterName := TO_STRING(eSeverity.QuickShutdown);
			3 : s_filterName := TO_STRING(eSeverity.NormalShutdown);
			4 : s_filterName := TO_STRING(eSeverity.Warning);
			5 : s_filterName := TO_STRING(eSeverity.Info);
		END_CASE
	
		FOR i:= 0 TO by_currentIndex -1 DO
			w_ErrorIndex := a_ErrorIndex[i];
			IF a_ActiveEvents[w_ErrorIndex].s_Severity = s_filtername THEN
				IF eactiveMsg < j THEN
					eActiveMsg := TO_BYTE(j);
				END_IF
				a_ErrorIndexSorted[by_SortedIndex] := a_ErrorIndex[i];
				by_SortedIndex := by_SortedIndex + 1;
			END_IF
		END_FOR
	END_FOR	
	
	//-------Message Formatter----------------------------------------------------------------------
	
	bMsgFull := FALSE;
	sMsg^ := '';
	s_SevTemp := '';
	FOR i:= 0 TO by_SortedIndex -1 DO
		w_ErrorIndex := a_ErrorIndexSorted[i];
	//clear message
		s_ErrorMessage := '';
	// Write Message
		IF s_sevtemp <> a_ActiveEvents[w_ErrorIndex].s_Severity THEN 
			s_ErrorMessage 	:= concat(s_ErrorMessage, a_ActiveEvents[w_ErrorIndex].s_Severity);
			s_ErrorMessage	:= concat(s_ErrorMessage, ': ');
			s_ErrorMessage	:= concat(s_ErrorMessage, s_messageBreak);
			s_sevtemp := a_ActiveEvents[w_ErrorIndex].s_Severity;
		END_IF
		s_ErrorMessage	:= concat(s_ErrorMessage, a_ActiveEvents[w_ErrorIndex].s_Message);
		i_RequiredLength := TO_INT(len2(pSTRING := sMsg)) + LEN(s_ErrorMessage);
		
		IF (i_RequiredLength < di_nElements - LEN(s_EndMessage)- LEN(s_endMessage)) THEN
			// Add comma and space if not first msg
			IF sMsg^ <> '' THEN
				concat2(pSrcString1 := sMsg,pSrcString2:=ADR(s_messageSeparation), pDstString := sMsg, nDstSize :=nSize);
			END_IF 
			//Add msg
			concat2(pSrcString1 := sMsg,pSrcString2:=ADR(s_ErrorMessage), pDstString := sMsg, nDstSize := nSize);
		ELSE
			//Trigger message is full
			IF NOT bMsgFull THEN
				concat2(pSrcString1 := sMsg,pSrcString2:=ADR(s_EndMessage), pDstString := sMsg, nDstSize := nSize);
			END_IF
			bMsgFull := TRUE;
			EXIT;
		END_IF
	END_FOR
END_IF

IF sMsg^ = '' AND w_MessageCheckSum <> 0 THEN
	w_MessageCheckSumLast := 0;
END_IF


]]></ST>
      </Implementation>
    </Method>
    <Method Name="PresetBasicControl" Id="{9d4cba98-8b1e-4655-bb3f-7c43d8f149e6}">
      <Declaration><![CDATA[METHOD PresetBasicControl
VAR_INPUT
	enable				: BOOL;
END_VAR

VAR_INST
	rtrig_SetPreset		: r_Trig;
END_VAR


VAR_IN_OUT
	SoftOut		: ST_Softsettings;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[rtrig_SetPreset(CLK:= enable);

IF rTrig_SetPreset.Q THEN
	SoftOut.system.b_EnableTransportMode := FALSE;
END_IF

SoftOut.system.b_AutomaticSwitching := TRUE;
]]></ST>
      </Implementation>
    </Method>
