31:	sName:= 'reactivePowerOutput'		        ; st_Variable:= IotExtractType(monitor.powermonitor.OutputField.ar_ReactivePower[0], 0, 2);       	 						eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
32:	sName:= 'phaseVoltageL1'		            ; st_Variable:= IotExtractType(monitor.powermonitor.OutputField.ar_PhaseVoltage[1], 0 , 10);       	 							eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
33:	sName:= 'phaseVoltageL2'		            ; st_Variable:= IotExtractType(monitor.powermonitor.OutputField.ar_PhaseVoltage[2], 0, 10);       	 							eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
34:	sName:= 'phaseVoltageL3'		            ; st_Variable:= IotExtractType(monitor.powermonitor.OutputField.ar_PhaseVoltage[3], 0, 10);       	 							eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
