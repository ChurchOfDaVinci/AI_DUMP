eDataMappingVarNames.Generator_ar_ReactivePower_AVG: 				st_Variable:= IotExtractType(monitor.Generator.ar_ReactivePower[0], 1, 1); 
eDataMappingVarNames.Generator_ar_ApparentPower_AVG: 				st_Variable:= IotExtractType(monitor.Generator.ar_ApparentPower[0], 1, 1); 
eDataMappingVarNames.HartingIO_b_DigitalInput1Active: 				st_Variable:= IotExtractType(monitor.HartingIO.b_DigitalInput1Active, 0, 0); 
eDataMappingVarNames.HartingIO_b_DigitalInput2Active: 				st_Variable:= IotExtractType(monitor.HartingIO.b_DigitalInput2Active, 0, 0); 
eDataMappingVarNames.HartingIO_b_GenLowFuel: 				st_Variable:= IotExtractType(monitor.HartingIO.b_GenLowFuel, 0, 0); 
eDataMappingVarNames.HartingIO_b_ExtSystemShutdownRequest: 				st_Variable:= IotExtractType(monitor.HartingIO.b_ExtSystemShutdownRequest, 0, 0); 
eDataMappingVarNames.HartingIO_b_ExtEMstopOK: 				st_Variable:= IotExtractType(monitor.HartingIO.b_ExtEMstopOK, 0, 0); 
eDataMappingVarNames.HartingIO_b_ExtEMstopActive: 				st_Variable:= IotExtractType(monitor.HartingIO.b_ExtEMstopActive, 0, 0); 
END_CASE

IF index >= eDataMappingVarNames.controlfb_control_b_start AND index <= eDataMappingVarNames.controlfb_HardSettings_system_a_ui_OutputCurrentLimit_3 THEN
	st_RW.ReadFromNUC := aData[index].LogType <> 0;
	st_RW.WriteToNUC := FALSE;
ELSE
	st_RW.ReadFromNUC := FALSE;
	st_RW.WriteToNUC :=  aData[index].LogType <> 0;
END_IF


//-------------------------------Write to output---------------------------------------------
IotMappingV2.sName		:= aData[index].Label;				//Name of the variable
IotMappingV2.sValue		:= st_Variable.sValue;	//Extracted value of the variable
IotMappingV2.eUpdate	:= aData[index].LogInterval;				//Update frequency
IotMappingV2.st_RW		:= st_RW;				//Read/Write
IotMappingV2.pAdress	:= st_Variable.pAdress; //Adress pointer to variable
IotMappingV2.diSize		:= st_Variable.diSize;
IotMappingV2.ClassType	:= st_Variable.ClassType; //Extracted data type of the variable
IotMappingV2.bNumber	:= st_Variable.bNumber;
IotMappingV2.bJson		:= bJson;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IoTWriteBacktoVar" Id="{f5435517-1683-4bda-bc9b-0a22e1062dae}">
      <Declaration><![CDATA[METHOD IoTWriteBacktoVar : BOOL;
VAR_INPUT
	sValue	  : STRING; //Content of variable to write to in STRING type
	pAdress	  : PVOID; //Adress of the Variable
	ClassType : __SYSTEM.TYPE_CLASS; //Type of the Variable
END_VAR

VAR
	pBool	: POINTER TO BOOL;
	pInt	: POINTER TO INT;
	pLreal	: POINTER TO LREAL;
	pWord	: POINTER TO WORD;
	pDword	: POINTER TO DWORD;
	pSint	: POINTER TO SINT;
	pReal	: POINTER TO REAL;
	pString : POINTER TO STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE UDINT_TO_INT(Classtype) OF
    IBaseLibrary.TypeClass.TYPE_BOOL :
		pBool:=pAdress;
		pBool^:=STRING_TO_BOOL(sValue);
    IBaseLibrary.TypeClass.TYPE_ENUM :
		pInt:=pAdress;
		pInt^:=STRING_TO_INT(sValue);
    IBaseLibrary.TypeClass.TYPE_LREAL :
		pLreal:=pAdress;
		pLreal^:=STRING_TO_LREAL(sValue);
    IBaseLibrary.TypeClass.TYPE_WORD :
		pWord:=pAdress;
		pWord^:= STRING_TO_WORD(sValue);
    IBaseLibrary.TypeClass.TYPE_DWORD :
		pAdress:=STRING_TO_DWORD(sValue);
    IBaseLibrary.TypeClass.TYPE_SINT :
		pSint:=pAdress;
		pSint^:= STRING_TO_SINT(sValue);
    IBaseLibrary.TypeClass.TYPE_INT :
		pInt:=pAdress;
		pInt^:=STRING_TO_INT(sValue);
    IBaseLibrary.TypeClass.TYPE_REAL :
		pReal:=pAdress;
		pReal^:=STRING_TO_REAL(sValue);
    IBaseLibrary.TypeClass.TYPE_STRING :	
		pString:=pAdress;
		pString^:=sValue;
		
	ELSE
		IoTWriteBackToVar:=FALSE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="OrPublish" Id="{5eeca784-63d0-471e-be07-c1f55dae6fe5}">
      <Declaration><![CDATA[METHOD OrPublish : BOOL

VAR_INPUT
	iotprops 		: REFERENCE TO ST_IotProps;
	sOrPubPrefix	: STRING;
	sAssetID		: STRING;
END_VAR

VAR
	sTopic			: 	STRING;
	sQuote			:	STRING := '"';
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Prepare Topic		
sTopic:= concat(sORPubPrefix,IotProps.sName);
sTopic:= concat(sTopic,sAssetID);

//Catch NANs
IF IotProps.sValue = '#NaN' THEN
	IotProps.sValue:='0';
END_IF

//Convert payload to JSON string if text ( "sValue" )
IF NOT IotProps.bNumber AND NOT IotProps.bJson THEN
	concat2(ADR(sQuote), ADR(IotProps.sValue), ADR(IotProps.sValue), SIZEOF(IotProps.sValue));
	concat2(ADR(IotProps.sValue), ADR(sQuote), ADR(IotProps.sValue), SIZEOF(IotProps.sValue));
END_IF

//Publish 
fbMqttClient.Publish(sTopic:=sTopic,
pPayload := ADR(IotProps.sValue), //ADR(MessageToPublishJson),
nPayloadSize := LEN2(ADR(IotProps.sValue)), // ADR(MessageToPublishJson)),
eQoS := TcIotMqttQos.AtMostOnceDelivery,
bRetain:= FALSE,
bQueue := FALSE);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishVarsV1" Id="{e7725402-5e07-4b2a-a16b-fafd3b1973f8}">
      <Declaration><![CDATA[METHOD PublishVarsV1 : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[b_UpdateActive := fbSendFastMessageTimer.Q OR fbSendSlowMessageTimer.Q OR bInitiateFirstTimeSend;
IF e_state = eConnectionState.authorized AND b_UpdateActive THEN
	FOR i:= 1 TO iSizeIotMappingV1 BY 1 DO	
			
		//----Get variable mapping properties corresponding to index
		st_IotProps:= IotMapping(i);
		
		//----Fast Message Sending
		IF (st_IotProps.eUpdate = eUpdate.Fast) AND st_IotProps.st_RW.WriteToNUC AND fbSendFastMessageTimer.Q THEN
				//Publish in OpenRemote format
				OrPublish(sOrPubPrefix:=sPubPrefix, sAssetID:=sAssetID, iotprops := st_IotProps);	
				//OrPublish(sOrPubPrefix:=sPubPrefix,sName:=st_IotProps.sName,sAssetID:=sAssetID,sValue:=st_IotProps.sValue, bNumber:=st_IotProps.bNumber);	
		END_IF
		
		//----Slow Message Sending---------
		IF (st_IotProps.eUpdate = eUpdate.Slow) AND st_IotProps.st_RW.WriteToNUC AND fbSendSlowMessageTimer.Q THEN		
				//Publish in OpenRemote format
				OrPublish(sOrPubPrefix:=sPubPrefix, sAssetID:=sAssetID, iotprops := st_IotProps);
		END_IF
		
		//----Maintenance Message Sending (sends every reconnect, which is reset daily)---------
		IF (st_IotProps.eUpdate = eUpdate.Daily) AND st_IotProps.st_RW.WriteToNUC AND bInitiateFirstTimeSend THEN		
				//Publish in OpenRemote format
				OrPublish(sOrPubPrefix:=sPubPrefix, sAssetID:=sAssetID, iotprops := st_IotProps);
		END_IF
		
		//----On change Message Sending------
		IF (st_IotProps.eUpdate = eUpdate.OnChange) AND st_IotProps.st_RW.WriteToNUC AND (fbSendFastMessageTimer.Q  OR bInitiateFirstTimeSend) THEN
			i_OnChangeValuesIndex := i_OnChangeValuesIndex + 1;
			
			//Evaluate whether value has changed or first time message trigger is active
			IF st_IotProps.sValue <> aPreviousValue[i_OnChangeValuesIndex] OR bInitiateFirstTimeSend THEN
				//Set current value to memory
				aPreviousValue[i_OnChangeValuesIndex]:= st_IotProps.sValue;
				//Publish in OpenRemote format
				OrPublish(sOrPubPrefix:=sPubPrefix, sAssetID:=sAssetID, iotprops := st_IotProps);

			END_IF
		END_IF	
	END_FOR
	i_OnChangeValuesIndex := 0;
	//Disable First Time send
	bInitiateFirstTimeSend:=FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishVarsV2" Id="{5cde2544-92ee-45d3-a3ae-1116f5b62fd4}">
      <Declaration><![CDATA[METHOD PublishVarsV2 : BOOL
VAR_INPUT
	Authorized : BOOL;
	Interval : eUpdate;
END_VAR

VAR_IN_OUT
	state : ST_IOT_SentStateLog;
END_VAR

VAR
	Checksum : WORD;
	i : INT;
	Update : BOOL;
	CheckSumWordLast	: WORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Authorized AND State.bUpdate THEN
	State.bMessageSent := FALSE;
	FOR i:= State.LastIndexSent TO State.LastIndex BY 1 DO	
		//----Get variable mapping properties corresponding to index
		st_IotProps:= IotMappingV2(i);

		//---- Message Sending
		IF (st_IotProps.eUpdate = interval) AND st_IotProps.st_RW.WriteToNUC AND State.bUpdate THEN
			//Publish in OpenRemote format
			IF State.LastIndexSent < i THEN
				// onchange detection
				IF st_IotProps.eUpdate = eUpdate.OnChange THEN 
					CheckSum 	:= F_CheckSum16(st_IotProps.pAdress, st_iotProps.diSize, 0);
					Update := aCheckSumLast[i] <> CheckSum;
					aCheckSumLast[i] := CheckSum;
				ELSE
					Update := TRUE;
				END_IF
				
				//Update variable
				IF update THEN
					OrPublish(sOrPubPrefix:=sPubPrefix, sAssetID:=sAssetID, iotprops := st_IotProps);
					State.LastIndexSent := i;
					EXIT;
				END_IF
			END_IF
		END_IF
	END_FOR
ELSE
	RETURN;
END_IF

IF State.LastIndexSent = State.LastIndex AND State.bUpdate THEN
	State.bUpdate := FALSE;
	State.LastIndexSent := 0;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="shutdown" Id="{b724972f-010b-4ca0-9b17-f3bb0308556a}">
      <Declaration><![CDATA[METHOD shutdown : BOOL

]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF s_ShutdownFb = 'ERR' THEN
	w_shutdown := 0;
ELSE
	w_shutdown := 1;
END_IF

shutdown := s_ShutdownFb = 'OK';]]></ST>
      </Implementation>
    </Method>
