<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="MqttComOpenremote" Id="{892d67f6-1728-44e7-a46f-6c2166a8f218}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MqttComOpenremote
VAR
	sStartShutdownCMD	: STRING;
	sEventMsg			: STRING(2000);
	eActiveMsg			: eSeverity; // range from 0 to 5. 0 = none, 1 info, ... 5 em shutdown
	productionDateString: STRING;
	bInitiateFirstTimeSend : BOOL;
	w_shutdown			: WORD; //0 = remain, 1 = shutdown request
	s_ShutdownFb		: STRING;
	rtrig_shutdownRequested		:	R_trig;
END_VAR

VAR
	timer1: profiler;
	testword : WORD;
	b_UpdateActive	: BOOL;

	// Function blocks
	fbMqttClient 					: FB_IotMqttClient;
	fbMessageQueue					: FB_IotMqttMessageQueue;
    fbMessage						: FB_IotMqttMessage;
	fbJsonWriter					: FB_JsonSaxWriter;
	fbJsonDataType					: FB_JsonReadWriteDataType;
	fbJson							: FB_JsonDomParser;
	// Internal Vars
	ConnectionState					: ETCIOTMQTTCLIENTSTATE;

	stAutoProvisioning				: ST_AutoProvisioning;
	stAutoProvClear					: ST_Autoprovisioning;
	i								: INT; // for loop index
	bSetParameter 					: BOOL := TRUE;
	bConnect 						: BOOL := TRUE;	


	bSubscribed						: BOOL;
	bIncommingMsg					: BOOL;
	{attribute 'TcEncoding':='UTF-8'}
	receivingTopic					: STRING(255);
	{attribute 'TcEncoding':='UTF-8'}
	sMessage						: STRING(255);
	sMessageEmpty					: STRING(255);
	//sMessageEmpty					: STRING(20000);
	{attribute 'TcEncoding':='UTF-8'}
	bSubscribedAutoProv				: BOOL;
	hrErrorOccurred 				: DINT; //Contains latest error message
	st_IotProps						: ST_IotProps;
	sTopic							: STRING;
	aPreviousValue					: ARRAY[1..20] OF STRING(2000); //Stores values for onChange trigger. Keep this array as long as the IoTMapping Case!!
	sSubscribtion					: STRING(255);
	sSubChecker						: STRING(255);
	
	//Settings
	fbSendFastMessageTimer			: TON := (PT:=T#15S); 
	fbSendSlowMessageTimer			: TON := (PT:=T#60S);
	fbDailyTimer					: TON := (PT:=T#1D); //used for daily reconnect, which also results in sending eUpdate.Daily messages
	fbConnectionTimer				: TON := (PT:=T#5S);
	iSizeIotMappingV1				: INT := 100;
	iSizeTotal						: INT  := 0;
	iSizeMax						: INT := 2000;
	sPubPrefix						: STRING  := 'master/plc/writeattributevalue/';
	sSubPrefix						: STRING  := 'master/plc/attributevalue/';  // only use attributevalue, this code does not process full /attribute/ message
	sAssetID						: STRING  := '/5WGb8fQx2n68yDmW4rYh9B';
	{attribute 'TcEncoding':='UTF-8'}
	autoProvSub						: STRING(255) := 'provisioning/device2/response';
	{attribute 'TcEncoding':='UTF-8'}
	autoProvPub						: STRING(255) := 'provisioning/device2/request';
	
	s_AutoProvMsg					: STRING(4010):= '{"type": "x509","cert": "-----BEGIN CERTIFICATE-----\nMIIFPTCCAyUCFDQ4u2+PTWiPgHVzlYHSt5SDqQoPMA0GCSqGSIb3DQEBCwUAMGMx\nCzAJBgNVBAYTAk5MMRMwEQYDVQQIDApTb21lLVN0YXRlMQ8wDQYDVQQHDAZBbG1l\nbG8xGzAZBgNVBAoMElZETCBFbmVyZ3kgU3lzdGVtczERMA8GA1UEAwwIVkVTIENB\nIDIwIBcNMjQwMzEzMTQxMDU4WhgPMjEyNDAyMTgxNDEwNThaMFExCzAJBgNVBAYT\nAk5MMRMwEQYDVQQIDApPdmVyaWpzc2VsMRswGQYDVQQKDBJWREwgRW5lcmd5IFN5\nc3RlbXMxEDAOBgNVBAMMB2RldmljZTIwggIiMA0GCSqGSIb3DQEBAQUAA4ICDwAw\nggIKAoICAQCiwnpUiyODuS5kLG+Zi7te7CUrHVIp+ZA39L/wISaBE7/z9MRjYxVK\notSnVWUyCt+pU3EHkC4X6SQz7vRuQET13L49LOYjUD/Gn4t87YD/Kj5r/9cj7Vf3\nxnI+1Kwh7BmajAtsB3wVZxe/RmCfO9D7SGors4gGI+RZAvV3U0hHFWHU6G2TCb+q\nJfp71xQJQUp4QW6USlSAC2d77BbXMyV+c1FYaoqJIInd5JgEK6WQpoZ4S+A8P7AO\n2rbMRsPMrvDAe7WpsbQNZnHfEgV7nEP6+19D0fum3q0fp68hrnzyvRJ90ShOS6Le\n+mdnd326RP6LzTd+mXgcAmHczJiiQ1iY+OtC9VySsylsfW2VngJQaYd+f88Sx/85\nQCOwp4oA5hrNDIfQU1JnRDoVcSnPIvyzpqrERig6IEtpgT2DG32VOgne47ut0H0r\nIE7mXlRXYmSkKTws2Iph2nKpwwSdcvtYY+DrmPgT3EE7jAP/OkMNr0afQFmvqaQ+\n2SbxiivPxUwJLXGccrBmV1J3A91JbNwVdhvD3Ab0Rf/O8yWN0yEJ5X5e1q+b7hwa\nfh04iF8BM+ofYNGu74CKDq4cSWoU431G86TW2EMus6W0BCcvh3O+jGDNQ6bzfqYq\nUq+It8m5WpWjsvZtmXROFeCAsGK45eKdRR72zXl4YOItXaVqUzCr2QIDAQABMA0G\nCSqGSIb3DQEBCwUAA4ICAQB7n0i/OYpdXb5fgRe2fQ9IFIfXF7K88rzKgh+B1SWP\nVqfp8l5uHQZO9+k2qFmUbPdvE+zSlOuS98/cEErLdUOJvMidIAAkJHSr2F8IoLoT\nJgHEhj/SD5EBWEgsWV/6GewwpCOW21dA3Y1pgANWOK7KxoWkcLRb5iykBe5z8AU7\n+LDPNVnhdy+GuFkpzvEUiYL8CSYDJT28o1Rs9+HxglUZ39faTCU82O1rGJ+l9L2a\nWU3vwI7vqDEzIFfEHn48+XUoZVXgq818a1pSaJil7pMZb0EYbJHDHQGvetL8gddc\n1Rcibmofu/ZBXoK1bxk7KgJ9lEjO4BoZZ0tK19APuxBjClIBm7oTnj87+/YJfBfk\nQMSzDe30u+TdHRKIWa4DckzFFTBQsNg8T+t9PbhS1kD1D0dECBzbllOnD2v6xbf+\nshnK5LWrgIoKVpocyTc46B4S0g9Drk2eDOtA3G3SH+IbT8wgeIxiqDNRHYFcHDjq\nAOQpB9xGhmsURHuv+l0gwMmi7/Ru5MXkVJrAplkFN/ShB961xzcfERn9dsgcP/75\nlHY7qglTN5gSh/QFime0JgV1Om2VantZXQUiQGsgFbMgivjV5qo57Y9T+xg5EKT8\nx2IR2GTsnK9H7Q0TNAeTGV0qcN6tIGpfQHe8f9o3LLq4QaHeR3JYhZhkiC6i+lnw\nAA==\n-----END CERTIFICATE-----\n-----BEGIN CERTIFICATE-----\nMIIFqTCCA5GgAwIBAgIUNrEQi2T7AK4cV+ePfFtr0IBVl6MwDQYJKoZIhvcNAQEL\nBQAwYzELMAkGA1UEBhMCTkwxEzARBgNVBAgMClNvbWUtU3RhdGUxDzANBgNVBAcM\nBkFsbWVsbzEbMBkGA1UECgwSVkRMIEVuZXJneSBTeXN0ZW1zMREwDwYDVQQDDAhW\nRVMgQ0EgMjAgFw0yNDAzMTMxNDEwNDlaGA8yMTI0MDIxODE0MTA0OVowYzELMAkG\nA1UEBhMCTkwxEzARBgNVBAgMClNvbWUtU3RhdGUxDzANBgNVBAcMBkFsbWVsbzEb\nMBkGA1UECgwSVkRMIEVuZXJneSBTeXN0ZW1zMREwDwYDVQQDDAhWRVMgQ0EgMjCC\nAiIwDQYJKoZIhvcNAQEBBQADggIPADCCAgoCggIBAJ2dmmFb3vcP92xgubb/DQBn\nrX1HV93mzthCntSKvTOsyIpZJQ35c8OyL35qq6nzLj/iDoGrQxC+zKghKzRB1HhO\nNg2DnXNNqzvug/m4PXao5w59D//VWP70mT6yfhgsFJKzJNi3EnPLiz41HP6/hLG0\nwudKpIK3j25Wm70FsWvw2z1icUDcyp7Ef7Ob4Koy7uOsDa5W8tZDlN3hDlU784T9\nzvlxTSvvK4uHz+Qi+1R6OVMoiBB6ZtXfQKSUrEHwNTXKjt51vR8bEdZamNUW5O8L\nl4yGenkySDEZdPvG43SZS1+CV5zSSiVCxSbFGSIO8c5ldkAUS/MMwxpIgXpf2xyS\nSstF6mebFl0Ij/EXybkh5tz8DWAsnSm6gRhaLhpdtgBZX4v43p47CRGY8DoeGzA6\ne2aFgtVQTDI3Gvr1nVQR7wkdQh0YzETy7vbBIy7HYXQw6pE/eskFSEEKFChxvkL7\nQHAcRp1RaXNOQM2uja/1h16HFxRFNd91BCdmUms64DuXAIBXteSt6bfINle4Znne\n2rUrTkvZw+6MMPVn44IrzgKbYv0bZEFPMtaLXNp1BPNMkzsNtAuLXLRm//9KA9ov\nGr/NMdO9j1e72/myYYD0+T165GTO5ZIS92jOkyb+REOAHz4R1Nb1eluehiJ0zVgK\nM78ki4Z+Z1nBxIkbByq3AgMBAAGjUzBRMB0GA1UdDgQWBBTKkYlzFWWdQk8jl6Wm\nkl+r4hoY8zAfBgNVHSMEGDAWgBTKkYlzFWWdQk8jl6Wmkl+r4hoY8zAPBgNVHRMB\nAf8EBTADAQH/MA0GCSqGSIb3DQEBCwUAA4ICAQBPv0q2OjExx4RypECI4C0LQtLo\njBrWitz7tIBN+pg5EJmSMfZqHypTvErX8ACEuWeV1pLmBHTrW/Y5OzVzslwjMGj0\nnzZaGj6+nQA+xP1rqD1uFIz8JLN9gkUBmzoitBqv1M06YKWKDMeY8FEqPoA4smQg\nsBCOw6G5jGLpNwOFF7mrWkGWL6GAiHno/XiDHQgOG+e8sflQu9VmZhJk6+E1Pbyw\neKtdWNxrr82KY32U+D8z2Q4x8EUhft4BEVbidN+l4mFaK9Dd7SXCYPeG8FL9ejcj\ncORGJ447d/vMlaHF4hCpO9VajkEXErPDaxeXk3YyUf55ngErG2j0q7JmkKHZfDNW\nxz4oUwq51FF1/zAlx25RNjfw+X01tToDQFORyZONTmtskBKpTQKTWTPBqV35dM1A\nycEwXRPUYDNkx8C5qBuIjo0m3Tg4ynczhBS24L2DSvXARdc53vmyQxH/dFD+3KTz\nvV+kVccGjzvbRCPnIuBMrKC1dISp4AH7V/aWtrYStlR9Dczyf35Dw9kBIBSuBGXF\nk0Y1sz2H4Y8bzPkQJYniQlMSNAE2u/IlaGDmNjU/Jz1HPT4HQw8yOCV2vPXsFTJa\nO/RBnXwv2OlD8ZovIe9Jj3wHjOiiC2F7jOUkG0AdezBL0OoI3aeeOuJtwgWe8xId\nmxkGBfwQH6Ut2F8VYQ==\n-----END CERTIFICATE-----\n"}';
	s_RootCA						: STRING(1283):= '-----BEGIN CERTIFICATE-----\nMIIDdzCCAl+gAwIBAgIUL1oQITunxPxaR4r6HQuPcRZeIUowDQYJKoZIhvcNAQEL\nBQAwSjEmMCQGA1UEAwwdVkVTIFNlbGYtc2lnbmVkIDE5Mi4xNjguMS4xMjYxCzAJ\nBgNVBAYTAk5MMRMwEQYDVQQHDApPdmVyaWpzc2VsMCAXDTI0MDMwNzE1MjU1MVoY\nDzIxMjEwODI2MTUyNTUxWjBKMSYwJAYDVQQDDB1WRVMgU2VsZi1zaWduZWQgMTky\nLjE2OC4xLjEyNjELMAkGA1UEBhMCTkwxEzARBgNVBAcMCk92ZXJpanNzZWwwggEi\nMA0GCSqGSIb3DQEBAQUAA4IBDwAwggEKAoIBAQC2HgB7KTx120GMtx+8fxY2VVm4\nXCz0WoIMgKeIbT7AHLH9FL6bEWiSCYdVWmLdSP53I32Amz93sjF6JRzxKVMM2OG5\n4ZkAKvejgePGWLRBL/kqf+0G3saga3lSCkmdJ9K+MRAGkE4WxcpnRZRQFZ46+7Fy\nfqfL+OWwazcNeTJp72l4D0BcPEJbgEuOIyOguUzSGitiK9nxMaq1rtIQ5Io/hg/J\nLfyjZ/Zha1V1qGco93410KyCSDpIF9L422by3mUOhn0AOMmfbMAk9XZmnGnbn7Pq\nIXtHEypEb7bcgAk7NehZHa+6bOyySEaxHcD888muRa458M/mpUG26fr7GOL9AgMB\nAAGjUzBRMB0GA1UdDgQWBBQut15Nm/Gnk4UsaVVK5LWEQWmilTAfBgNVHSMEGDAW\ngBQut15Nm/Gnk4UsaVVK5LWEQWmilTAPBgNVHRMBAf8EBTADAQH/MA0GCSqGSIb3\nDQEBCwUAA4IBAQCEc0xguZVreDCk1rFUJHSZqq3su8EbBhCTaCGrXLi2+ky7QnDm\nibHD29L9vyBPf/4kVY8dYOT0MwNb5qtfESyr7NMD/BTcnd7/zprGL7agWXbAO1xH\njw41vQW6dhd+GbUh9ftzHFrOiOnYKeUnISauyWD6yH8kFDjdaByU8r/lSJ23SXWE\nrDK8TSgKPRYYh4kH3snUPlscwivjZj9I8MiSx2GpqqogTrwNjoM/pVj+z2ENrUGR\nj0eWEJ2UiDxXtKhAQYOLyT7Nvmscb68CBVZPTv3sq+BvAkGPAQE8G7I38Nh+vEJ5\nVlFbMEjDO3FnkDx20dg53936N5w0x+Res2R4\n-----END CERTIFICATE-----\n';

	r_trigConnected					: R_TRIG;
	
	i_OnChangeValuesIndex			: INT;
END_VAR

VAR_IN_OUT CONSTANT
	{ attribute 'TcHmiSymbol.Hide' }
	monitor							: ST_System_Monitor;
END_VAR

VAR_IN_OUT 
	aData							: ARRAY [1..2000] OF ST_IoTDataHMI;
	controlvars						: ST_ExtController_get;
	st_params						: ST_IOT_params;
END_VAR

VAR_INPUT
	updateTrigger					: BOOL;
END_VAR

VAR
	updateList						: R_TRIG;
END_VAR

VAR_OUTPUT
	e_state							: eConnectionState;
END_VAR

VAR
	sJsonDocX8			:	STRING(2000);
	

	FastMessageState 		: ST_IOT_SentStateLog;
	SlowMessageState 		: ST_IOT_SentStateLog;
	DailyMessageState 		: ST_IOT_SentStateLog;
	OnchangeMessageState 	: ST_IOT_SentStateLog;
	aCheckSumLast			: ARRAY [1..2000] OF WORD;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// This script:
//   - Initializes an encrypted MQTT connection with openremote in the local network using the auto-provisioning method.
//   - Publishes data from the variables specified in the method "IotMapping", at different rates: Fast, Slow or OnChange (if ST_RW.WriteToNuc:=TRUE).
//   - Subcribes on topics as specified in the method "IotMapping" and pushes the received values back to the variable (if ST_RW.ReadFromNuc:=TRUE).
timer1(START:=TRUE,RESET:=TRUE);
rtrig_shutdownRequested(clk := w_shutdown = 1); //trigger instant message upon shutdown request
// -----( 0 )---------------------------  Prepare ------------------------------------------------------------------------------
// Clear previous received message
sMessage:=sMessageEmpty;

//Activate Timers
fbSendFastMessageTimer(IN:= NOT fbSendFastMessageTimer.Q, PT:= TO_TIME(st_params.r_UpdateTimeFast * 1000));
fbSendSlowMessageTimer(IN:= NOT fbSendSlowMessageTimer.Q, PT:= TO_TIME(st_params.r_UpdateTimeSlow * 1000));
fbDailyTimer(IN:= NOT fbDailyTimer.Q,);
fbConnectionTimer(IN:= NOT fbConnectionTimer.Q);

//-----( 1 )------------------- Initiate MQTT Connection using auto-provisioning------------------------------------------------
//------------------------------------------------------------------------------------------------------------------------------

IF (NOT fbMqttclient.bConnected AND fbConnectionTimer.Q) OR fbDailyTimer.Q THEN
	e_state := eConnectionState.disconnected;
	//Reset connection
	fbMqttClient.Execute(FALSE);
	//Configure
	IF bSetParameter THEN
		bSetParameter := FALSE;
		fbMqttClient.sHostName							:= '10.4.0.41';
		fbMqttClient.nHostPort							:= 8883;
		fbMqttClient.sTopicPrefix						:= '';
		fbMqttClient.sClientId							:= 'plc';
		fbMqttClient.sUserName							:= '';
		fbMqttClient.sUserPassword						:= '';
		fbMqttClient.stTLS.bNoServerCertCheck			:= TRUE;
		fbMqttClient.stTLS.sCA							:= 'c:\PLCUtility\rootCA.pem'; 
		fbMqttClient.nKeepAlive							:= 60;
		fbMqttClient.ipMessageQueue						:= fbMessageQueue;
	END_IF
	//Set and check, get error code
	fbMqttClient.Execute(bConnect);
	IF fbMqttClient.bError THEN
		hrErrorOccurred := fbMqttClient.hrErrorCode;
	END_IF	
    //Clear the Subscribe message structures
	stAutoProvisioning:=stAutoProvClear;

ELSE
	//Reset parameter set for next time connecting
	bSetParameter := TRUE;
END_IF

//Trigger connected state on rising edge
r_trigConnected(CLK:= fbMqttclient.bConnected);
IF r_trigConnected.Q THEN
	e_state := eConnectionState.connected;
END_IF

ConnectionState:= fbMQTTClient.eConnectionState;

//Auto Provisioning Pub/Sub		
IF	e_state < eConnectionState.authorized AND fbConnectionTimer.Q THEN
	//Subscribe on auto-provisioning channel
	IF NOT bSubscribedAutoProv THEN
		bSubscribedAutoProv:= fbMqttClient.Subscribe(sTopic:=autoProvSub,eQoS:=TcIotMqttQos.AtMostOnceDelivery);
	END_IF
	//Publish auto-provisioning request
	fbMqttClient.Publish(sTopic:=autoProvPub,
	pPayload := ADR(s_AutoProvMsg),
	nPayloadSize := LEN2(ADR(s_AutoProvMsg)),
	eQoS := TcIotMqttQos.AtMostOnceDelivery,
	bRetain:= FALSE,
	bQueue := FALSE);
	
	//Reset Asset Subscribtion Initialization
	bSubscribed:= FALSE;
	//Initiate on daily messages to be send one time after connect.
	DailyMessageState.bUpdate := TRUE;
	bInitiateFirstTimeSend := TRUE;

END_IF

//Start new Execute (else you won't receive messages...)
fbMqttClient.Execute(bConnect);

//Check for incomming messages
IF fbMessageQueue.nQueuedMessages > 0 THEN
	 IF fbMessageQueue.Dequeue(fbMessage:=fbMessage) THEN
		fbMessage.GetTopic(pTopic:=ADR(receivingTopic), nTopicSize:=SIZEOF(receivingTopic) );
		//Process autoprovisioning topic message
		IF receivingTopic = autoProvSub THEN
			fbMessage.GetPayload(pPayload:=ADR(sMessage), nPayloadSize:=SIZEOF(sMessage), bSetNullTermination:=FALSE );
			
			IF find(sMessage, 'success') <> 0 THEN
				e_state := eConnectionState.authorized;
			ELSIF find(sMessage, 'error') <> 0 THEN
				e_state := eConnectionState.authorization_declined;
			END_IF
//--------------------------------------END OF AUTO PROVISIONING---------------------------------------------------------
		ELSE
			// Process asset messages
			bIncommingMsg:=TRUE;
			fbMessage.GetPayload(pPayload:=ADR(sMessage), nPayloadSize:=SIZEOF(sMessage), bSetNullTermination:=FALSE);
			// OpenRemote sends attributevalue in extra quotes if it is a string, remove extra quotes (now double pressent)
			IF LEFT(sMessage,1)= '"' AND RIGHT(sMessage,1)= '"' THEN
			    sMessage:=DELETE(sMessage,1,1);
			    sMessage:=DELETE(sMessage,1,LEN(sMessage));
			END_IF
		END_IF
	END_IF
END_IF

//--------(  2  )----------Process Incomming Messages--------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------------

//Subscribe to Topics
iSizeTotal := MIN(TO_INT(eDataMappingVarNames.last), iSizeMax);
IF NOT bSubscribed AND e_state = eConnectionState.authorized THEN
		FOR i:= 1 TO iSizeTotal BY 1 DO
			IF NOT aData[i].b_IOTWriteAllowed THEN
				CONTINUE; // Jump to the next loop.
			END_IF
			//----Get variable mapping properties corresponding to index
			st_IotProps:= IotMappingV2(i);
			
			//----Check if topic is marked for subscribtion
			IF st_IotProps.st_RW.ReadFromNUC THEN
				sSubscribtion:=concat(concat(sSubPreFix,st_IotProps.sName),sAssetID);
				fbMqttClient.Subscribe(sTopic:=sSubscribtion,eQoS:=TcIotMqttQos.AtMostOnceDelivery);
			END_IF			
		END_FOR
	bSubscribed:=TRUE;
END_IF

//Process Received Messages
IF e_state = eConnectionState.authorized AND bIncommingMsg THEN
	FOR i:= 1 TO iSizeTotal BY 1 DO
		//Check if data write is enabled:
		IF NOT aData[i].b_IOTWriteAllowed THEN
			CONTINUE; // Jump to the next loop.
		END_IF
		
		st_IotProps:= IotMappingV2(i);
		//----Make the topic in format as is received for comparison
		sSubChecker:= concat(concat(sSubPrefix,st_IotProps.sName),sAssetID);
		//Check if the received message corresponds to the current index 
		IF receivingTopic = sSubChecker AND st_IotProps.st_RW.ReadFromNUC THEN
			//Put payload into variable
			IotWriteBackToVar(sMessage,st_IotProps.pAdress,st_IotProps.ClassType);
			//Disable processing again.
			bIncommingMsg:=FALSE;
		END_IF
	END_FOR
END_IF

//-----  (  3  ) ----------Publish Messages based on IotMapping and Fast, Slow or OnChange timers------------------------
//-----------------------------------------------------------------------------------------------------------------------

updatelist(CLK := UpdateTrigger);
IF updateList.Q THEN
	SlowMessageState.LastIndex := 0;
	FastMessageState.LastIndex := 0;
	DailyMessageState.LastIndex := 0;
	OnchangeMessageState.LastIndex := 0;
	FOR i := 1 TO iSizeTotal DO
		//---- Determine last index of fast and slow variables
		IF aData[i].LogInterval = eUpdate.Fast AND aData[i].LogType <> eLogType.none THEN
			FastMessageState.LastIndex := i;
		END_IF
		IF aData[i].LogInterval = eUpdate.Slow AND aData[i].LogType <> eLogType.none THEN
			SlowMessageState.LastIndex := i;
		END_IF
		IF aData[i].LogInterval = eUpdate.Daily AND aData[i].LogType <> eLogType.none THEN
			DailyMessageState.LastIndex := i;
		END_IF
		IF aData[i].LogInterval = eUpdate.Onchange AND aData[i].LogType <> eLogType.none THEN
			OnchangeMessageState.LastIndex := i;
		END_IF
	END_FOR
END_IF

b_UpdateActive := rtrig_shutdownRequested.q;

IF fbSendFastMessageTimer.Q THEN
	FastMessageState.bUpdate := TRUE;
END_IF
IF fbSendSlowMessageTimer.Q THEN
	SlowMessageState.bUpdate := TRUE;
END_IF
IF fbSendFastMessageTimer.Q  OR DailyMessageState.bUpdate OR rtrig_shutdownRequested.q THEN
	OnchangeMessageState.bUpdate := TRUE;
END_IF

IF controlvars.LoggingBudgetOK THEN
	PublishVarsV2(Authorized := e_state = eConnectionState.authorized, interval := eUpdate.Fast, state := FastMessageState);
	PublishVarsV2(Authorized := e_state = eConnectionState.authorized, interval := eUpdate.Slow, state := SlowMessageState);
	PublishVarsV2(Authorized := e_state = eConnectionState.authorized, interval := eUpdate.Daily, state := DailyMessageState);
	PublishVarsV2(Authorized := e_state = eConnectionState.authorized, interval := eUpdate.onchange, state := OnchangeMessageState);
end_if
PublishVarsV1();

timer1(START:=FALSE);

controlvars.e_ConnectionState := e_state;]]></ST>
    </Implementation>
    <Method Name="FillBatteryDatalog" Id="{6de0f877-560b-463e-b91f-3c52ed293b96}">
      <Declaration><![CDATA[METHOD PUBLIC FillBatteryDatalog : BOOL
VAR_INPUT
	s_MBMUData	:	STRING(255);
	s_SBMUData	:	ARRAY[0..3] OF STRING (255);
	s_EMSData	:	STRING(255);
END_VAR

VAR
	fbJson      	: FB_JsonSaxWriter;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbJson.StartObject();
fbJson.AddKeyString('MBMU',s_MBMUData);
fbJson.AddKeyString('SBMU1',s_SBMUData[0]);
fbJson.AddKeyString('SBMU2',s_SBMUData[1]);
fbJson.AddKeyString('SBMU3',s_SBMUData[2]);
fbJson.AddKeyString('SBMU4',s_SBMUData[3]);
fbJson.AddKeyString('EMS',s_EMSData);
fbJson.EndObject();
fbJson.CopyDocument(pDoc := sJsonDocX8, nDoc := SIZEOF(sJsonDocX8));
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IoTExtractType" Id="{83d0dcf9-25e9-4193-b05f-dafb4eba6569}">
      <Declaration><![CDATA[METHOD IoTExtractType : ST_VarBuffer
VAR_INPUT
	sVariableName	: ANY;
	precision		: INT := 0; 
	threshold		: REAL := 0;
END_VAR

VAR
	bNumber		: BOOL;
	
	tempReal	: REAL;
	tempLreal	: LREAL;
	tempDword	: DWORD;
	tempWord	: WORD;
	tempSINT	: SINT;
	tempint		: INT;
	tempUint	: UINT;
	tempusint	: USINT;
	//pTosValue	: PVOID := ADR(sValue);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE UDINT_TO_INT(sVariableName.TypeClass) OF
    IBaseLibrary.TypeClass.TYPE_BOOL :
		IF PBOOL_TO_BOOL(sVariableName.pValue) THEN
			IotExtractType.sValue := 'true';
		ELSIF NOT PBOOL_TO_BOOL(sVariableName.pValue) THEN
			IotExtractType.sValue := 'false';
		END_IF
		bNumber:= TRUE;
    IBaseLibrary.TypeClass.TYPE_ENUM :
		IotExtractType.sValue	:= TO_STRING(PINT_TO_INT(sVariableName.pValue));
		bNumber:= FALSE;
    IBaseLibrary.TypeClass.TYPE_LREAL :
		tempLreal := PLREAL_TO_LREAL(sVariableName.pValue);
		IF ABS(tempLreal) < threshold THEN tempLreal := 0; END_IF
		IotExtractType.sValue	:= TO_STRING(LREAL_TO_FMTSTR(tempLreal, precision, TRUE));
		bNumber:= TRUE;
    IBaseLibrary.TypeClass.TYPE_WORD :
		tempword := PWORD_TO_WORD(sVariableName.pValue);
		IF tempword < threshold THEN tempword := 0; END_IF
		IotExtractType.sValue	:= TO_STRING(tempword);
		bNumber:= TRUE;
    IBaseLibrary.TypeClass.TYPE_DWORD :
		tempDword := PDWORD_TO_DWORD(sVariableName.pValue);
		IF tempdword < threshold THEN tempdword := 0; END_IF
		IotExtractType.sValue	:= TO_STRING(tempdword);
		bNumber:= TRUE;
    IBaseLibrary.TypeClass.TYPE_SINT :
		tempsint := PSINT_TO_SINT(sVariableName.pValue);
		IF ABS(tempsint) < threshold THEN tempsint := 0; END_IF
		IotExtractType.sValue	:= TO_STRING(tempsint);
		bNumber:= TRUE;
    IBaseLibrary.TypeClass.TYPE_INT :
		tempint := PINT_TO_INT(sVariableName.pValue);
		IF ABS(tempint) < threshold THEN tempint := 0; END_IF
		IotExtractType.sValue	:= TO_STRING(tempint);
		bNumber:= TRUE;	
	IBaseLibrary.TypeClass.TYPE_UINT :
		tempuint := PUINT_TO_UINT(sVariableName.pValue);
		IF tempuint < threshold THEN tempuint := 0; END_IF
		IotExtractType.sValue	:= TO_STRING(tempuint);
		bNumber:= TRUE;	
    IBaseLibrary.TypeClass.TYPE_REAL :
		tempreal := PREAL_TO_REAL(sVariableName.pValue);
		IF ABS(tempreal) < threshold THEN tempreal := 0; END_IF
		IotExtractType.sValue	:= TO_STRING(LREAL_TO_FMTSTR(tempreal, precision, TRUE));
		bNumber:= TRUE;
	IBaseLibrary.TypeClass.TYPE_STRING :
		//Pas op gevaarlijke functie, doet rechtstreeks geheugen adres manipulatie!
		memcpy(ADR(IotExtractType.sValue),sVariableName.pValue,sVariablename.diSize);
		bNumber:= FALSE;
	IBaseLibrary.TypeClass.TYPE_USINT :
		tempusint := PUSINT_TO_USINT(sVariableName.pValue);
		IF tempusint < threshold THEN tempusint := 0; END_IF
		IotExtractType.sValue	:= TO_STRING(tempusint);
		bNumber:= TRUE;
ELSE
	IotExtractType.sValue:='UNKNOWN_DATA_TYPE';
		
END_CASE

IoTExtractType.pAdress	:= sVariableName.pValue;
IotExtractType.diSize := sVariableName.diSize;
IotExtractType.ClassType:= sVariableName.TypeClass;
IotExtractType.bNumber  := bNumber;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IotMapping" Id="{a45dc000-ad50-4755-868e-776a573c193d}">
      <Declaration><![CDATA[METHOD IotMapping : ST_IotProps
VAR_INPUT
	index : INT;
END_VAR

VAR
	pAdress 		: PVOID;
	st_Variable		: ST_VarBuffer;
	bJson			: BOOL;
	tempString		: STRING;
	tempReal		: REAL;
	fbJson      	: FB_JsonSaxWriter;
	sJsonDocX12     : STRING(255);
	sJsonDocX11     : STRING(255);
	
	jsonKey			: STRING;
	i				: INT; // for loop index
	
END_VAR

VAR_OUTPUT
	sName			: STRING;
	eUpdate			: eUpdate;
	st_RW			: ST_RW;
	//bNumber		: BOOL;
	//bJson			: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE index OF 
//----(1)--- FILL STRUCTURES WITH DATA FROM PLC ------------------------------------------------------------
//----------------------------------------------------------------------------------------------------------
//--- eUpdate 0=Fast 1=Slow 2=Onchange 3=Daily--------------------------------------------------------------
//--- OnChange messages only get published when changing, at the same rate as the Fast timer----------------
//----st_Buffer contains properties of the given variable---------------------------------------------------
//General
1:	tempString := TO_STRING(monitor.controlfb.HardSettings.setup.e_ControlSource);
	sName:= 'controlMode'						; st_Variable:= IotExtractType(tempString, 0, 0);       	 																	eUpdate:= 2;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
2:	sName:= 'urgentMessages'					; st_Variable:= IotExtractType(sEventMsg, 0, 0);																				eUpdate:= 2;    st_RW.WriteToNUC:=TRUE;		st_RW.ReadFromNUC:=FALSE;			
//IoT operation to start/stop inverter 0=NA 1=ON 2=OFF 3=HOLD
//Doesnt exist yet in plc //3:	sName:= 'setOperation'		; st_Variable:= IotExtractType(eActiveMsg);																	eUpdate:= 2;    st_RW.WriteToNUC:=FALSE;		st_RW.ReadFromNUC:=TRUE;	
4:	tempString := TO_STRING(monitor.system.e_State);
	sName:= 'operatingState'					; st_Variable:= IotExtractType(tempString, 0, 0);    																			eUpdate:= 2;    st_RW.WriteToNUC:=TRUE;     st_RW.ReadFromNUC:=FALSE;           
5:	sName:= 'model'								; st_Variable:= IotExtractType(Settings.Properties.s_ManufacturerModel, 0, 0);    											eUpdate:= 2;    st_RW.WriteToNUC:=TRUE;     st_RW.ReadFromNUC:=FALSE;          
6:	sName:= 'serialNumber'						; st_Variable:= IotExtractType(Settings.Properties.s_SerialNumber, 0, 0);       												eUpdate:= 2;    st_RW.WriteToNUC:=FALSE;    st_RW.ReadFromNUC:=TRUE;
7:	sName:= 'clientAbbreviation'				; st_Variable:= IotExtractType(Settings.Properties.s_Client, 0, 0);       	 												eUpdate:= 2;    st_RW.WriteToNUC:=FALSE; 	st_RW.ReadFromNUC:=TRUE;        
8:	tempString := CONCAT(CONCAT('{"type":"Point","coordinates":[',CONCAT(TO_STRING(monitor.router.GPS.Longitude), CONCAT(',',TO_STRING(monitor.router.GPS.Latitude)))),']}');
	sName:= 'location'							; st_Variable:= IotExtractType(tempString, 0, 0);      	 																	eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;  	bJson := TRUE;
//Temperatures				                      
9:	sName:= 'ambientTemperature'				; st_Variable:= IotExtractType(monitor.Cooling.HeatpumpSystem.PrimaryHeatPumpGet.HeatPumpData.r_OutdoorTemp, 1, 0);       	eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;									
10:	sName:= 'cabinetTemperature'				; st_Variable:= IotExtractType(monitor.enclosure.climate.r_Temperature, 1, 0);       	 																	eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;	
11:	sName:= 'inverterTemperature'				; st_Variable:= IotExtractType(monitor.powerstack.PowermoduleMaster.r_TemperatureInverter, 1, 0);       	 					eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;	
12:	sName:= 'coolantTemperature'                ; st_Variable:= IotExtractType(monitor.Cooling.r_CoolantTemperature, 1 ,0);       	 										eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
//Battery					                                                                                              											
13:	sName:= 'stateOfCharge'			            ; st_Variable:= IotExtractType(monitor.battery.BatteryInfo.r_SOCScaled, 1, 0);    	 										eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
//14:	sName:= ''					    ; st_Variable:= IotExtractType(monitor.battery.BatteryInfo.r_SOH);       	 													eUpdate:= 2;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
15:	sName:= 'dcLinkCurrent'				        ; st_Variable:= IotExtractType(monitor.battery.BatteryInfo.r_SystemCurrent, 0, 0);       	 									eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
16:	sName:= 'dcLinkVoltage'			            ; st_Variable:= IotExtractType(monitor.battery.BatteryInfo.r_SystemVoltage, 0, 0);       	 									eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
//17:	sName:= ''								; st_Variable:= IotExtractType(monitor.powermonitor.BESS.r_EnergySupplied);       	 									eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;	
//18:	sName:= ''								; st_Variable:= IotExtractType(monitor.powermonitor.BESS.r_EnergyConsumed);       	 									eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;	                              
19:	sName:= 'coolantPressure'			        ; st_Variable:= IotExtractType(monitor.Cooling.r_CoolantPressure, 1, 0);       	 											eUpdate:= 2;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
20:	sName:= 'productionDate'				    ; st_Variable:= IotExtractType(productionDateString, 0, 0);     	 															eUpdate:= 2;    st_RW.WriteToNUC:=FALSE; 	st_RW.ReadFromNUC:=TRUE;
	settings.Properties.s_ProductionDate := TO_STRING(TO_DT(TO_LWORD(productionDateString) / 1000));
21:	sName:= 'currentL1InputField'				; st_Variable:= IotExtractType(monitor.powermonitor.InputField.ar_Current[1], 0	,2);       	 								eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;	
22:	sName:= 'currentL2InputField'				; st_Variable:= IotExtractType(monitor.powermonitor.InputField.ar_Current[2], 0	,2);       	 								eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;	   
23:	sName:= 'currentL3InputField'				; st_Variable:= IotExtractType(monitor.powermonitor.InputField.ar_Current[3],0	,2);       	 								eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
24:	sName:= 'currentNInputField'				; st_Variable:= IotExtractType(monitor.powermonitor.InputField.ar_Current[4],0	,2);       	 								eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
25:	sName:= 'activePowerInput'					; st_Variable:= IotExtractType(monitor.powermonitor.InputField.ar_ActivePower[0],0, 5);       	 								eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
26:	sName:= 'reactivePowerInput'		    	; st_Variable:= IotExtractType(monitor.powermonitor.InputField.ar_ReactivePower[0],0,5);       	 							eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
//Doesnt exist yet in plc 27:	sName:= 'powerDcCoupling'		        ; st_Variable:= IotExtractType(GVL.a);       	 												eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
//Doesnt exist yet in plc 28:	sName:= 'currentDcCoupling'		        ; st_Variable:= IotExtractType(GVL.a);       	 												eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
29:	sName:= 'averageCellTemperature'            ; st_Variable:= IotExtractType(monitor.battery.BatteryInfo.ar_CellTemperature[1], 1, 0);       	 							eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
// OutputField		                                                                                                      											
