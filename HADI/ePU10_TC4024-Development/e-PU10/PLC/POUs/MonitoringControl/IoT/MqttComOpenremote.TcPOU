36:	sName:= 'lineVoltageL2L3'		            ; st_Variable:= IotExtractType(monitor.powermonitor.OutputField.ar_LineVoltage[2], 0, 10);       	 							eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
