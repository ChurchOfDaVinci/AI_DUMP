eDataMappingVarNames.system_GenGridController_b_gensetHot: 				st_Variable:= IotExtractType(monitor.system.GenGridController.b_gensetHot, 0, 0); 
eDataMappingVarNames.system_GenGridController_b_gensetStarting: 				st_Variable:= IotExtractType(monitor.system.GenGridController.b_gensetStarting, 0, 0); 
eDataMappingVarNames.system_GenGridController_b_ModeTransActive: 				st_Variable:= IotExtractType(monitor.system.GenGridController.b_ModeTransActive, 0, 0); 
eDataMappingVarNames.system_GenGridController_b_ModeTransInhibit: 				st_Variable:= IotExtractType(monitor.system.GenGridController.b_ModeTransInhibit, 0, 0); 
eDataMappingVarNames.system_GenGridController_b_ModeChanged: 				st_Variable:= IotExtractType(monitor.system.GenGridController.b_ModeChanged, 0, 0); 
eDataMappingVarNames.system_GenGridController_b_ShowModeTrans: 				st_Variable:= IotExtractType(monitor.system.GenGridController.b_ShowModeTrans, 0, 0); 
eDataMappingVarNames.system_GenGridController_b_extGensetMode: 				st_Variable:= IotExtractType(monitor.system.GenGridController.b_extGensetMode, 0, 0); 
eDataMappingVarNames.system_GenGridController_b_gensetcontrol: 				st_Variable:= IotExtractType(monitor.system.GenGridController.b_gensetcontrol, 0, 0); 
eDataMappingVarNames.system_GenGridController_e_BreakerMode: 				st_Variable:= IotExtractType(monitor.system.GenGridController.e_BreakerMode, 0, 0); 
eDataMappingVarNames.system_GenGridController_e_PowerControlMode: 				st_Variable:= IotExtractType(monitor.system.GenGridController.e_PowerControlMode, 0, 0); 
eDataMappingVarNames.system_GenGridController_e_GensetMode: 				st_Variable:= IotExtractType(monitor.system.GenGridController.e_GensetMode, 0, 0); 
eDataMappingVarNames.system_GenGridController_e_GensetStartStop: 				st_Variable:= IotExtractType(monitor.system.GenGridController.e_GensetStartStop, 0, 0); 
eDataMappingVarNames.system_GenGridController_e_state: 				st_Variable:= IotExtractType(monitor.system.GenGridController.e_state, 0, 0); 
eDataMappingVarNames.system_GenGridController_e_RunCondition: 				st_Variable:= IotExtractType(monitor.system.GenGridController.e_RunCondition, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_InvalidGensetParameters: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_InvalidGensetParameters, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_RotationFieldFault: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_RotationFieldFault, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_CurrentLimitDisconnect: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_CurrentLimitDisconnect, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_CurrentLimitTrip: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_CurrentLimitTrip, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_EmstopDisconnect: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_EmstopDisconnect, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_ShutdownDisconnect: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_ShutdownDisconnect, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_OverloadTrip: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_OverloadTrip, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_OverFreqTrip: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_OverFreqTrip, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_UnderFreqTrip: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_UnderFreqTrip, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_OverVoltTrip: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_OverVoltTrip, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_UnderVoltTrip: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_UnderVoltTrip, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_ShutdownTimeOut: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_ShutdownTimeOut, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_SynchronisationFault: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_SynchronisationFault, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_StartupFault: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_StartupFault, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_WarmupFault: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_WarmupFault, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_GenDownTrip: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_GenDownTrip, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_GridLostTrip: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_GridLostTrip, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_TransToGenIsoInhibit: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_TransToGenIsoInhibit, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_TransToGenDroopInhibit: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_TransToGenDroopInhibit, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_TransToGenFixInhibit: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_TransToGenFixInhibit, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_TransFromInputGridAckRQ: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_TransFromInputGridAckRQ, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_TransFromInputGenAckRQ: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_TransFromInputGenAckRQ, 0, 0); 
eDataMappingVarNames.system_GenGridController_events_b_StartingInhibit: 				st_Variable:= IotExtractType(monitor.system.GenGridController.events.b_StartingInhibit, 0, 0); 
eDataMappingVarNames.system_events_b_RestartRequiredMachineName: 				st_Variable:= IotExtractType(monitor.system.events.b_RestartRequiredMachineName, 0, 0); 
eDataMappingVarNames.system_events_b_TimeUpdateFailed: 				st_Variable:= IotExtractType(monitor.system.events.b_TimeUpdateFailed, 0, 0); 
eDataMappingVarNames.powerstack_e_State: 				st_Variable:= IotExtractType(monitor.powerstack.e_State, 0, 0); 
eDataMappingVarNames.powerstack_e_PowerState: 				st_Variable:= IotExtractType(monitor.powerstack.e_PowerState, 0, 0); 
