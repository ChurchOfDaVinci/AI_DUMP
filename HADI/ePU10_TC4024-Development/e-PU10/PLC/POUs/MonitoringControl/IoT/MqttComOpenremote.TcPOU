68:	sName:='idleChargePower'                    ; st_Variable:= IotExtractType(controlvars.SoftSettings.PSB.setpointTimeslot1.r_IdleChargePower, 0, 0);       	 			eUpdate:= 0;    st_RW.WriteToNUC:=FALSE; 	st_RW.ReadFromNUC:=TRUE;
69:	sName:='socTarget'                          ; st_Variable:= IotExtractType(sStartShutdownCMD, 0, 0);       	 															eUpdate:= 0;    st_RW.WriteToNUC:=FALSE; 	st_RW.ReadFromNUC:=TRUE;
70:	sName:='relHumCabinet'                      ; st_Variable:= IotExtractType(monitor.enclosure.climate.r_Humidity, 0, 0);       	 										eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
71:	sName:='transformerTemperature'             ; st_Variable:= IotExtractType(monitor.neutraltransformer.r_TemperaturePhase[1], 1, 0);       	 							eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
72:	sName:='voltageLN'                          ; st_Variable:= IotExtractType(monitor.powermonitor.InputField.ar_PhaseVoltage[0], 0, 0);       	 							eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
73:	sName:='currentNOutputField'                ; st_Variable:= IotExtractType(monitor.powermonitor.OutputField.ar_Current[4], 0,0);       	 								eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
74:	sName:='zeropointPowerload'                 ; st_Variable:= IotExtractType(monitor.neutraltransformer.r_Powerload, 1, 0);       	 										eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
75:	sName:='machineDescription'                 ; st_Variable:= IotExtractType(monitor.system.s_SystemName, 0, 0);       	 													eUpdate:= 2;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
76:	sName:='hardwareConfiguration'              ; st_Variable:= IotExtractType(settings.Properties.s_ConfigurationCode, 0, 0);       	 										eUpdate:= 2;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
77: sName:='gridFilterTemperature'				; st_Variable:= IotExtractType(monitor.powerstack.r_MaxTemperature, 1, 0);       	 											eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
// X1: Number representing eSeverity level (positive number)
78: sName:='X1'									; st_Variable:= IotExtractType(eActiveMsg, 0, 0);       	 																	eUpdate:= 2;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
// X2: Number representing other state (positive number)
//79: sName:='X2'				; st_Variable:= IotExtractType(GVL.a);       	 																						eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
// X3: Non defined number to store (number)
//80: sName:='X3'				; st_Variable:= IotExtractType(GVL.a);       	 																						eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
// X4: Custom operational message read only by openremote (string)
//81: sName:='X4'				; st_Variable:= IotExtractType(GVL.a);       	 																						eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
// X5: Custom operational message r/w (string)
//82: sName:='X5'				; st_Variable:= IotExtractType(GVL.a);       	 																						eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
// X6: Custom datalog text 1 (string)
//83: sName:='X6'				; st_Variable:= IotExtractType(GVL.a);       	 																						eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
// X7: Custom datalog text 2 (string)
//84: sName:='X7'				; st_Variable:= IotExtractType(GVL.a);       	 																						eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
// X8: Custom JSON datalog 1: CATL Data (JSON string)
85: sName:='X8'				; st_Variable:= IotExtractType(sJsonDocX8, 0, 0);       	 																					eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;	bJson := TRUE;
// X9: Custom JSON datalog 2: Predictive Maintenance (JSON string)
86: sName:='X9'				; st_Variable:= IotExtractType(Wearlogging.JsonText, 0, 0);       	 																			eUpdate:= 3;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;	bJson := TRUE;

// X10: Custom JSON datalog 3: Fast Operational Data (JSON string )
//87: sName:='X10'				; st_Variable:= IotExtractType(GVL.a);       	 																						eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
// X11: Custom JSON datalog 4: Slow Operational Data (JSON string)
88: fbJson.StartObject();
	FOR i:= 1 TO 6 BY 1 DO
		IoTMapping_json_X11(index:=i, sName=>jsonKey, st_Variable=>st_Variable);
		fbJson.AddKeyString(jsonKey,st_Variable.sValue);
	END_FOR
	fbJson.EndObject();
	sJsonDocX11:=fbJson.GetDocument();
	sName:='X11'				; st_Variable:= IotExtractType(sJsonDocX11, 0,0);      	 																					eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;	bJson := TRUE;
// X12: Custom JSON datalog 5: onChange Operational Data (JSON string)
89: fbJson.StartObject();
	FOR i:= 1 TO 2 BY 1 DO
		IoTMapping_json_X12(index:=i, sName=>jsonKey, st_Variable=>st_Variable);
		fbJson.AddKeyString(jsonKey,st_Variable.sValue);
	END_FOR
	fbJson.EndObject();
	sJsonDocX12:=fbJson.GetDocument();
	sName:='X12'				; st_Variable:= IotExtractType(sJsonDocX12, 0, 0);       	 																					eUpdate:= 2;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;	bJson := TRUE;

// X13: Custom JSON datalog 6: (JSON string)
//90: sName:='X13'				; st_Variable:= IotExtractType(GVL.a);       	 																						eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
// X14: Custom JSON datalog 7: (JSON string)
//91: sName:='X14'				; st_Variable:= IotExtractType(GVL.a);       	 																						eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
// X15: Custom JSON message r/w (JSON string)
//92: sName:='X15'				; st_Variable:= IotExtractType(GVL.a);       	 																						eUpdate:= 1;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
93:	sName:= 'currentDcCoupling'				        ; st_Variable:= IotExtractType(monitor.DCswitchgear.r_Current, 1, 1);       	 							eUpdate:= 0;    st_RW.WriteToNUC:=TRUE; 	st_RW.ReadFromNUC:=FALSE;
//Populated via Attributelink:
//-cycleCount
//-totalEnergyFromBattery (counter needs improvement)
//-totalEnergyToBattery (counter needs improvement)
//-stateOfHealth


END_CASE


//-------------------------------Write to output---------------------------------------------
IotMapping.sName		:= sName;				//Name of the variable
IotMapping.sValue		:= st_Variable.sValue;	//Extracted value of the variable
IotMapping.eUpdate		:= eUpdate;				//Update frequency
IotMapping.st_RW		:= st_RW;				//Read/Write
IotMapping.pAdress		:= st_Variable.pAdress; //Adress pointer to variable
IotMapping.ClassType	:= st_Variable.ClassType; //Extracted data type of the variable
IotMapping.bNumber		:= st_Variable.bNumber;
IotMapping.bJson		:= bJson;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IoTMapping_json_X11" Id="{a441caf9-2c7e-42fd-a5a2-e0203926b328}">
      <Declaration><![CDATA[METHOD IoTMapping_json_X11
VAR_INPUT
	index :INT;
END_VAR


VAR_OUTPUT
	sName			: STRING;
	st_Variable		: ST_VarBuffer;
	tempString		: STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE index OF
	//Energy Counters
	1: sName:= 'kWhInOutput'		; st_Variable:= IotExtractType(monitor.powermonitor.OutputField.r_EnergyConsumed, 0, 0);
	2: sName:= 'kWhOutOutput'		; st_Variable:= IotExtractType(monitor.powermonitor.OutputField.r_EnergySupplied, 0, 0);
	3: sName:= 'kWhInInput'			; st_Variable:= IotExtractType(monitor.powermonitor.InputField.r_EnergyConsumed, 0, 0);
	4: sName:= 'kWhOutInput'		; st_Variable:= IotExtractType(monitor.powermonitor.InputField.r_EnergySupplied, 0, 0);
	5: sName:= 'kWhInBattery'       ; st_Variable:= IotExtractType(monitor.powermonitor.BESS.r_EnergyConsumed, 0, 0);
	6: sName:= 'kWhOutBattery'		; st_Variable:= IotExtractType(monitor.powermonitor.BESS.r_EnergySupplied, 0 , 0);
	//Doesnt exist yet in plc 5: sName:= 'kWhInDcCoup'		; st_Variable:= IotExtractType(tempString);
	//Doesnt exist yet in plc 6: sName:= 'kWhOutDcCoup'		; st_Variable:= IotExtractType(tempString);
	7: sName:= 'kWhSelfConsumption' ; st_Variable:= IotExtractType(tempString, 0, 0);
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="IoTMapping_json_X12" Id="{7c59e038-b216-43a1-8872-8111b2c88571}">
      <Declaration><![CDATA[METHOD IoTMapping_json_X12
VAR_INPUT
	index :INT;
END_VAR


VAR_OUTPUT
	sName			: STRING;
	st_Variable		: ST_VarBuffer;
	tempString		: STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE index OF
	//Operational Values JSON: Variable values (st_Variable) and their corresponding PowerNet attributeName (sName) to be put into a json.
	1: tempString:= TO_STRING(monitor.system.GenGridController.e_state);
	   sName:= 'inputState'				    ; st_Variable:= IotExtractType(tempString, 0, 0);
	2: tempString:= TO_STRING(monitor.internalpsu.e_400VSupplySource);
	   sName:= 'auxSupply'					; st_Variable:= IotExtractType(tempString, 0, 0);
	3: IF settings.Configuration.b_PeakshaverBoxEnable THEN
			tempString:= TO_STRING(monitor.peakshavebox.b_active );
	  		sName:= 'peakShaveStatus'					; st_Variable:= IotExtractType(tempString, 0, 0);
		END_IF

	4: 	IF controlvars.SoftSettings.setup.e_AcInputType = eACinputtype.Genset THEN
			tempString:= TO_STRING(monitor.system.GenGridController.e_state );
		ELSIF controlvars.SoftSettings.setup.b_ExtGenset THEN
			IF monitor.system.GenGridController.e_RunCondition <> eruncondition.None THEN
				tempString:=  TO_STRING('Running');
			ELSE
				tempString:=  TO_STRING('Off');
			END_IF
		ELSE
			tempString:=  TO_STRING('None');
		END_IF
		sName:= 'generatorStatus'					; st_Variable:= IotExtractType(tempString, 0, 0);
	
	5: 	IF settings.Configuration.b_ACInputConnection THEN
			IF controlvars.SoftSettings.setup.e_AcInputType = eACinputtype.Grid THEN
				tempString:= TO_STRING(monitor.system.GenGridController.e_state );
			ELSE
				tempString:= TO_STRING('Init');
			END_IF
			sName:= 'InputGridStatus'				; st_Variable:= IotExtractType(tempString, 0, 0);
		END_IF
			
	6:	tempString:= SEL(monitor.powerstack.b_InverterGridFormingMode, 'Grid Following', 'Grid Forming');
	   sName:= 'operationMode'				    ; st_Variable:= IotExtractType(tempString, 0, 0);
	
	  
	   
	7:	//ACDC charger status	
	8:	//DCDC satus
	9:  //parallel status
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="IotMappingV2" Id="{431eb580-3ed2-4a5c-8e42-394c707ae310}">
      <Declaration><![CDATA[METHOD IotMappingV2 : ST_IotProps
VAR_INPUT
	index : DINT;
END_VAR

VAR
	pAdress 		: PVOID;
	st_Variable		: ST_VarBuffer;
	bJson			: BOOL;
	tempString		: STRING;
	tempReal		: REAL;
	fbJson      	: FB_JsonSaxWriter;
	sJsonDocX12     : STRING(255);
	sJsonDocX11     : STRING(255);
	
	jsonKey			: STRING;
	i				: INT; // for loop index
	st_RW			: ST_RW;
END_VAR

VAR_OUTPUT
	sName			: STRING;
	eUpdate			: eUpdate;
	//bNumber		: BOOL;
	//bJson			: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF index < eDataMappingVarnames.last AND (aData[index].LogType = 0 OR aData[index].Label = '') THEN
	RETURN;
END_IF

CASE index OF 

//----(1)--- FILL STRUCTURES WITH DATA FROM PLC ------------------------------------------------------------
//----------------------------------------------------------------------------------------------------------
//--- eUpdate 0=Fast 1=Slow 2=Onchange 3=Daily--------------------------------------------------------------
//--- OnChange messages only get published when changing, at the same rate as the Fast timer----------------
//----st_Buffer contains properties of the given variable---------------------------------------------------
eDataMappingVarNames.safety_b_SafetyOK: 				st_Variable:= IotExtractType(monitor.safety.b_SafetyOK, 0, 0); 
eDataMappingVarNames.safety_b_EstopChannelAOK: 				st_Variable:= IotExtractType(monitor.safety.b_EstopChannelAOK, 0, 0); 
eDataMappingVarNames.safety_b_EstopChannelBOK: 				st_Variable:= IotExtractType(monitor.safety.b_EstopChannelBOK, 0, 0); 
eDataMappingVarNames.safety_b_InsulationMonitorOK: 				st_Variable:= IotExtractType(monitor.safety.b_InsulationMonitorOK, 0, 0); 
eDataMappingVarNames.safety_b_MRCDBOK: 				st_Variable:= IotExtractType(monitor.safety.b_MRCDBOK, 0, 0); 
eDataMappingVarNames.safety_b_InverterDoorOK: 				st_Variable:= IotExtractType(monitor.safety.b_InverterDoorOK, 0, 0); 
eDataMappingVarNames.safety_b_ZptOK: 				st_Variable:= IotExtractType(monitor.safety.b_ZptOK, 0, 0); 
eDataMappingVarNames.system_b_SMSnumberConfigured: 				st_Variable:= IotExtractType(monitor.system.b_SMSnumberConfigured, 0, 0); 
eDataMappingVarNames.system_b_CustomNameConfigured: 				st_Variable:= IotExtractType(monitor.system.b_CustomNameConfigured, 0, 0); 
eDataMappingVarNames.system_s_SystemName: 				st_Variable:= IotExtractType(monitor.system.s_SystemName, 0, 0); 
eDataMappingVarNames.system_b_TransportModePending: 				st_Variable:= IotExtractType(monitor.system.b_TransportModePending, 0, 0); 
eDataMappingVarNames.system_b_DehumModePending: 				st_Variable:= IotExtractType(monitor.system.b_DehumModePending, 0, 0); 
eDataMappingVarNames.system_e_State: 				st_Variable:= IotExtractType(monitor.system.e_State, 0, 0); 
eDataMappingVarNames.system_e_gridmode: 				st_Variable:= IotExtractType(monitor.system.e_gridmode, 0, 0); 
eDataMappingVarNames.system_e_UgridPowermode: 				st_Variable:= IotExtractType(monitor.system.e_UgridPowermode, 0, 0); 
eDataMappingVarNames.system_b_StartAllowed: 				st_Variable:= IotExtractType(monitor.system.b_StartAllowed, 0, 0); 
eDataMappingVarNames.system_r_CurrentEfficiency: 				st_Variable:= IotExtractType(monitor.system.r_CurrentEfficiency, 1, 0); 
eDataMappingVarNames.system_r_AvgEfficiency: 				st_Variable:= IotExtractType(monitor.system.r_AvgEfficiency, 1, 0); 
eDataMappingVarNames.system_r_RoundtripEfficiency: 				st_Variable:= IotExtractType(monitor.system.r_RoundtripEfficiency, 1, 0); 
eDataMappingVarNames.system_DT_SystemTime: 				st_Variable:= IotExtractType(monitor.system.DT_SystemTime, 0, 0); 
eDataMappingVarNames.system_PowerController_r_CurrentAct: 				st_Variable:= IotExtractType(monitor.system.PowerController.r_CurrentAct, 0, 1); 
eDataMappingVarNames.system_PowerController_r_Sact: 				st_Variable:= IotExtractType(monitor.system.PowerController.r_Sact, 0, 1); 
eDataMappingVarNames.system_PowerController_r_PAct: 				st_Variable:= IotExtractType(monitor.system.PowerController.r_PAct, 0, 1); 
eDataMappingVarNames.system_PowerController_r_QAct: 				st_Variable:= IotExtractType(monitor.system.PowerController.r_QAct, 0, 1); 
eDataMappingVarNames.system_PowerController_r_PhaseVoltageAct: 				st_Variable:= IotExtractType(monitor.system.PowerController.r_PhaseVoltageAct, 0, 1); 
eDataMappingVarNames.system_PowerController_r_PFact: 				st_Variable:= IotExtractType(monitor.system.PowerController.r_PFact, 2, 0); 
eDataMappingVarNames.system_PowerController_r_FeedInCurrentLimitActual: 				st_Variable:= IotExtractType(monitor.system.PowerController.r_FeedInCurrentLimitActual, 0, 0); 
eDataMappingVarNames.system_PowerController_r_SupplyInCurrentLimitActual: 				st_Variable:= IotExtractType(monitor.system.PowerController.r_SupplyInCurrentLimitActual, 0, 0); 
eDataMappingVarNames.system_PowerController_b_ThrottlingActive: 				st_Variable:= IotExtractType(monitor.system.PowerController.b_ThrottlingActive, 0, 0); 
eDataMappingVarNames.system_PowerController_ui_ThrottlingType: 				st_Variable:= IotExtractType(monitor.system.PowerController.ui_ThrottlingType, 0, 0); 
eDataMappingVarNames.system_PowerController_events_b_ReactivePIDError: 				st_Variable:= IotExtractType(monitor.system.PowerController.events.b_ReactivePIDError, 0, 0); 
eDataMappingVarNames.system_PowerController_events_b_ActivePIDError: 				st_Variable:= IotExtractType(monitor.system.PowerController.events.b_ActivePIDError, 0, 0); 
eDataMappingVarNames.system_PowerController_events_b_FreqShiftPIDError: 				st_Variable:= IotExtractType(monitor.system.PowerController.events.b_FreqShiftPIDError, 0, 0); 
