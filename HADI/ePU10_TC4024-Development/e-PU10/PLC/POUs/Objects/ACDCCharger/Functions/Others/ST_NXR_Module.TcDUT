<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_NXR_Module" Id="{3101b229-9cf4-489b-8937-062685a02fd8}">
    <Declaration><![CDATA[TYPE ST_NXR_Module :
STRUCT
    // ===== Commands =====
    rSetVoltage_V         	: REAL;  // Voltage command   0x0021
    rSetCurrent_A         	: REAL;  // Current command   0x0022
    bPowerEnable          	: BOOL;  // Power enable command   0x0030
	
	bResetFault     		: BOOL;


    // ===== Status =====  
    bStatus_PowerOn       	: BOOL;  // Module powered    0x0040 bit22
    bStatus_Fault         	: BOOL;  // Fault active      0x0040 bit0
    bStatus_OverTemp      	: BOOL;  // Over-temperature  0x0040 bit30
    bStatus_ModuleEnabled 	: BOOL;  // Module enabled
	
	// ===== Raw status words =====
    dwStatusWord           	: DWORD;  // Register 0x0040
    dwExtStatusWord        	: DWORD;  // Register 0x0042

    // ===== Runtime =====
    udRuntime_s            	: UDINT; // Total run time in seconds
	
	bStatus_CANFault		: BOOL;
	
	rActVoltage_V  			: REAL;  // Actual Voltage
	rActCurrent_A 			: REAL;  // Actual Current
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>