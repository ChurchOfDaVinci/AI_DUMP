<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_CanId" Id="{dc3f1a5f-0e8b-48ed-a6e2-a2423d8e16f2}">
    <Declaration><![CDATA[TYPE ST_CanId :
STRUCT
    ExtendedBit : BOOL;   // Bit31 (should always be TRUE)
    ErrorCode   : BYTE;   // Bits 28..26
    DeviceNo    : BYTE;   // Bits 25..22
    CommandNo   : BYTE;   // Bits 21..16
    TargetAddr  : BYTE;   // Bits 15..8
    SourceAddr  : BYTE;   // Bits 7..0
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>