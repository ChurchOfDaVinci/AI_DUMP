<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_SystemDiagnostic" Id="{cd0829c7-2e1e-431a-acf3-64327b35c5fa}">
    <Declaration><![CDATA[TYPE ST_SystemDiagnostic :
STRUCT

    (* ===== GLOBAL STATUS ===== *)
    bAnyError          : BOOL;
    bAnyWarning        : BOOL;

    (* ===== ERRORS (CRITICAL) ===== *)
    bError_OutputOV    : BOOL;
    bError_OverTemp    : BOOL;
    bError_ShortCircuit: BOOL;
    bError_ModuleError : BOOL;
    bError_CommLost    : BOOL;
    bError_PhaseLost   : BOOL;

    (* ===== WARNINGS ===== *)
    bWarn_InputOV      : BOOL;
    bWarn_InputUV      : BOOL;
    bWarn_FanError     : BOOL;
    bWarn_PowerLimit   : BOOL;
    bWarn_TempHigh     : BOOL;
    bWarn_CurrentLimit : BOOL;

    (* ===== SYSTEM INFO ===== *)
    bAllModulesOff     : BOOL;
    bAllModulesOn      : BOOL;

END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>