    <Method Name="EMSTOP" Id="{0a1cf74e-7bbd-4307-817d-bceb907cdafe}">
      <Declaration><![CDATA[METHOD EMSTOP : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[by_PSPowerRequest := 0;
get.CoolingSystemMode := eCoolingSystemState.EMSTOP;

IPSRequest.b_Demand_400V := FALSE;
IPSRequest.b_Demand_24V := FALSE;

//Disable all


EMSTOP := Heatpumps.EMStop() AND IO.Idle(true);]]></ST>
      </Implementation>
    </Method>
    <Method Name="EnclosureConditioning" Id="{59c2bfb9-6271-45b8-841d-e9d39ac9c572}">
      <Declaration><![CDATA[METHOD EnclosureConditioning : BOOL
VAR_INPUT
	b_CheckOnly	:	Bool;
END_VAR

VAR_INST
	b_CoolingRequired	:	BOOL;
	b_HeatingRequired	:	BOOL;	
	ManualForce			:	BOOL;
	Ton_ConditioningTimeout	:	Ton	:= (PT := T#30M);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stControlData.r_EnclosureTemperature > st_params.r_EnclosureIdleTempMax THEN
	b_CoolingRequired := TRUE;
	b_HeatingRequired := FALSE;
ELSIF b_CoolingRequired AND stControlData.r_EnclosureTemperature < MAX(st_params.r_EnclosureIdleTempMax-5, stControlData.r_CoolantTemperature+1) THEN
	b_CoolingRequired := FALSE;
END_IF

IF stControlData.r_EnclosureTemperature < MAX(st_params.r_EnclosureIdleTempMin, stControlData.r_CurrentEnclosureDewPoint) THEN
	b_HeatingRequired := TRUE;
	b_CoolingRequired := FALSE;
ELSIF b_HeatingRequired AND stControlData.r_EnclosureTemperature > MAX(st_params.r_EnclosureIdleTempMin, stControlData.r_CurrentEnclosureDewPoint)+5 THEN
	b_HeatingRequired := FALSE;
END_IF

//limit enclosureconditioning to 30m, then reconsider entry triggers.
Ton_ConditioningTimeout(in := b_CoolingRequired OR b_HeatingRequired);
IF Ton_ConditioningTimeout.q THEN
	b_CoolingRequired := FALSE;
	b_HeatingRequired := FALSE;
END_IF

EnclosureConditioning := b_CoolingRequired OR b_HeatingRequired;

IF NOT b_CheckOnly THEN
	stControlData.b_DCFancoilEnable := EnclosureConditioning;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ForceHeatpumpMode" Id="{f13a8885-36a7-4174-9f19-5472039184be}">
      <Declaration><![CDATA[METHOD ForceHeatpumpMode : BOOL

VAR_INST
	ftrigRelease		: F_TRIG;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//force values for commisioning
IF st_params.b_ActivateCooling THEN
	stControlData.e_HeatpumpMode := eHeatpumpMode.Cooling;
	st_params.b_ActivateHeating := FALSE;
END_IF

//force values for commisioning
IF st_params.b_ActivateHeating THEN
	stControlData.e_HeatpumpMode := eHeatpumpMode.Heating;
	st_params.b_ActivateCooling := FALSE;
END_IF

ftrigRelease(CLK := st_params.b_ActivateHeating OR st_params.b_ActivateHeating);
IF ftrigRelease.Q THEN
	stControlData.e_HeatpumpMode := eHeatpumpMode.Standby;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Action Name="FullCooling_active" Id="{ffd4300a-4efe-4d1e-8b8a-2c3730ecbf7b}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[CASE get.CoolingSystemMode OF
 	eCoolingSystemState.InverterPowerMode, eCoolingSystemState.InverterConditioning: 
		IF io.FullCooling() THEN
			by_PSPowerRequest := MAX(1, by_PSsetCooling);
			
			IF NOT InverterConditioning(FALSE) THEN
				IF NOT BatteryConditioning(FALSE) AND by_PSsetCooling < 2 THEN
					SFCTrans := TRUE;
		END_IF
		END_IF
		ELSE
			by_PSPowerRequest := 1;
			SFCTrans := TRUE;	//<-- willen we dit wel?
		END_IF	
		
	eCoolingSystemState.BatteryConditioning:
			io.BatteryCooling();
			by_PSPowerRequest := 0;
			IF NOT BatteryConditioning(FALSE) THEN
				SFCTrans := TRUE;
			END_IF

			IF NOT b_400V_Available THEN
				SFCTrans := TRUE;
			END_IF
END_CASE

EnclosureConditioning(FALSE);

SFCTip := SFCTrans AND NOT SFCTip;

]]></ST>
      </Implementation>
    </Action>
    <Method Name="GetDiagnostics" Id="{0f3312c0-95d5-40c2-9540-1c389d23f92f}">
      <Declaration><![CDATA[METHOD GetDiagnostics 
VAR_IN_OUT
	AddError		: ARRAY [*] OF FB_AddErrorST;
	a_ActiveEvents	: ARRAY [*] OF ST_ErrorStruct;
	w_Index			: WORD;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*Battery loop valve stuck*)	AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_BattLoopValveStuck,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 1,
			e_ObjectID				:= e_ID,
			s_Message				:= 'Battery loop valve fault',
			e_sev					:= eSeverity.Warning,	
			b_AutoClear			:= FALSE,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
(*Fancoil loop valve stuck*)	AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_FancoilLoopValveStuck,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 2,
			s_Message				:= 'Fancoil loop valve fault',
			e_sev					:= eSeverity.Warning,	
			b_AutoClear			:= FALSE,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
	
(*Inverter loop valve stuck*)	AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_InverterLoopValveStuck,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 3,
			s_Message				:= 'Inverter loop valve fault',
			e_sev					:= eSeverity.QuickShutdown,	
			b_AutoClear			:= FALSE,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
(*Inverter cooling error*)		AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_InverterCoolingLoopError,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 4,
			s_Message				:= 'Inverter loop failed',
			e_sev					:= eSeverity.QuickShutdown,	
			b_AutoClear			:= FALSE,
			
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
(*Heatpump Warning*)			AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_HeatpumpWarning,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 5,
			s_Message				:= 'Heatpump warning',
			e_sev					:= eSeverity.Warning,	
			b_AutoClear			:= FALSE,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;		
	
(*Heatpump inoperative*)		AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_HeatPumpError ,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 6,
			s_Message				:= 'Heatpump inoperative',
			e_sev					:= eSeverity.Warning,	
			b_AutoClear			:= FALSE,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
(*400V fuse failure*)			AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_CoolingSystemFuseFailure,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 7,
			s_Message				:= '400V fuse fault',
			e_sev					:= eSeverity.QuickShutdown,	
			b_AutoClear			:= FALSE,
			);
		w_Index := w_Index +1;
		
(*Coolant pressure lost*)		AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_CoolingLoopIdlePressureError,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 8,
			s_Message				:= 'pressure fault',
			e_sev					:= eSeverity.NormalShutdown,	
			b_AutoClear			:= FALSE,
			);
		w_Index := w_Index +1;	
	
(*Coolant pressure low*)		AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_CoolingLoopIdlePressureWarning,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 9,
			s_Message				:= 'pressure warning',
			e_sev					:= eSeverity.Warning,	
			b_AutoClear			:= TRUE,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;	
	
(*AC water pump start timeout*)	AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_ACwaterPumpTimeOut,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 10,
			s_Message				:= 'AC waterpump startup timeout',
			e_sev					:= eSeverity.Warning,	
			b_AutoClear			:= TRUE,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
(*Coolant Temp too High*)		AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_CoolantTempTooHigh,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 11,
			s_Message				:= 'Coolant temperature too high',
			e_sev					:= eSeverity.Normalshutdown,	
			b_AutoClear				:= FALSE,
			);
		w_Index := w_Index +1;
		
(*Coolant Temp too Low*)		AddError[w_Index](
			b_ErrorTrig				:= Get.Events.b_CoolantTempTooLow,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 12,
			s_Message				:= 'Coolant temperature too low',
			e_sev					:= eSeverity.Normalshutdown,	
			b_AutoClear				:= FALSE,
			);
		w_Index := w_Index +1;
(*DC pump pressure fault*)		AddError[w_Index](
			b_ErrorTrig				:= Get.Events.b_DCpumpPressureFault,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 13,
			s_Message				:= 'DC pump pressure fault',
			e_sev					:= eSeverity.normalshutdown,	
			b_AutoClear				:= FALSE,
			t_TriggerTime			:= T#5S,
			);
		w_Index := w_Index +1;
		
(*DC pump startup timeout*)		AddError[w_Index](
			b_ErrorTrig				:= Get.Events.b_DCpumpTimeout,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 14,
			s_Message				:= 'DC pump failed to start before timeout, retrying',
			e_sev					:= eSeverity.Warning,	
			b_AutoClear				:= FALSE,
			);
		w_Index := w_Index +1;

		
		
//check if this call works:
Heatpumps.GetDiagnostics(AddError := AddError, a_ActiveEvents := a_ActiveEvents, w_Index := w_Index);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetWearCounters" Id="{a43a522b-46c1-46a5-b522-cca0d524c739}">
      <Declaration><![CDATA[METHOD GetWearCounters : BOOL
VAR_INST

END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IO.GetWearCounters();
Heatpumps.GetWearCounters();]]></ST>
      </Implementation>
    </Method>
    <Method Name="HeatpumpSetpoint" Id="{d56ca302-5bf1-4299-b879-2d24db1e9de9}">
      <Declaration><![CDATA[METHOD HeatpumpSetpoint
VAR_INPUT
	b_dehumActive		: BOOL;
	e_mode				: eHeatPumpMode;
	r_DewpointOffset	: REAL := 2;
	r_loadPercentage	: REAL;
	r_batteryTemp		: REAL;
END_VAR

VAR_IN_OUT
	SetpointOut			: REAL;
END_VAR

VAR_INST 
	r_factor							: REAL := 0.03;
	r_IdleSetpoint						: REAL;			
	r_LoadDependentOffset				: REAL;
	r_setpoint							: REAL;
	r_setpointAVG						: REAL;
	r_setpointSum						: REAL := 18;
	w_SumCounter						: WORD := 1;
	ton_Sumrate							: TON := (PT := T#1S);
	ton_RefreshRate						: TON := (PT := T#1M);
	ton_DewPointOKDelay					: TON := (PT := T#15M);
		
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
//Setpoint
IF NOT b_dehumActive THEN 
	IF e_mode = eHeatpumpMode.Heating THEN
		SetpointOut := 35;
	ELSE
		//Gain of battery temperature offset for temperature setpoint offset.
		r_IdleSetpoint := get.r_EnclosureDewpoint + r_DewpointOffset;
	
		ton_DewPointOKDelay(IN:=  get.r_CoolantTemperature > get.r_EnclosureDewpoint);
		IF ton_DewPointOKDelay.Q THEN
			// relation f(x) := a - 0.04 * x^2, where a = idlesetpoint, x = loadpercentage
			r_LoadDependentOffset := EXPT(r_factor * r_loadpercentage, 2);
		ELSE
			r_LoadDependentOffset := 0;
		END_IF
		
		r_setpoint := LIMIT(5, r_IdleSetpoint - r_LoadDependentOffset, 25);
	END_IF
	
	//Smoothout setpoint
	ton_Sumrate(IN := NOT ton_Sumrate.Q);
	IF ton_Sumrate.Q THEN
		IF w_Sumcounter = 60 THEN
			//increment array index to add new efficiency value until upperbound has been reached.
			r_setpointSum := r_setpointSum - r_setpointAVG + r_setpoint;
		ELSE
			//add new value to the summation
			w_Sumcounter := w_Sumcounter +1;
			r_setpointSum := r_setpointSum + r_setpoint;
		END_IF
		
		//System average efficiency during operation
		r_setpointAVG := r_setpointSum / MAX(1, w_Sumcounter);	
	END_IF
	
	//update setpoint every 1 minute.
	ton_RefreshRate(IN := NOT ton_RefreshRate.Q);
	IF ton_RefreshRate.Q THEN
		SetpointOut := r_setpointAVG;
	END_IF
END_IF


]]></ST>
      </Implementation>
    </Method>
    <Action Name="Init_CoolingSFC" Id="{ae837533-19bb-4390-9872-827488decb8a}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[IF get.CoolingSystemMode = EcoolingsystemState.OFF OR get.CoolingSystemMode = EcoolingsystemState.EMSTOP THEN
	stControldata.e_HeatpumpMode := eHeatpumpMode.Standby;
	IF get.HeatPumpStatus <> Eheatpumpstate.Active_Cooling OR get.HeatPumpStatus <> Eheatpumpstate.Active_Heating THEN
		by_PSPowerRequest := 0;
		IPSRequest.b_Demand_24V := FALSE;
		IPSRequest.b_Demand_400V := FALSE;
	END_IF
	
	IF NOT b_InverterRunning THEN
		IO.Idle(false);
	END_IF
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Method Name="InverterConditioning" Id="{a40c182c-2d83-4e0c-a877-07d9567edd20}">
      <Declaration><![CDATA[METHOD InverterConditioning : BOOL
VAR_INPUT
	b_CheckOnly	: BOOL;	
END_VAR

VAR_INST
	heatpumpActive			: 	BOOL;
	b_CoolingRequired		:	BOOL;
	b_HeatingRequired		:	BOOL;
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF r_InverterTemp > st_params.r_MaxInverterTemperature OR stControlData.r_CoolantTemperature >= st_params.r_CoolantTempCoolingStart THEN
	b_CoolingRequired := TRUE;
	b_HeatingRequired := FALSE;
ELSIF Heatpumps.Get.PrimaryHeatpumpGet.HeatpumpData.r_OutletWaterTemp < Heatpumps.Get.PrimaryHeatpumpGet.Setpoint THEN
	b_CoolingRequired := FALSE;
END_IF

IF stControlData.r_CoolantTemperature <= MAX(st_params.r_CoolantTempHeatingStart, stControlData.r_CurrentEnclosureDewPoint) THEN
	b_HeatingRequired := TRUE;
	b_CoolingRequired := FALSE;
ELSIF b_HeatingRequired AND stControlData.r_CoolantTemperature > MAX(20, stControlData.r_CurrentEnclosureDewPoint+5) THEN
	b_HeatingRequired := FALSE;
END_IF
				
IF NOT b_CheckOnly THEN
	IF b_HeatingRequired THEN
		Heatpumps.WriteSetpoint(OperatingMode := eHeatPumpMode.Heating, Setpoint := MAX(25, stControlData.r_CurrentEnclosureDewPoint+10));
	ELSIF b_CoolingRequired THEN
		Heatpumps.WriteSetpoint(OperatingMode := eHeatPumpMode.Cooling, Setpoint := MAX(15.0, stControlData.r_CurrentEnclosureDewPoint));
	END_IF
END_IF

InverterConditioning := b_HeatingRequired OR b_CoolingRequired;	//returns true if conditioning still required


]]></ST>
      </Implementation>
    </Method>
    <Action Name="LimitedCooling_active" Id="{c9aa11cd-abcc-4c14-b46a-142d396d076a}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[//CASE get.CoolingSystemMode OF
// 	eCoolingSystemState.InverterPowerMode: SFCTrans := stConditioningRequirements.by_SetCooling = 2;
//	ELSE
//		SFCTrans := TRUE;
//END_CASE

//SFCtip := SFCtrans AND b_400V_available AND NOT SFCtip;



CASE get.CoolingSystemMode OF
 	eCoolingSystemState.InverterPowerMode: 	
		IPSRequest.b_Demand_400V := TRUE;
		by_PSPowerRequest := 1;
		SFCTrans := b_400V_available;
	
	eCoolingSystemState.InverterConditioning:
		by_PSPowerRequest := 1;
		IPSRequest.b_Demand_400V := BatteryConditioning(TRUE);
		SFCTrans := b_400V_available AND IPSRequest.b_Demand_400V;
	
	eCoolingSystemState.BatteryConditioning:
		IPSRequest.b_Demand_400V := TRUE;
		SFCTrans := b_400V_available;
	
	eCoolingSystemState.EnclosureConditioning:	
		SFCTrans := FALSE;	//stay here for enclosure conditioning
	
	eCoolingSystemState.OFF:					
		SFCReset := TRUE;	//return to init
	
END_CASE

SFCtip := SFCtrans AND NOT SFCtip;]]></ST>
      </Implementation>
    </Action>
    <Action Name="RequestPower_active" Id="{40817a66-8d57-4a9c-a764-5866d2d7519e}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[IPSRequest.b_Demand_24V := TRUE;
]]></ST>
      </Implementation>
    </Action>
    <Method Name="Reset" Id="{666f681c-4cc6-4403-8d16-3eb3d9da41f9}">
      <Declaration><![CDATA[METHOD Reset : BOOL
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Set in SFC, but will not self clear. Reset at this point. It will fail again when restarting
//No way of testing it prior to that point


Get.Events.b_BattLoopValveStuck := FALSE;
Get.Events.b_CoolingLoopIdlePressureError := FALSE;
Get.Events.b_InverterCoolingLoopError := FALSE;
Get.Events.b_CoolingSystemFuseFailure := FALSE;
Get.Events.b_FancoilLoopValveStuck := FALSE;
Get.Events.b_HeatPumpError := FALSE;
Get.Events.b_InverterLoopValveStuck := FALSE;
get.Events.b_CoolantTempTooLow := FALSE;
get.Events.b_CoolantTempTooHigh := FALSE;
get.Events.b_DCpumpPressureFault := FALSE;

									
IF get.CoolingSystemMode = eCoolingSystemState.EMSTOP THEN
	get.CoolingSystemMode := eCoolingSystemState.OFF;
END_IF
	
Heatpumps.Reset();

Reset := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetConditioningMode" Id="{ff2a88bc-df5f-43b8-bbed-0b785414a837}">
      <Declaration><![CDATA[METHOD SetConditioningMode : BOOL
VAR_INPUT
END_VAR

VAR_INST
	RTrigPowerModeReq	: r_trig;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF get.CoolingSystemMode <> eCoolingSystemState.EMSTOP THEN
	IF b_coolingSystemEnable THEN
	
		IF by_PSsetCooling > 1 THEN// OR b_InverterRunning THEN
			get.CoolingSystemMode := eCoolingSystemState.InverterPowerMode;
		ELSIF by_PSsetCooling > 0 or b_InverterRunning THEN//BatteryConditioning(b_CheckOnly := TRUE) AND by_PSPowerRequest = 1 THEN
			get.CoolingSystemMode := eCoolingSystemState.InverterConditioning;
		ELSIF BatteryConditioning(b_CheckOnly := TRUE) AND (b_ConditioningOnBatteryAllowed OR b_400v_Available) THEN
			get.CoolingSystemMode := eCoolingSystemState.BatteryConditioning;
		//Determine which SFC should be active, halt all others.
		ELSIF EnclosureConditioning(b_CheckOnly := TRUE) AND (b_ConditioningOnBatteryAllowed OR b_400v_Available) THEN
			get.CoolingSystemMode := eCoolingSystemState.EnclosureConditioning;
		
		ELSE
			get.CoolingSystemMode := eCoolingSystemState.OFF;
		END_IF
	ELSE
		get.CoolingSystemMode := eCoolingSystemState.OFF;
	END_IF
end_if
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetEvents" Id="{4b0c7908-f733-4a81-8514-170222955399}">
      <Declaration><![CDATA[METHOD SetEvents : BOOL
VAR_INPUT
END_VAR

VAR
	r_hysteresis : REAL := 2;
END_VAR


]]></Declaration>
      <Implementation>
        <ST><![CDATA[//TOO low --> normalshutdown
IF get.r_CoolantTemperature <= st_params.r_MinCoolantTemperature AND NOT get.CoolingSystemMode = eCoolingSystemState.DeHum THEN
	get.Events.b_CoolantTempTooLow := TRUE;
ELSIF get.r_CoolantTemperature > st_params.r_MinCoolantTemperature + r_hysteresis THEN
	get.Events.b_CoolantTempTooLow := FALSE;
END_IF

//Low --> powermode to 1.
IF get.r_CoolantTemperature <= st_params.r_CoolantTempHeatingStart THEN
	get.Events.b_CoolantTempLow := TRUE;
ELSIF get.r_CoolantTemperature > st_params.r_CoolantTempHeatingStart + r_hysteresis THEN
	get.Events.b_CoolantTempLow := FALSE;
END_IF

//High --> powermode to 1. 
IF get.r_CoolantTemperature > st_params.r_CoolantTempCoolingStart THEN
	get.Events.b_CoolantTempHigh := TRUE;
ELSIF get.r_CoolantTemperature < st_params.r_CoolantTempCoolingStart - r_hysteresis THEN
	get.Events.b_CoolantTempHigh := FALSE;
END_IF


//TOO high --> normal shutdown
IF get.r_CoolantTemperature >= st_params.r_MaxCoolantTemperature AND NOT get.CoolingSystemMode = eCoolingSystemState.DeHum THEN
	get.Events.b_CoolantTempTooHigh := TRUE;
ELSIF get.r_CoolantTemperature < st_params.r_MaxCoolantTemperature - r_hysteresis THEN
	get.Events.b_CoolantTempTooHigh := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Action Name="SFCTipReset" Id="{48b1bf2d-f365-462b-a89c-ba536b5cd0a2}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[SFCTip := FALSE;
SFCTrans:= FALSE;
]]></ST>
      </Implementation>
    </Action>
    <Method Name="Shutdown" Id="{27650de6-c687-4726-9894-db210aa21421}">
      <Declaration><![CDATA[METHOD Shutdown : BOOL

VAR_INST
	Ton_HPShutdown			:	TON	:=	(PT:=T#1S);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[b_CoolingSystemEnable := FALSE;
Heatpumps.Shutdown();
by_PSPowerRequest := 0;
Ton_HPShutdown(in:= get.HeatPumpStatus <> eHeatpumpstate.Active_Cooling AND get.HeatPumpStatus <> eHeatpumpstate.Active_Heating);

//shutdown delay to allow for compressor shutdown
Shutdown := Ton_HPShutdown.Q AND get.CoolingSystemMode = eCoolingsystemstate.OFF;



]]></ST>
      </Implementation>
    </Method>
    <Method Name="Start" Id="{e6b09d2b-38f3-4a54-ba01-546214766934}">
      <Declaration><![CDATA[METHOD Start : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[b_CoolingSystemEnable := TRUE;
Heatpumps.Start();
Start := true;
]]></ST>
      </Implementation>
    </Method>
    <Action Name="StartFullCooling_active" Id="{1553d603-29b3-46d2-b268-9b8e040130d7}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[//SFCtip := io.FullCooling() and b_400V_available;


CASE get.CoolingSystemMode OF
 	eCoolingSystemState.InverterPowerMode, eCoolingSystemState.InverterConditioning:
 		SFCtrans := io.FullCooling();
	
	eCoolingSystemState.BatteryConditioning:	SFCTrans := io.BatteryCooling();

	eCoolingSystemState.OFF:					SFCReset := TRUE;
	
END_CASE

SFCtip := SFCtrans AND NOT SFCtip;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="StartLimitedCooling_active" Id="{dcfc7593-d8be-4f18-98a8-bee106a4a9ed}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[//SFCtip := io.LimitedCooling();


CASE get.CoolingSystemMode OF
 	eCoolingSystemState.InverterPowerMode, eCoolingSystemState.InverterConditioning: 		
		IF io.LimitedCooling() THEN
			IF by_PSsetCooling = 0 THEN
				 by_PSPowerRequest := 0;
				 IPSRequest.b_Demand_400V := FALSE;
			ELSE
				SFCTrans := TRUE;
			END_IF	
		END_IF
		
	eCoolingSystemState.BatteryConditioning:	SFCTrans := TRUE;
	eCoolingSystemState.EnclosureConditioning:	SFCTrans := io.EnclosureCooling();
	eCoolingSystemState.OFF:					SFCReset := TRUE;
END_CASE

SFCtip := SFCtrans AND NOT SFCtip;

]]></ST>
      </Implementation>
    </Action>
