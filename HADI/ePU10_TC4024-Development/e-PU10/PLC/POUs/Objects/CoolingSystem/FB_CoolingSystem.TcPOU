<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_CoolingSystem" Id="{f632dad5-0ddb-4b03-b8d0-21b7b8da0602}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_CoolingSystem
VAR_IN_OUT
	st_params					: ST_Coolingsystem_params;
END_VAR

VAR
	stControlData				:	ST_CoolingSystem_Control;
	stConditioningRequirements	:	ST_ConditioningRequirements;
	Heatpumps					:	FB_HeatPumpSystem;
	IO							:	FB_CoolingSystem_IO;

	alpha						: 	REAL;
	b_CoolingSystemEnable		:	BOOL;
END_VAR;

VAR CONSTANT
	e_ID		: eObject_ID := eObject_ID.Cooling;
END_VAR

VAR_OUTPUT
	Get							: ST_CoolingSystem_Get;		//Various cooling sytem data for logging
	IPSRequest 					: ST_InternalPowerSupply_PowerDemand;//to FB_IPS, power requirements for cooling system
	by_PSPowerRequest				: BYTE; //Allowed operating mode for inverter. 0: no modulating allowed, 1: modulating allowed, no power delivery, 2:inverter power delivery allowed.
	b_FanPowerstackEnable			: BOOL;
END_VAR

VAR_INPUT
	b_DehumStart			: BOOL;
	//From Powerstack Inverter cooling request
	by_PSsetCooling			:	BYTE;	//Inverter request cooling. 0=none, 1=startup only, 2=power delivery mode
	b_InverterRunning		: 	BOOL;	//True if inverter is modulating, used as determine when pumps may shutdown
	r_InverterLoad			:	REAL;
	r_InverterTemp			:	Real;
		//Internal power supply status
	b_24v_Available			:	BOOL;	//from FB_ips, 24V online
	b_400v_Available 		:	BOOL;	//from FB_ips, 400vac online
	e_400vSupplySource		:	e400vSupplySource;
	//From BMS
	r_BMSAverageBattTemp	:	REAL;	//from FB_BMS, average battery temperature
	r_BMSMaxBattTemp		:	REAL;	//from FB_BMS, max battery temperature (may not be needed)
	//From Enclosure
	r_EnclosureHumidity		:	REAL;	//from FB_enclosure
	r_EnclosureTemperature	:	REAL;	//from FB_enclosure
	b_ConditioningOnBatteryAllowed : BOOL; //when set to false. The SOC is too low to allow for internal conditioning. Only inverter operation allowed.
	
END_VAR

VAR
	SFCTrans : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//Exchange external data into datastruct (for simpler passing around within the cooling system)

stConditioningRequirements.Dehum 			:= 	b_DehumStart;
//stControldata.b_fanPowerstackEnable			:= 	b_FanPowerstackEnable;
stControlData.b_InverterRunning				:=	b_InverterRunning;
stControlData.r_BMSBatteryTemperature 		:= 	r_BMSMaxBattTemp;
stControlData.R_BMSMaxBatteryTemperature	:=	r_BMSMaxBattTemp;
stControlData.r_EnclosureHumidity			:=	r_EnclosureHumidity;
stControlData.r_EnclosureTemperature		:=	r_EnclosureTemperature;
stControlData.b_24V_Available				:=	b_24V_Available;
stControlData.b_400v_Available				:=	b_400V_Available;
stControlData.e_400vSupplySource			:=	e_400vSupplySource;
stControlData.r_CurrentEnclosureDewPoint	:= 	CalculateDewpoint(humid := r_EnclosureHumidity, temp:=r_EnclosureTemperature);

//fill get struct
get.r_CoolantTemperature				:= stControlData.r_CoolantTemperature;
get.r_CoolantPressure					:= stControlData.r_CoolantPressure;
get.r_EnclosureDewpoint					:= stControlData.r_CurrentEnclosureDewPoint;

	
////Call local IO functionblock	
IO(b_24VDCavailable := b_24v_Available,
	b_400VAvailable := b_400V_Available, 
	b_inverterRunning := b_InverterRunning,
	r_CoolantPressure => stControlData.r_CoolantPressure,
	r_CoolantIdlePressure => stcontroldata.r_CoolantIdlePressure,
	r_CoolantTemperature => stControlData.r_CoolantTemperature,
	st_params := st_params, 
 	Events := get.Events);

////Call standby climate monitors for Battery and enclosure 
//Determine which SFC to start, based on current status and priority. 
CoolingSFC();
SetConditioningMode();


//for commissioning only. Accessed from parameters.
ForceHeatpumpMode();

//Call Heatpump FB
HeatPumps(st_params := st_params, b_EnablePower := b_400v_Available, r_CoolantTemperature := stControlData.r_CoolantTemperature);//(stControlData.b_HeatPumpPowerEnable AND b_400v_Available));
get.HeatPumpSystem REF= Heatpumps.Get;
get.HeatPumpStatus := get.HeatPumpSystem.HeatPumpStatus;

setevents();



]]></ST>
    </Implementation>
    <Folder Name="SFC" Id="{87470b12-0e37-4e5e-afc6-004df3913932}" />
    <Transition Name="ActivateCoolingSystem" Id="{9be98dea-9712-435a-bd93-36568c1c9caf}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[(get.CoolingSystemMode <> 0 AND get.CoolingSystemMode <> 10) AND NOT SFCError
]]></ST>
      </Implementation>
    </Transition>
    <Method Name="BatteryConditioning" Id="{1e09975c-19e6-4b86-82b1-b4c1a4e236c6}">
      <Declaration><![CDATA[METHOD BatteryConditioning : BOOL;
VAR_INPUT
	b_CheckOnly	: BOOL;	
END_VAR

VAR_INST
	b_CoolingRequired		:	BOOL;
	b_HeatingRequired		:	BOOL;
	heatpumpActive			: BOOL;
	b_HeatingCondition 		: BOOL;
	b_CoolingCondition		: BOOL;
	ton_HysteresisTimout	: TON := (PT:= T#1H);
	ton_heatingModeDelay	: TON := (PT := T#1M);	//1 minute delay before heating, to compensate for temperature data init time
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ton_heatingModeDelay(in := (stControlData.r_BMSBatteryTemperature < MAX(st_params.r_BatteryTempMin, stControlData.r_CurrentEnclosureDewPoint)) AND (stControlData.r_BMSBatteryTemperature > -50));
b_HeatingCondition := ton_heatingModeDelay.Q;

b_CoolingCondition := stControlData.r_BMSBatteryTemperature > st_params.r_BatteryTempMax;
ton_HysteresisTimout(IN := b_HeatingCondition OR b_CoolingCondition);

IF b_CoolingCondition OR st_params.b_ActivateCooling THEN
	b_CoolingRequired := TRUE;
	b_HeatingRequired := FALSE;
ELSIF stControlData.r_BMSBatteryTemperature < MAX(st_params.r_BatteryTempMax - ST_Params.r_BatteryTempHysteresis, stControlData.r_CurrentEnclosureDewPoint + 2) OR ton_HysteresisTimout.Q THEN
	b_CoolingRequired := FALSE;		
END_IF

IF b_HeatingCondition  OR st_params.b_ActivateHeating THEN
	b_CoolingRequired := FALSE;
	b_HeatingRequired := TRUE;
ELSIF stControlData.r_BMSBatteryTemperature >  MAX(st_params.r_BatteryTempMin, stControlData.r_CurrentEnclosureDewPoint) + ST_Params.r_BatteryTempHysteresis OR ton_HysteresisTimout.Q THEN
	b_HeatingRequired := FALSE;		
END_IF
// TEMPORARY SOLUTION
	
IF NOT b_CheckOnly THEN
	IF b_HeatingRequired THEN
		Heatpumps.WriteSetpoint(OperatingMode := eHeatPumpMode.Heating, Setpoint := MAX(25, stControlData.r_CurrentEnclosureDewPoint+10));
	ELSIF b_CoolingRequired THEN
		Heatpumps.WriteSetpoint(OperatingMode := eHeatPumpMode.Cooling, Setpoint := MAX(15.0, stControlData.r_CurrentEnclosureDewPoint));
	ELSE
		Heatpumps.WriteSetpoint(OperatingMode := eHeatPumpMode.Standby, Setpoint := 18.0);
END_IF
END_IF


BatteryConditioning := b_CoolingRequired OR b_HeatingRequired;	//returns true if conditioning still required
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CalculateDewpoint" Id="{19acc56e-f77c-4002-97d0-a50bd4d70499}">
      <Declaration><![CDATA[METHOD CalculateDewpoint : REAL;
VAR_INPUT
	humid : REAL;
	Temp : REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[alpha := LN(MAX(Humid,0.01)/100)+(17.625*temp/(243.12+temp));
CalculateDewpoint := 243.12*alpha/(17.625-alpha);]]></ST>
      </Implementation>
    </Method>
    <Action Name="ContinuousActions" Id="{b22234e4-5959-413f-9265-976d8b0b077c}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[SFCreset := get.CoolingSystemMode = EcoolingSystemstate.OFF OR get.CoolingSystemMode = EcoolingSystemstate.EMSTOP;

]]></ST>
      </Implementation>
    </Action>
