    <Action Name="aReadCoils" Id="{17d5d889-5dc6-4c18-9f7b-e3770639388a}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[bMBActive := TRUE;

MBMaster.ReadCoils(	UnitID 		:= 	HeatPumpID,
					Quantity 	:= 	5,
					MBAddr		:=	0,				
					cbLength 	:= 	6,
					pMemoryAddr	:=	ADR(CoilStatus),
					Execute		:=	ftrig_ModbusStartTrigger.Q,
				);
	

IF TransmissionDoneTrigger.q THEN
	IF NOT MBMaster.Error THEN
		//Full datastruct for debug purposes. Can be removed later
		LGget.Coils.b_EnableOperation := CoilStatus.0;
		LGget.Coils.b_EnableSwwOperation := CoilStatus.1;
		LGget.Coils.b_EnableSilentMode := CoilStatus.2;
		LGget.Coils.b_EnableDesinfectionMode := Coilstatus.3;
		LGget.Coils.b_EmstopActive := CoilStatus.4;
		LGget.Coils.b_EnableEmStop := CoilStatus.5;
		//Full datastruct for debug purposes. Can be removed later
		
	ELSE
		MBRetryCount := MBRetryCount + 1;
	END_IF
	
	sfctip := TRUE;
END_IF


get.HeatpumpData.w_ErrorList[1] := lgget.Data.UI_ErrorCode;
get.Setpoint := lgget.Control.r_Setpoint1;]]></ST>
      </Implementation>
    </Action>
    <Action Name="aReadDiscreteInputs" Id="{b03b78a7-7ef3-49a6-9b40-f138c46410b4}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[

MBMaster.ReadInputStatus(	UnitID 		:= 	HeatPumpID,
							Quantity 	:= 	16,
							MBAddr		:=	0,
							cbLength 	:= 	SIZEOF(Databuffer),
							pMemoryAddr	:=	ADR(DataBuffer),
							Execute		:=	ftrig_ModbusStartTrigger.Q,
						);



IF TransmissionDoneTrigger.q THEN
	IF NOT MBMaster.Error THEN
		//Full datastruct for debug purposes. Can be removed later
		LGget.Status.b_WaterFlowNOK := DataBuffer[0].0;
		LGget.Status.b_WaterPumpOn := DataBuffer[0].1;
		LGget.Status.b_ExtWaterPumpOn := DataBuffer[0].2;
		LGget.Status.b_CompressorOn := DataBuffer[0].3;
		LGget.Status.b_DefrostOn := DataBuffer[0].4;
		LGget.Status.b_SWWModeOn := DataBuffer[0].5;
		LGget.Status.b_SWWTankDesinfectionActive := DataBuffer[0].6;
		LGget.Status.b_SilentModeOn := DataBuffer[0].7;
		LGget.Status.b_CoolingActive := DataBuffer[0].8;
		LGget.Status.b_SolarPumpActive := DataBuffer[0].9;
		LGget.Status.b_BackupHeater1Active := DataBuffer[0].10;
		LGget.Status.b_BackupHeater2Active := DataBuffer[0].11;
		LGget.Status.b_SWWBoostHeaterActive := DataBuffer[0].12;
		LGget.Status.b_ErrorActive := DataBuffer[0].13;
		LGget.Status.b_EMOperationAvailable := DataBuffer[0].14;
		LGget.Status.b_EMSWWOperationAvailable := DataBuffer[0].15;
		LGget.Status.b_MixPumpActive := DataBuffer[1].0;
		//Full datastruct for debug purposes. Can be removed later
		
		get.Events.b_PumpError := DataBuffer[0].0;
		get.HeatpumpData.b_DefrostingActive := DataBuffer[0].4;
		
		
		//error active and no em operation allowed
		IF DataBuffer[0].13 THEN
			get.HeatPumpState := eHeatpumpstate.ERROR;
			IF NOT DataBuffer[0].14 THEN
				HeatpumpEMOperationAvailable := FALSE;
			ELSE
				HeatpumpEMOperationAvailable := TRUE;
			END_IF
		ELSIF get.HeatPumpState = eHeatpumpstate.ERROR THEN
			get.HeatPumpState := eHeatpumpstate.Initializing;
			HeatpumpEMOperationAvailable := FALSE;
		END_IF
		
		//done, preset for next step
		MBRetryCount := 0;
	ELSE
		MBRetryCount := MBRetryCount + 1;
	END_IF
	sfctip := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="aReadHolding" Id="{703128ea-fd61-4142-a532-854700cedc29}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[
MBMaster.ReadRegs(	UnitID 		:= 	HeatPumpID,
					Quantity 	:= 	10,
					MBAddr		:=	0,
					cbLength 	:= 	SIZEOF(Databuffer),
					pMemoryAddr	:=	ADR(DataBuffer),
					Execute		:=	ftrig_ModbusStartTrigger.Q,
					);


IF TransmissionDoneTrigger.q THEN
	IF NOT MBMaster.Error THEN
		LGget.Control.ui_OperatingMode := Databuffer[0];
		LGget.Control.ui_ControlMode := Databuffer[1];
		LGget.Control.r_Setpoint1 := (WORD_TO_REAL(Databuffer[2])/10);
		LGget.Control.r_RoomSetpoint := (WORD_TO_REAL(Databuffer[3])/10);
		LGget.Control.ui_TempShiftValue := Databuffer[4];
		LGget.Control.r_Setpoint2 := (WORD_TO_REAL(Databuffer[5])/10);
		LGget.Control.r_RoomSetpoint2 := (WORD_TO_REAL(Databuffer[6])/10);
		LGget.Control.ui_TempShiftValue2 := Databuffer[7];
		LGget.Control.r_DHWgoalTemp := (WORD_TO_REAL(Databuffer[8])/10);
		LGget.Control.ui_EnergyStatus := Databuffer[9];
		
		get.Setpoint := (WORD_TO_REAL(Databuffer[2])/10);


		IF get.HeatPumpState <> eHeatpumpstate.ERROR THEN
			CASE lgget.Data.ui_OperationalMode OF
				0:
					get.HeatPumpState := eHeatpumpstate.Standby;
				1:
					get.HeatPumpState := eHeatpumpstate.Active_Cooling;
				2:
					get.HeatPumpState := eHeatpumpstate.Active_Heating;
			END_CASE
		END_IF
	
		//done, preset for next step
		MBRetryCount := 0;

	ELSE
		MBRetryCount := MBRetryCount + 1;
		
	END_IF
	sfctip := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="aReadInputRegs" Id="{fbc4850c-089e-43b3-b8e9-931681c8e914}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[//SFCTip := FALSE;

MBMaster.ReadInputRegs ( 
					UnitID 		:= 	HeatPumpID,
					Quantity 	:= 	13,
					MBAddr		:=	0,
					cbLength 	:= 	SIZEOF(Databuffer),
					pMemoryAddr	:=	ADR(Databuffer),
					Execute		:=	ftrig_ModbusStartTrigger.Q,		
					);
				
IF TransmissionDoneTrigger.q THEN
	IF NOT MBMaster.Error THEN
		
	//Full datastruct for debug purposes. Can be removed later
		LGget.Data.UI_ErrorCode := Databuffer[0];	
		LGget.Data.ui_OperationalMode := (Databuffer[1]);	
		LGget.Data.r_CoolantInletTemp := WORD_TO_REAL((Databuffer[2]))/10;	
		LGget.Data.r_CoolantOutletTemp := WORD_TO_REAL((Databuffer[3]))/10;
		LGget.Data.r_BackupHeaterTemp := WORD_TO_REAL((Databuffer[4]))/10;
		LGget.Data.r_SWWTankTemp :=  WORD_TO_REAL((Databuffer[5]))/10;
		LGget.Data.r_SolarCollectorTemp := WORD_TO_REAL((Databuffer[6]))/10;
		LGget.Data.r_RoomTemp1 := WORD_TO_REAL((Databuffer[7]))/10;
		LGget.Data.r_FlowRate := WORD_TO_REAL((Databuffer[8]))/10;
		LGget.Data.r_FlowTempCircuit2 := WORD_TO_REAL((Databuffer[9]))/10;
		LGget.Data.r_RoomTemp2 := WORD_TO_REAL((Databuffer[10]))/10;
		LGget.Data.UI_EnergyStatus := (Databuffer[11]);
		LGget.Data.r_OutsideTemp := WORD_TO_REAL((Databuffer[12]))/10;
	//full datastruct for debug purposes. can be removed later	
		
		
		get.HeatpumpData.w_ErrorList[1] := Databuffer[0];
		Get.HeatpumpData.r_InletWaterTemp := WORD_TO_REAL((Databuffer[2]))/10;	
		get.HeatpumpData.r_OutletWaterTemp := WORD_TO_REAL((Databuffer[3]))/10;
		get.HeatpumpData.r_OutdoorTemp := WORD_TO_REAL((Databuffer[12]))/10;
		get.HeatpumpData.ui_WaterFlowRate := TO_UINT(Databuffer[8]/10);
	ELSE
		MBRetryCount := MBRetryCount + 1;
	END_IF
	sfctip := TRUE;
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="aUpdateDone" Id="{a76d3193-ed30-4543-9e89-78c90c05a4f9}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[SFCTip := FALSE;
bMBActive := FALSE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="aWaitforCommfree" Id="{f6c1c3e9-abfd-42a0-8163-eb1d8155f68a}" FolderPath="SFC\">
