    <Method Name="AllowMBComm" Id="{523c4199-41fb-47fd-a8e6-46416c0d753d}">
      <Declaration><![CDATA[METHOD AllowMBComm : BOOL
VAR_INPUT
	b_AllowComm	:	Bool;
