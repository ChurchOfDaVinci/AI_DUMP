    <Folder Name="Private methods" Id="{8b534f85-da30-44ae-bc4f-b938f8394d8a}" />
    <Folder Name="SFC" Id="{9fba5e26-6fac-44ab-9160-e0ce21829df4}" />
    <Action Name="aClearErrors" Id="{0f2764e1-542c-48f7-bf03-5553478b868e}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[IF b_resetErrors THEN
	
	Databuffer[0]	:= 0;
	
	MBMaster.WriteSingleRegister(
						UnitID 		:= 	HeatPumpID,
						MBAddr		:=	950,
						Quantity 	:= 	1,
						cbLength 	:= SIZEOF(Databuffer),
						pMemoryAddr	:=	ADR(Databuffer[0]),
						Execute		:=	ftrig_ModbusStartTrigger.Q,		
						);
						
	IF TransmissionDoneTrigger.q THEN
		IF NOT MBMaster.Error THEN
			b_resetErrors := FALSE;
		END_IF
		SFCTip := NOT SFCTip;
	END_IF

ELSE
	SFCTip := NOT SFCTip;
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="aGetFWInfo" Id="{d0c91b1a-c387-42d6-8ffb-ce3d029ccfc7}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[bMBActive := TRUE;

IF get.HeatPumpState = eHeatpumpState.Initializing THEN
	MBMaster.ReadRegs(	UnitID 		:= 	HeatPumpID,
						Quantity 	:= 	4,
						MBAddr		:=	1,
						cbLength 	:= 	SIZEOF(DataBuffer), //64
						pMemoryAddr	:=	ADR(DataBuffer),
						Execute		:=	ftrig_ModbusStartTrigger.Q,

						);
	

	IF TransmissionDoneTrigger.q THEN
		IF NOT MBMaster.Error AND MBmaster.cbRead = 8 THEN
			get.HeatpumpData.i_FW_Version 		:= 	WORD_TO_INT(DataBuffer[0]);
			get.HeatpumpData.i_FW_release 		:= 	WORD_TO_INT(DataBuffer[1]);
			get.HeatpumpData.w_FW_Subrelease 	:= 	DataBuffer[2];
			get.HeatpumpData.w_FW_creationDate	:=	DataBuffer[3];
			MBRetryCount := 0;	
			sfctip := TRUE;
		ELSE
			MBRetryCount := MBRetryCount + 1;

		END_IF
	END_IF
ELSE
	sfctip := NOT sfctip;
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="aGetOperatingHours" Id="{d64c13c6-c2ed-406a-9ab3-0504d6f4a530}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[

MBMaster.ReadRegs(	UnitID 		:= 	HeatPumpID,
					Quantity 	:= 	1,
					MBAddr		:=	305,
					cbLength 	:= 	SIZEOF(Databuffer),
					pMemoryAddr	:=	ADR(DataBuffer),
					Execute		:=	ftrig_ModbusStartTrigger.Q,
					);



IF TransmissionDoneTrigger.q THEN
	IF NOT MBMaster.Error THEN
		//transmission done, process data
		
		//just use comp 1 for now. See if the others are even used
		//i think it will be a dual word value. But check later
		get.HeatpumpData.i_OperatingHours := WORD_TO_INT(DataBuffer[0]);
		
		//done, preset for next step
		MBRetryCount := 0;
	ELSE
		MBRetryCount := MBRetryCount + 1;
	END_IF
	sfctip := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="agetSerialNumber" Id="{e0681782-53fe-4b4c-a16d-21511d706c8f}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[
IF get.HeatPumpState = eHeatpumpState.Initializing THEN
	MBMaster.ReadRegs(	UnitID 		:= 	HeatPumpID,
						Quantity 	:= 	18,
						MBAddr		:=	80,
						cbLength 	:= 	SIZEOF(Databuffer),//32*2,
						pMemoryAddr	:=	ADR(DataBuffer),
						Execute		:=	ftrig_ModbusStartTrigger.Q,	
						);
	
	IF TransmissionDoneTrigger.q THEN
		IF NOT MBMaster.Error THEN
			FOR u_counter:=0 TO 17 BY 1 DO
				get.HeatpumpData.w_Serialnumber[u_counter]	:= 	DataBuffer[u_counter];
			END_FOR
			MBRetryCount := 0;
		
			sfctip := TRUE;
			get.HeatPumpState := eHeatpumpState.Standby;
		ELSE
			MBRetryCount := MBRetryCount + 1;
			
		END_IF
	END_IF
ELSE
	sfctip := NOT sfctip;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="AllowMBComm" Id="{75feb672-1846-4378-8d10-36eea50c3e29}">
      <Declaration><![CDATA[METHOD AllowMBComm : BOOL
VAR_INPUT
	b_AllowComm	:	Bool;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MBFree	:= b_AllowComm;
]]></ST>
      </Implementation>
    </Method>
    <Action Name="aReadErrors" Id="{ffc5a8ad-90c9-4c6c-b5e9-4240616ab079}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[
MBMaster.ReadRegs(	UnitID 		:= 	HeatPumpID,
					Quantity 	:= 	7,
					MBAddr		:=	950,
					cbLength 	:= 	SIZEOF(Databuffer),
					pMemoryAddr	:=	ADR(DataBuffer),
					Execute		:=	ftrig_ModbusStartTrigger.Q,
					);

IF TransmissionDoneTrigger.q THEN
	IF NOT MBMaster.Error AND MBMaster.cbRead = 14 THEN
	
			ParseHeatPumpErrors(	w_Alarms1 := DataBuffer[0],
									w_Alarms2 := DataBuffer[1],
									w_Alarms3 := DataBuffer[2],
									w_Alarms4 := DataBuffer[3],
									w_Alarms5 := DataBuffer[4],
									w_Alarms6 := DataBuffer[5],
									w_Alarms7 := DataBuffer[6],
									Get := Get			
								);
			
			//done, preset for next step
			
			MBRetryCount := 0;

	ELSE
		MBRetryCount := MBRetryCount + 1;
				
	END_IF
	sfctip := TRUE;
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="aReadMode" Id="{af76185d-53cb-45eb-98fd-778c8b95fc94}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[
MBMaster.ReadRegs(	UnitID 		:= 	HeatPumpID,
					Quantity 	:= 	1,
					MBAddr		:=	200,
					cbLength 	:= 	SIZEOF(Databuffer),
					pMemoryAddr	:=	ADR(DataBuffer),
					Execute		:=	ftrig_ModbusStartTrigger.Q,
					);


IF TransmissionDoneTrigger.q THEN
	IF NOT MBMaster.Error THEN
	
		//transmission done, process data
		CASE DataBuffer[0] OF
			0:	get.HeatPumpState := eHeatpumpState.Standby;
			1:	get.HeatPumpState := eHeatpumpState.Active_Cooling;
			2:	get.HeatPumpState := eHeatpumpState.Active_Heating;
		END_CASE
		
		//done, preset for next step
		MBRetryCount := 0;

	ELSE
		MBRetryCount := MBRetryCount + 1;
		
	END_IF
	sfctip := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="aReadSetpoint" Id="{4d691f32-97bc-45d3-b606-4df3e459765e}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[
//r_FanSpeedPCT			:	REAL;		//7000
//r_PumpSpeedPCT		:	REAL;		//7001

MBMaster.ReadRegs(	UnitID 		:= 	HeatPumpID,
					Quantity 	:= 	2,
					MBAddr		:=	7203,
					cbLength 	:= 	SIZEOF(Databuffer),
					pMemoryAddr	:=	ADR(DataBuffer),
					Execute		:=	ftrig_ModbusStartTrigger.Q,		
					);

IF TransmissionDoneTrigger.q THEN
	IF NOT MBMaster.Error THEN
	
		//transmission done, process data
		get.HeatpumpData.r_SetpointHeating	:=	DataBuffer[1]/10;
		get.HeatpumpData.r_SetpointCooling	:=	DataBuffer[0]/10;
		//done, preset for next step
		MBRetryCount := 0;
	ELSE
		MBRetryCount := MBRetryCount + 1;
	END_IF
	
	sfctip := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="aReadSpeeds" Id="{34ec7637-39e3-4ac9-9488-25b0aeecf400}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[
//r_FanSpeedPCT			:	REAL;		//7000
//r_PumpSpeedPCT		:	REAL;		//7001

MBMaster.ReadRegs(	UnitID 		:= 	HeatPumpID,
					Quantity 	:= 	2,
					MBAddr		:=	7000,
					cbLength 	:= 	SIZEOF(Databuffer),
					pMemoryAddr	:=	ADR(DataBuffer),
					Execute		:=	ftrig_ModbusStartTrigger.Q,		
					);

IF TransmissionDoneTrigger.q THEN
	IF NOT MBMaster.Error THEN
		
		//transmission done, process data
		get.HeatpumpData.r_FanSpeedPCT		:=	WORD_TO_REAL(DataBuffer[0])/10;
		get.HeatpumpData.r_PumpSpeedPCT		:= 	WORD_TO_REAL(DataBuffer[1])/10;
		
		MBRetryCount := 0;
	ELSE
		MBRetryCount := MBRetryCount + 1;
	END_IF
	sfctip := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="aReadTemps" Id="{9e41bb01-18b5-427e-b053-d065a3847140}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[
(*
r_InletWaterTemp	:	REAL;		//400
r_OutletWaterTemp	:	REAL;		//401
r_HighPressure		:	REAL;		//406
r_LowPressure		:	REAL;		//414
r_CompInputTemp		:	REAL;		//422
r_OutdoorTemp		:	REAL;		//428
r_CompOutputTemp	:	REAL;		//433-435
ui_WaterFlowRate		:	uINT;		//444
*)

MBMaster.ReadRegs(	UnitID 		:= 	HeatPumpID,
					Quantity 	:= 	45,
					MBAddr		:=	400,
					cbLength 	:= 	SIZEOF(Databuffer),
					pMemoryAddr	:=	ADR(DataBuffer),
					Execute		:=	ftrig_ModbusStartTrigger.Q,		
					);


IF TransmissionDoneTrigger.q THEN
	IF NOT MBMaster.Error THEN
		
		//transmission done, process data
		get.HeatpumpData.r_InletWaterTemp		:=	INT_TO_REAL(DataBuffer[0])/10;
		get.HeatpumpData.r_OutletWaterTemp		:= 	INT_TO_REAL(DataBuffer[1])/10;
		get.HeatpumpData.r_HighPressure			:=	INT_TO_REAL(DataBuffer[6])/100;
		get.HeatpumpData.r_LowPressure			:= 	INT_TO_REAL(DataBuffer[14])/100;
		get.HeatpumpData.r_CompInputTemp		:=	INT_TO_REAL(DataBuffer[22])/10;
		get.HeatpumpData.r_OutdoorTemp			:= 	INT_TO_REAL(DataBuffer[28])/10;
		get.HeatpumpData.r_CompOutputTemp		:=	INT_TO_REAL(DataBuffer[33])/10;	//comp dischyarge 1 for now
		get.HeatpumpData.ui_WaterFlowRate			:= 	DataBuffer[44];
		
		MBRetryCount := 0;
	ELSE
		MBRetryCount := MBRetryCount + 1;
	END_IF
	sfctip := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="aUpdateDone" Id="{fccf67b3-e81f-4239-896e-82fb13b55428}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[SFCTip := FALSE;
bMBActive := FALSE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="aWaitforCommfree" Id="{fc9c1698-8717-4473-9080-2ea71bc670e0}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[//SFCTip := FALSE;
//b_EnableTransmission	:= FALSE;
//ModbusStartTrigger(clk := b_EnableTransmission);
]]></ST>
      </Implementation>
    </Action>
    <Action Name="aWriteMode" Id="{f8e43c8e-d626-40e7-a816-06cd84ed4065}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[//SFCTip := FALSE;


//b_EnableTransmission	:= TRUE;
//ModbusStartTrigger(clk := b_EnableTransmission);

Databuffer[0]	:= RequestedSetpoint.OperatingMode;	//set operating mode for write
Databuffer[1]	:= 3;								//enable write registers

MBMaster.WriteRegs ( 
					UnitID 		:= 	HeatPumpID,
					Quantity 	:= 	2,
					MBAddr		:=	7200,
					cbLength 	:= 	SIZEOF(Databuffer),
					pMemoryAddr	:=	ADR(Databuffer),
					Execute		:=	ftrig_ModbusStartTrigger.Q,		
					);
				
IF TransmissionDoneTrigger.q THEN
	IF NOT MBMaster.Error THEN
				
		MBRetryCount := 0;
	ELSE
		MBRetryCount := MBRetryCount + 1;
	END_IF
	sfctip := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="aWriteSetpoint" Id="{91ee0a0c-1f2e-4fcc-9b64-e975ed0477a1}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[
CASE RequestedSetpoint.OperatingMode OF				//Update setpoint depending on mode
	eHeatPumpMode.Cooling:
		Databuffer[0]	:= REAL_TO_WORD(LIMIT(50, ((RequestedSetpoint.Setpoint)*10), 230));
		Databuffer[1]	:= REAL_TO_WORD(Get.HeatpumpData.r_SetpointHeating*10);
	eHeatPumpMode.Heating:
		Databuffer[0]	:= REAL_TO_WORD(Get.HeatpumpData.r_SetpointCooling*10);
		Databuffer[1]	:= REAL_TO_WORD(LIMIT(250, ((RequestedSetpoint.Setpoint)*10), 550));
	eHeatPumpMode.Standby:
		Databuffer[0]	:= REAL_TO_WORD(Get.HeatpumpData.r_SetpointCooling*10);
		Databuffer[1]	:= REAL_TO_WORD(Get.HeatpumpData.r_SetpointHeating*10);	
END_CASE

MBMaster.WriteRegs (
		UnitID 		:= 	HeatPumpID,
		Quantity 	:= 	2,
		MBAddr		:=	7203,
		cbLength 	:= 	SIZEOF(Databuffer),
		pMemoryAddr	:=	ADR(Databuffer),
		Execute		:=	ftrig_ModbusStartTrigger.Q,		
);



IF TransmissionDoneTrigger.q THEN
	IF NOT MBMaster.Error THEN
		//done, preset for next step

		MBRetryCount := 0;;
	ELSE
		MBRetryCount := MBRetryCount + 1;
	END_IF
	sfctip := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="ContinousActions" Id="{fe7e31cf-9fa6-4319-a971-68075f36f201}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[//sfctip := False;
ton_modbusStuckTrigger(in := NOT ton_modbusStuckTrigger.q AND NOT TP_ModbusStartTriggerDelay.q);
TP_ModbusStartTriggerDelay(IN := NOT MBMaster.BUSY AND NOT ton_modbusStuckTrigger.q );
ftrig_ModbusStartTrigger(clk := TP_ModbusStartTriggerDelay.Q);

IF SFCError THEN
	SFCError := FALSE;
	get.Events.b_CommWarning := TRUE;
END_IF

IF NOT ACPowerStatus THEN
	IF get.HeatPumpState <> eHeatpumpstate.OFF THEN
		get.HeatPumpState := eHeatpumpState.OFF;
		SFCReset := TRUE;
	END_IF
END_IF


//safeguard, should the sfc get stuck, heatpumpsystem can revoke MB rights and SFC resets.
//IF NOT MBfree AND bMBActive AND NOT MBMaster.BUSY THEN
//	SFCReset := TRUE;
//END_IF 

IF ACPowerStatus AND get.HeatPumpState = eHeatpumpState.OFF THEN
	get.HeatPumpState := eHeatpumpState.Initializing;
END_IF

HeatpumpPreheatControl();


//reset mb master if stuck in busy
ton_MBBUSYTimeOut(IN := MBmaster.BUSY);
IF ton_MBBUSYTimeOut.Q THEN
	MBMaster.ReadRegs();
	MBMaster.WriteRegs();
	MBMaster.WriteSingleRegister();
END_IF

//Reset heatpump when error occurs, but after a bit of cooldown time.
//Maybe add a functionality to stop trying after x tries to prevent continuous reset cycles
Ton_ErrorTimer(in := get.Events.b_CompressorError OR 
					get.Events.b_FanError OR 
					get.Events.b_PressureError OR 
					get.Events.b_WaterTempError OR 
					get.Events.b_PumpError );
IF Ton_ErrorTimer.Q THEN
	b_resetErrors := TRUE;
END_IF

TransmissionDoneTrigger(clk := MBMaster.Busy);
MBMaster.Timeout		:= st_params.t_ModbusTimeOut;		

get.Events.b_CommWarning := MBRetryCount > st_params.i_modbusRetries;
]]></ST>
      </Implementation>
    </Action>
    <Method Name="EMStop" Id="{0e0744ec-5685-475d-b684-1647784260d4}">
      <Declaration><![CDATA[METHOD EMStop : BOOL

]]></Declaration>
      <Implementation>
        <ST><![CDATA[RequestedSetpoint.OperatingMode := eHeatpumpMode.Standby;
b_Emstop := TRUE;
EMstop := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="getDiagnostics" Id="{26afdf5e-b8bd-4c30-96dd-155d31f238eb}">
      <Declaration><![CDATA[METHOD GetDiagnostics 
VAR_IN_OUT
	AddError		: ARRAY [*] OF FB_AddErrorST;
	a_ActiveEvents	: ARRAY [*] OF ST_ErrorStruct;
	w_Index			: WORD;
END_VAR

VAR_OUTPUT
	b_errorActive	: BOOL;
	b_warningActive	: BOOL;
END_VAR

VAR
	by_errCt	: BYTE;
	by_warnCt	: BYTE;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[	(*Modbus comm fault*)	AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_commwarning,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 30 + ((HeatPumpID-1)*10),
			e_ObjectID				:= e_ID,
			s_Message				:= 'Modbus communication fault',
			e_sev					:= eSeverity.Warning,	
			b_AutoClear			:= TRUE,
			t_TriggerTime		:=	T#60s,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
	(*Heatpump Compressor fault*)	AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_CompressorError,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 31 + ((HeatPumpID-1)*10),
			s_Message				:= concat('Compressor fault', sCompressorErrorText),
			e_sev					:= eSeverity.Warning,	
			b_AutoClear			:= FALSE,
			t_TriggerTime		:=	T#1S,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
	
	
	(*Heatpump Fan fault*)			AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_FanError,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 32 + ((HeatPumpID-1)*10),
			s_Message				:= 'Fan fault',
			e_sev					:= eSeverity.Warning,	
			b_AutoClear			:= FALSE,
			t_TriggerTime		:=	T#1S,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
	(*HHeatpump Internal IO fault*)		AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_IOError ,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 33 + ((HeatPumpID-1)*10),
			s_Message				:= 'internal IO fault',
			e_sev					:= eSeverity.Warning,	
			b_AutoClear			:= FALSE,
			t_TriggerTime		:=	T#1S,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;
		
	(*Heatpump pressure fault*)		AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_PressureError,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 34 + ((HeatPumpID-1)*10),
			s_Message				:= concat('pressure fault', sPressureErrorText),
			e_sev					:= eSeverity.Warning,	
			b_AutoClear			:= FALSE,
			t_TriggerTime		:=	T#1S,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;

	(*Heatpump Probe fault*)		AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_ProbeError,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 35 + ((HeatPumpID-1)*10),
			s_Message				:= 'probe fault',
			e_sev					:= eSeverity.Warning,	
			b_AutoClear			:= FALSE,
			t_TriggerTime		:=	T#1S,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;	

	(*Heatpump Pump fault*)			AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_PumpError,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 36 + ((HeatPumpID-1)*10),
			s_Message				:= concat('pump fault', sPumpErrorText),
			e_sev					:= eSeverity.Warning,	
			b_AutoClear			:= FALSE,
			t_TriggerTime		:=	T#1S,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;	

	(*Heatpump valve fault*)			AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_ValveError,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:=37 + ((HeatPumpID-1)*10),
			s_Message				:= 'valve fault',
			e_sev					:= eSeverity.Warning,	
			b_AutoClear			:= FALSE,
			t_TriggerTime		:=	T#1S,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;	

	(*Heatpump Water temperature error*)			AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_WaterTempError,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 38 + ((HeatPumpID-1)*10),
			s_Message				:= concat('water temperature error', sWaterTempErrorText),
			e_sev					:= eSeverity.Warning,	
			b_AutoClear			:= FALSE,
			t_TriggerTime		:=	T#1S,
			//in_e_ErrAckAccess		:= TRUE,
			);
		w_Index := w_Index +1;		
		
	(*Heatpump Preheating active*)			AddError[w_Index](
			b_ErrorTrig				:= Get.Events.b_HeatpumpPreheatingActive,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 39 + ((HeatPumpID-1)*10),
			s_Message				:= concat('Heatpump preheating active for ', TO_STRING(t_RemainingPreheatingTime)),
			e_sev					:= eSeverity.Info,	
			b_AutoClear				:= TRUE,
			);
		w_Index := w_Index +1;	

]]></ST>
      </Implementation>
    </Method>
    <Method Name="HeatpumpPreheatControl" Id="{33bc884d-9a23-48d8-a2a0-b97ef01a84a3}" FolderPath="Private methods\">
      <Declaration><![CDATA[METHOD PRIVATE HeatpumpPreheatControl : BOOL
VAR
	b_PreheatingRequired	:	BOOL;
END_VAR

VAR_INST
	ton_PreheatingTimer	:	Ton;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//enable operation
ton_PreheatingTimer(IN:= ACPowerStatus, PT:= TO_TIME(st_params.dw_HeatpumpOperationDelay*1000*60));
b_PreheatingRequired := ((DT_TO_INT(GVL.dt_SystemDateTime) - DT_TO_INT(dt_LastHPOperationTime))/60) > st_params.i_SkipHPPreheatingTime;

t_RemainingPreheatingTime := ton_PreheatingTimer.PT - ton_preheatingTimer.ET;

IF ton_PreheatingTimer.Q THEN
	dt_LastHPOperationTime := GVL.dt_SystemDateTime;
	t_RemainingPreheatingTime := T#0ms;
END_IF

get.Events.b_HeatpumpPreheatingActive := b_PreheatingRequired AND ACPowerStatus ;
]]></ST>
      </Implementation>
    </Method>
    <Action Name="Init" Id="{77f20429-c6ce-4b1c-8377-0716ca6f5e2b}">
      <Implementation>
        <ST><![CDATA[get.HeatPumpState := eHeatpumpstate.OFF;
bmbActive := FALSE;
SFCReset := false;]]></ST>
      </Implementation>
    </Action>
    <Method Name="MBCommBusy" Id="{12e79b4a-d10a-4eda-a5a5-88ae4e595b89}">
      <Declaration><![CDATA[METHOD MBCommBusy : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MBCommBusy := bMBActive;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ParseHeatPumpErrors" Id="{17941482-6c37-46be-ac5c-65d44a2bcb81}" FolderPath="Private methods\">
      <Declaration><![CDATA[METHOD ParseHeatPumpErrors : BOOL
VAR_INPUT
	w_Alarms1	:	WORD;
	w_Alarms2	:	WORD;
	w_Alarms3	:	WORD;
	w_Alarms4	:	WORD;
	w_Alarms5	:	WORD;
	w_Alarms6	:	WORD;
	w_Alarms7	:	WORD;
END_VAR		


VAR_IN_OUT
	get	:	ST_HeatPump_Get;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[get.events.b_ProbeError		:=	WORD_TO_BOOL(w_Alarms3) OR WORD_TO_BOOL(w_Alarms4) OR w_Alarms5.0;

get.events.b_PressureError		:=	w_Alarms1.0 OR	//E001: High Pressure
									w_Alarms1.1 OR //E002: Low Pressure
									w_Alarms2.3;	//E020: Inverted Pressure Transducers
									
sPressureErrorText := '';
IF get.events.b_PressureError THEN
	sPressureErrorText := concat(sPressureErrorText, SEL(w_Alarms1.0, '', ' E001'));
	sPressureErrorText := concat(sPressureErrorText, SEL(w_Alarms1.1, '', ' E002'));
	sPressureErrorText := concat(sPressureErrorText, SEL(w_Alarms2.3, '', ' E020'));
END_IF
									
get.events.b_CompressorError	:=	w_Alarms1.2 OR //E003: Compressor overheated
									w_Alarms1.7 OR //E008: Compressor underspeed
									w_Alarms1.8 OR	//E009: High disch temp
									w_Alarms1.12 OR //E013: Comp2 Overheated
									w_Alarms2.2 OR	//E019: CP2 High disch temp
									w_Alarms2.6 OR	//E023: Comp3 Overheated
									w_Alarms5.1 OR //'E801: Link Inverter1',
									w_Alarms5.2 OR //'E802: Link Inverter2',
									w_Alarms5.3 OR //'E803: Link Inverter3',
									w_Alarms5.4 OR //'E851: HWfault Inverter1',
									w_Alarms5.5 OR //'E852: HWfault Inverter2',
									w_Alarms5.6 OR //'E853: HWfault Inverter3',
									w_Alarms5.7 OR //'E861: OverCurrent Inv1',
									w_Alarms5.8 OR //'E862: OverCurrent Inv2',
									w_Alarms5.9 OR //'E863: OverCurrent Inv3',
									w_Alarms5.10 OR //'E871: High Temp Inv1',
									w_Alarms5.11 OR //'E872: High Temp Inv2',
									w_Alarms5.12 OR //'E873: High Temp Inv3',
									w_Alarms5.13 OR //'E881: Bad Voltage Inv1',
									w_Alarms5.14 OR //'E882: Bad Voltage Inv2',
									w_Alarms5.15 OR //'E883: Bad Voltage Inv3',
									w_Alarms6.0 OR //E891: Phase Seq Inv1',
									w_Alarms6.1 OR //'E892: Phase Seq Inv2',
									w_Alarms6.2 OR //'E893: Phase Seq Inv3',
									w_Alarms6.3 OR //'E901: Model err Inv1',
									w_Alarms6.4 OR //'E902: Model err Inv2',
									w_Alarms6.5 OR //'E903: Model err Inv3',
									w_Alarms6.6 OR //'E911: Ovl error Inv1',
									w_Alarms6.7 OR //'E9112: Ovl error Inv2',
									w_Alarms6.8 OR //'E913: Ovl error Inv3',
									w_Alarms6.9 OR //'E921: Overc PFC Inv1',
									w_Alarms6.10 OR //'E922: Overc PFC Inv2',
									w_Alarms6.11 OR //'E923: Overc PFC Inv3',
									w_Alarms6.12 OR //'E931: Int Com ERR Inv1',
									w_Alarms6.13 OR //'E932: Int Com ERR Inv2',
									w_Alarms6.14 OR //'E933: Int Com ERR Inv3',
									w_Alarms6.15 OR //'E941: Fault PFC Inv1',
									w_Alarms7.0 OR //E942: Fault PFC Inv2
									w_Alarms7.1 OR //'E943: Fault PFC Inv3',
									w_Alarms7.2 OR //'E951: Probe error Inv1',
									w_Alarms7.3 OR //'E952: Probe error Inv2',
									w_Alarms7.4 OR //'E953: Probe error Inv3',
									w_Alarms7.5 OR //'E961: Abnormal Cond Inv1',
									w_Alarms7.6 OR //'E962: Abnormal Cond Inv2',
									w_Alarms7.7 OR //'E963: Abnormal Cond Inv3',
									w_Alarms7.8 OR //'E971: Inv1 Eeprom Error',
									w_Alarms7.9 OR //'E972: Inv2 Eeprom Error',
									w_Alarms7.10 OR //'E973: Inv3 Eeprom Error',
									w_Alarms7.11;	//E029: CP3 High disch temp

sCompressorErrorText := '';
IF get.events.b_CompressorError THEN
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms1.2, '', ' E003'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms1.7, '', ' E008'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms1.8, '', ' E009'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms1.12, '', ' E013'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms2.2, '', ' E019'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms2.6, '', ' E023'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms5.1, '', ' E801'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms5.2, '', ' E802'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms5.3, '', ' E803'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms5.4, '', ' E851'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms5.5, '', ' E852'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms5.6, '', ' E853'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms5.7, '', ' E861'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms5.8, '', ' E862'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms5.9, '', ' E863'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms5.10, '', ' E871'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms5.11, '', ' E872'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms5.12, '', ' E873'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms5.13, '', ' E881'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms5.14, '', ' E882'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms5.15, '', ' E883'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms6.0 , '', ' E891'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms6.1 , '', ' E892'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms6.2 , '', ' E893'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms6.3 , '', ' E901'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms6.4 , '', ' E902'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms6.5 , '', ' E903'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms6.6 , '', ' E911'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms6.7 , '', ' E912'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms6.8 , '', ' E913'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms6.9 , '', ' E921'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms6.10, '', ' E922'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms6.11, '', ' E923'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms6.12, '', ' E931'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms6.13, '', ' E932'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms6.14, '', ' E933'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms6.15, '', ' E941'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms7.0 , '', ' E942'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms7.1 , '', ' E943'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms7.2 , '', ' E951'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms7.3 , '', ' E952'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms7.4 , '', ' E953'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms7.5 , '', ' E961'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms7.6 , '', ' E962'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms7.7 , '', ' E963'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms7.8 , '', ' E971'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms7.9 , '', ' E972'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms7.10, '', ' E973'));
	sCompressorErrorText := concat(sCompressorErrorText, SEL(w_Alarms7.11, '', ' E029'));
END_IF
								
get.events.b_ValveError		:=		w_Alarms2.11; //E041: Incongruent temps;


get.events.b_FanError			:=	w_Alarms1.2 OR //E004: Fan Overheated	
									w_Alarms1.13 OR //E014: Fan2 Overheated 
									w_Alarms2.7;	//E024: Fan3 Overheated					

get.events.b_PumpError			:=	w_Alarms1.5 OR	 	//E006: Lack of flow
									w_Alarms1.15 OR 	//E016: Pump Overheated
									w_Alarms2.9;		//E026: Pump2 Overheated

sPumpErrorText := '';
IF get.events.b_PumpError THEN
	sPumpErrorText := concat(sPumpErrorText, SEL(w_Alarms1.5, '', ' E006'));
	sPumpErrorText := concat(sPumpErrorText, SEL(w_Alarms1.15, '', ' E016'));
	sPumpErrorText := concat(sPumpErrorText, SEL(w_Alarms2.9, '', ' E026'));		
END_IF						
									
get.events.b_WaterTempError		:=	w_Alarms2.1 OR	//E018: OverTemperature
									w_Alarms1.4;	//E005: Frost

sWaterTempErrorText := '';									
IF get.events.b_WaterTempError THEN
	sWaterTempErrorText := concat(sWaterTempErrorText, SEL(w_Alarms1.5, '', ' E018'));
	sWaterTempErrorText := concat(sWaterTempErrorText, SEL(w_Alarms1.15, '', ' E005'));	
END_IF		


									
get.events.b_IOError			:=	w_Alarms2.14 OR 	//E101: IOMod1 Disconnected
									w_Alarms2.15; 		//E102: IOMod2 Disconnected
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{ad3e7a12-6909-4ad9-9cd7-325e7420a948}">
      <Declaration><![CDATA[METHOD Reset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//until restarting the heatpump we don't know if errors are gone. So clear them for now.

get.Events.b_CompressorError := FALSE;
get.Events.b_FanError := FALSE;
get.Events.b_IOError := FALSE;
get.Events.b_PressureError := FALSE;
get.Events.b_ProbeError := FALSE;
get.Events.b_PumpError := FALSE;
get.Events.b_ValveError := FALSE;
get.Events.b_WaterTempError := FALSE;
b_Emstop := FALSE;

Reset := TRUE;
	]]></ST>
      </Implementation>
    </Method>
    <Method Name="Setpoint" Id="{f7af15b8-be6d-4c84-8946-1e161b817045}">
      <Declaration><![CDATA[METHOD Setpoint : BOOL
VAR_INPUT
	OperatingMode	:	eHeatpumpMode	:= 	eHeatpumpMode.Standby;
	Temperature		: 	REAL			:=	18;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF get.HeatPumpState >= eHeatpumpstate.Standby AND 
	NOT get.Events.b_HeatpumpPreheatingActive AND 
	NOT b_EMstop THEN
	RequestedSetpoint.Setpoint		:= Temperature;
	RequestedSetpoint.OperatingMode := OperatingMode;
ELSE
	RequestedSetpoint.OperatingMode := eHeatPumpMode.Standby;
	RequestedSetpoint.Setpoint		:= 18.0;
END_IF

get.Setpoint := RequestedSetpoint.Setpoint;
]]></ST>
      </Implementation>
    </Method>
    <Action Name="SFCTipReset" Id="{3959ea04-7fa9-46c8-9b4c-52dfc0f75011}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[SFCTip := FALSE;

]]></ST>
      </Implementation>
    </Action>
