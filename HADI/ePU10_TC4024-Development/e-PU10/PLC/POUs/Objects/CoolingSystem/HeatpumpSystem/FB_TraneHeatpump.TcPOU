<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_TraneHeatpump" Id="{46a27ec4-89c7-4e26-8c2f-4e874e444292}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TraneHeatpump implements IF_Heatpump
VAR_IN_OUT
	MBMaster		:	ModbusRtuMasterV2_KL6x22B;
END_VAR

VAR_OUTPUT
	Get				:	ST_HeatPump_Get;

END_VAR

VAR_IN_OUT CONSTANT
	st_params		: 	ST_Coolingsystem_params;
END_VAR

VAR_INPUT
	ACPowerStatus	:	BOOL;
	HeatPumpID		:	BYTE;
	SFCInit			:	BOOL;
	e_ID				:	eObject_ID := eObject_ID.HeatPump;
END_VAR
		
VAR
	ton_MBBUSYTimeOut		: TON := (PT := T#10s);
	DataBuffer				:	ARRAY[0..50] OF WORD;
	ton_modbusStuckTrigger	:	Ton	:=	(PT := T#5S);
	Ton_ErrorTimer			:	Ton := (PT := T#5M);
	MBRetryCount			:	BYTE;
	MBFree					:	BOOL;
	bMBActive				:	BOOL;
	ftrig_ModbusStartTrigger		:	f_Trig;
	TransmissionDoneTrigger	:	F_Trig;
	
	TP_ModbusStartTriggerDelay	:	TP := (PT := TIME#50MS);
	u_counter				:	UINT;
END_VAR

VAR
	RequestedSetpoint				:	st_OperatingPoint;
	b_EMStop						:	BOOL;
	b_resetErrors					:	BOOL;
	t_RemainingPreheatingTime	:	TIME;
	sPressureErrorText			:	STRING;
	sCompressorErrorText		:	STRING;
	sPumpErrorText				:	STRING;
	sWaterTempErrorText			:	STRING;
END_VAR

VAR PERSISTENT
	dt_LastHPOperationTime	:	DT := DT#1970-1-1-0:0:0.000;
END_VAR]]></Declaration>
