	Qset			:	REAL;	//60..100 = 0.6..1
	PFset			:	REAL;	//0 - 1;
	Uset			: 	REAL;
	Fset			: 	REAL;
	U_Fdroopset		: 	REAL := 4;
	GensetMode		: 	eGensetMode := eGensetMode.FixedPower;
END_STRUCT
END_TYPE
