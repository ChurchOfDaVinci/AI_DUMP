	PrimaryOutputContactSignal		: 	eOutputContactSignal := eOutputContactSignal.GenStartStop;
	SecondaryOutputContactSignal	:	eOutputContactSignal := eOutputContactSignal.None;
	PrimaryInputContactSignal		: 	eInputSignal := eInputSignal.None;
	SecondaryInputContactSignal		: 	eInputSignal := eInputSignal.None;
	AO1Target				: eAOTarget := eAOTarget.Genset;
	AO2Target				: eAOTarget	:= eAOTarget.hPU;
END_STRUCT
END_TYPE
