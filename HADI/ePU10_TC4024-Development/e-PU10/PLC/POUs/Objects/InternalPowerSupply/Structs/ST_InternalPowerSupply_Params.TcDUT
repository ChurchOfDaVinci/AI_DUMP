<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_InternalPowerSupply_Params" Id="{c73dfe6b-5e2f-44ec-bb03-5b9f131c3f99}">
    <Declaration><![CDATA[TYPE ST_InternalPowerSupply_Params :
STRUCT
	b_InternalACfromBusbar	: BOOL := FALSE;
	i_IntZPTStartupDelay: INT := 100; // ms
	i_ACStartupDelay : INT := 100; //ms
	i_DCPSU_StartupDelay: INT := 5000; //ms
	i_ACPSU_StartupDelay: INT := 5000; //ms
	
	//trigger level before Battery low error is issued. 
	usi_UPSBattLowErrorSOC		:	USINT 	:= 30;
	//UPS charging request was apparently denied. System should shutdown? 
	usi_UPSBattLowwarningSOC	:	USINT 	:= 40;
	//trigger level before Battery low warning is issued and UPS charging is requested from Internal power supply
	usi_UPSBattLowinfoSOC		:	USINT	:= 60;	
	//r_SOC level at which UPS charging is no longer requested so HVDC can be shutdown.
	usi_UPSBattOKSOC 			:	USINT	:= 90;
	//Timeout between LowBatteryError occuring and self-shutdown initiating
	LowBatteryShutdownTimer		:	TIME := T#10M;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>