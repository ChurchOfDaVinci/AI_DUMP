<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_PowerStack" Id="{e4a4d14a-8386-4cfd-b8a1-0a4eefabcc5d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PowerStack
//Accessible input data from main program
VAR_INPUT
	set											: ST_PowerStack_Set;
	e_ACRotationStateExt						: eACRotationState;
	b_EnableFan									: BOOL;
	b_transportMode								: BOOL;
	b_rotationswitchEnable						: BOOL;
	by_CoolingPowerRequest						: BYTE; //0 off, 1 internal 400VAC supply required, 2 Full Power Allowed
	r_PLossInternal								: REAL;
	r_QLossInternal								: REAL;
	b_DoublePowermodule							: BOOL;	
	b_BatteryDCReady							: BOOL;	
	r_BatteryDCVoltage							: REAL;
	b_ExtGridCodeTrip							: BOOL;	
	b_OutputConnected							: BOOL;
	b_InputConnected							: BOOL;
	b_InternalACRequired						: BOOL;
END_VAR

//Accessible output data to main program
VAR_OUTPUT
	get										: ST_PowerStack_Get;
	st_InternalPsuSupplyRequest				: ST_InternalPowerSupply_PowerDemand;
	b_InternalPsuACOk						: BOOL;
	b_MasterMccbEDM							: BOOL;
	b_SlaveMccbEDM							: BOOL;
	b_NetcontEDM							: BOOL;
	by_CoolingControl						: BYTE; // 0:= off, 1:= startup, 2:= run
END_VAR

//These variables MUST be passed to the powerstack in order to work properly. Thats why they are declared separately in the VAR_IN_OUT (CONSTANT)
VAR_IN_OUT CONSTANT			
	st_params									: ST_Powerstack_Params;
	st_calibration								: ST_Powerstack_calibration;
END_VAR

// local variables in powerstack
VAR
	//function blocks
	Netcontactor						: FB_Netcontactor;
	PowermoduleMaster					: FB_powermodule;
	PowermoduleSlave					: FB_powermodule;
	LOM 								: FB_LOMDetection;
END_VAR

VAR
    eControl 					: (stand_by, Start, Stop, Shutdown);
	s_ErrorStep					: STRING;
	rTrig_start					: R_Trig;
	ton_StandbyNetConCloseDelay : TON := (PT:= T#5S);
	ton_SFCtipDelay				: TON := (PT:= T#1S);
	
	standbyDeactivateState		: BOOL; // trigger on shutdown, reset on busbar ac Rtrig or Reset.
	rTrig_StandByDeactStateReset: R_TRIG;
END_VAR
 
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Netcontactor();
	get.Netcontactor REF= netcontactor.get;
	Netcontactor.set.e_ACRotationState := e_ACRotationStateExt;
	Netcontactor.set.b_ACdetected := get.b_ACDetected;
	Netcontactor.set.b_RotationSwitchEnable := b_rotationswitchEnable;
	Netcontactor.set.e_ClosingRequest := set.e_NetconClosingRequest;
	Netcontactor.set.b_SynchronizedToD7	:= PowermoduleMaster.get.UgridStatusWord.b_SynchronizedToD7;
	PowermoduleMaster.set.b_D7SyncRequest := Netcontactor.get.b_SyncCloseCommand;
	

 //passthrough the reference of the get/set input and output variables to underlaying functions.
PowermoduleMaster(
	b_enable := TRUE,
	 st_params:=st_params.PowermoduleMaster,
	st_calibration := st_calibration.Master,
	e_ID := eObject_ID.PowerModuleMaster,
	r_batteryDCVoltage := r_BatteryDCVoltage);
	get.PowermoduleMaster REF= powermoduleMaster.get;
PowermoduleSlave(
	b_enable := b_doublePowermodule,
 	st_params:=st_params.PowermoduleSlave, 
	st_calibration := st_calibration.Slave,
	e_ID := eObject_ID.PowerModuleSlave,
	r_batteryDCVoltage := r_BatteryDCVoltage);
	get.PowermoduleSlave REF= powermoduleSlave.get;
	
//Start Stop sequence
StartStopSFC();

//Bundle data from powermodules to powerstack total
BundlePowerStackGets(st_params := st_params);

//Droop settings to/from powermodules
ControlDroop(
	setMaster := powermoduleMaster.set,
	setSlave := powerModuleSlave.set,
	b_ControlEnabled := get.b_ControlEnabled
	);

//Powermodules Control
Controlpowermodules(
	r_APloss:= r_PLossInternal,
	r_RPloss := r_QLossInternal,
	setMaster:= Powermodulemaster.set,
	setSlave:= PowermoduleSlave.set,
	st_params := st_params);

//setEvents
setEvents(events:= get.Events,  st_params := St_params);

b_MasterMccbEDM	:= PowermoduleMaster.b_MccbEDM;
b_SlaveMccbEDM	:= PowermoduleSlave.b_MccbEDM;
b_NetContEDM	:= Netcontactor.b_NetcontEDM;

//start trigger
rTrig_start(CLK:= eControl = Start);



]]></ST>
    </Implementation>
    <Folder Name="Private methods" Id="{e1983008-6c04-438d-9bf2-d36ae1de840b}" />
    <Folder Name="SFC" Id="{ba8a5ec6-fb54-4d76-a83c-fdf72853eb63}" />
    <Action Name="_aCloseNetcontactor_active" Id="{7aaf3028-c3a6-4cb8-99a6-d3615c08f176}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[get.e_State 				:= eStatusPowerStack.synchronization;

IF (NOT ton_StandbyNetConCloseDelay.Q OR standbyDeactivateState) AND eControl = stand_by THEN
	SFCtip := NOT SFCTIP;
ELSE
	SFCtip := Netcontactor.Close(b_Force := NOT get.b_ACDetected) AND NOT SFCTIP;
END_IF

]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aContinousActions" Id="{3ec4eaec-7ec5-4630-bbb4-bee453d3cf91}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[IF SFCerror THEN s_ErrorStep := SFCCurrentStep; END_IF;

//evaluate if inverter is in a gridforming kinda mode
get.b_InverterGridFormingMode := get.e_InverterMode <> eInvertermodes.Afe AND get.e_PowerMode <> ePowermodes.Isochronous AND get.b_InverterRunning;

//busbar AC check	
get.b_ACDetected := AcCheck(get.r_ACVoltageD7, get.r_FrequencyD7);

// evaluate grid AC, or when grid is lost.
DetectGridSync(
	b_netconFB := netcontactor.get.b_NetConFb,
	b_InverterGridFormingMode := get.b_InverterGridFormingMode,
	b_ExtGridConnected := set.b_ExtGridConnected,
	b_ACOk := get.b_ACDetected,
	b_IsochroneMode := powermodulemaster.get.e_PowerMode = ePowermodes.Isochronous,
	b_gridtied := get.b_GridTied,
	b_ACdetected := get.b_GridACdetected,
	b_GridCodeTripInverter := Powermodulemaster.get.GridcodeStatusWord.b_GridCodeTripActive,
	b_GridCodeActiveInverter := powermodulemaster.get.controldata.Controlword.b_GridCodeEnable,
	b_GridCodeOK := get.b_GridCodeOK,
	b_GridCheckActive := get.b_GridCodeCheckActive,
	t_GridLostMaxTripTime := TO_TIME(Settings.GridParams.ui_GCTripMaxTripTime),
	t_GridOKReleaseTime :=  TO_TIME(TO_REAL(settings.GridParams.ui_GCokReleaseTime)*1000)
	);



//Evaluate ac available for standby mode
ton_StandbyNetConCloseDelay(IN := st_params.b_StandbyEnable 
	AND get.b_GridACdetected
	AND set.b_automaticswitching);	
	
// internal AC check
//b_InternalPsuACOk := InternalAcCheck(SEL(netcontactor.get.b_NetConFb, get.r_ACVoltageSupply, get.r_ACVoltageD7), get.r_FrequencySupply, get.b_GridTied);
b_InternalPsuACOk := InternalAcCheck(	SEL(netcontactor.get.b_NetConFb, get.r_ACVoltageSupply, get.r_ACVoltageD7), 
										SEL(netcontactor.get.b_NetConFb, get.r_FrequencySupply, get.r_FrequencyD7));


//get starting enable condition
get.b_StartEnabled := StartingEnable();

rTrig_StandByDeactStateReset(CLK:= get.b_ACDetected);
IF rTrig_standbyDeactStateReset.Q THEN
	standbyDeactivateState := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="_aCoolingRequest_active" Id="{89706bcf-691d-4484-9202-0d37e5a7d33b}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[by_CoolingControl := 1;

get.e_State := eStatusPowerStack.Wait_CoolingMode1;]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aHVDCRequest_active" Id="{9bc7e831-3b86-4ac2-bdee-0012fe4dc74b}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[st_InternalPsuSupplyRequest.b_Demand_HVDC := TRUE;
get.e_State := eStatusPowerStack.Wait_HVDC;]]></ST>
      </Implementation>
    </Action>
    <Action Name="_aIdle_active" Id="{7c0a1ecd-00eb-4188-9a18-c05691955948}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[get.events.b_GridCodeWarning:= FALSE; 
get.b_ControlEnabled		:= TRUE;


IF Netcontactor.Open() AND PowermoduleMaster.Idle() THEN
	get.b_StartedState 			:= FALSE;
	get.e_State := eStatusPowerStack.idle;
	//PowermoduleMaster.Idle();
	IF get.b_GridCodeOK THEN
		get.e_State 							:= eStatusPowerStack.GridCodeStop;
	END_IF
END_IF



//SFCtip := XNOR((get.b_GridCodeOK AND get.b_GridCodeCheckActive), eControl = start) AND NOT detectConnectionLoss(TRUE) AND NOT SFCtip;
SFCtip := SEL(get.b_GridCodeCheckActive, TRUE, get.b_GridCodeOK) AND eControl = start AND NOT detectConnectionLoss(TRUE) AND NOT SFCtip;
//IF get.b_GridACdetected AND get.Netcontactor.b_NetConFb THEN
//	PowermoduleMaster.Idle(); //Stop modulation to stop power supply when grid is existing. Grid supplies internals through net contactor
//ELSE
//	Netcontactor.Open(); // keep master inverter modulation, but open netcontactor to stop power supply to load.
//END_IF

//PowermoduleSlave.Idle(); //stop slave always]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aInit_active" Id="{3387b206-2cfd-43aa-9549-32864d78d2db}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[SFCReset 					:= FALSE;
get.b_StartedState 			:= FALSE;

get.e_State := eStatusPowerStack.Init;
get.b_ControlEnabled 	:= FALSE;

//IF by_CoolingPowerRequest = eCoolingPowerRequest.off THEN
IF NOT b_internalACRequired THEN
	ShutdownFull(FALSE);
	IF NOT get.b_ACDetected THEN
		Netcontactor.Open();
	END_IF
ELSE
	get.e_State := eStatusPowerstack.Cooling_Shutdown;
END_IF

//by_CoolingControl		:= 0;
//b_InternalPsuACOk		:= FALSE;

]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aRunning_active" Id="{3e1336e9-63c9-4950-a01b-d24628cda005}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[get.b_ControlEnabled		:= TRUE;
get.b_StartedState 			:= TRUE;
PowermoduleMaster.Run(set.e_PowerMode, set.e_InverterMode, NOT netcontactor.get.b_NetConFb);
get.e_State 				:= eStatusPowerStack.running;

//If force close is activated, the gridcode trip will be not lead to opening of the contactor.
//this is used to operate an external contactor instead.
IF set.b_NetcontactorHoldClose AND netcontactor.get.b_NetConFb THEN
	Netcontactor.Close(TRUE);
	SFCTip := DetectConnectionLoss(FALSE) AND NOT SFCTip;
ELSE 
	SFCtip := LOM.Q OR (NOT get.b_GridCodeOK AND get.b_GridCodeCheckActive) OR DetectConnectionLoss(TRUE) OR by_CoolingPowerRequest <> 2 AND NOT SFCTip;
END_IF

]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aSFCtip_reset" Id="{c04b4d4f-0e98-4ad6-a80f-f86d07dd9e3c}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[sfctip:= FALSE;]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aStandBy_active" Id="{4e133d11-386b-43ee-8966-ccb7b4a23860}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[//default values, will be overwritten if neccessary
get.e_State := eStatusPowerstack.Standby;
PowermoduleSlave.Shutdown(b_force := FALSE);// slave shutdown always during stand-by

IF get.b_InverterRunning THEN
	by_CoolingControl := 1;
ELSE 
	by_CoolingControl := 0;	// Also cooling deactivated from a powermodule point of view. Cooling decides if this can be achieved.
END_IF

	
ton_SFCtipDelay(Q=> SFCtip);

IF st_params.b_StandbyEnable AND set.b_automaticswitching AND NOT b_transportMode AND b_InternalACRequired THEN
	IF ton_StandbyNetconCloseDelay.Q THEN // if grid, than close netcontactor
		get.e_State := eStatusPowerstack.Standby_GridSupply;	
		IF NOT Netcontactor.get.b_NetConFb AND NOT st_params.b_SoftStartEnable AND NOT get.b_InverterRunning THEN
			Netcontactor.Close(TRUE);
		//ELSIF NOT Netcontactor.get.b_NetConFb AND NOT standbyDeactivateState THEN
			//ton_SFCtipDelay.IN:= NOT ton_SFCtipDelay.Q;
		//ELSIF by_CoolingPowerRequest = eCoolingPowerRequest.off THEN
		ELSIF NOT b_InternalACRequired THEN
			ShutdownFull(FALSE);
		ELSIF get.b_InverterRunning AND Netcontactor.get.b_NetConFb THEN
			PowermoduleMaster.Run(ePowermodes.Isochronous ,eInverterModes.Microgrid, FALSE);
		ELSIF (b_InternalACRequired AND NOT standbyDeactivateState AND (NOT get.b_InverterRunning OR NOT Netcontactor.get.b_NetConFb)) THEN
			ton_SFCtipDelay.IN:= NOT ton_SFCtipDelay.Q;
		END_IF
	//if no grid detected, no internal supply is made by default unless it is requested from cooling	
	ELSIF Netcontactor.Open() THEN
		//IF by_CoolingPowerRequest = eCoolingPowerRequest.off THEN
		IF NOT b_InternalACRequired THEN
			ShutdownFull(FALSE);	
		ELSE
			ton_SFCtipDelay.IN:= NOT ton_SFCtipDelay.Q AND NOT PowermoduleMaster.Run(ePowermodes.Droop, eInverterModes.Island, TRUE);
		END_IF
		get.e_State := eStatusPowerstack.Standby_InternalSupply;
	END_IF
ELSE
	IF NOT get.b_GridACdetected THEN
		Netcontactor.Open();
	END_IF
	
	//IF by_CoolingPowerRequest = eCoolingPowerRequest.off THEN
	IF NOT b_InternalACRequired THEN
		IF Netcontactor.Open() AND ShutdownFull(FALSE) THEN
			get.e_State := eStatusPowerstack.Standby;
		END_IF
	ELSE
		get.e_State := eStatusPowerstack.Cooling_Shutdown;
	END_IF
END_IF


]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">false</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aStandby_exit" Id="{e7d41b54-6e37-46df-82c6-5261694bfe05}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[SFCtip := FALSE;
ton_SFCtipDelay.IN := FALSE;

IF eControl = start THEN 
	ton_StandbyNetConCloseDelay.IN := FALSE;
END_IF

st_InternalPsuSupplyRequest.b_Demand_24V := TRUE;

]]></ST>
      </Implementation>
    </Action>
    <Action Name="_aStartMaster_active" Id="{549dc378-de28-458a-af1d-0137dde202ff}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[sfctip := PowermoduleMaster.Start(netcontactor.get.b_NetConFb AND get.b_ACdetected) AND NOT SFCTip;
get.e_State := eStatusPowerStack.Start_Master;


]]></ST>
      </Implementation>
    </Action>
    <Action Name="_aStartSlave_active" Id="{90d01767-2750-4c44-a97e-e521c53831f1}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[sfctip:= PowermoduleSlave.Start(TRUE);
get.e_State 		:= eStatusPowerStack.Start_Slave;]]></ST>
      </Implementation>
    </Action>
    <Action Name="_aUVRSupplyRequest_active" Id="{f9e37431-4cb8-4f4a-895c-6265ef95061f}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[IF b_doublePowermodule THEN
	SFCtip := powermodulemaster.get.b_MccbUvr24VdcOK AND powermoduleSlave.get.b_MccbUvr24VdcOK AND NOT SFCtip;
ELSE
	SFCtip := powermodulemaster.get.b_MccbUvr24VdcOK AND NOT SFCtip;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="BundlePowerStackGets" Id="{2e7f6acb-cc33-450c-b6f3-351d6ddde88f}" FolderPath="Private methods\">
      <Declaration><![CDATA[METHOD PRIVATE BundlePowerStackGets : BOOL
VAR_IN_OUT CONSTANT
	st_params			: ST_Powerstack_params;
END_VAR
VAR_INST
	r_Derating : REAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[get.e_PowerMode			:= get.PowermoduleMaster.e_PowerMode;
get.r_FrequencySupply := get.PowermoduleMaster.r_FrequencySupply;
get.r_ACVoltageSupply	:= get.PowermoduleMaster.r_ACVoltageSupply;
get.r_ACVoltageD7		:= get.PowermoduleMaster.r_ACVoltageD7;
get.r_FrequencyD7		:= get.PowermoduleMaster.r_FrequencyD7;
get.r_FrequencyDroop	:= get.PowermoduleMaster.r_FrequencyDroop;
get.r_VoltageDroop		:= get.PowermoduleMaster.r_VoltageDroop;

get.r_ActivePower		:= get.PowermoduleMaster.r_ActivePower + get.PowermoduleSlave.r_ActivePower;
get.r_ReactivePower		:= get.PowermoduleMaster.r_ReactivePower + get.PowermoduleSlave.r_ReactivePower;
get.r_ApparentPower		:= get.PowermoduleMaster.r_ApparentPower + get.PowermoduleSlave.r_ApparentPower;
get.r_CosPhi			:= SEL(get.r_ApparentPower = 0, (get.r_ActivePower / get.r_ApparentPower), 0); //avoid dividing by zero;
get.r_DCcurrent			:= get.PowermoduleMaster.r_DCCurrent	+ get.PowermoduleSlave.r_DCCurrent;
get.r_DCVoltage			:= get.PowermoduleMaster.r_DCVoltage;
get.r_DCPower			:= get.PowermoduleMaster.r_DCPower + get.PowermoduleSlave.r_DCPower;
get.r_LoadPercent		:= SEL(
	b_DoublePowermodule,get.PowermoduleMaster.r_LoadPercent, (get.PowermoduleMaster.r_LoadPercent + get.PowermoduleSlave.r_LoadPercent) / 2);
get.r_Pmin				:= get.PowermoduleMaster.r_Pmin + get.PowermoduleSlave.r_Pmin;
get.r_Pmax				:= get.PowermoduleMaster.r_Pmax + get.PowermoduleSlave.r_Pmax;
get.r_QMax				:= get.PowermoduleMaster.r_Qmax + get.PowermoduleSlave.r_Qmax;
get.r_QMin				:= get.PowermoduleMaster.r_Qmin + get.PowermoduleSlave.r_Qmin;
get.r_ACcurrentLimit	:= get.PowermoduleMaster.r_ACcurrentLimit + get.PowermoduleSlave.r_ACcurrentLimit;
get.r_ACcurrentLimitMax	:= SEL(b_doublePowermodule, st_params.PowermoduleMaster.r_ACCurrentLimitMax, st_params.PowermoduleMaster.r_ACCurrentLimitMax + st_params.PowermoduleSlave.r_ACCurrentLimitMax);
get.r_Smax				:= get.r_ACcurrentLimit * get.r_ACVoltageSupply * 1.73 / 1000; 
get.r_PowerChangeRate	:= TO_REAL(st_params.i_MaxPowerChangeRate);
get.r_AcCurrent	:= get.PowermoduleMaster.r_ACCurrent + get.PowermoduleSlave.r_ACCurrent;


get.r_OvercurrentValueAct 	:= SEL(
	b_DoublePowermodule, 
	get.PowermoduleMaster.r_OverCurrentValue, 
	(get.PowermoduleMaster.r_OverCurrentValue + get.PowermoduleSlave.r_OverCurrentValue) / 2
	);
get.r_ThrottlingValueAct := (1 - LIMIT(0, get.r_OvercurrentValueAct, 1)) * 100;
	
get.b_inverterRunning 	:= PowermoduleMaster.get.StatusWord.b_Running OR PowermoduleSlave.get.StatusWord.b_Running;
get.b_DCDetected 		:= powermoduleMaster.get.r_DCVoltage > 120; // vdc
get.r_OvercurrentValueMax:= TO_REAL(st_params.ui_OvercurrentRating) /100;
r_Derating := (100 - TO_REAL(st_params.ui_DeratingStack)) / 100; // total current derating when parallel inverters according to danfoss
get.r_RatedCurrent 	:= (st_params.powermodulemaster.r_InverterRatedCurrent + SEL(b_doublePowermodule,0,st_params.PowermoduleSlave.r_InverterRatedCurrent * r_Derating));
get.r_RatedPower	:= (st_params.powermodulemaster.r_InverterRatedPower + SEL(b_doublePowermodule,0,st_params.PowermoduleSlave.r_InverterRatedPower* r_Derating));

get.b_EcomodeAvailable := b_DoublePowermodule;

get.r_MaxTemperature := MAX(powermodulemaster.get.r_TemperatureMax, powermoduleSlave.get.r_TemperatureMax);
//get.b_GridCodeOK := NOT powermodulemaster.get.GridcodeStatusWord.b_GridCodeTripActive;
//get.b_GridCodeActive := powermodulemaster.get.controldata.Controlword.b_GridCodeEnable;
get.e_InverterMode := powermodulemaster.get.e_InverterMode;
get.e_PowerMode := powermodulemaster.get.e_PowerMode;
get.e_ThrottlingStatus := powermodulemaster.get.e_ThrottlingStatus;

IF get.r_ActivePower > 1 THEN
	get.e_PowerState := ePowerstate.Discharging;
ELSIF get.r_ActivePower < 1 THEN
	get.e_PowerState := ePowerstate.Charging;
ELSE
	get.e_PowerState := ePowerstate.None;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ControlDroop" Id="{49bfd096-51c6-43dd-9594-1a6b1e34f34b}" FolderPath="Private methods\">
      <Declaration><![CDATA[METHOD PRIVATE ControlDroop
VAR_IN_OUT
	setMaster			: ST_Powermodule_Set;
	setSlave			: ST_Powermodule_Set;
	b_controlEnabled	: BOOL;
END_VAR

VAR
	r_DroopLimitMin		: REAL;
	r_DroopLimitMax		: REAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[r_DroopLimitMin := LIMIT(0,st_params.r_DroopMinimum, st_params.r_DroopMaximum );
r_DroopLimitMax := MAX(st_params.r_DroopMinimum, st_params.r_DroopMaximum);

//Write to powermodules
setMaster.r_FrequencyDroop	:= LIMIT(r_DroopLimitMin, set.r_FrequencyDroop, r_DroopLimitMax);
setMaster.r_VoltageDroop	:= LIMIT(r_DroopLimitMin, set.r_VoltageDroop,	r_DroopLimitMax);
setSlave.r_FrequencyDroop	:= LIMIT(r_DroopLimitMin, set.r_FrequencyDroop,	r_DroopLimitMax);
setSlave.r_VoltageDroop 	:= LIMIT(r_DroopLimitMin, set.r_VoltageDroop,	r_DroopLimitMax); 


// read from powermodules
IF NOT b_ControlEnabled THEN				//during startup control is disabled and the powermode only from first inverter. 
	get.e_PowerMode := get.PowermoduleMaster.e_PowerMode;
ELSE
	IF get.PowermoduleMaster.e_PowerMode = ePowerModes.Droop AND SEL(Settings.Configuration.b_DoublePowerModule, 1, get.PowermoduleSlave.e_PowerMode = ePowerModes.Droop) THEN
		get.e_PowerMode:= ePowerModes.Droop;
	ELSIF get.PowermoduleMaster.e_PowerMode = ePowerModes.DroopZeroStart AND SEL(Settings.Configuration.b_DoublePowerModule, 1, get.PowermoduleSlave.e_PowerMode = ePowerModes.DroopZeroStart) THEN
		get.e_PowerMode := ePowerModes.DroopZeroStart;
	ELSIF get.PowermoduleMaster.e_PowerMode = ePowerModes.Isochronous AND SEL(Settings.Configuration.b_DoublePowerModule, 1, get.PowermoduleSlave.e_PowerMode = ePowerModes.Isochronous) THEN
		get.e_PowerMode := ePowerModes.Isochronous;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ControlPowermodules" Id="{24fdff5b-85c7-47b1-b1be-9f3b70272437}" FolderPath="Private methods\">
      <Declaration><![CDATA[METHOD PRIVATE ControlPowermodules : BOOL

VAR_IN_OUT CONSTANT
	r_APloss	: REAL;
	r_RPloss	: REAL;
	st_params 	: ST_Powerstack_params;
END_VAR

VAR_IN_OUT
	setMaster			: ST_Powermodule_Set;
	setSlave			: ST_Powermodule_Set;
END_VAR

VAR_INST
	r_PmaxFinal						: REAL;
	r_PminFinal						: REAL;
	r_PLMfreqOffset					: REAL;
	r_PLMvoltOffset					: REAL;
	r_FreqDeltaLOM					: REAL;	
	ton_GridCodeTripDelay			: TON := (PT:= T#2S);
	ton_RampDisabled				: Ton := (PT := T#2S);
	fb_ramp_Pset					: fb_Ramp := (b_Enable := TRUE, r_rampRate := 50);
	fb_ramp_Qset					: fb_Ramp := (b_Enable := TRUE, r_rampRate := 50);
	r_Derating						: REAL;
	r_PM1Load						: REAL; // 0- 100 %
	r_PM2Load						: REAL; // 0- 100 % 
	r_GrossActivePower				: REAL;
	r_GrossReactivePower			: REAL;
	r_ActiveLossOffset				: REAL;
	r_ReactiveLossOffset			: REAL;
	
	// Nominal Voltage and frequency
	r_VoltageDroopOffset				: REAL;
	r_FrequencyDroopOffset				: REAL;
	
	r_Pmax			: REAL;
	r_Pmin			: REAL;
	r_ACcurrentLimit: REAL;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Variables to be used in the controls
r_PM1Load := SEL(b_doublePowermodule, 1, st_params.PowermoduleMaster.r_InverterRatedCurrent / get.r_RatedCurrent);
r_PM2Load := 1- r_PM1Load; // Same as 1- r_contributionPM1


//write to powermodules
//set island mode
setMaster.r_DroopIslandMode := st_params.r_DroopIslandMode;
setMaster.r_DroopMaximum := st_params.r_DroopMaximum;
setMaster.r_DroopMinimum := st_params.r_DroopMinimum;

//Control fan
setMaster.b_FanContactor := b_EnableFan;
setSlave.b_FanContactor := b_EnableFan;

//external gridcode trip (Now coming from missing phase current/ high current unbalance).
IF set.e_InverterMode = eInvertermodes.Afe OR setMaster.b_ExtgridCodeTrip THEN
	ton_GridCodeTripDelay(IN := b_extGridCodetrip);
	setMaster.b_ExtgridCodeTrip := ton_GridCodeTripDelay.Q;
	setSlave.b_ExtgridCodeTrip := ton_GridCodeTripDelay.Q;
END_IF

//calculate internal loss offset
r_ActiveLossOffset := r_APloss;
r_ReactiveLossOffset:= r_RPloss + st_params.r_ReactiveOffset;


ton_RampDisabled(IN := get.b_StartedState);
//Gross power: requested + internal loss 
r_grossActivePower := set.r_ActivePower * st_params.r_ActiveSetpointGain - r_ActiveLossOffset;
fb_ramp_Pset(IN := r_grossActivePower, SETtoIN := ton_RampDisabled.Q);
//magic reactive fix to the inverter:P
//SEL(set.r_ReactivePower < 0, -0.00039, -0.0007) * -set.r_ReactivePower + 1;
r_grossReactivePower := st_params.r_ReactiveSetpointGain * set.r_ReactivePower - r_ReactiveLossOffset;
fb_ramp_Qset(IN := r_grossReactivePower, SETtoIN := ton_RampDisabled.Q, SetZero:= NOT get.b_StartedState);


//Powerlimiting mode ugrid
PowerLimitingMode(
	enable := get.b_InverterGridFormingMode AND NOT set.b_DisableShifting,
	PowerLimitingMode := set.e_PowerLimitingMode,
	ActivePower := get.r_ActivePower,
	MaxPower := set.r_Pmax,
	MinPower := set.r_Pmin,
	ShiftHoldTimeRemaining => get.t_ShiftHoldTimeRemaining,
	Active	=> get.Events.b_PlimitShiftingActive,
	Pmax => r_PmaxFinal,
	Pmin => r_PminFinal,
	FreqOffset => r_PLMfreqOffset,
	VoltOffset => r_PLMvoltOffset,
	st_params := st_params.FreqVoltageShift,
	);
	
//Max Charge Power
SetMaster.r_Pmin := r_PminFinal * r_PM1Load;
SetSlave.r_Pmin := r_PminFinal * r_PM2Load;
//Max Discharge Power
SetMaster.r_Pmax := r_PmaxFinal * r_PM1Load;
SetSlave.r_Pmax := r_PmaxFinal * r_PM2Load;
//Max AC current limit (first reactive limits, then active);
SetMaster.r_ACcurrentLimit := set.r_ACcurrentLimit * r_PM1Load;
SetSlave.r_ACcurrentLimit:= set.r_ACcurrentLimit * r_PM2Load;

//ActivePower
setMaster.r_ActivePower := SEL(set.r_Pmax = 0 AND fb_ramp_Pset.Q > 0, fb_ramp_Pset.Q * r_PM1Load, st_params.i_ChargeOnlyIdlePower); 
setSlave.r_ActivePower := fb_ramp_Pset.Q * r_PM2Load; 


//Set Reactive Power
setMaster.r_ReactivePower := fb_ramp_Qset.Q * r_PM1Load;// fb_ramp_Qset.Q  // fb_ramp_Qset.Q * r_PM1Load;
setSlave.r_ReactivePower := fb_ramp_Qset.Q * r_PM2Load; //fb_ramp_Qset.Q * r_PM2Load;

//Overcurrent factor
setMaster.r_overcurrentFactor := CoolingDerating();
setSlave.r_overcurrentFactor := CoolingDerating();

//Max power change rate
SetMaster.i_PowerChangeRate := st_params.i_MaxPowerChangeRate; //limit to 300%/s 
SetSlave.i_PowerChangeRate := st_params.i_MaxPowerChangeRate;

//set frequency to inverter
r_FreqDeltaLOM := FreqPulseDelta(LOM.b_enable AND settings.MachineParams.Powerstack.LOM.EnablePowerPulse,
								PulseSize := st_params.LOM.PowerPulseSize,
								Droop := get.r_FrequencyDroop, 
								DetectionTime := SEL(st_params.LOM.ForceSlowDetection, st_params.LOM.DetectionTimeFast_ms, st_params.LOM.DetectionTimeSlow_ms)
								);


		
								
setMaster.r_NomFrequency := set.r_NominalOutputFrequency + r_FreqDeltaLOM + r_PLMfreqOffset;
SetSlave.r_NomFrequency := set.r_NominalOutputFrequency + r_FreqDeltaLOM + r_PLMfreqOffset;


//set voltage to inverter
setMaster.r_NomVoltage := set.r_NominalOutputVoltage + r_PLMVoltOffset;
SetSlave.r_NomVoltage := set.r_NominalOutputVoltage + r_PLMvoltOffset;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="CoolingDerating" Id="{a2b7fe03-3749-405f-addf-802adb58d032}" FolderPath="Private methods\">
      <Declaration><![CDATA[METHOD CoolingDerating : REAL

VAR_INST
	percentage			: REAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Cooling derating
IF by_CoolingPowerRequest <> 2 AND get.b_ControlEnabled THEN
	percentage := LIMIT(0, 100 - st_params.ui_DeratingLimCooling, st_params.ui_OvercurrentRating);
	get.Events.b_CoolingDerating := TRUE;
ELSE
	percentage := st_params.ui_OvercurrentRating;
	get.Events.b_CoolingDerating := FALSE;
END_IF

CoolingDerating := percentage / 100;]]></ST>
      </Implementation>
    </Method>
    <Action Name="CoolingReady_active" Id="{992a4870-d306-49b3-a28a-eceec44bff46}" FolderPath="SFC\">
      <Implementation>
        <ST><![CDATA[IF eControl <> stand_by THEN
	by_CoolingControl := 2;
END_IF

get.e_State := eStatusPowerStack.Wait_CoolingMode2;

SFCTIP := 	((by_CoolingPowerRequest > 1 AND NOT DetectConnectionLoss(TRUE)) OR 
			(eControl = stand_by AND by_CoolingPowerRequest =1)) AND NOT SFCTip;]]></ST>
      </Implementation>
    </Action>
    <Method Name="DetectConnectionLoss" Id="{e7cf7181-36d1-4c92-ae84-7e4947314c05}" FolderPath="Private methods\">
      <Declaration><![CDATA[METHOD DetectConnectionLoss : BOOL
VAR_INPUT
	CurrentState		: BOOL;
END_VAR

VAR_INST
	ftrig_Input 	: F_TRIG;
	ftrig_Output 	: F_TRIG;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[ftrig_Output(CLK := b_OutputConnected);
ftrig_Input(CLK:= b_InputConnected);

IF NOT b_OutputConnected AND ftrig_Input.Q THEN
	DetectConnectionLoss := TRUE;
END_IF


IF NOT b_InputConnected AND ftrig_Output.Q THEN
	DetectConnectionLoss := TRUE;
END_IF

IF CurrentState THEN
	DetectConnectionLoss := NOT (b_InputConnected OR b_OutputConnected);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="DetectGridSync" Id="{a4c08ebe-593b-4a36-b9d6-917c4313fc87}" FolderPath="Private methods\">
      <Declaration><![CDATA[METHOD PRIVATE DetectGridSync : BOOL
VAR_INPUT
	b_netconFB					: BOOL;
	b_InverterGridFormingMode	: BOOL;
	b_ExtGridConnected			: BOOL;
	b_ACOK						: BOOL;
	b_IsochroneMode				: BOOL;
	b_GridCodeActiveInverter 	: BOOL;
	b_GridCodeTripInverter		: BOOL;
	t_GridLostMaxTripTime		: TIME;
	t_GridOKReleaseTime			: TIME;
END_VAR

VAR_INST
	rTrigStartCommand			: R_TRIG;
	b_inverterGridCodeOK			: BOOL;
	b_AFErequested				: BOOL;
	ton_DetectionDelay			: TON := (PT := T#50MS);
	ton_DetectionDelayNoGrid	: TON := (PT := T#50MS);
	b_ExtGridCheck				: BOOL;
	tp_ExtGridLost				: TP := (PT := T#40MS);
	fTrig_ACOK					: F_TRIG;
	ton_GridLostRelease			: TON := (PT := T#0M);
	ton_GridTripDelay			: TON ;
	DisableGCtrip				: TOF := (PT:= T#1S);
END_VAR


VAR_IN_OUT
	b_Gridtied				: BOOL;
	b_GridCodeOK			: BOOL;
	b_gridCheckActive		: BOOL;
	b_ACdetected			: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[PowermoduleMaster.set.b_GridCodeEnable := st_params.b_GridCodesEnabled;

// update AC detected while not connected to busbar
b_ExtGridCheck := b_ExtGridConnected AND b_InverterGridFormingMode; // OLD: get.e_InverterMode = eInvertermodes.Afe;
ton_DetectionDelay(IN := NOT b_ACOK OR (b_netconFB AND NOT get.b_InverterRunning));
tp_ExtGridLost(IN := NOT b_ExtGridConnected, PT := TO_TIME(settings.GridParams.ui_GCTripMaxTripTime));
IF ton_DetectionDelay.Q OR NOT b_netconFB OR b_ExtGridCheck OR tp_ExtGridLost.Q THEN
	b_ACdetected	:= b_ACOK;
END_IF

//conditions where gridAC is not possible.
//ton_DetectionDelayNoGrid(IN := b_netconFB AND b_InverterGridFormingMode AND get.b_StartedState); // OLD: get.e_InverterMode = eInvertermodes.Afe;
//IF ton_DetectionDelayNoGrid.Q THEN
//	b_ACdetected := FALSE;
//END_IF

//Grid OK inverter statement
b_inverterGridCodeOK := NOT b_GridCodeActiveInverter OR (NOT b_GridCodeTripInverter AND b_GridCodeActiveInverter);

//disable GC Trip
DisableGCTrip(IN:= detectConnectionLoss(TRUE));


//Manual gridlost check
b_AFERequested := set.e_InverterMode = eInvertermodes.Afe;
b_gridCheckActive := b_AFERequested OR NOT b_gridCodeOK AND NOT DisableGCTrip.Q; //or not netconfb ;
//b_gridCheckActive := set.e_InverterMode = eInvertermodes.Afe AND get.b_ControlEnabled AND NOT DisableGCTrip.Q;

LOM(r_Freq := get.r_FrequencyD7, 
	r_NomFreq := set.r_NominalOutputFrequency, 
	r_Volt:= Get.r_ACVoltageD7,
	b_enable := Get.b_StartedState AND get.e_PowerMode = ePowermodes.Isochronous AND get.e_InverterMode <> eInvertermodes.Afe,
	SlowDetection:= set.b_slowLom, //only activate fast when external grid is coupled.
	st_params := st_params.LOM);

IF LOM.Q THEN
	b_gridCheckActive := TRUE;
END_IF

IF b_ACOK AND b_gridCodeOK THEN
	LOM.Reset();
END_IF


ton_GridTripDelay(IN:= NOT b_ACOK AND b_gridCheckActive, PT := t_GridLostMaxTripTime);
IF ton_GridTripDelay.Q OR NOT b_inverterGridCodeOK OR LOM.Q THEN
	b_ACdetected := FALSE;
	b_gridCodeOK := FALSE;
END_IF

get.t_GridCodeReconnectTime := ton_GridLostRelease.PT - ton_GridLostRelease.ET;

ton_GridLostRelease(
	IN := b_ACOK AND b_inverterGridCodeOK AND NOT LOM.Q AND NOT b_gridCodeOK,
	PT := SEL(b_gridCheckActive AND b_AFERequested, T#1S, t_GridOKReleaseTime)
	);

rTrigStartCommand(CLK:= eControl = start);
IF ton_GridLostRelease.Q OR NOT get.b_ControlEnabled OR DisableGCTrip.Q OR rTrigStartCommand.Q THEN
	b_gridCodeOK := TRUE;
END_IF

get.Events.b_GridCodeWarning := NOT b_gridCodeOK;
b_Gridtied := b_netconFB AND b_gridCodeOK AND b_gridCheckActive;


]]></ST>
      </Implementation>
    </Method>
    <Method Name="EMstop" Id="{46aaf967-2b26-442a-80d8-17fc558e0a20}">
      <Declaration><![CDATA[METHOD PUBLIC EMstop : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[EMstop := 
	SFCCurrentStep = 'Init' AND Netcontactor.Open() AND ShutdownFull(TRUE);
//Set internal control mode to shutdown
eControl := Shutdown;



//force SFC to init with execution of init step
SFCReset := TRUE;

IF EMstop THEN
	get.e_State := eStatusPowerStack.off;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FreqCheckPLimitUgrid" Id="{ff4c3315-43ed-4082-b2d1-4e7ccbce0575}" FolderPath="Private methods\">
      <Declaration><![CDATA[METHOD FreqCheckPLimitUgrid : BOOL
VAR_INPUT
	b_enable			: BOOL;
	r_Frequency			: REAL;
	r_LowFreqLim		: REAL;
	r_HighFreqLim		: REAL;
	t_TriggerDelay		: TIME := T#1000MS;
END_VAR

VAR_OUTPUT
	b_LowFreqTrip		: BOOL;
	b_HighFreqTrip		: BOOL;
END_VAR

VAR_INST
	ton_TriggerDelay	: TON;
	Activate			: BOOL;
END_VAR


]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*
-------INFO---------
This function is added to raise a normal shutdown before the inverter does at under/over frequency in ugrid.
this under/over frequency check is raised when the pmax or pmin limit is reached in ugrid mode resulting in frequency shift done by inverter.
To avoid a trip by inverter underfrequency, resulting in ac outage, we detect the event slightly earlier.
This creates a normal shutdown command in the error program and will keep possibility of correctly stopping the cooling supply.
If this script was not here, the under frequency trip of the inverter would be seen, leading to AC outage and this
interrupts all internal AC devices. Especially for the heatpump, this is undesirable. 
*)


activate := b_enable AND LIMIT(get.r_Pmin, get.r_ActivePower, get.r_Pmax) <> get.r_ActivePower; 
ton_triggerDelay(IN := (r_Frequency < r_LowFreqLim OR r_Frequency > r_HighFreqLim) AND activate, PT := t_TriggerDelay);

IF ton_triggerDelay.Q THEN
	b_LowFreqTrip := r_Frequency < r_LowFreqLim;
	b_HighFreqTrip := r_Frequency > r_HighFreqLim;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FreqPulseDelta" Id="{1b9a15d6-f112-4c8f-b179-fc4c3db05a33}" FolderPath="Private methods\">
      <Declaration><![CDATA[METHOD FreqPulseDelta : REAL
VAR_INPUT
	Enable			: BOOL;
	PulseSize		: REAL; // % of ratedpower
	Droop			: REAL;
	DetectionTime	: UINT;
END_VAR

VAR_INST
	DetectionTimeFactor	: UINT := 3; 
	FreqShift			: REAL;
	ton_PulseTime		: TON;
	b_toggleState		: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*-------INFO---------
This function is for intentionally disturbing the frequency setpoint of the inverter in a microgrid. It has been with grid and genset connected.
Testing must be done for multiple batteries in ugrid mode. The small disturbances are made on the frequency. The pulsesize is in % of rated power.
The change of the frequency therefore is relative to the droop settings and the nominal frequency setting.
The detection time and a multiplication factor gives the sweet spot of the pulse time and detection mechanism in the LOM detection.

If this puls is disabled in ugrid, the LOM detection might not function properly and
frequency might drift away in case of grid loss before transition to island mode is made.
*)

ton_PulseTime(IN := NOT ton_pulseTime.Q, PT := TO_TIME(detectionTime*DetectionTimeFactor)); //must be bigger than detection time. factor 5 seems fine.

IF ton_pulseTime.Q THEN
	b_ToggleState := NOT b_toggleState;
END_IF


FreqShift := PulseSize / 100 * settings.GridParams.r_GridNominalFrequency * Droop / 100; 
IF enable THEN
	FreqPulseDelta := SEL(b_toggleState, -1, 1) * FreqShift;
ELSE
	FreqPulseDelta := 0;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetDiagnostics" Id="{1d11429f-eaaf-463e-9e1f-f600f7faa67f}">
      <Declaration><![CDATA[METHOD PUBLIC GetDiagnostics
VAR_IN_OUT
	AddError		: ARRAY [*] OF FB_AddErrorST;
	a_ActiveEvents	: ARRAY [*] OF ST_ErrorStruct;
	w_Index			: WORD;
END_VAR

VAR_INST
	varString		: STRING;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*POWERSTACK*)
	//Warnings
	(*DC voltage diff*) 	AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_DCdeviationHigh,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 1,
			e_ObjectID				:= eObject_ID.PowerStack,
			s_Message				:= 'DC voltage difference between powermodules high',
			e_sev					:= eseverity.Warning
			);
		w_Index := w_Index +1;
	
	(*Temperature*) 			AddError[w_Index](
			b_ErrorTrig			:= Get.Events.b_TemperatureDeviationHigh,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID					:= 2,
			e_ObjectID				:= eObject_ID.PowerStack,
			s_Message				:= 'temperature difference between powermodules high',
			e_sev					:= eseverity.Warning,
			b_AutoClear			:= TRUE,
		);
		w_Index := w_Index +1;
		
	(*UnderFreq limit exceeded*)	AddError[w_Index](
			b_ErrorTrig				:= Get.Events.b_UnderFreqFault ,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 3,
			e_ObjectID				:= eObject_ID.PowerStack,
			s_Message				:= 'under frequency trip',
			e_sev					:= eseverity.normalshutdown
		);
		w_Index := w_Index +1;	
		
	(*OverFreq limit exceeded*)		AddError[w_Index](
			b_ErrorTrig				:= Get.Events.b_OverFreqFault,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 4,
			e_ObjectID				:= eObject_ID.PowerStack,
			s_Message				:= 'over frequency trip',
			e_sev					:= eseverity.normalshutdown
		);
		w_Index := w_Index +1;	
		
	(*Cooling derating*)	AddError[w_Index](
			b_ErrorTrig			:=  get.Events.b_CoolingDerating,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 5,
			s_Message				:= 'Cooling system derating causing inverter output to be limited',
			e_sev					:= eseverity.warning,
			b_autoclear				:= TRUE,
		);
		w_Index := w_Index +1;

	(*SFC Timeout*)	AddError[w_Index](
			b_ErrorTrig				:= SFCerror,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 6,
			e_ObjectID				:= eObject_ID.PowerStack,
			s_Message				:= CONCAT('SFC error at step: ', s_errorstep),
			e_sev					:= eseverity.NormalShutdown
		);
		w_Index := w_Index +1;
		
		
(*Start inhibit*)	AddError[w_Index](
			b_ErrorTrig				:= NOT get.b_StartEnabled AND set.e_InverterMode = eInvertermodes.Afe,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 8,
			s_Message				:= CONCAT('Inverter starting in grid following mode inhibited, ',SEL(NOT get.b_GridCodeOK AND get.b_GridCodeCheckActive, 'waiting for grid AC','waiting for gridcode release')),
			e_sev					:= eseverity.info,
			b_autoclear				:= TRUE,
		);
		w_Index := w_Index +1;
		
(*Start inhibit*)	AddError[w_Index](
			b_ErrorTrig			:= NOT get.b_StartEnabled AND set.e_InverterMode = eInvertermodes.Island,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 9,
			s_Message				:= 'Inverter starting in grid forming mode inhibited, disconnect AC from busbar',
			e_sev					:= eseverity.info,
			b_autoclear				:= TRUE,
		);
		w_Index := w_Index +1;
		
	(*Overvoltage fault*)	AddError[w_Index](
			b_ErrorTrig			:= get.Events.b_OverVoltageFault,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 10,
			s_Message				:= 'Overvoltage fault', //10-12-2024: change to normalshutdown once verified
			e_sev					:= eseverity.warning,
			b_autoclear				:= FALSE,
		);
		w_Index := w_Index +1;
		
	(*underVoltage fault*)	AddError[w_Index](
			b_ErrorTrig			:= get.Events.b_underVoltageFault,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 11,
			s_Message				:= 'Undervoltage fault',
			e_sev					:= eseverity.warning, // 10-12-2024: change to normalshutdown once verified 
			b_autoclear				:= FALSE,
		);
		w_Index := w_Index +1;
		
	(*Overvoltage warning*)	AddError[w_Index](
			b_ErrorTrig			:= get.Events.b_OverVoltageFault,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 12,
			s_Message				:= 'Overvoltage warning',
			e_sev					:= eseverity.warning,
			b_autoclear				:= TRUE,
		);
		w_Index := w_Index +1;
		
	(*underVoltage fault*)	AddError[w_Index](
			b_ErrorTrig			:= get.Events.b_underVoltageFault,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 13,
			s_Message				:= 'Undervoltage warning',
			e_sev					:= eseverity.warning,
			b_autoclear				:= TRUE,
		);
		w_Index := w_Index +1;

		(*Overvoltage warning*)	AddError[w_Index](
			b_ErrorTrig			:= get.Events.b_TemperatureFault,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 14,
			s_Message				:= 'Temperature fault',
			e_sev					:= eseverity.warning,
			b_autoclear				:= TRUE,
		);
		w_Index := w_Index +1;
		
	(*underVoltage fault*)	AddError[w_Index](
			b_ErrorTrig			:= get.Events.b_TemperatureWarning,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 15,
			s_Message				:= 'Temperature warning',
			e_sev					:= eseverity.warning,
			b_autoclear				:= TRUE,
		);
		w_Index := w_Index +1;
		
(*Plimit warning*)	AddError[w_Index](
			b_ErrorTrig				:= get.Events.b_PlimitShutdownWarning,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 16,
			s_Message				:= CONCAT(CONCAT('Power limit reached, shutdown in ', TO_STRING(get.Events.ui_shutdownRemainingTime)),'s'),
			e_sev					:= eseverity.warning,
			b_autoclear				:= TRUE,
		);
		w_Index := w_Index +1;
		
(*Plimit shutdown*)	AddError[w_Index](
			b_ErrorTrig				:= get.Events.b_PlimitShutdown,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 17,
			s_Message				:= 'Power limit shutdown',
			e_sev					:= eseverity.normalshutdown,
			b_autoclear				:= TRUE,
		);
		w_Index := w_Index +1;
		
(*Plimit shifting *)	AddError[w_Index](
			b_ErrorTrig				:= get.Events.b_PlimitShiftingActive,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 18,
			s_Message				:= CONCAT(CONCAT(TO_STRING(set.e_PowerLimitingMode), ' active, output on hold for: '), TO_STRING(get.t_ShiftHoldTimeRemaining)),
			e_sev					:= eseverity.Warning,
			b_autoclear				:= TRUE,
		);
		w_Index := w_Index +1;

		
IF get.b_GridACdetected THEN
	varstring := CONCAT('gridcode disconnect active, reconnecting in: ', TO_STRING(get.t_GridCodeReconnectTime));
ELSE
	varstring := 'gridcode disconnect active, reset to reconnect in island mode';
END_IF
		
(*Gridcode disconnect *)	AddError[w_Index](
			b_ErrorTrig				:= get.Events.b_GridCodeWarning,
			out_ST_Error			:= a_ActiveEvents[w_Index],
			w_ErrorID				:= 19,
			s_Message				:= varstring,
			e_sev					:= eseverity.warning,
			b_autoclear				:= TRUE,
		);
		w_Index := w_Index +1;



(*INSERT NESTED OBJECTS*)
Netcontactor.GetDiagnostics(AddError := AddError, a_activeEvents:= a_ActiveEvents, w_Index:= w_Index);
PowermoduleMaster.GetDiagnostics(AddError := AddError, a_activeEvents:= a_ActiveEvents, w_Index:= w_Index);
PowermoduleSlave.GetDiagnostics(AddError := AddError, a_activeEvents:= a_ActiveEvents, w_Index:= w_Index);

]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetWearCounters" Id="{8d7a4bda-c016-4f91-a559-ba02cd1889bc}">
      <Declaration><![CDATA[METHOD GetWearCounters : BOOL
VAR_INST
	RightNetContactor	:	FB_Varlogger;
	LeftNetContactor	:	FB_Varlogger;
	
	MasterPmMCCB		:	FB_Varlogger;
	MasterPmDCMain		:	FB_Varlogger;
	MasterPmPrecharge	:	FB_Varlogger;
	MasterPMACFanHrs	:	FB_Varlogger;		
	
	SlavePmMCCB			:	FB_Varlogger;
	SlavePmDCMain		:	FB_Varlogger;
	SlavePmPrecharge	:	FB_Varlogger;
	SlavePMACFan		:	FB_Varlogger;
	
	SlowDataTimer				:	TON := (PT := T#30M);
	
	initdone		:	Bool;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SlowDataTimer(in := NOT SlowDataTimer.Q);

IF get.PowermoduleMaster.w_OperationHours > 0 THEN
	Wearlogging.SetInteger(eLogItemGroupID.PowerStack, 	'MstrInvHrs', 				eLogTypes.WriteValue, 		WORD_TO_LINT(get.PowermoduleMaster.w_OperationHours));
END_IF
Wearlogging.SetFloat(eLogItemGroupID.PowerStack, 	'MstrMaxDischCurrentEver', 	eLogTypes.KeepHighestValue, REAL_TO_LREAL(get.PowermoduleMaster.r_ACCurrent));
Wearlogging.SetFloat(eLogItemGroupID.PowerStack, 	'MstrMaxChargeCurrentEver', eLogTypes.KeepLowestValue, 	REAL_TO_LREAL(get.PowermoduleMaster.r_AcCurrent));
		
												
MasterPmMCCB(			TriggerInput := get.PowermoduleMaster.b_MccbFb, 
						LogItemGroup :=  eLogItemGroupID.PowerStack, 
						LogItemName := 'MstrMCCBCnt', 
						LogType := eLogTypes.TrackCycles);	
						
MasterPmDCMain(			TriggerInput := get.PowermoduleMaster.b_DCcontactorFb, 
						LogItemGroup :=  eLogItemGroupID.PowerStack, 
						LogItemName := 'MstrDcMainCnt', 
						LogType := eLogTypes.TrackCycles);							

MasterPmPrecharge(		TriggerInput := get.PowermoduleMaster.b_PrechargeContactor, 
						LogItemGroup :=  eLogItemGroupID.PowerStack, 
						LogItemName := 'MstrDcPrechargeCnt', 
						LogType := eLogTypes.TrackCycles);		

MasterPMACFanHrs(		TriggerInput := get.PowermoduleMaster.b_FanFb, 
						LogItemGroup :=  eLogItemGroupID.PowerStack, 
						LogItemName := 'MstrAcFanHrs', 
						LogType := eLogtypes.TrackOnTime);	



					
IF b_doublePowermodule THEN
	Wearlogging.SetInteger(eLogItemGroupID.PowerStack, 	'SlvInvHrs', 				eLogTypes.WriteValue, 		WORD_TO_LINT(get.PowermoduleSlave.w_OperationHours));
	Wearlogging.SetFloat(eLogItemGroupID.PowerStack, 	'SlvMaxDischCurrentEver', 	eLogTypes.KeepHighestValue, REAL_TO_LREAL(get.PowermoduleSlave.r_ACCurrent));
	Wearlogging.SetFloat(eLogItemGroupID.PowerStack, 	'SlvMaxChargeCurrentEver', 	eLogTypes.KeepLowestValue, 	REAL_TO_LREAL(get.PowermoduleSlave.r_AcCurrent));		
												
	SlavePmMCCB(			TriggerInput := get.PowermoduleSlave.b_MccbFb, 
							LogItemGroup :=  eLogItemGroupID.PowerStack, 
							LogItemName := 'SlvMCCBCnt', 
							LogType := eLogTypes.TrackCycles);	
							
	SlavePmDCMain(			TriggerInput := get.PowermoduleSlave.b_DCcontactorFb, 
							LogItemGroup :=  eLogItemGroupID.PowerStack, 
							LogItemName := 'SlvDcMainCnt', 
							LogType := eLogTypes.TrackCycles);							
	
	SlavePmPrecharge(		TriggerInput := get.PowermoduleSlave.b_PrechargeContactor, 
							LogItemGroup :=  eLogItemGroupID.PowerStack, 
							LogItemName := 'SlvDcPrechargeCnt', 
							LogType := eLogTypes.TrackCycles);		
	
	SlavePMACFan(			TriggerInput := get.PowermoduleSlave.b_FanFb, 
							LogItemGroup :=  eLogItemGroupID.PowerStack, 
							LogItemName := 'SlvAcFanHrs', 
							LogType := eLogTypes.TrackOnTime);	
END_IF


RightNetContactor(		TriggerInput := get.Netcontactor.b_NetcontRightFb, 
						LogItemGroup :=  eLogItemGroupID.PowerStack, 
						LogItemName := 'NetcRightCnt', 
						LogType := eLogTypes.TrackCycles);		
												
LeftNetContactor(		TriggerInput := get.Netcontactor.b_NetcontLeftFb, 
						LogItemGroup :=  eLogItemGroupID.PowerStack, 
						LogItemName := 'NetcLeft', 
						LogType := eLogTypes.TrackCycles);	
						
IF NOT initdone THEN
	Wearlogging.SetFloat(eLogItemGroupID.General, 	'nameplatePowerCapacity', 	eLogTypes.WriteValue, 	TO_DINT(SEL(settings.Configuration.b_DoublePowerModule, 360, 720)));
	initdone := TRUE;		
END_IF						]]></ST>
      </Implementation>
    </Method>
    <Method Name="InternalAcCheck" Id="{e2e887b9-c272-412f-99d6-3d2027ffcc7d}" FolderPath="Private methods\">
      <Declaration><![CDATA[METHOD PRIVATE InternalAcCheck : BOOL
VAR_INPUT
	r_ACVoltage	: REAL;
	r_ACFreq	: REAL;
END_VAR

VAR_INST
	b_VoltageOK				: BOOL;
	b_FrequencyOK			: BOOL;
	tof_ReleaseACNOK		: TOF := (PT:= T#2S);
	
	tof_MaxRetryTimeOut		: Tof := (PT:= T#60S);
	ton_ResetRetries		: TON := (PT:= T#60S);
	by_maxRetries			: BYTE := 5;
	by_retries				: BYTE;
	r_trigOK				: r_TRIG;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[b_VoltageOK	:= LIMIT(350, r_ACVoltage, 450) = r_ACVoltage;
b_FrequencyOK :=  LIMIT(45, r_ACFreq, 65) = r_ACFreq;

tof_ReleaseACNOK(IN:= b_VoltageOK AND b_FrequencyOK); 
	
r_trigOK(CLK := tof_ReleaseACNOK.Q);
IF r_trigOK.Q THEN
	by_Retries := by_retries + 1;
END_IF
IF by_Retries > by_MaxRetries THEN
	by_Retries := 0;
	tof_MaxRetryTimeOut(IN := TRUE);
ELSE
	tof_MaxRetryTimeOut(IN := FALSE);
END_IF
	
InternalAcCheck := tof_ReleaseACNOK.Q AND NOT tof_MaxRetryTimeOut.Q;
ton_ResetRetries(IN:= InternalAcCheck);
IF ton_ResetRetries.Q THEN
	by_Retries := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="PowerLimitingMode" Id="{be42d950-2cca-4baa-bdef-0cabc61eaa34}" FolderPath="Private methods\">
      <Declaration><![CDATA[METHOD PowerLimitingMode;
VAR_INPUT
	enable					: BOOL;
	PowerLimitingMode		: ePLM;
	ActivePower				: REAL;
	MaxPower				: REAL;
	MinPower				: REAL;
END_VAR
VAR_IN_OUT CONSTANT
	st_params : ST_powerstack_ShiftingParams;
END_VAR

VAR_INST
	tof_shiftHoldTime	: Tof := (PT := T#20M);
	tPulseRate			: TIME := T#100MS;
	tonIncreasePulse	: TON := (PT := T#100MS);
	OffsetCounter		: CTUD;
	i_counterValue		: INT;
	PDeadband			: REAL := 3;
	PmaxReached			: BOOL;
	PminReached			: BOOL;
	Nolimit				: BOOL;
	
	MaxVoltOffsetUp		: REAL := 40;
	MaxVoltOffsetDown	: REAL := 40;
	
	MaxFreqOffsetUp		: REAL := 2.5;
	MaxFreqOffsetDown	: REAL := 2.5;
	
	r_FreqStepUp	: REAL := 0.1; // hz/s
	r_FreqStepDown	: REAL := 0.1; // hz/s
	r_FreqStepActual: REAL ;
	r_VoltStepUp	: REAL := 0.1; // V/s
	r_VoltStepDown 	: REAL := 0.1;
	r_VoltStepActual: REAL ;
	
	w_CounterSteps		: WORD := 1000;
	ton_InitialPmaxDelay	: TON := (PT := T#1S);
	ton_InitialPminDelay	: TON := (PT := T#1S);
	ton_shutdownTimer	: TON := (PT := T#1M);
	shutdownTrigger		: BOOL;
END_VAR

VAR_OUTPUT
	ShiftHoldTimeRemaining 	: TIME;
	Active				: BOOL;
	Pmax				: REAL;
	Pmin				: REAL;
	FreqOffset			: REAL;
	VoltOffset			: REAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT enable THEN
	Pmax := MaxPower;
	Pmin := MinPower;
	get.Events.b_PlimitShutdownWarning := FALSE;
	get.Events.b_PlimitShutdown := FALSE;
	active := FALSE;
	ShiftHoldTimeRemaining := st_params.ShiftingHoldTime;
	RETURN;
END_IF

shutdownTrigger	:= FALSE;
ton_InitialPmaxDelay(in := ActivePower > MAX(MaxPower, PDeadband), pt := st_params.InitialOverloadDelay);
ton_InitialPminDelay(in := ActivePower < MIN(MinPower, -PDeadband), pt := st_params.InitialOverloadDelay);

PmaxReached := ton_InitialPmaxDelay.Q;
PminReached	:= ton_InitialPminDelay.Q;

Nolimit := NOT PmaxReached AND NOT PminReached;

//max voltage offsets based on grid settings
MaxVoltOffsetUp := LIMIT(settings.GridParams.r_GridNominalVoltage, st_params.VoltMaxPu * settings.GridParams.r_GridNominalVoltage, settings.GridParams.r_GridvoltageMax) - settings.GridParams.r_GridNominalVoltage;
MaxVoltOffsetDown := settings.GridParams.r_GridNominalVoltage - LIMIT(settings.GridParams.r_GridvoltageMin, st_params.VoltMinPu * settings.GridParams.r_GridNominalVoltage, settings.GridParams.r_GridNominalVoltage);
r_VoltStepUp := MaxVoltOffsetUp / MAX(1, w_CounterSteps);
r_VoltStepDown := MaxVoltOffsetDown/ MAX(1, w_CounterSteps);
r_VoltStepActual := SEL(i_countervalue < 0, r_VoltStepUp, r_VoltStepDown);

//max frequency offsets based on grid settings
MaxFreqOffsetUp := LIMIT(settings.GridParams.r_GridNominalFrequency, st_params.FreqMaxPu * settings.GridParams.r_GridNominalFrequency, settings.GridParams.r_GridFrequencyMax) - settings.GridParams.r_GridNominalFrequency;
MaxFreqOffsetDown := settings.GridParams.r_GridNominalFrequency - LIMIT(settings.GridParams.r_GridFrequencyMin, st_params.FreqMinPu * settings.GridParams.r_GridNominalFrequency, settings.GridParams.r_GridNominalFrequency);
r_FreqStepUp := MaxFreqOffsetUp / MAX(1, w_CounterSteps);
r_FreqStepDown := MaxFreqOffsetDown / MAX(1, w_CounterSteps);
r_FreqStepActual := SEL(i_countervalue < 0, r_FreqStepUp, r_FreqStepDown);

//If shifting is done and limit is released. Hold current counter for 20 min, before reducing.
tof_shiftHoldTime(IN := (i_countervalue <> 0 AND NOT Nolimit), PT := st_params.ShiftingHoldTime);

//pulse Timer
tonIncreasePulse(IN := NOT tonIncreasePulse.Q, PT := tPulseRate);

OffsetCounter(
	CU := ((PminReached OR (i_countervalue < 0 AND Nolimit AND NOT tof_shiftHoldTime.Q)) AND tonIncreasePulse.Q) AND NOT OffsetCounter.QU,
	CD := ((PmaxReached OR (i_countervalue > 0 AND Nolimit AND NOT tof_shiftHoldTime.Q)) AND tonIncreasePulse.Q) AND NOT OffsetCounter.QD,
	LOAD := NOT get.b_StartedState,
	PV := SEL(get.b_StartedState, w_CounterSteps, w_CounterSteps*2));
i_countervalue := OffsetCounter.CV - w_CounterSteps;

CASE PowerLimitingMode OF
	ePLM.FreqShift: //default controlled by inverters
		Pmax := get.r_RatedPower;
		Pmin := -get.r_RatedPower;
		FreqOffset := LIMIT(-MaxFreqOffsetDown, r_FreqStepActual * i_countervalue, MaxFreqOffsetUp);
		
	ePLM.VoltShift:
		VoltOffset := LIMIT(-MaxVoltOffsetDown, r_VoltStepActual * i_countervalue, MaxVoltOffsetUp);
		Pmax := get.r_RatedPower;
		Pmin := -get.r_RatedPower;
		
	ePLM.FreqVoltShift:
		VoltOffset := LIMIT(-MaxVoltOffsetDown, r_VoltStepActual * i_countervalue, MaxVoltOffsetUp);
		FreqOffset := LIMIT(-MaxFreqOffsetDown, r_FreqStepActual * i_countervalue, MaxFreqOffsetUp);
		Pmax := get.r_RatedPower;
		Pmin := -get.r_RatedPower;
		
	ePLM.Shutdown:
		shutdownTrigger	:= NOT Nolimit;
		Pmax := get.r_RatedPower;
		Pmin := -get.r_RatedPower;	
END_CASE

ton_shutdownTimer(IN:= shutdownTrigger AND get.b_StartedState, PT := st_params.ShutdownDelay);
IF get.Events.b_PlimitShutdownWarning THEN
	get.Events.ui_shutdownRemainingTime := TO_UINT(TO_REAL(ton_shutdownTimer.PT - ton_shutdownTimer.ET)/ 1000);
END_IF

//outputs and events
Active := i_countervalue <> 0 AND PowerLimitingMode <> ePLM.Shutdown;
ShiftHoldTimeRemaining := tof_shiftHoldTime.PT - tof_shiftHoldTime.ET;
get.Events.b_PlimitShutdownWarning := ton_shutdownTimer.IN;
get.Events.b_PlimitShutdown := ton_shutdownTimer.Q;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{3608d5c6-5c10-4736-8fb3-11ae035aa650}">
      <Declaration><![CDATA[METHOD PUBLIC Reset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Reset := Netcontactor.Reset() AND PowermoduleMaster.Reset() AND PowerModuleSlave.Reset() AND get.e_State <> eStatusPowerstack.fault;

standbyDeactivateState := FALSE;
get.b_GridCodeOK := TRUE;
//rs_Stop.RESET1 := TRUE;
//rs_StartUp.RESET1:= TRUE;	
//rs_Shutdown.RESET1:= TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetEvents" Id="{db954732-a49e-4010-b182-6f513f1206f2}" FolderPath="Private methods\">
      <Declaration><![CDATA[METHOD PRIVATE SetEvents
VAR_IN_OUT
	events							: ST_PowerStack_Events;
END_VAR

VAR_IN_OUT CONSTANT
	st_params						: ST_Powerstack_Params;
END_VAR


VAR
	r_DCVoltageDeviation			: REAL := 0.02; //2%
	r_TemperatureDeviation			: REAL:= 10; // 10C
END_VAR

VAR_INST
	tp_ACdetectionCheck				: TON:= (PT:=T#2S);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF b_doublePowermodule THEN
	//DC Voltage Deviation higher than 2% between powermodules
	events.b_DCdeviationHigh:= ABS(get.PowermoduleMaster.r_DCVoltage - get.PowermoduleSlave.r_DCVoltage) > get.r_DCVoltage * r_DcVoltageDeviation;
	
	//Temperature Deviation between highest temperature in powermodules higher than 10C
	events.b_temperatureDeviationHigh:= ABS(get.PowermoduleMaster.r_TemperatureMax - get.PowermoduleSlave.r_TemperatureMax) > r_TemperatureDeviation;
	
	//slave warning and faults
	events.b_SlaveFault := get.PowermoduleSlave.Events.b_GeneralFaultFlag;
	events.b_SlaveWarning := get.PowermoduleSlave.Events.b_GeneralWarningFlag;

END_IF

//Master warning and faults
events.b_MasterFault := get.PowermoduleMaster.Events.b_GeneralFaultFlag;
events.b_MasterWarning := get.PowermoduleMaster.Events.b_GeneralWarningFlag;
events.b_OvercurrentFault := get.PowermoduleMaster.Events.b_F1OverCurrent OR get.PowermoduleSlave.Events.b_F1OverCurrent;
events.b_OvercurrentWarning := get.r_LoadPercent > get.r_OvercurrentValueAct * 100;
events.b_OvervoltageFault :=  get.PowermoduleMaster.Events.b_F2OverVoltage OR get.PowermoduleSlave.Events.b_F2OverVoltage;
events.b_OvervoltageWarning := get.r_ACVoltageD7 > settings.GridParams.r_GridvoltageMax;
events.b_TemperatureFault := PowermoduleMaster.GetTemperatureEvents(FALSE) OR
	PowermoduleSlave.GetTemperatureEvents(FALSE);
events.b_TemperatureWarning := PowermoduleMaster.GetTemperatureEvents(TRUE) OR
	PowermoduleSlave.GetTemperatureEvents(TRUE);
events.b_startupTimeOut := SFCerror;

FreqCheckPLimitUgrid(
	b_enable := get.b_StartedState AND get.e_InverterMode <> eInvertermodes.Afe AND get.e_PowerMode <> ePowermodes.Isochronous, 
	r_Frequency := get.r_FrequencySupply,
	r_LowFreqLim := st_params.r_FreqLowLimit,
	r_HighFreqLim := st_params.r_FreqHighLimit,
	t_TriggerDelay := TO_TIME(st_params.ui_FreqLimitTripDelay),
	b_LowFreqTrip => events.b_UnderFreqFault,
	b_HighFreqTrip => events.b_OverFreqFault);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Shutdowncmd" Id="{3252be1f-0201-4f42-8602-c777771a2b0f}">
      <Declaration><![CDATA[METHOD Shutdowncmd : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eControl := Shutdown;
//if SFC transition occurs, give feedback.
SFCreset := TRUE;
Shutdowncmd := FALSE;

get.e_State := eStatusPowerStack.shutdown; 
by_CoolingControl := 0;

IF b_InternalACRequired THEN
	get.e_State := eStatusPowerStack.Cooling_Shutdown;
	standbyDeactivateState := TRUE;
		powermodulemaster.Run(Powermode := ePowermodes.Isochronous, InverterMode := eInvertermodes.Microgrid, TRUE );
		IF netcontactor.Open() THEN;
			powermodulemaster.Run(Powermode := ePowermodes.DroopZeroStart, InverterMode := eInvertermodes.Microgrid, TRUE);
			Shutdowncmd	:= TRUE;
		END_IF
	//END_IF
ELSE
	IF ShutdownFull(FALSE)  THEN;
		IF Netcontactor.Open() THEN
			Shutdowncmd	:= TRUE;
			get.e_State := eStatusPowerStack.off;
		END_IF
	END_IF
	
END_IF
	
//	CASE by_CoolingPowerRequest OF // when cooling system allows, all power is killed
//		0: //off
//			by_CoolingControl := 0;
//				IF ShutdownFull(FALSE)  THEN ;
//					IF NOT st_params.b_StandbyEnable THEN
//						IF Netcontactor.Open() THEN
//							Shutdowncmd	:= TRUE;
//							get.e_State := eStatusPowerStack.off;
//						END_IF
//					ELSE			
//						IF NOT get.b_ACDetected THEN
//							Netcontactor.Open();
//						END_IF
//						Shutdowncmd	:= TRUE;
//						get.e_State := eStatusPowerStack.off;
//					END_IF
//				END_IF	
		
//		1, 2: //limited 	
////			IF false then //get.b_GridACdetected THEN //get.b_ACDetected THEN 
////				by_CoolingControl := 0;
////				Shutdowncmd := ShutdownFull(FALSE);
////			ELSE
//				by_CoolingControl := 1;
//				PowerModuleSlave.Shutdown(b_force := FALSE);
//				Shutdowncmd := Netcontactor.Open();
//			//END_IF// if cooling system still wants power AND AC grid is available	
//	END_CASE				

//Shutdowncmd := get.e_Status = eStatusPowerStack.off OR get.e_Status = eStatusPowerStack.init;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ShutdownFull" Id="{b5e7acdd-c5c2-44b3-85fe-0b68cada8086}" FolderPath="Private methods\">
      <Declaration><![CDATA[METHOD PRIVATE ShutdownFull : BOOL
VAR_INPUT
	b_force : BOOL;
END_VAR

VAR_INST
	shutdownfb: BOOL;
	ton_ShutdownTimeOut				: TON:= (PT:=T#30S);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[shutdownfb := PowermoduleMaster.Shutdown(b_force) AND PowermoduleSlave.Shutdown(b_force);
IF shutdownfb THEN
	st_InternalPsuSupplyRequest.b_Demand_HVDC := FALSE;
	st_InternalPsuSupplyRequest.b_Demand_24V := FALSE;
END_IF

ton_ShutdownTimeOut(IN := NOT shutdownfb, Q => get.Events.b_ShutdownTimeOut);


ShutdownFull := shutdownfb;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Standbycmd" Id="{cf6b4612-ee6f-4214-aa1c-7be6d3ccd05e}">
      <Declaration><![CDATA[METHOD Standbycmd : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT(get.e_State = eStatusPowerstack.fault) THEN
	eControl := stand_by;
END_IF

//if SFC transition occurs, give feedback.
Standbycmd := get.e_State = eStatusPowerstack.Standby_GridSupply OR get.e_State = eStatusPowerstack.Standby_GridSupply;
 ]]></ST>
      </Implementation>
    </Method>
    <Method Name="Startcmd" Id="{d0bc3cd7-9278-4072-b3ab-8627c69bac1b}">
      <Declaration><![CDATA[METHOD PUBLIC Startcmd : BOOL

]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF get.b_StartEnabled THEN
	eControl := start;
END_IF

//if we get to status running, give feedback.
Startcmd := get.e_State = eStatusPowerStack.running OR get.e_State = eStatusPowerStack.idle;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="StartingEnable" Id="{f8744432-8b12-426d-bd74-1bc6895ea3bb}" FolderPath="Private methods\">
      <Declaration><![CDATA[METHOD StartingEnable : BOOL
VAR_INPUT
END_VAR
VAR_INST
	b_startcondAFE : BOOL;
	b_startcondUgrid: BOOL;
	b_startcondNoFaults: BOOL;
	b_startcondIsland: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[b_StartcondAFE := set.e_InverterMode = eInvertermodes.Afe AND get.b_GridACdetected;
b_startcondUgrid:= set.e_InverterMode = eInvertermodes.microgrid;

b_startcondNoFaults := NOT(get.e_State = eStatusPowerstack.fault OR powermodulemaster.get.Events.b_GeneralFaultFlag OR powermoduleslave.get.Events.b_GeneralFaultFlag);
b_startcondIsland:=  set.e_InverterMode = eInvertermodes.Island AND NOT get.b_GridACdetected;

StartingEnable := (b_StartcondAFE OR b_startcondUgrid OR b_startcondIsland) AND b_startcondNoFaults OR get.b_StartedState;]]></ST>
      </Implementation>
    </Method>
