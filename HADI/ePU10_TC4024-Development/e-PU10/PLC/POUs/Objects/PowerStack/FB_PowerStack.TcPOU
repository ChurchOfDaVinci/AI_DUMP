    <Method Name="Stopcmd" Id="{3c08d9ca-56db-4ac6-984c-47fe8f634930}">
      <Declaration><![CDATA[METHOD Stopcmd : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT(get.e_State = eStatusPowerstack.fault) THEN
	eControl := Stop;
END_IF

//if SFC transition occurs, give feedback.
Stopcmd := get.e_State = eStatusPowerStack.idle;
]]></ST>
      </Implementation>
    </Method>
