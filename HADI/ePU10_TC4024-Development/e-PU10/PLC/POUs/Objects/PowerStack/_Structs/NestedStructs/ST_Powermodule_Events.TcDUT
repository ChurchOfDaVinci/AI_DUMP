  <DUT Name="ST_Powermodule_Events" Id="{a3554099-5258-4e4c-8c4b-f4ec786f8b83}">
    <Declaration><![CDATA[TYPE ST_Powermodule_Events :
STRUCT
		b_GeneralFaultFlag				: BOOL;
		b_GeneralWarningFlag			: BOOL;

		//Powermodule Warnings
		b_CMSTemperatureRangeWarning	: BOOL;
		b_FanStateUnknownWarning		: BOOL;
		b_TempThrottlingActive			: BOOL;
		b_CurrThrottlingActive			: BOOL;
		
		//INVERTER Fault Status Word 
		b_F1OverCurrent					: BOOL;
		b_F2OverVoltage					: BOOL;
		b_F9UnderVoltage				: BOOL;
		b_F91ShortCircuit				: BOOL;
		b_F3EarthFault					: BOOL;
		b_Spare							: BOOL;
		b_F14UnitOverTemperature		: BOOL;
		b_F56TemperatureFault			: BOOL;
		b_F10LineSynchFault				: BOOL;
		b_F52KeypadOCCommFault			: BOOL;
		b_F53FieldbusFault				: BOOL;
		b_F59SystembusFault				: BOOL;
		b_F54SlotCommunicationFault		: BOOL;
		b_F50Meas4mAFault				: BOOL;
		b_F11OutputPhaseFault 			: BOOL;
		b_F80ChargeFault				: BOOL;
		b_F51ExternalFault				: BOOL;
		b_F31IGBTFault					: BOOL;
		b_F64MCBstateFault				: BOOL;
		b_WatchdogError					: BOOL;
		b_24VdcUVRFault					: BOOL;
		
		//Buscoupler connected faults
		b_MCCBtrip						: BOOL;	
		b_ShutdownTimeOut				: BOOL;
		b_StartUpTimeOut				: BOOL;
	
		//Temperature faults and warnings 
		b_CMChokeTemperatureHigh		: ARRAY [1..4] OF BOOL;
		b_CMChokeTemperatureTooHigh		: ARRAY [1..4] OF BOOL;
		b_GridChokeTemperatureHigh		: ARRAY [1..3] OF BOOL;
		b_GridChokeTemperatureTooHigh	: ARRAY [1..3] OF BOOL;
		b_inverterTemperatureHigh		: BOOL;
		b_PT100Overrange				: BOOL;
		b_PT100Underrange				: BOOL;
		by_PT100ErrorCount				: BYTE;
		

		
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
