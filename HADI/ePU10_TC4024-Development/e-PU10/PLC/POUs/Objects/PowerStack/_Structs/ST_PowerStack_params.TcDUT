<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_PowerStack_params" Id="{b7dfab60-53ed-47f6-8464-6d575460df23}">
    <Declaration><![CDATA[TYPE ST_PowerStack_params :
STRUCT
	b_SoftStartEnable		: BOOL := TRUE;
	b_StandbyEnable			: BOOL := TRUE;
	b_GridcodesEnabled		: BOOL := TRUE;
	r_DroopMinimum			: REAL := 0.0;
	r_DroopIslandMode		: REAL := 0.1;
	r_DroopMaximum			: REAL := 10; //%
	r_ReactiveOffset		: REAL := 0;
	ui_DeratingStack		: UINT := 5; // %
	ui_DeratingLimCooling	: UINT := 80; // %
	i_MaxPowerChangeRate	: INT := 500; // %/s
	ui_OvercurrentRating	: UINT := 150; // %
	i_ChargeOnlyIdlePower	: INT := -3;
	r_ActiveSetpointGain	: REAL := 1; 
	r_ReactiveSetpointGain  : REAL := 1;
	
	//AC drive limits
	r_FreqLowLimit			: REAL := 48;
	r_FreqHighLimit			: REAL := 52; 
	ui_FreqLimitTripDelay	: UINT := 2000; // milliseconds
	FreqVoltageShift		: st_powerstack_ShiftingParams;
	
	PowermoduleMaster		: ST_PowerModule_params;
	PowermoduleSlave		: ST_PowerModule_params;
	LOM						: ST_Powerstack_LOMParams;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>