  <DUT Name="ST_OvercurrentProtection_Params" Id="{2c948606-b547-4e49-a8f3-d8bb6c1b380c}">
    <Declaration><![CDATA[TYPE ST_OvercurrentProtection_Params :
STRUCT
	ui_OCPtripTime		: UINT := 900; //Seconds
	ui_Ik				: UINT := 16; // Short circuit capacity of component to be protected [Ik/s]
	ui_Irated			: UINT := 400; // rated current 
	ui_gain				: UINT := 10; //gain for tuning calculated remaining time during overcurrent.
	OutputNormalShutdownDelay : TIME := T#5S;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>