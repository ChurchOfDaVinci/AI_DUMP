<div id="Buttons" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControl" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-creator-viewport-width="500" data-tchmi-creator-viewport-height="200" data-tchmi-height-mode="Content" data-tchmi-min-height="20" data-tchmi-min-width="20" data-tchmi-width-unit="%" data-tchmi-height-unit="%" data-tchmi-visibility="%f%if(%pp%show%/pp%){'Visible'} else {'Collapsed'}%/f%" data-tchmi-width-mode="Content">
