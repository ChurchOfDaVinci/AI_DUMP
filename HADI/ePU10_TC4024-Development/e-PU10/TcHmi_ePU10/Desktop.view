<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_ClientHMIlink.onPressed",
    "actions": [
      {
        "objectType": "ActionTemplate",
        "active": false,
        "templateName": "PopUpOpen",
        "fnParams": [
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:framework#/definitions/ContentPath",
            "value": "Contents/V3/3-Diagnostics.content"
          }
        ],
        "asyncWait": true
      },
      {
        "objectType": "Comment",
        "comment": "TEunis opening HMI test"
      },
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "window.open('https://10.4.0.40:1021', '_parent');"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      },
      {
        "objectType": "JavaScript",
        "active": false,
        "sourceLines": [
          "// Maak een symbol-object direct met de PLC/HMI-variabelenaam",
          "var symbol = new TcHmi.Symbol('%s%ClientHMI_URL%/s%'); ",
          "// Vervang bovenstaande string door het exacte pad van je variabele in de HMI (zonder %s%...%/s%)",
          "",
          "// Bij readEx krijg je direct de waarde als eerste argument",
          "urlSym.readEx(function (value) {",
          "    if (typeof value === 'string' && value.length > 0) {",
          "        // Voor hetzelfde venster:",
          "        //TcHmi.System.Host.navigate(value, true);",
          "",
          "        // Voor nieuw tabblad/venster:",
          "        window.open(value, '_parent');",
          "    } else {",
          "        console.warn('URL-variabele is leeg of geen string:', value);",
          "    }",
          "});"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  },
  {
    "event": "%s%PLC.Settings.Configuration::b_ClientHMI%/s%",
    "actions": [
      {
        "objectType": "SwitchCase",
        "active": true,
        "compare": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/BOOL",
          "symbolExpression": "%s%PLC.Settings.Configuration::b_ClientHMI%/s%"
        },
        "cases": [
          {
            "caseValue": {
              "objectType": "StaticValue",
              "valueType": "tchmi:general#/definitions/BOOL",
              "value": true
            },
            "actions": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctrl%TcHmiButton_ClientHMIlink::Visibility%/ctrl%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:framework#/definitions/Visibility",
                  "value": "Visible"
                },
                "asyncWait": true
              }
            ]
          },
          {
            "caseValue": {
              "objectType": "StaticValue",
              "valueType": "tchmi:general#/definitions/BOOL",
              "value": false
            },
            "actions": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctrl%TcHmiButton_ClientHMIlink::Visibility%/ctrl%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:framework#/definitions/Visibility",
                  "value": "Collapsed"
                },
                "asyncWait": true
              }
            ]
          }
        ],
        "asyncWait": true
      }
    ]
  }
]
</script>





