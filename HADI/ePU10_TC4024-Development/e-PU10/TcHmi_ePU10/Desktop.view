<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%s%PLC.HMI.Monitoringvars::System::e_SystemState%/s%",
    "actions": [
      {
        "objectType": "Condition",
        "active": true,
        "parts": [
          {
            "if": [
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:server#/definitions/PLC.eSystemState-ShowRecursively",
                  "symbolExpression": "%s%PLC.HMI.Monitoringvars::System::e_SystemState%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:server#/definitions/PLC.eSystemState-ShowRecursively",
                  "value": 4
                },
                "compareOperator": "==",
                "logic": null
              }
            ],
            "then": [
              {
                "objectType": "ActionTemplate",
                "active": true,
                "templateName": "PopUpOpen",
                "fnParams": [
                  {
                    "objectType": "StaticValue",
                    "valueType": "tchmi:framework#/definitions/ContentPath",
                    "value": "Contents/V3/6.Additional/WaitingScreen.content"
                  }
                ],
                "asyncWait": true
              }
            ]
          },
          {
            "else": [
              {
                "objectType": "ActionTemplate",
                "active": true,
                "templateName": "PopUpClose",
                "fnParams": [],
                "asyncWait": true
              }
            ]
          }
        ],
        "asyncWait": true
      }
    ]
  }
]
</script>
</div>


</div>
