<div id="NumInputField" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControl" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-width-unit="%" data-tchmi-height-unit="%" data-tchmi-creator-viewport-width="500" data-tchmi-creator-viewport-height="500" data-tchmi-visibility="%f%if(%pp%enable%/pp%){'Visible'}else{'Collapsed'}%/f%" data-tchmi-height-mode="Content" data-tchmi-right="0" data-tchmi-bottom="0">
<div id="TcHmiTextblock_parlist_title" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-height="100" data-tchmi-height-unit="%" data-tchmi-left-unit="px" data-tchmi-text="%pp%Title%/pp%" data-tchmi-top-unit="px" data-tchmi-width-unit="%" data-tchmi-word-wrap="true" data-tchmi-text-horizontal-alignment="Left" data-tchmi-text-font-size="%i%DataTableFontSize%/i%" data-tchmi-text-vertical-alignment="Center" data-tchmi-width="100" data-tchmi-height-mode="Content" data-tchmi-is-enabled="true" data-tchmi-left="0" data-tchmi-visibility="Visible" data-tchmi-zindex="4" data-tchmi-top="5">
<script data-tchmi-target-attribute="data-tchmi-content-padding" type="application/json">
{
  "left": 5,
  "right": 0,
  "top": 0,
  "bottom": 0,
  "leftUnit": "px",
  "rightUnit": "px",
  "topUnit": "px",
  "bottomUnit": "px"
}
</script>


</div>
<div id="TcHmiNumericInput_parlist_value" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiNumericInput" data-tchmi-auto-focus-out="true" data-tchmi-decimal-digits="%pp%decimals%/pp%" data-tchmi-grid-column-index="1" data-tchmi-grid-row-index="0" data-tchmi-left-unit="px" data-tchmi-reset-to-last-valid-value="true" data-tchmi-top-unit="px" data-tchmi-width-unit="px" data-tchmi-right="0" data-tchmi-value-horizontal-alignment="Center" data-tchmi-value-font-size="%i%DataTableFontSize%/i%" data-tchmi-auto-select-text="true" data-tchmi-min-value="%pp%Min1%/pp%" data-tchmi-max-value="%pp%Max1%/pp%" data-tchmi-is-enabled="%f%%pp%ObserveOnly1%/pp%== 0%/f%" data-tchmi-width="100" data-tchmi-height="%f%%i%DataTableFontSize%/i%+ 6%/f%" data-tchmi-tooltip="%pp%Info1%/pp%" data-tchmi-value="%pp%Value|BindingMode=TwoWay%/pp%" data-tchmi-visibility="Visible" data-tchmi-zindex="4" data-tchmi-top="5" data-tchmi-zero-padding="0">
<script data-tchmi-target-attribute="data-tchmi-content-padding" type="application/json">
{
  "top": 3,
  "right": 3,
  "bottom": 3,
  "left": 3
}
</script>





</div>
<div id="TcHmiTextblock_parlist_info" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-height-unit="%" data-tchmi-left-unit="px" data-tchmi-top-unit="px" data-tchmi-width-unit="%" data-tchmi-word-wrap="true" data-tchmi-text-horizontal-alignment="Left" data-tchmi-text-font-size="%f%%i%DataTableFontSize%/i%-2%/f%" data-tchmi-text-vertical-alignment="Center" data-tchmi-height-mode="Content" data-tchmi-is-enabled="true" data-tchmi-left="10" data-tchmi-top="25" data-tchmi-grid-row-index="1" data-tchmi-text="%pp%Info%/pp%" data-tchmi-visibility="Collapsed" data-tchmi-text-font-style="Italic" data-tchmi-width="100" data-tchmi-bottom="0">
<script data-tchmi-target-attribute="data-tchmi-content-padding" type="application/json">
{
  "left": 5,
  "right": 0,
  "top": 0,
  "bottom": 0,
  "leftUnit": "px",
  "rightUnit": "px",
  "topUnit": "px",
  "bottomUnit": "px"
}
</script>




</div>

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "NumInputField.onMouseLeave",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%TcHmiTextblock_parlist_info::Visibility%/ctrl%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:framework#/definitions/Visibility",
          "value": "Collapsed"
        },
        "asyncWait": true
      }
    ]
  },
  {
    "event": "NumInputField.onMouseOver",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%TcHmiTextblock_parlist_info::Visibility%/ctrl%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:framework#/definitions/Visibility",
          "value": "Visible"
        },
        "asyncWait": true
      }
    ]
  }
]
</script>
</div>