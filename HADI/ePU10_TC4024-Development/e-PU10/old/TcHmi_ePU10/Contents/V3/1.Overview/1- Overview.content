<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%s%PLC.HMI.Monitoringvars::IPSU::b_400VacOK%/s%",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": false,
        "sourceLines": [
          "var symbol = new TcHmi.Symbol('%s%PLC.HMI.Monitoringvars::IPSU::b_400VacOK%/s%');",
          "symbol.readEx(function (data) {",
          "    if (data.error === TcHmi.Errors.NONE) {",
          "        // Handle result value... ",
          "        var value = data.value;",
          "        var element = document.getElementById('AuxSupplyEllipse');",
          "        ",
          "        if (element) {",
          "            updateColor(value, element);\t",
          "        } else {",
          "            console.error(\"Element not found: AuxSupplyEllipse\");",
          "        }",
          "        ",
          "    } else {",
          "        // Handle error... ",
          "        console.error(\"Error reading symbol:\", data.error);",
          "    }",
          "});",
          "",
          "function updateColor(bool, element) {",
          "    if (bool) {",
          "        element.style.fill = '#00A22B';",
          "    } else {",
          "        element.style.fill = 'none';",
          "    }",
          "}"
        ],
        "injectContextObject": true,
        "asyncWait": true,
        "waitMode": "Synchronous"
      },
      {
        "objectType": "Condition",
        "active": true,
        "parts": [
          {
            "if": [
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:server#/definitions/PLC.e400VSupplySource-ShowRecursively",
                  "symbolExpression": "%s%PLC.HMI.Monitoringvars::IPSU::e_400VSource%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:server#/definitions/PLC.e400VSupplySource-ShowRecursively",
                  "value": 2
                },
                "compareOperator": "==",
                "logic": null
              }
            ],
            "then": [
              {
                "objectType": "JavaScript",
                "active": true,
                "sourceLines": [
                  "document.getElementById('AuxSupplyEllipse').style.fill= \"#00a22b\";"
                ],
                "injectContextObject": true,
                "asyncWait": true,
                "waitMode": "Synchronous"
              }
            ]
          },
          {
            "else": [
              {
                "objectType": "JavaScript",
                "active": true,
                "sourceLines": [
                  "document.getElementById('AuxSupplyEllipse').style.fill= \"none\";"
                ],
                "injectContextObject": true,
                "asyncWait": true,
                "waitMode": "Synchronous"
              }
            ]
          }
        ],
        "asyncWait": true
      }
    ]
  }
]
</script>
</div>
