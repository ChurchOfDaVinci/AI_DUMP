<div id="4-6-StatusIoTController" data-tchmi-type="TcHmi.Controls.System.TcHmiContent" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-creator-viewport-height="768" data-tchmi-height-mode="Content" data-tchmi-width-unit="%" data-tchmi-width="100" data-tchmi-width-mode="Value">

<div id="CombinedDataArrays_IoTWrite" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-height-unit="px" data-tchmi-left="0" data-tchmi-left-unit="px" data-tchmi-target-user-control="Contents/CombinedDataArrays.usercontrol" data-tchmi-top="30" data-tchmi-top-unit="px" data-tchmi-width-unit="px" data-tchmi-right="0" data-tchmi-bottom="0" data-tchmi-title="%l%PNcontroller%/l%" data-tchmi-dataarray="%s%PLC.HMI.Monitoringvars::arraydata::IotcontrolData%/s%" data-tchmi-header1="General" data-tchmi-header2="%l%Powerstack%/l%" data-tchmi-header3="%l%BatterySystem%/l%" data-tchmi-height-mode="Content" data-tchmi-width-mode="Content" data-tchmi-header4="%l%PSB%/l%" data-tchmi-show5="true" data-tchmi-header5="%l%Input%/l%" data-tchmi-header6="" data-tchmi-show6="false">

