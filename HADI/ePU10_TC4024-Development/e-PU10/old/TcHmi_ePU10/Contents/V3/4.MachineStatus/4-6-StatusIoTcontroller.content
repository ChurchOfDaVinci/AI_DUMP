[
  {
    "path": "s_Type",
    "comparator": "==",
    "value": "general"
  }
]
</script>

<script data-tchmi-target-attribute="data-tchmi-filter2" type="application/json">
[
  {
    "path": "s_Type",
    "comparator": "==",
    "value": "powerstack"
  }
]
</script>

<script data-tchmi-target-attribute="data-tchmi-filter3" type="application/json">
[
  {
    "path": "s_Type",
    "comparator": "==",
    "value": "battery"
  }
]
