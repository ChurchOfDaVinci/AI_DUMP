<div id="4-6-StatusPNControl" data-tchmi-type="TcHmi.Controls.System.TcHmiContent" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-width="100" data-tchmi-height-mode="Content" data-tchmi-width-unit="%" data-tchmi-width-mode="Value">

<div id="CombinedDataArrays_PN" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-height-unit="px" data-tchmi-left="0" data-tchmi-left-unit="px" data-tchmi-target-user-control="Contents/CombinedDataArrays.usercontrol" data-tchmi-top="30" data-tchmi-top-unit="px" data-tchmi-width-unit="px" data-tchmi-right="0" data-tchmi-bottom="0" data-tchmi-title="%l%PNcontroller%/l%" data-tchmi-dataarray="%s%PLC.HMI.Monitoringvars::arraydata::PNcontrolData%/s%" data-tchmi-header1="General" data-tchmi-header2="%l%Powerstack%/l%" data-tchmi-header3="%l%BatterySystem%/l%" data-tchmi-height-mode="Content" data-tchmi-width-mode="Content" data-tchmi-header4="%l%PSB%/l%" data-tchmi-show5="true" data-tchmi-header5="%l%Input%/l%" data-tchmi-show6="false">
<script data-tchmi-target-attribute="data-tchmi-filter1" type="application/json">
[
  {
    "path": "s_Type",
    "comparator": "==",
    "value": "general"
  }
]
</script>

<script data-tchmi-target-attribute="data-tchmi-filter2" type="application/json">
[
  {
    "path": "s_Type",
    "comparator": "==",
    "value": "powerstack"
  }
]
</script>

<script data-tchmi-target-attribute="data-tchmi-filter3" type="application/json">
[
  {
    "path": "s_Type",
    "comparator": "==",
    "value": "battery"
  }
]
</script>

<script data-tchmi-target-attribute="data-tchmi-filter4" type="application/json">
[
  {
    "path": "s_Type",
    "comparator": "==",
    "value": "PSB"
  }
]
</script>

<script data-tchmi-target-attribute="data-tchmi-filter5" type="application/json">
[
  {
    "path": "s_Type",
    "comparator": "==",
    "value": "input"
  }
]
</script>

<script data-tchmi-target-attribute="data-tchmi-filter6" type="application/json">
[
  {
